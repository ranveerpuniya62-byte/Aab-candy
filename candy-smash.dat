function processJellyCellBreaks(clearedCells){
  if(Object.keys(jellyCells).length === 0) return;

  // For each cleared cell, check if it has jelly on it. Only a real
  // row/column clear reaches here (this is called from the same spots as
  // processLockedCandyUnlocks/processFrozenCandyBreaks) — placing a block
  // alone never touches jellyCells.
  clearedCells.forEach(([cr, cc])=>{
    const key = `${cr},${cc}`;
    const jelly = jellyCells[key];
    if(!jelly || jelly.broken) return;

    jelly.jellyHits--;
    playSound('collect');

    if(jelly.jellyHits <= 0){
      // Mark broken synchronously (before the pop animation/removal
      // timer below) so a candy under this cell counts toward its own
      // target in this same clear pass — see collectJourneyCandies.
      jelly.broken = true;
      breakJelly(cr, cc);
    } else {
      crackJelly(cr, cc);
    }
  });
}

function crackJelly(r, c){
  const dom = getCellDOM(r, c);
  dom.classList.remove('jelly-crack');
  void dom.offsetWidth; // Trigger reflow
  dom.classList.add('jelly-crack');
  playSound('pop');
}

function breakJelly(r, c){
  const dom = getCellDOM(r, c);
  const key = `${r},${c}`;

  // Trigger break animation
  dom.classList.add('jelly-breaking');
  playSound('targetdone');

  // Count this jelly cell toward the level's jelly objective right away.
  if(journeyLevel){
    const jellyTarget = journeyLevel.targets.find(t=>t.isJelly);
    if(jellyTarget && jellyTarget.collected<jellyTarget.required){
      jellyTarget.collected++;
      updateJourneyHUD();
      pulseJourneyHUD();
    }
  }

  // Remove after animation
  setTimeout(()=>{
    delete jellyCells[key];
    refreshCellVisual(r, c);
    dom.classList.remove('jelly-breaking');
  }, 500);
}

/* ============================================================
   BLAST JOURNEY — CHOCOLATE SPREAD (clearing + spread)
============================================================ */
function processChocolateBreaks(clearedCells){
  if(Object.keys(chocolateCells).length === 0) return;

  // A chocolate cell only loses a hit when it is ITSELF part of a real
  // row/column clear (same rule as jelly above) — never from a plain
  // block placement that doesn't clear anything.
  clearedCells.forEach(([cr, cc])=>{
    const key = `${cr},${cc}`;
    const choc = chocolateCells[key];
    if(!choc) return;
    // FIX: a cell already broken (hits<=0, visual still fading ~500ms) must not be hit/counted again.
    if(choc.hits<=0) return;

    choc.hits--;
    if(choc.hits <= 0){
      breakChocolate(cr, cc);
    }
  });
}

function breakChocolate(r, c){
  const dom = getCellDOM(r, c);
  const key = `${r},${c}`;

  dom.classList.add('chocolate-breaking');
  playSound('targetdone');

  // A real break happened this move — resets the spread counter (see
  // handleChocolateSpread, called once per move from afterPlacement).
  chocolateBrokenThisMove = true;

  // Count this chocolate cell toward the level's objective right away.
  if(journeyLevel){
    const chocoTarget = journeyLevel.targets.find(t=>t.isChocolate);
    if(chocoTarget && chocoTarget.collected<chocoTarget.required){
      chocoTarget.collected++;
      updateJourneyHUD();
      pulseJourneyHUD();
    }
  }

  setTimeout(()=>{
    delete chocolateCells[key];
    refreshCellVisual(r, c);
    dom.classList.remove('chocolate-breaking');
  }, 500);
}

/* ============================================================
   BLAST JOURNEY — CANDY BOMB COUNTDOWN (defusing)
   Called from the exact same clear-processing spots as
   processChocolateBreaks/processJellyCellBreaks — a bomb only defuses
   when it is ITSELF part of a real row/column clear (or an equivalent
   existing clear event: special-candy line clear, bomb-blast, tornado —
   same "real clear" definition already used for chocolate/jelly above),
   never from a plain block placement that doesn't clear anything.
============================================================ */
function processBombDefuses(clearedCells){
  if(Object.keys(journeyBombCells).length === 0) return;
  clearedCells.forEach(([cr, cc])=>{
    const key = `${cr},${cc}`;
    if(journeyBombCells[key]) defuseBomb(cr, cc);
  });
}

function defuseBomb(r, c){
  const dom = getCellDOM(r, c);
  const key = `${r},${c}`;

  dom.classList.add('bomb-defusing');
  playSound('targetdone');
  vibrate(20);

  // Removed from the live map right away (synchronously) — so it's
  // already gone by the time afterPlacement's countdown-tick loop runs
  // later this same move, and can never also be counted as "expired".
  delete journeyBombCells[key];

  // Count this bomb toward the level's objective right away.
  if(journeyLevel){
    const bombTarget = journeyLevel.targets.find(t=>t.isBomb);
    if(bombTarget && bombTarget.collected<bombTarget.required){
      bombTarget.collected++;
      updateJourneyHUD();
      pulseJourneyHUD();
    }
  }

  setTimeout(()=>{
    dom.removeAttribute('data-bomb-count');
    refreshCellVisual(r, c);
    dom.classList.remove('bomb-defusing');
  }, 500);
}

/* ============================================================
   RAINBOW CANDY — collection
   Called from the same clear-processing spots as chocolate/bomb, but
   AFTER processLockedCandyUnlocks/processFrozenCandyBreaks/
   processJellyCellBreaks so their hit-counters already reflect this same
   clear — a Rainbow Candy nested inside one of those only becomes
   collectible the instant that obstacle's own last hit lands, never
   before (existing obstacle rules aren't bypassed, per spec).
============================================================ */
function processRainbowCollection(clearedCells){
  if(Object.keys(rainbowCells).length === 0) return;
  clearedCells.forEach(([cr, cc])=>{
    const key = `${cr},${cc}`;
    if(!rainbowCells[key]) return;
    const jellyHere = jellyCells[key];
    if(jellyHere && !jellyHere.broken) return;      // jelly not popped yet
    const lockedHere = lockedCandies[key];
    if(lockedHere && lockedHere.unlockHits>0) return; // still locked
    const frozenHere = frozenCandies[key];
    if(frozenHere && frozenHere.iceHits>0) return;    // ice not broken yet
    collectRainbowCandy(cr, cc);
  });
}

function collectRainbowCandy(r, c){
  const dom = getCellDOM(r, c);
  const key = `${r},${c}`;

  dom.classList.add('rainbow-collecting');
  playSound('targetdone');
  vibrate(20);

  delete rainbowCells[key];

  if(journeyLevel){
    const rainbowTarget = journeyLevel.targets.find(t=>t.isRainbow);
    if(rainbowTarget && rainbowTarget.collected<rainbowTarget.required){
      rainbowTarget.collected++;
      updateJourneyHUD();
      pulseJourneyHUD();
    }
  }

  setTimeout(()=>{
    refreshCellVisual(r, c);
    dom.classList.remove('rainbow-collecting');
  }, 500);
}

/* ============================================================
   TREASURE BOX — placement (Blast Journey Step 10)
   Always sits on a filled candy cell, same requirement as bomb/locked/
   frozen/jelly/rainbow (needs to actually be part of a real line clear to
   ever be opened). Like Rainbow Candy, it's explicitly ALLOWED to land on
   a cell that is ALSO locked/frozen/jelly — that's the "unlock/break/
   de-jelly first, then hit the box" case, handled by
   processTreasureBoxHits() below. It's kept OFF chocolate/bomb/rainbow
   cells simply because nothing in the spec defines how those would nest
   with it, same undefined-nesting avoidance used by rainbow. Positions
   are never hard-coded: CUSTOM_LEVEL_TREASURE only supplies a count +
   hitsRequired per level (see above), and this picks `count` random
   eligible cells at level start.
============================================================ */
function initializeTreasureCells(config){
  if(!config.hasTreasure || config.treasureCount<=0) return;

  const desired = config.treasureCount;
  const hitsRequired = config.treasureHitsRequired || 2;
  let placed = 0;
  let attempts = 0;

  while(placed < desired && attempts < 300){
    attempts++;
    const r = Math.floor(Math.random()*SIZE);
    const c = Math.floor(Math.random()*SIZE);
    const key = `${r},${c}`;

    if(board[r][c].void || board[r][c].obstacle || !board[r][c].filled) continue;
    if(board[r][c].specialType) continue; // keep it a plain candy underneath, like locked/frozen/rainbow do
    if(treasureCells[key] || chocolateCells[key] || journeyBombCells[key] || rainbowCells[key] || pathCells[key]) continue;

    treasureCells[key] = { hitsRequired, hitsRemaining: hitsRequired };
    placed++;
  }

  // Guard: never leave the objective needing more opens than actually got
  // placed (same guard used for chocolate/bomb/rainbow above).
  const treasureTarget = config.targets.find(t=>t.isTreasure);
  if(treasureTarget){
    if(placed === 0){
      const idx = config.targets.indexOf(treasureTarget);
      if(idx>=0) config.targets.splice(idx,1);
      config.hasTreasure = false;
    } else if(placed < desired){
      treasureTarget.required = placed;
    }
  }
}

/* ============================================================
   TREASURE BOX — first-time tutorial
============================================================ */
function showTreasureTutorialIfNeeded(config){
  if(!config.hasTreasure || treasureTutorialShown) return;

  treasureTutorialShown = true;

  const tutorial = document.createElement('div');
  tutorial.style.cssText = `
    position:fixed; top:50%; left:50%; transform:translate(-50%, -50%);
    background:rgba(0,0,0,.85); color:#fff; padding:30px 40px;
    border-radius:20px; z-index:9999; text-align:center;
    font-weight:800; font-size:18px; font-family:var(--font-heading);
    box-shadow:0 8px 32px rgba(0,0,0,.5);
    animation:tutorialSlideIn .4s cubic-bezier(.34,1.56,.64,1);
  `;

  tutorial.innerHTML = `
    <div style="font-size:32px; margin-bottom:12px;">🎁</div>
    <div style="margin-bottom:8px;">TREASURE</div>
    <div style="font-size:14px; color:#ccc; margin-bottom:20px;">Clear around the box<br>to open it!</div>
    <button style="
      background:#ff8fd0; color:#fff; border:none; padding:10px 20px;
      border-radius:10px; font-weight:800; cursor:pointer; font-size:14px;
      font-family:var(--font-body);
    " onclick="this.parentElement.remove();">GOT IT!</button>
  `;

  document.body.appendChild(tutorial);

  setTimeout(()=>{
    if(tutorial.parentElement) tutorial.remove();
  }, 5000);
}

/* ============================================================
   TREASURE BOX — hits/opening
   Called from the same clear-processing spots as chocolate/bomb/rainbow,
   AFTER processLockedCandyUnlocks/processFrozenCandyBreaks/
   processJellyCellBreaks so their hit-counters already reflect this same
   clear — a Treasure Box nested inside one of those only starts taking
   hits the instant that obstacle's own last hit lands, never before
   (existing obstacle rules aren't bypassed, per spec). Only an actual
   clear that directly includes the box's cell counts — a plain block
   placement that clears nothing never reaches this function at all.
============================================================ */
function processTreasureBoxHits(clearedCells){
  if(Object.keys(treasureCells).length === 0) return;
  clearedCells.forEach(([cr, cc])=>{
    const key = `${cr},${cc}`;
    const treasure = treasureCells[key];
    if(!treasure) return;
    const jellyHere = jellyCells[key];
    if(jellyHere && !jellyHere.broken) return;       // jelly not popped yet
    const lockedHere = lockedCandies[key];
    if(lockedHere && lockedHere.unlockHits>0) return; // still locked
    const frozenHere = frozenCandies[key];
    if(frozenHere && frozenHere.iceHits>0) return;    // ice not broken yet

    treasure.hitsRemaining--;
    playSound('collect');

    if(treasure.hitsRemaining <= 0){
      openTreasureBox(cr, cc);
    } else {
      crackTreasureBox(cr, cc);
    }
  });
}

function crackTreasureBox(r, c){
  const dom = getCellDOM(r, c);
  const key = `${r},${c}`;
  dom.setAttribute('data-treasure-hits', Math.max(0, treasureCells[key].hitsRemaining));
  dom.classList.remove('treasure-crack');
  void dom.offsetWidth; // Trigger reflow
  dom.classList.add('treasure-crack');
  playSound('pop');
}

function openTreasureBox(r, c){
  const dom = getCellDOM(r, c);
  const key = `${r},${c}`;
  const rect = boardEl.getBoundingClientRect();
  const x = rect.left + 8 + (c+0.5)*(boardCellSize+3);
  const y = rect.top + 8 + (r+0.5)*(boardCellSize+3);

  dom.classList.add('treasure-opening');
  playSound('targetdone');
  vibrate(20);
  spawnTreasureParticles(x, y);
  showTreasureReward(x, y);

  // Removed from the live map right away (synchronously), same as bomb's
  // defuseBomb — so it can never be double-counted by a later clear this
  // same move.
  delete treasureCells[key];

  if(journeyLevel){
    const treasureTarget = journeyLevel.targets.find(t=>t.isTreasure);
    if(treasureTarget && treasureTarget.collected<treasureTarget.required){
      treasureTarget.collected++;
      updateJourneyHUD();
      pulseJourneyHUD();
    }
  }

  setTimeout(()=>{
    dom.removeAttribute('data-treasure-hits');
    refreshCellVisual(r, c);
    dom.classList.remove('treasure-opening');
  }, 500);
}

// A small burst of pink/purple/gold sparkle particles when a box opens —
// same lightweight reused .particle system as the bomb/tornado bursts
// above, deliberately smaller (per spec: no huge explosion).
function spawnTreasureParticles(x, y){
  const colors = ['#ff8fd0','#c86bff','#ffd166','#ffe9a8'];
  for(let i=0;i<8;i++){
    const p = document.createElement('div');
    p.className='particle';
    const size = 5+Math.random()*6;
    p.style.width=size+'px'; p.style.height=size+'px';
    p.style.left=x+'px'; p.style.top=y+'px';
    p.style.background = colors[Math.floor(Math.random()*colors.length)];
    const angle = Math.random()*Math.PI*2;
    const dist = 24+Math.random()*24;
    p.style.setProperty('--pt', `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px)`);
    document.body.appendChild(p);
    setTimeout(()=>p.remove(), 650);
  }
}

// The small visual candy reward (🎁 → 🍬✨, per spec) — a floating emoji
// that pops up and fades out. Purely visual/objective feedback; never
// touches the existing score system (per spec — no new scoring/currency).
function showTreasureReward(x, y){
  const rewardEl = document.createElement('div');
  rewardEl.textContent = '🍬✨';
  rewardEl.style.cssText = `
    position:fixed; left:${x}px; top:${y}px; transform:translate(-50%,-50%);
    z-index:591; pointer-events:none; font-size:20px;
    animation:treasureRewardFloat .7s ease-out forwards;
  `;
  document.body.appendChild(rewardEl);
  setTimeout(()=>rewardEl.remove(), 700);
}

/* ============================================================
   CANDY PATH / SWEET ROUTE — placement (Blast Journey Step 11)
   UNLIKE every mechanic above, this is never randomly placed — the exact
   ordered route lives in CUSTOM_LEVEL_PATH (ported onto config.pathCells
   by generateLevelConfig) as hand-authored { row, col } steps guaranteed
   to sit inside that level's actual board-shape mask and be orthogonally
   connected step-to-step, per spec ("Do NOT randomly generate paths
   unless the generated path is guaranteed to be valid and connected").
   This just turns that ordered list into the live pathCells/pathSequence
   state. Runs FIRST among all the init*Cells() calls in startJourneyLevel
   so every other mechanic's own placement can skip a path cell (see the
   `|| pathCells[key]` guards added to each of them above) — Candy Path
   never has to share a cell/pseudo-element with another obstacle overlay.
============================================================ */
function initializePathCells(config){
  if(!config.hasPath || !config.pathCells || config.pathCells.length===0) return;

  pathSequence = [];
  config.pathCells.forEach((step, idx)=>{
    // Safety guard only — every hand-authored route above already sits
    // fully inside its level's board-shape mask, so this should never
    // actually trigger; it just keeps a typo'd/void coordinate from ever
    // producing an unreachable path step.
    if(board[step.row][step.col].void) return;
    const key = `${step.row},${step.col}`;
    pathCells[key] = { order: idx, completed: false };
    pathSequence.push(key);
  });

  // Guard: never leave the objective needing more completions than the
  // route actually has usable steps for (same guard used by every other
  // mechanic above).
  const pathTarget = config.targets.find(t=>t.isPath);
  if(pathTarget){
    if(pathSequence.length===0){
      const idx = config.targets.indexOf(pathTarget);
      if(idx>=0) config.targets.splice(idx,1);
      config.hasPath = false;
    } else if(pathSequence.length < pathTarget.required){
      pathTarget.required = pathSequence.length;
    }
  }
}

/* ============================================================
   CANDY PATH — first-time tutorial
============================================================ */
function showPathTutorialIfNeeded(config){
  if(!config.hasPath || pathTutorialShown) return;

  pathTutorialShown = true;

  const tutorial = document.createElement('div');
  tutorial.style.cssText = `
    position:fixed; top:50%; left:50%; transform:translate(-50%, -50%);
    background:rgba(0,0,0,.85); color:#fff; padding:30px 40px;
    border-radius:20px; z-index:9999; text-align:center;
    font-weight:800; font-size:18px; font-family:var(--font-heading);
    box-shadow:0 8px 32px rgba(0,0,0,.5);
    animation:tutorialSlideIn .4s cubic-bezier(.34,1.56,.64,1);
  `;

  tutorial.innerHTML = `
    <div style="font-size:32px; margin-bottom:12px;">🍭</div>
    <div style="margin-bottom:8px;">SWEET PATH</div>
    <div style="font-size:14px; color:#ccc; margin-bottom:20px;">Clear the path cells<br>in order to reach the finish!</div>
    <button style="
      background:#9a6fe0; color:#fff; border:none; padding:10px 20px;
      border-radius:10px; font-weight:800; cursor:pointer; font-size:14px;
      font-family:var(--font-body);
    " onclick="this.parentElement.remove();">GOT IT!</button>
  `;

  document.body.appendChild(tutorial);

  setTimeout(()=>{
    if(tutorial.parentElement) tutorial.remove();
  }, 5000);
}

/* ============================================================
   CANDY PATH — progression
   Called from the same clear-processing spots as chocolate/bomb/rainbow/
   treasure. Enforces the IN-ORDER rule directly by construction: it only
   ever looks at pathSequence[pathNextIndex] (the one and only step that's
   currently allowed to complete) and advances one step at a time — a
   later step being part of this same clear can never complete ahead of an
   earlier, not-yet-reached one, since the loop below stops the instant
   the current expected step isn't in this clear. A single clear CAN
   legitimately complete several consecutive steps at once, if the route
   happens to run through more than one cell of the same cleared row/
   column — that's still "in order", just several in-order steps landing
   in the same move.
============================================================ */
function processPathProgress(clearedCells){
  if(pathSequence.length===0 || pathNextIndex>=pathSequence.length) return;

  const clearedSet = new Set(clearedCells.map(([r,c])=>`${r},${c}`));
  let anyCompleted = false;

  while(pathNextIndex < pathSequence.length && clearedSet.has(pathSequence[pathNextIndex])){
    const [pr, pc] = pathSequence[pathNextIndex].split(',').map(Number);
    completePathCell(pr, pc);
    pathNextIndex++;
    anyCompleted = true;
  }

  if(!anyCompleted) return;

  refreshPathActiveHighlight();
  if(pathNextIndex>=pathSequence.length) celebratePathComplete();
}

function completePathCell(r, c){
  const key = `${r},${c}`;
  const step = pathCells[key];
  if(!step || step.completed) return;
  step.completed = true;

  const dom = getCellDOM(r, c);
  dom.classList.remove('path-active');
  dom.classList.add('path-completed');
  dom.classList.remove('path-completing');
  void dom.offsetWidth; // Trigger reflow
  dom.classList.add('path-completing');
  playSound('targetdone');
  vibrate(15);

  const rect = boardEl.getBoundingClientRect();
  const x = rect.left + 8 + (c+0.5)*(boardCellSize+3);
  const y = rect.top + 8 + (r+0.5)*(boardCellSize+3);
  spawnPathParticles(x, y);

  setTimeout(()=>dom.classList.remove('path-completing'), 500);

  if(journeyLevel){
    const pathTarget = journeyLevel.targets.find(t=>t.isPath);
    if(pathTarget && pathTarget.collected<pathTarget.required){
      pathTarget.collected++;
      updateJourneyHUD();
      pulseJourneyHUD();
    }
  }
}

// Moves the glowing "clear this next" highlight onto the new current step.
// Called once per batch of completions (not per-cell) since a single
// clear can legitimately complete several consecutive steps at once.
function refreshPathActiveHighlight(){
  const nextKey = pathSequence[pathNextIndex];
  if(!nextKey) return;
  const [nr, nc] = nextKey.split(',').map(Number);
  getCellDOM(nr, nc).classList.add('path-active');
}

// The final step just completed — a short, lightweight celebration (per
// spec): the whole route re-flashes once and an extra sparkle burst plays
// at the finish cell. The finish step's own sound/vibrate already played
// inside completePathCell just above, so this is visual-only.
function celebratePathComplete(){
  const finishKey = pathSequence[pathSequence.length-1];
  if(finishKey){
    const [fr, fc] = finishKey.split(',').map(Number);
    const rect = boardEl.getBoundingClientRect();
    const x = rect.left + 8 + (fc+0.5)*(boardCellSize+3);
    const y = rect.top + 8 + (fr+0.5)*(boardCellSize+3);
    spawnPathParticles(x, y);
  }
  pathSequence.forEach(key=>{
    const [r, c] = key.split(',').map(Number);
    const dom = getCellDOM(r, c);
    dom.classList.remove('path-completing');
    void dom.offsetWidth; // Trigger reflow
    dom.classList.add('path-completing');
    setTimeout(()=>dom.classList.remove('path-completing'), 500);
  });
}

// A small purple/gold/green sparkle burst, reused for both per-step and
// finish-line celebrations — same lightweight .particle system as the
// bomb/treasure bursts above, kept intentionally small per spec.
function spawnPathParticles(x, y){
  const colors = ['#cdb3ff','#9a6fe0','#ffd166','#baffc9'];
  for(let i=0;i<6;i++){
    const p = document.createElement('div');
    p.className='particle';
    const size = 4+Math.random()*5;
    p.style.width=size+'px'; p.style.height=size+'px';
    p.style.left=x+'px'; p.style.top=y+'px';
    p.style.background = colors[Math.floor(Math.random()*colors.length)];
    const angle = Math.random()*Math.PI*2;
    const dist = 20+Math.random()*20;
    p.style.setProperty('--pt', `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px)`);
    document.body.appendChild(p);
    setTimeout(()=>p.remove(), 600);
  }
}

// Called once per completed Journey move (from afterPlacement), AFTER any
// bombs affected by this move's clear have already been defused/removed
// above. Ticks every still-active bomb's countdown down by exactly one,

// updates its visual/warning state, and reports whether any bomb reached
// 0 — afterPlacement uses that to fail the level, but only after first
// confirming the move didn't also just complete every objective (see the
// WIN-before-FAIL ordering there).
function tickBombCountdowns(){
  let expired = false;
  Object.keys(journeyBombCells).forEach(key=>{
    const bomb = journeyBombCells[key];
    bomb.countdown--;
    const [br,bc] = key.split(',').map(Number);
    if(bomb.countdown<=0){
      expired = true;
      getCellDOM(br,bc).classList.add('bomb-expiring');
    } else if(bomb.countdown<=2){
      // Countdown 2 and 1 get a subtle warning cue (per spec: gentle at 3
      // via CSS pulse alone, stronger + sound at 2, strongest at 1).
      playSound('tornadowarn');
      if(bomb.countdown===1) vibrate(15);
    }
    updateBombCellVisual(br,bc);
  });
  return expired;
}

// Called once per completed Journey move (from afterPlacement). Tracks how
// many consecutive moves passed without a chocolate break, and spreads
// chocolate to exactly ONE adjacent eligible cell once that streak hits
// the level's configured interval. Chocolate spreading never touches
// journeyMovesRemaining — it's purely a board-state change.
function handleChocolateSpread(){
  if(!journeyLevel || !journeyLevel.chocolateSpreadEvery){
    chocolateBrokenThisMove = false;
    return;
  }
  if(chocolateBrokenThisMove){
    chocolateMovesSinceBreak = 0;
  } else {
    chocolateMovesSinceBreak++;
    if(chocolateMovesSinceBreak >= journeyLevel.chocolateSpreadEvery){
      chocolateMovesSinceBreak = 0;
      trySpreadChocolate();
    }
  }
  chocolateBrokenThisMove = false;
}

function trySpreadChocolate(){
  const maxCells = journeyLevel.maxChocolateCells || journeyLevel.chocolateCount || 0;
  if(Object.keys(chocolateCells).length >= maxCells) return; // cap reached — no further spread

  // Gather every empty/normal cell adjacent to an existing chocolate cell
  // that's eligible to receive it: not void, not obstacle, not already
  // chocolate, and not locked/frozen/jelly (protected cells, per spec).
  const candidates = [];
  const seen = new Set();
  Object.keys(chocolateCells).forEach(key=>{
    const [r,c] = key.split(',').map(Number);
    [[r-1,c],[r+1,c],[r,c-1],[r,c+1]].forEach(([nr,nc])=>{
      if(!inBounds(nr,nc)) return;
      const nKey = `${nr},${nc}`;
      if(seen.has(nKey)) return;
      if(board[nr][nc].void || board[nr][nc].obstacle) return;
      if(chocolateCells[nKey] || lockedCandies[nKey] || frozenCandies[nKey] || jellyCells[nKey]) return;
      seen.add(nKey);
      candidates.push([nr,nc]);
    });
  });
  if(candidates.length===0) return;

  const [tr,tc] = candidates[Math.floor(Math.random()*candidates.length)];
  chocolateCells[`${tr},${tc}`] = { hits: 1 };

  const dom = getCellDOM(tr,tc);
  refreshCellVisual(tr,tc);
  dom.classList.remove('chocolate-spreading');
  void dom.offsetWidth;
  dom.classList.add('chocolate-spreading');
  playSound('pop');
  setTimeout(()=>dom.classList.remove('chocolate-spreading'), 500);
}

function startJourneyLevel(n){
  playSound('levelstart');
  mode = 'journey';
  currentJourneyLevelNumber = n;
  journeyMovesUsed = 0;
  journeyRoundOver = false; // BUGFIX (Step 17 QA): fresh round guard for this level/restart
  const config = generateLevelConfig(n);
  journeyLevel = config;
  journeyMovesRemaining = config.moves; // null = unlimited; resets to the level's original count on restart too
  // BUGFIX (Step 17 QA): tell buildStartingBoard how many filled cells this
  // level's Locked/Frozen candy objectives need at minimum, so those
  // mechanics are never silently skipped on a sparse early-level board.
  const minOccupiedForObstacles = config.targets.filter(t=>t.locked).length + config.targets.filter(t=>t.frozen).length;
  board = buildStartingBoard(n, config.targetEmojis, minOccupiedForObstacles);
  lockedCandies = {}; // Reset locked candies map
  frozenCandies = {}; // Reset frozen candies map
  jellyCells = {}; // Reset jelly cells map
  chocolateCells = {}; // Reset chocolate cells map
  chocolateMovesSinceBreak = 0;
  chocolateBrokenThisMove = false;
  journeyBombCells = {}; // Reset candy bomb cells map
  rainbowCells = {}; // Reset rainbow candy cells map
  treasureCells = {}; // Reset treasure box cells map
  pathCells = {}; // Reset Candy Path cells map
  pathSequence = [];
  pathNextIndex = 0;
  initializePathCells(config); // Set up the Candy Path FIRST — every other mechanic below skips a path cell (see the `|| pathCells[key]` guards in each), so Candy Path never has to share a cell with another obstacle overlay
  initializeLockedCandies(config); // Set up locked candies for this level
  initializeFrozenCandies(config); // Set up frozen candies for this level
  initializeJellyCells(config); // Set up jelly cells for this level
  initializeChocolateCells(config); // Set up chocolate cells for this level
  initializeBombCells(config); // Set up candy bomb cells for this level
  initializeRainbowCandies(config); // Set up rainbow candies for this level
  initializeTreasureCells(config); // Set up treasure boxes for this level
  setupBossVisuals(n); // LEVEL 200 only — shows/resets the Candy Castle boss scene; a no-op (hides everything) on every other level
  score = 0;
  obstaclesSpawned = 0;
  obstacleCount = 0;
  placementsSinceStart = 0;
  dragInfo = null;
  modeTagEl.textContent = 'LEVEL ' + n;
  updateScoreUI();
  classicResetComboState();
  applyBlastJourneyTheme(n);
  buildBoardDOM();
  computeCellSize();
  refreshAllCells();
  newTray();
  gameScreen.classList.add('journey-mode');
  gameScreen.classList.remove('classic-tap');
  showJourneyHUD(true);
  renderJourneyHUD();
  showScorePanel(false);
  setClassicTopbar(false);
  clearHintHighlights();
  updateHintUI();
  showHintBar(true);
  showScreen(gameScreen);
  setTimeout(computeCellSize, 60);
  if(bossActive){
    showBossIntro();
  } else {
    showJourneyLevelIntro(n);
  }
  showLockedCandyTutorialIfNeeded(config);
  showFrozenCandyTutorialIfNeeded(config);
  showJellyTutorialIfNeeded(config);
  showMovesTutorialIfNeeded(config);
  showComboTutorialIfNeeded(config);
  showChocolateTutorialIfNeeded(config);
  showBombTutorialIfNeeded(config);
  showRainbowTutorialIfNeeded(config);
  showTreasureTutorialIfNeeded(config);
  showPathTutorialIfNeeded(config);
}

function startGame(selectedMode){
  playSound('button');
  mode = selectedMode;
  board = createEmptyBoard();
  score = 0;
  obstaclesSpawned = 0;
  obstacleCount = 0;
  placementsSinceStart = 0;
  dragInfo = null;
  modeTagEl.textContent = mode.toUpperCase();
  updateScoreUI();
  classicResetComboState();
  resetTornadoSession();
  buildBoardDOM();
  computeCellSize();
  gameScreen.classList.remove('journey-mode');
  gameScreen.classList.toggle('classic-tap', mode==='classic' && CLASSIC_TAP_FILL);
  classicTapOver = false;
  showJourneyHUD(false);
  showScorePanel(true);
  setClassicTopbar(true);
  // Explicitly clear any leftover Journey theme layer state — the CSS
  // guard already forces opacity:0 outside journey-mode regardless, but
  // this keeps the JS-side state honest too rather than relying on CSS
  // alone to mask it.
  if(journeyThemeActiveLayer){
    el('journey-theme-bg-'+journeyThemeActiveLayer).classList.remove('active');
    journeyThemeActiveLayer = null;
    journeyThemeCurrentName = null;
  }
  clearHintHighlights();
  showHintBar(false);
  if(mode==='classic' && CLASSIC_TAP_FILL){
    // Tap-to-fill: no tray pieces at all.
    trayPieces = [null,null,null];
    trayEl.querySelectorAll('.piece-slot').forEach(s=>s.remove());
    ccCancel();
  } else {
    newTray();
  }
  showScreen(gameScreen);
  setTimeout(computeCellSize, 60);
}

function restartGame(){
  if(mode==='journey' && currentJourneyLevelNumber){
    startJourneyLevel(currentJourneyLevelNumber);
  } else {
    startGame(mode);
  }
}

/* ============================================================
   MORE GAMES — 3 lightweight bonus mini-games (Donut Drop, Ice Cream
   Stack, Puzzle Pop). Each is fully self-contained: its own state object,
   its own requestAnimationFrame loop (or timer chain for Puzzle Pop), and
   a start()/stop() pair. Input listeners are attached ONCE at setup time
   (never re-attached on every entry) and are gated by each game's own
   `active` flag, so there is no risk of duplicate listeners accumulating
   and no work happens while a game isn't the active screen. showScreen()
   calls stopAllMiniGames() any time we navigate to a non-mini-game
   screen, which is the single place all three loops/timers get shut down.
============================================================ */
function stopAllMiniGames(){
  stopDonutGame();
  stopIceStackGame();
  stopPuzzlePopGame();
  stopArrowGame();
}

/* ---------------- shared mini-game animation helpers ---------------- */
// Soft scale+fade entrance for a game's play area when it starts/restarts.
function playEntranceAnim(elm){
  elm.classList.remove('mg-enter');
  void elm.offsetWidth; // restart the CSS animation even if it's still mid-play
  elm.classList.add('mg-enter');
}
// Quick, satisfying scale pop whenever a score number changes.
function pulseScoreEl(elm){
  elm.classList.remove('mg-score-pulse');
  void elm.offsetWidth;
  elm.classList.add('mg-score-pulse');
}
// Game Over panel gets its own pop-in entrance instead of just appearing.
function showMiniGameOverlay(overlayEl){
  overlayEl.classList.remove('mg-hidden');
  const panel = overlayEl.querySelector('.minigame-overlay-panel');
  if(panel){
    panel.classList.remove('mg-panel-pop');
    void panel.offsetWidth;
    panel.classList.add('mg-panel-pop');
  }
}

/* ---------------- DONUT DROP ---------------- */
const donutCanvas = el('donut-canvas');
const donutCtx = donutCanvas.getContext('2d');
const donutOverlayEl = el('donut-overlay');
const donutCanvasWrapEl = el('donut-canvas-wrap');
const donutScoreEl = el('donut-score');
const donutState = {
  active:false, rafId:null, lastTime:0,
  plateX:0.5,        // instant target (from pointer) — used for game logic
  plateVisualX:0.5,  // smoothed on-screen position — used for drawing only
  pointerActive:false,
  // items/particles/popups are all capped in size (see splice calls below)
  // so continuous, indefinite play stays lightweight on low-end phones.
  items:[], particles:[], popups:[], spawnTimer:0, spawnInterval:1100,
  score:0, w:0, h:0, shakeT:0,
  speedLevel:0,      // v7: score milestones reached (1000 pts each) — only ever increases within a run
  scoreSpeedMul:1,   // v7: fall-speed multiplier from speedLevel (see donutScoreSpeedMul)
  playTop:0,         // v7/v8: top of the visible play area as a fraction of logical canvas height (negative = above the logical top)
  topExtra:0,        // v8: extra CSS px the play area is stretched UP (to just under the top bar); logical w/h are unchanged
  gameOverPending:false, // set the instant the chilli is caught, so this
                         // frame's remaining donuts still render/behave
                         // normally but no further game logic runs after
  // Step 4 visual enhancements: track multi-catch for staggered animations/effects
  donutsCaughtThisFrame:[], // {x, y, scale, t} positions of donuts caught this frame
  multiCatchGlowT:0,        // glow pulse timer for 3+ catch moment
  // Step 6 visual enhancements: track donut pop effects for catch animations
  popEffects:[]             // {x, y, life, scale} — sweet pop effects on catch
};
// Responsive-but-fluid interpolation: high factor so the plate reaches the
// finger within ~2 frames (no perceptible lag), while still smoothing out
// raw touch jitter into soft "water-like" motion instead of an instant snap.
const DONUT_PLATE_SMOOTH = 0.55;
function donutResize(){
  // v8: stretch the play area UP so donuts start right under the score/top bar. The logical canvas
  // (donutState.w/h, plate, catch zone, donut size) stays exactly the original 3:4 box at the bottom;
  // the extra strip above it is drawn through a translate, so nothing else moves or rescales.
  const ex = donutFitPlayArea();
  donutState.topExtra = ex;
  const rect = donutCanvasWrapEl.getBoundingClientRect();
  donutState.w = Math.max(1, Math.round(rect.width));
  donutState.h = Math.max(1, Math.round(rect.height) - ex);
  // Render at devicePixelRatio so the canvas stays crisp on high-DPI phones
  // instead of blurry — capped at 2.5x so it never becomes an oversized,
  // wasteful backing store on very high-DPR devices. All existing draw code
  // keeps using donutState.w/h (CSS-pixel space); this transform is the
  // only thing that changes.
  const dpr = Math.min(window.devicePixelRatio||1, 2.5);
  donutCanvas.width = Math.round(donutState.w*dpr);
  donutCanvas.height = Math.round((donutState.h + ex)*dpr);
  donutCtx.setTransform(dpr,0,0,dpr,0,ex*dpr);
}
/* ---- DONUT FALL-SPEED RAMP (Donut Catch + Donut Levels) ----
   Multiplier applied to DONUT fall speed as a function of seconds played:
   the first 12 s start slow (0.65x easing up to 1.0x), then every 10 s the speed
   steps up by `step` (each bump eases in over ~3 s, so it feels like a smooth
   "speed-up" rather than a jump) until it reaches `cap`. Pure function of play time. */
function donutTimeSpeedMul(tSec, step, cap){
  const t = Math.max(0, tSec);
  if(t < 12){
    const w = t/12;
    return 0.65 + 0.35*(w*w*(3 - 2*w));
  }
  const u = (t - 12)/10, n = Math.floor(u);
  let e = Math.min(1, Math.max(0, ((u - n) - 0.7)/0.3));
  e = e*e*(3 - 2*e);
  return Math.min(cap, 1 + step*(n + e));
}
/* ---- v7: SPAWN LINE + SCORE-MILESTONE SPEED (Donut Catch + Donut Levels) ----
   SPAWN LINE: donuts enter from the top of the VISIBLE play area and fall down. In Donut Catch the top bar
   sits above the canvas, so the line is the canvas top edge (playTop = 0, unchanged from v6). In Levels the
   score/time HUD is drawn over the top of the canvas, so the line is the bottom edge of that HUD: donuts spawn
   just above it (clipped, so they slide out from the line) instead of passing behind the panel.
   SPEED: every 1000 points raises the fall speed by DONUT_SCORE_SPEED_STEP (and tightens the spawn gap a little),
   up to DONUT_SCORE_SPEED_MAX. donutState.speedLevel only ever goes up, so each milestone applies exactly once. */
const DONUT_SPAWN_MARGIN_PX = 6;
const DONUT_SCORE_MILESTONE = 1000;      // points per speed milestone
const DONUT_SCORE_SPEED_STEP = 0.06;     // +6% fall speed per milestone
const DONUT_SCORE_SPEED_MAX = 1.36;      // hard cap (reached at 6000 pts)
const DONUT_SCORE_SPEED_IN_LEVELS = true; // false = Levels keep only their own per-level difficulty
// v8: gap (px) kept between the top bar and the top of the play area.
const DONUT_TOP_GAP_PX = 4;
// Puts the play-area wrapper's TOP just under the top bar while keeping its natural width and its BOTTOM edge
// where it always was. Returns the number of CSS px it grew upward (0 if there is no room / nothing to do).
function donutFitPlayArea(){
  try{
    const wrap = donutCanvasWrapEl;
    wrap.style.height = ''; wrap.style.alignSelf = ''; wrap.style.marginTop = ''; wrap.style.aspectRatio = '';  // back to the natural 3:4 box
    const natTop = wrap.offsetTop, natH = wrap.getBoundingClientRect().height;   // offsetTop = layout position inside .minigame-stage
    const ex = Math.max(0, Math.round(natTop - DONUT_TOP_GAP_PX));
    if(ex > 0){
      wrap.style.aspectRatio = 'auto';
      wrap.style.height = (natH + ex) + 'px';
      wrap.style.alignSelf = 'flex-start';
      wrap.style.marginTop = DONUT_TOP_GAP_PX + 'px';
    }
    return ex;
  }catch(e){ return 0; }
}
function donutPlayTopFrac(){
  try{
    const c = donutCanvasWrapEl.getBoundingClientRect(), s = donutState;
    if(!(c.height > 0) || !(s.h > 0)) return 0;
    const origin = c.top + (s.topExtra || 0);     // screen Y of logical y = 0
    let top = c.top;                              // highest visible pixel of the play area
    const bar = document.querySelector('#donut-screen .minigame-topbar');
    if(bar){ const b = bar.getBoundingClientRect(); if(b.bottom > top) top = b.bottom + DONUT_SPAWN_MARGIN_PX; }
    const hud = el('donut-lvl-hud');
    if(hud && hud.offsetParent !== null){ const b = hud.getBoundingClientRect(); if(b.bottom + DONUT_SPAWN_MARGIN_PX > top) top = b.bottom + DONUT_SPAWN_MARGIN_PX; }
    return Math.min(0.3, (top - origin)/s.h);
  }catch(e){ return 0; }
}
function donutRefreshPlayTop(){ const t = donutPlayTopFrac(); donutState.playTop = t; return t; }
function donutScoreSpeedLevel(score){ return Math.max(0, Math.floor(score / DONUT_SCORE_MILESTONE)); }
function donutScoreSpeedMul(level){ return Math.min(DONUT_SCORE_SPEED_MAX, 1 + DONUT_SCORE_SPEED_STEP*level); }
function donutScoreSpawnFactor(level){ return Math.max(0.8, 1 - 0.03*level); }
function donutScoreSpawnInterval(ms){ return Math.max(420, Math.round(ms * donutScoreSpawnFactor(donutState.speedLevel))); }
// Call after every score increase. Returns true only on the call that crosses a NEW milestone.
function donutScoreSpeedCheck(score){
  const n = donutScoreSpeedLevel(score);
  if(n > donutState.speedLevel){
    donutState.speedLevel = n;
    donutState.scoreSpeedMul = donutScoreSpeedMul(n);
    return true;
  }
  return false;
}
function donutReset(){
  donutState.items = [];
  donutState.speedT = 0;
  donutState.chilliTimer = 0; donutState.chilliJit = 1;   // progressive chilli pressure timer
  donutState.particles = [];
  donutState.popups = [];
  donutState.spawnTimer = 0;
  donutState.spawnInterval = 1100;
  donutState.score = 0;
  donutState.speedLevel = 0;
  donutState.scoreSpeedMul = 1;
  donutState.playTop = 0;
  donutState.plateX = 0.5;
  donutState.plateVisualX = 0.5;
  donutState.shakeT = 0;
  donutState.gameOverPending = false;
  donutState.donutsCaughtThisFrame = [];
  donutState.multiCatchGlowT = 0;
  donutState.popEffects = [];
  donutScoreEl.textContent = '0';
  donutOverlayEl.classList.add('mg-hidden');
}
function startDonutGame(){
  donutResize();
  donutReset();
  donutState.active = true;
  donutState.lastTime = performance.now();
  donutState.rafId = requestAnimationFrame(donutLoop);
  playEntranceAnim(donutCanvasWrapEl);
}
function stopDonutGame(){
  donutState.active = false;
  if(donutState.rafId){ cancelAnimationFrame(donutState.rafId); donutState.rafId = null; }
}
function donutSpawnItem(forceBad){
  const top = donutRefreshPlayTop();   // v7: 0 in Donut Catch (canvas top), HUD bottom in Levels
  const bad = forceBad === true || Math.random() < 0.16; // the chilli hazard — catching it ends the game
  let spawnX = 0.08 + Math.random()*0.84;   // fraction of width
  if(forceBad === true){
    // Extra (pressure) chilli: keep it off the column of anything that just spawned so it never forms an unfair wall.
    for(let k=0;k<8 && donutState.items.some(o=>o.y < top+0.22 && Math.abs(o.x-spawnX) < 0.10);k++) spawnX = 0.08 + Math.random()*0.84;
  }
  donutState.items.push({
    x: spawnX,
    y: top - 0.06, dnTop: top,
    r: 0.055,
    // difficulty still ramps with score to keep it engaging over an
    // unbounded play session, but caps out at a fair, catchable speed
    speed: 0.16 + Math.random()*0.07 + Math.min(0.16, donutState.score*0.0015),
    bad,
    caught:false,
    // Step 5: Track spawn time for chilli visual pulse animation (visual only)
    spawnTime: performance.now(),
    // Step 9: Purely visual colour variant for the chilli hazard — chosen
    // once at spawn and kept for the item's lifetime. Does not affect
    // spawn odds/timing, position, speed, collision, scoring or game-over.
    chilliColor: bad ? (Math.random() < 0.5 ? 'red' : 'green') : null
  });
}
// Small, cheap particle burst (a handful of fading dots) for catch/score
// feedback — capped array size so it stays lightweight on low-end phones.
function donutSpawnBurst(x, y, color, count){
  for(let i=0;i<count;i++){
    const ang = (Math.PI*2*i)/count + Math.random()*0.4;
    donutState.particles.push({
      x, y, vx:Math.cos(ang)*0.55, vy:Math.sin(ang)*0.55 - 0.25,
      life:1, color
    });
  }
  if(donutState.particles.length > 80) donutState.particles.splice(0, donutState.particles.length-80);
}
// One floating "+10" per donut caught — each donut gets its own popup at
// its own catch location, so catching several at once shows several
// separate labels rather than one combined number.
function donutSpawnScorePopup(x, y, text){
  donutState.popups.push({ x, y, text, life:1 });
  if(donutState.popups.length > 20) donutState.popups.splice(0, donutState.popups.length-20);
}
/* PROGRESSIVE CHILLI PRESSURE — standalone Donut Catch.
   The regular spawns (16% chilli) are unchanged. On top of them, after a short grace period an extra chilli
   is added on its own timer; the gap between extra chillies shrinks the longer the run lasts
   (5.2s -> 1.9s over ~5 minutes, then it stays there) and the number of chillies allowed on screen at once
   grows from 2 to 5, so it gets steadily harder but never becomes unplayable. Resets on every new game. */
const DONUT_CHILLI_GRACE_S = 15;
function donutChilliPressure(tSec){
  const p = Math.max(0, Math.min(1, (tSec - DONUT_CHILLI_GRACE_S)/285));
  return { on: tSec >= DONUT_CHILLI_GRACE_S, gap: 5200 - 3300*p, maxLive: 2 + Math.round(p*3) };
}
function donutLoop(now){
  if(!donutState.active) return;
  const dt = Math.min(0.05, (now - donutState.lastTime)/1000);
  donutState.lastTime = now;
  const s = donutState;

  // smooth the visible plate toward the (instant) pointer-driven target
  s.plateVisualX += (s.plateX - s.plateVisualX) * DONUT_PLATE_SMOOTH;
  if(s.shakeT > 0) s.shakeT = Math.max(0, s.shakeT - dt*3.2);

  // The game runs indefinitely — no timer/duration/score-limit ever stops
  // spawning or scoring. Donuts keep appearing and score keeps climbing
  // until (and only until) the red chilli is actually caught below.
  s.speedT = (s.speedT || 0) + dt;
  const dnSpeedMul = donutTimeSpeedMul(s.speedT, 0.06, 1.6);
  s.spawnTimer += dt*1000;
  if(s.spawnTimer >= s.spawnInterval){
    s.spawnTimer = 0;
    s.spawnInterval = donutScoreSpawnInterval(Math.max(520, 1100 - Math.min(500, s.score*3)));
    donutSpawnItem();
  }
  // Progressive chilli pressure (see donutChilliPressure above).
  const chp = donutChilliPressure(s.speedT);
  if(chp.on){
    s.chilliTimer = (s.chilliTimer || 0) + dt*1000;
    if(s.chilliTimer >= chp.gap*(s.chilliJit || 1)){
      s.chilliTimer = 0; s.chilliJit = 0.85 + Math.random()*0.3;
      let liveChillies = 0;
      for(let k=0;k<s.items.length;k++) if(s.items[k].bad) liveChillies++;
      if(liveChillies < chp.maxLive) donutSpawnItem(true);
    }
  }

  const plateY = 0.90, plateHalfW = 0.11;
  // Every item that overlaps the plate this frame is caught independently
  // — if several donuts happen to reach the plate in the same frame, each
  // one is detected, scored and popped separately (no shared/merged count).
  // Step 4: track catches this frame for enhanced visual feedback on 3+ multi-catch
  s.donutsCaughtThisFrame = [];
  for(let i=s.items.length-1; i>=0; i--){
    const it = s.items[i];
    it.y += it.speed*dt*(it.bad ? 1 : dnSpeedMul)*s.scoreSpeedMul;
    if(!it.caught && it.y >= plateY-0.02 && it.y <= plateY+0.06 &&
       Math.abs(it.x - s.plateX) <= plateHalfW + it.r*0.5){
      it.caught = true;
      const px = it.x*s.w, py = it.y*s.h;
      if(it.bad){
        // Red chilli caught — the ONLY game-over condition. Freeze score
        // immediately, play the special sound/particles, then end.
        playSound('mg-chilli'); vibrate([25,30,60]);
        s.shakeT = 1;
        donutSpawnBurst(px, py, '255,90,60', 14);
        donutSpawnBurst(px, py, '255,209,102', 8);
        s.gameOverPending = true;
      } else {
        // Step 4: track this good donut catch for multi-catch effects
        s.donutsCaughtThisFrame.push({x: px, y: py, scale: 1, t: 0});
        
        // Step 6: Add sweet pop effect at catch location
        // Pop effect: scale up then fade, with sparkles and ripple glow
        s.popEffects.push({x: px, y: py, life: 1, scale: 1});
        
        s.score += 10;
        donutScoreSpeedCheck(s.score);   // v7: +speed once per 1000-pt milestone
        pulseScoreEl(donutScoreEl);
        donutScoreEl.textContent = s.score;
        playSound('donut-coin');
        donutSpawnBurst(px, py, '255,209,102', 8);
        donutSpawnScorePopup(px, py, '+10');
      }
      s.items.splice(i,1);
      continue;
    }
    if(it.y > 1.08){
      // Missed donuts (good or chilli) never penalize or end the game —
      // they're simply removed and play continues.
      s.items.splice(i,1);
    }
  }
  
  // Step 4: If 3+ donuts caught together, trigger enhanced visual feedback
  if(s.donutsCaughtThisFrame.length >= 3){
    s.multiCatchGlowT = 1;
    // Add cream/golden sparkle burst at each catch location
    for(let j=0; j<s.donutsCaughtThisFrame.length; j++){
      const caught = s.donutsCaughtThisFrame[j];
      // Premium sparkle burst: cream and golden for luxury feel
      donutSpawnBurst(caught.x, caught.y, '255,235,200', 6); // cream sparkles
      donutSpawnBurst(caught.x, caught.y, '255,220,130', 5); // golden sparkles
    }
  }

  // Step 4: Update multi-catch glow pulse and caught donut pop animations
  if(s.multiCatchGlowT > 0) s.multiCatchGlowT = Math.max(0, s.multiCatchGlowT - dt*2.5);
  for(let j=0; j<s.donutsCaughtThisFrame.length; j++){
    const caught = s.donutsCaughtThisFrame[j];
    caught.t += dt;
    // Strong but short pop: scale up quickly then ease back to 1
    if(caught.t < 0.15){
      caught.scale = 1 + (1 - caught.t/0.15) * 0.35; // peaks at 1.35, smooth ease
    } else {
      caught.scale = 1;
    }
  }

  for(let i=s.particles.length-1;i>=0;i--){
    const p = s.particles[i];
    p.x += p.vx*dt*60; p.y += p.vy*dt*60; p.vy += dt*1.4;
    p.life -= dt*2.2;
    if(p.life<=0) s.particles.splice(i,1);
  }
  for(let i=s.popups.length-1;i>=0;i--){
    const p = s.popups[i];
    p.y -= dt*38; // gentle upward drift
    p.life -= dt*1.15;
    if(p.life<=0) s.popups.splice(i,1);
  }
  
  // Step 6: Update pop effects — sweet pop animation on donut catch
  for(let i=s.popEffects.length-1;i>=0;i--){
    const pop = s.popEffects[i];
    pop.life -= dt*3.8; // fade over ~260ms (1/3.8 seconds)
    // Scale animation: grows to 1.4x at start, then shrinks as it fades
    const progress = 1 - pop.life; // 0→1 over lifetime
    if(progress < 0.2){
      // First 20%: scale up quickly (pop)
      pop.scale = 1 + (progress/0.2) * 0.4; // 1.0→1.4x
    } else {
      // Remaining 80%: scale down smoothly as fade continues
      pop.scale = 1.4 * (1 - (progress-0.2)/0.8); // 1.4x→0
    }
    if(pop.life<=0) s.popEffects.splice(i,1);
  }

  donutDraw();

  if(s.gameOverPending){
    donutGameOver();
    return;
  }
  s.rafId = requestAnimationFrame(donutLoop);
}
// ---- Donut Drop — premium donut/sparkle rendering (Step 3, visuals only) ----
// Purely cosmetic helpers: they only ever READ existing item/particle fields
// (x, y, r, bad, color, life) to decide where/how to draw. Nothing here
// writes to donutState, changes speeds/timers, or touches spawn/catch/
// collision logic in donutLoop()/donutSpawnItem() — those are untouched.
// A stable per-donut color is derived from its own (fixed-for-life) x
// position, so the same donut keeps the same icing color as it falls
// without needing any new state field.
const DONUT_ICING_PALETTE = [
  {icing:'#e6597a', shine:'#ffe1ea', glow:'rgba(230,89,122,.28)'},   // strawberry
  {icing:'#8a5a34', shine:'#d9a066', glow:'rgba(138,90,52,.28)'},    // chocolate
  {icing:'#e2a640', shine:'#ffe9b8', glow:'rgba(226,166,64,.28)'},   // caramel
  {icing:'#c76bd1', shine:'#f5ddff', glow:'rgba(199,107,209,.28)'}   // berry
];
function donutIcingFor(it){
  const idx = Math.floor(Math.abs(it.dnKey !== undefined ? it.dnKey : it.x)*997) % DONUT_ICING_PALETTE.length;
  return DONUT_ICING_PALETTE[idx];
}
// Draws one premium donut sprite centered at (cx,cy) with pixel radius R.
// `scale`/`alpha` only drive the subtle spawn entrance below — they never
// affect the collision radius (it.r), which this function never reads.
function donutDrawSprite(ctx, cx, cy, R, palette, scale, alpha){
  ctx.save();
  ctx.globalAlpha = alpha;
  ctx.translate(cx, cy);
  ctx.scale(scale, scale);

  // very subtle ambient glow behind the donut
  const glow = ctx.createRadialGradient(0,0,R*0.3, 0,0,R*1.7);
  glow.addColorStop(0, palette.glow);
  glow.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.beginPath(); ctx.arc(0,0,R*1.7,0,Math.PI*2); ctx.fillStyle = glow; ctx.fill();

  // dough ring with soft drop shadow for real depth
  ctx.save();
  ctx.shadowColor = 'rgba(50,25,10,.4)';
  ctx.shadowBlur = R*0.5;
  ctx.shadowOffsetY = R*0.16;
  const doughGrad = ctx.createRadialGradient(-R*0.3,-R*0.3,R*0.1, 0,0,R);
  doughGrad.addColorStop(0,'#f6d6a0'); doughGrad.addColorStop(1,'#c9903f');
  ctx.beginPath(); ctx.arc(0,0,R,0,Math.PI*2); ctx.fillStyle = doughGrad; ctx.fill();
  ctx.restore();

  // punch the classic donut hole so the background shows through
  ctx.globalCompositeOperation = 'destination-out';
  ctx.beginPath(); ctx.arc(0,0,R*0.34,0,Math.PI*2); ctx.fill();
  ctx.globalCompositeOperation = 'source-over';

  // glossy icing cap, clipped to the donut so it never overshoots the ring
  ctx.save();
  ctx.beginPath(); ctx.arc(0,0,R,0,Math.PI*2); ctx.clip();
  const icingGrad = ctx.createLinearGradient(0,-R,0,R*0.2);
  icingGrad.addColorStop(0, palette.shine); icingGrad.addColorStop(1, palette.icing);
  ctx.beginPath(); ctx.ellipse(0,-R*0.1, R*1.02, R*0.9, 0, 0, Math.PI*2);
  ctx.fillStyle = icingGrad; ctx.fill();
  ctx.globalCompositeOperation = 'destination-out';
  ctx.beginPath(); ctx.arc(0,0,R*0.34,0,Math.PI*2); ctx.fill();
  ctx.globalCompositeOperation = 'source-over';
  // two small icing drips over the dough edge for a hand-dipped look
  ctx.fillStyle = palette.icing;
  ctx.beginPath(); ctx.ellipse(R*0.5, R*0.18, R*0.14, R*0.2, 0.3, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(-R*0.55, R*0.05, R*0.12, R*0.17, -0.3, 0, Math.PI*2); ctx.fill();
  // a few flat sprinkles — cheap rects, kept small in number
  const sprinkles = ['#ffffff','#ffe6a8','#ff8fb3','#9be7ff'];
  for(let i=0;i<4;i++){
    const ang = (i/4)*Math.PI*2 + 0.5;
    ctx.save();
    ctx.translate(Math.cos(ang)*R*0.55, Math.sin(ang)*R*0.4 - R*0.12);
    ctx.rotate(ang);
    ctx.fillStyle = sprinkles[i];
    ctx.fillRect(-R*0.08,-R*0.02, R*0.16, R*0.04);
    ctx.restore();
  }
  ctx.restore(); // drop the icing clip

  // soft glossy highlight for a smooth, premium finish
  ctx.beginPath();
  ctx.ellipse(-R*0.32,-R*0.4, R*0.28, R*0.14, -0.5, 0, Math.PI*2);
  ctx.fillStyle = 'rgba(255,255,255,.55)';
  ctx.fill();

  ctx.restore();
}
// Step 6: Draw sweet pop effect at catch location — scale and ripple glow.
// Shows as expanding rings and fading glow for satisfying catch feedback.
function donutDrawPopEffect(ctx, cx, cy, life){
  if(life<=0) return;
  const progress = 1 - life; // 0→1 over lifetime
  
  // Expanding ripple rings (multiple layers for visual richness)
  ctx.save();
  for(let ring=0; ring<3; ring++){
    const delay = ring * 0.07; // each ring starts slightly later
    const ringLife = Math.max(0, life - delay);
    if(ringLife > 0){
      const ringProgress = 1 - ringLife;
      const ringSize = ringProgress * 32; // expands to 32px radius
      const ringAlpha = (1 - ringProgress) * 0.6; // fades as it expands
      ctx.globalAlpha = ringAlpha;
      ctx.strokeStyle = 'rgba(255,220,130, 1)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(cx, cy, ringSize, 0, Math.PI*2);
      ctx.stroke();
    }
  }
  ctx.restore();
  
  // Central glow halo (warm golden glow that fades)
  ctx.save();
  const haloGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, 24);
  haloGrad.addColorStop(0, `rgba(255,220,130, ${(1-progress)*0.5})`);
  haloGrad.addColorStop(1, 'rgba(255,220,130, 0)');
  ctx.fillStyle = haloGrad;
  ctx.fillRect(cx-24, cy-24, 48, 48);
  ctx.restore();
}
// Chilli sprite (visual only): realistic red / green chilli pepper drawn with
// canvas paths — long curved tapered pod, ridged calyx cap and a curved hooked
// stem, with glossy shading. Same signature, same call site, same pulse
// animation and same overall footprint (~R) as before; gameplay untouched.
// Takes spawn time to compute pulse animation (visual only — doesn't affect gameplay/collision).
function donutDrawChilli(ctx, cx, cy, R, spawnTime, now, variant){
  const palettes = {
    red:{
      stops:['#a6000e','#ff2b2b','#d9111a','#7a0008'],
      tip:'rgba(60,0,0,.35)', gloss:'rgba(255,225,215,.75)',
      glow:'rgba(255,60,40, 0.22)'
    },
    green:{
      stops:['#3a6410','#93c63c','#5f9b20','#2a5008'],
      tip:'rgba(15,45,0,.35)', gloss:'rgba(235,255,205,.7)',
      glow:'rgba(140,220,80, 0.22)'
    }
  };
  const pal = palettes[variant] || palettes.red;
  // Subtle pulse animation: scales up briefly when chilli first appears (first 600ms)
  const ageMs = Math.max(0, now - spawnTime);
  const pulsePhase = Math.min(1, ageMs / 600);
  const pulseAmount = Math.pow(Math.max(0, 1 - pulsePhase), 1.5) * 0.15;
  const pulseScale = 1 + pulseAmount;

  ctx.save();
  ctx.translate(cx, cy);
  ctx.scale(pulseScale, pulseScale);

  // Soft coloured glow behind the chilli so it stands out on the background
  ctx.save();
  const outerGlow = ctx.createRadialGradient(0, 0, R*0.6, 0, 0, R*1.5);
  outerGlow.addColorStop(0, pal.glow);
  outerGlow.addColorStop(1, pal.glow.replace(/[\d.]+\)$/,'0)'));
  ctx.fillStyle = outerGlow;
  ctx.beginPath();
  ctx.arc(0, 0, R*1.5, 0, Math.PI*2);
  ctx.fill();
  ctx.restore();

  // Pod outline path (long, curved, tapering to a pointed tip)
  const podPath = ()=>{
    ctx.beginPath();
    ctx.moveTo(-R*0.32, -R*0.55);
    ctx.bezierCurveTo(-R*0.46,-R*0.30, -R*0.52,-R*0.05, -R*0.50, R*0.20);
    ctx.bezierCurveTo(-R*0.48, R*0.55, -R*0.22, R*0.90,  R*0.22, R*1.16);
    ctx.bezierCurveTo( R*0.16, R*0.95,  R*0.20, R*0.60,  R*0.18, R*0.25);
    ctx.bezierCurveTo( R*0.16,-R*0.05,  R*0.30,-R*0.30,  R*0.36,-R*0.55);
    ctx.closePath();
  };

  // Body with soft drop shadow
  ctx.save();
  ctx.shadowColor = 'rgba(0,0,0,.35)';
  ctx.shadowBlur = R*0.5;
  ctx.shadowOffsetY = R*0.2;
  const bodyGrad = ctx.createLinearGradient(-R*0.5, 0, R*0.36, 0);
  bodyGrad.addColorStop(0, pal.stops[0]);
  bodyGrad.addColorStop(0.28, pal.stops[1]);
  bodyGrad.addColorStop(0.6, pal.stops[2]);
  bodyGrad.addColorStop(1, pal.stops[3]);
  ctx.fillStyle = bodyGrad;
  podPath();
  ctx.fill();
  ctx.restore();

  // Shading + glossy streaks, clipped to the pod
  ctx.save();
  podPath();
  ctx.clip();
  const tipGrad = ctx.createLinearGradient(0, R*0.4, 0, R*1.16);
  tipGrad.addColorStop(0, 'rgba(0,0,0,0)');
  tipGrad.addColorStop(1, pal.tip);
  ctx.fillStyle = tipGrad;
  ctx.fillRect(-R, R*0.4, R*2, R*0.9);
  ctx.lineCap = 'round';
  ctx.strokeStyle = pal.gloss;
  ctx.lineWidth = R*0.09;
  ctx.beginPath();
  ctx.moveTo(-R*0.30, -R*0.36);
  ctx.bezierCurveTo(-R*0.42,-R*0.05, -R*0.40, R*0.40, -R*0.16, R*0.80);
  ctx.stroke();
  ctx.globalAlpha = 0.45;
  ctx.lineWidth = R*0.04;
  ctx.beginPath();
  ctx.moveTo(-R*0.14, -R*0.30);
  ctx.bezierCurveTo(-R*0.24, 0, -R*0.22, R*0.42, -R*0.04, R*0.78);
  ctx.stroke();
  ctx.restore();

  // Stem: curved, hooked at the top
  ctx.save();
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  const stemPath = ()=>{
    ctx.beginPath();
    ctx.moveTo(R*0.02, -R*0.60);
    ctx.bezierCurveTo(-R*0.02,-R*0.90, R*0.04,-R*1.08, R*0.30,-R*1.14);
    ctx.quadraticCurveTo(R*0.40,-R*1.16, R*0.44,-R*1.08);
  };
  ctx.strokeStyle = '#3f6a1c';
  ctx.lineWidth = R*0.17;
  stemPath(); ctx.stroke();
  ctx.strokeStyle = '#86b446';
  ctx.lineWidth = R*0.05;
  ctx.translate(-R*0.03, 0);
  stemPath(); ctx.stroke();
  ctx.restore();

  // Calyx cap where the stem meets the pod
  ctx.save();
  const capGrad = ctx.createLinearGradient(-R*0.42, 0, R*0.46, 0);
  capGrad.addColorStop(0, '#2f5a14');
  capGrad.addColorStop(0.5, '#5f9a2c');
  capGrad.addColorStop(1, '#2a4f10');
  ctx.fillStyle = capGrad;
  ctx.beginPath();
  ctx.moveTo(-R*0.42, -R*0.60);
  ctx.bezierCurveTo(-R*0.40,-R*0.74,  R*0.40,-R*0.76,  R*0.46,-R*0.60);
  ctx.bezierCurveTo( R*0.44,-R*0.50,  R*0.30,-R*0.44,  R*0.02,-R*0.44);
  ctx.bezierCurveTo(-R*0.28,-R*0.44, -R*0.40,-R*0.50, -R*0.42,-R*0.60);
  ctx.closePath();
  ctx.fill();
  ctx.strokeStyle = 'rgba(0,0,0,.22)';
  ctx.lineWidth = Math.max(1, R*0.025);
  for(let i=-2; i<=2; i++){
    ctx.beginPath();
    ctx.moveTo(R*0.09*i, -R*0.70);
    ctx.lineTo(R*0.08*i, -R*0.47);
    ctx.stroke();
  }
  ctx.restore();

  ctx.restore();
}

function donutDrawSparkle(ctx, p){
  const alpha = Math.max(0, p.life);
  if(alpha<=0) return;
  const size = (3.5*p.life+1) * 1.5;
  ctx.save();
  ctx.globalAlpha = alpha;
  ctx.translate(p.x, p.y);
  ctx.rotate(p.life*2.2);
  ctx.fillStyle = `rgba(${p.color},${alpha})`;
  ctx.beginPath();
  ctx.moveTo(0,-size); ctx.lineTo(size*0.28,-size*0.28); ctx.lineTo(size,0); ctx.lineTo(size*0.28,size*0.28);
  ctx.lineTo(0,size); ctx.lineTo(-size*0.28,size*0.28); ctx.lineTo(-size,0); ctx.lineTo(-size*0.28,-size*0.28);
  ctx.closePath();
  ctx.fill();
  ctx.restore();
}
/* Shark catcher sprite (v6): glossy 3D-cartoon shark drawn with canvas paths — no bitmap.
   Palette: body #168DD1, highlights #62D5F4, belly #FFFFFF, outline/shadow #075985, teeth white.
   Built ONCE into an offscreen canvas (design space 200x160, rendered 2.5x) and then drawn with a single
   drawImage per frame, exactly like the old image sprite — so per-frame cost and layout are unchanged. */
let DONUT_SHARK_SPRITE = null;
function donutGetSharkSprite(){
  if(DONUT_SHARK_SPRITE) return DONUT_SHARK_SPRITE;
  try{
    const K = 2.5, DW = 200, DH = 160;
    const cv = document.createElement('canvas');
    cv.width = DW*K; cv.height = DH*K;
    const g = cv.getContext('2d');
    g.scale(K, K);
    g.lineJoin = 'round'; g.lineCap = 'round';
    const BODY = '#168DD1', HI = '#62D5F4', WHITE = '#FFFFFF', DEEP = '#075985';

    const bez = (p, t) => {
      const m = 1-t;
      const x = m*m*m*p[0][0] + 3*m*m*t*p[1][0] + 3*m*t*t*p[2][0] + t*t*t*p[3][0];
      const y = m*m*m*p[0][1] + 3*m*m*t*p[1][1] + 3*m*t*t*p[2][1] + t*t*t*p[3][1];
      let dx = 3*m*m*(p[1][0]-p[0][0]) + 6*m*t*(p[2][0]-p[1][0]) + 3*t*t*(p[3][0]-p[2][0]);
      let dy = 3*m*m*(p[1][1]-p[0][1]) + 6*m*t*(p[2][1]-p[1][1]) + 3*t*t*(p[3][1]-p[2][1]);
      const l = Math.hypot(dx, dy) || 1;
      return {x, y, tx: dx/l, ty: dy/l};
    };

    // shape paths ------------------------------------------------------------
    const tailP = () => { g.beginPath(); g.moveTo(48,98); g.lineTo(10,52); g.quadraticCurveTo(27,88,25,101);
      g.quadraticCurveTo(29,124,8,148); g.lineTo(52,116); g.closePath(); };
    const dorsalP = () => { g.beginPath(); g.moveTo(80,62); g.bezierCurveTo(88,36,100,20,114,8);
      g.bezierCurveTo(112,26,118,38,132,44); g.closePath(); };
    const mouthP = () => { g.beginPath(); g.moveTo(120,91); g.bezierCurveTo(140,74,168,66,190,58);
      g.quadraticCurveTo(204,84,190,110); g.bezierCurveTo(168,104,144,96,120,91); g.closePath(); };
    const upperP = () => { g.beginPath(); g.moveTo(34,104); g.bezierCurveTo(40,70,84,40,124,34);
      g.bezierCurveTo(154,30,180,40,190,58); g.bezierCurveTo(168,66,140,74,120,91);
      g.bezierCurveTo(96,97,62,106,34,104); g.closePath(); };
    const lowerP = () => { g.beginPath(); g.moveTo(34,104); g.bezierCurveTo(60,134,110,148,150,138);
      g.bezierCurveTo(170,134,184,124,190,110); g.bezierCurveTo(168,104,144,96,120,91);
      g.bezierCurveTo(96,97,62,106,34,104); g.closePath(); };
    const finP = () => { g.beginPath(); g.moveTo(98,108); g.bezierCurveTo(92,128,78,142,58,151);
      g.bezierCurveTo(88,155,116,147,130,126); g.bezierCurveTo(118,122,106,116,98,108); g.closePath(); };

    const fillStroke = (fill, w) => {
      g.fillStyle = fill; g.fill();
      g.strokeStyle = DEEP; g.lineWidth = w; g.stroke();
    };
    const finGrad = (y0, y1) => { const gr = g.createLinearGradient(0, y0, 0, y1);
      gr.addColorStop(0, HI); gr.addColorStop(0.45, BODY); gr.addColorStop(1, '#0F6DA8'); return gr; };

    // soft contact shadow under the shark -----------------------------------------
    g.fillStyle = 'rgba(7,89,133,.30)';
    g.beginPath(); g.ellipse(112, 154, 74, 5.5, 0, 0, Math.PI*2); g.fill();

    // tail + dorsal fin (behind the body) ---------------------------------------
    tailP();   fillStroke(finGrad(52,148), 5);
    dorsalP(); fillStroke(finGrad(8,62), 5);

    // mouth cavity ----------------------------------------------------------
    mouthP();
    const mg = g.createLinearGradient(0, 58, 0, 110);
    mg.addColorStop(0, '#6b1236'); mg.addColorStop(1, '#c0266b');
    g.fillStyle = mg; g.fill();
    g.save(); mouthP(); g.clip();
    g.fillStyle = '#F472B6';
    g.beginPath(); g.ellipse(162, 102, 24, 7, -0.12, 0, Math.PI*2); g.fill();
    g.fillStyle = 'rgba(255,255,255,.35)';
    g.beginPath(); g.ellipse(158, 99, 12, 2.2, -0.12, 0, Math.PI*2); g.fill();
    g.restore();
    mouthP(); g.strokeStyle = DEEP; g.lineWidth = 4; g.stroke();

    // white belly / lower jaw ----------------------------------------------------
    lowerP();
    const bg = g.createLinearGradient(0, 96, 0, 142);
    bg.addColorStop(0, WHITE); bg.addColorStop(0.6, WHITE); bg.addColorStop(1, '#E3F6FE');
    fillStroke(bg, 5);

    // blue upper body + head ---------------------------------------------------------
    upperP();
    const ug = g.createLinearGradient(0, 30, 0, 106);
    ug.addColorStop(0, HI); ug.addColorStop(0.32, BODY); ug.addColorStop(1, '#0F6DA8');
    fillStroke(ug, 5);
    // glossy highlights, clipped to the body
    g.save(); upperP(); g.clip();
    g.fillStyle = 'rgba(255,255,255,.55)';
    g.beginPath(); g.ellipse(94, 52, 23, 5, -0.5, 0, Math.PI*2); g.fill();
    g.beginPath(); g.ellipse(126, 40, 7, 2.6, -0.28, 0, Math.PI*2); g.fill();
    g.fillStyle = 'rgba(98,213,244,.35)';
    g.beginPath(); g.ellipse(70, 84, 22, 8, -0.25, 0, Math.PI*2); g.fill();
    g.restore();

    // teeth (clean white) ---------------------------------------------------------------
    const upperLip = [[190,58],[168,66],[140,74],[120,91]];
    const lowerLip = [[190,110],[168,104],[144,96],[120,91]];
    const tooth = (p, up, len, bw) => {
      const nx = up ? p.ty : -p.ty, ny = up ? -p.tx : p.tx;
      g.beginPath();
      g.moveTo(p.x - p.tx*bw, p.y - p.ty*bw);
      g.lineTo(p.x + nx*len, p.y + ny*len);
      g.lineTo(p.x + p.tx*bw, p.y + p.ty*bw);
      g.closePath();
      g.fillStyle = WHITE; g.fill();
      g.strokeStyle = DEEP; g.lineWidth = 1.6; g.stroke();
    };
    [0.10,0.27,0.44,0.61,0.78,0.92].forEach(t => tooth(bez(upperLip, t), true, 11, 4.4));
    [0.14,0.32,0.50,0.68,0.86].forEach(t => tooth(bez(lowerLip, t), false, 9, 4.0));

    // gill slits ---------------------------------------------------------------------------
    g.strokeStyle = DEEP; g.lineWidth = 2.6;
    [92,100,108].forEach(x => { g.beginPath(); g.moveTo(x,68); g.quadraticCurveTo(x-6,78,x-1,88); g.stroke(); });

    // pectoral fin -----------------------------------------------------------------------------
    finP(); fillStroke(finGrad(108,155), 5);

    // eye -------------------------------------------------------------------------------------------
    g.fillStyle = WHITE; g.beginPath(); g.arc(148, 51, 8, 0, Math.PI*2); g.fill();
    g.strokeStyle = DEEP; g.lineWidth = 2.4; g.stroke();
    g.fillStyle = '#0B2A44'; g.beginPath(); g.arc(150.5, 52, 5, 0, Math.PI*2); g.fill();
    g.fillStyle = WHITE; g.beginPath(); g.arc(152.4, 49.6, 1.9, 0, Math.PI*2); g.fill();
    g.beginPath(); g.arc(148.6, 54.4, 0.9, 0, Math.PI*2); g.fill();
    // nostril
    g.fillStyle = DEEP; g.beginPath(); g.ellipse(180, 52, 1.8, 1.2, 0.5, 0, Math.PI*2); g.fill();

    DONUT_SHARK_SPRITE = cv;
  }catch(e){ DONUT_SHARK_SPRITE = null; }
  return DONUT_SHARK_SPRITE;
}
function donutDraw(){
  const ctx = donutCtx, s = donutState, w = s.w, h = s.h;
  ctx.save();
  if(s.shakeT>0){
    const mag = s.shakeT*6;
    ctx.translate((Math.random()-0.5)*mag, (Math.random()-0.5)*mag);
  }
  ctx.clearRect(-10,-10-(s.topExtra||0),w+20,h+20+(s.topExtra||0));
  
  // Step 4: Subtle canvas glow pulse for 3+ catch moment
  if(s.multiCatchGlowT > 0){
    const glowAlpha = s.multiCatchGlowT * 0.25; // very subtle
    ctx.save();
    ctx.globalAlpha = glowAlpha;
    const centerGlow = ctx.createRadialGradient(w*0.5, h*0.5, h*0.15, w*0.5, h*0.5, h*0.9);
    centerGlow.addColorStop(0, 'rgba(255,220,130, 0.6)');
    centerGlow.addColorStop(1, 'rgba(255,220,130, 0)');
    ctx.fillStyle = centerGlow;
    ctx.fillRect(0, 0, w, h);
    ctx.restore();
  }
  // PREMIUM DESSERT THEME — background only (Step 1). Everything below this
  // block (items, particles, popups, plate) is untouched: same drawing
  // calls, same order, same values — only what gets painted BEHIND them
  // has changed, from the old flat purple gradient to a warm dark-chocolate
  // → cream gradient with two very soft pink/orange glows and a faint
  // diagonal sheen so the screen doesn't read as flat. No extra shapes,
  // objects, or decorations are drawn — nothing here can distract from or
  // interfere with gameplay, spawning, collision or scoring.
  const grad = ctx.createLinearGradient(0,0,0,h);
  grad.addColorStop(0,'#2b1710');    // dark chocolate (top)
  grad.addColorStop(0.55,'#6b3f2a'); // warm milk-chocolate (mid)
  grad.addColorStop(1,'#f3e0c7');    // warm cream (bottom)
  ctx.fillStyle = grad; ctx.fillRect(-10,-10,w+20,h+20);

  // Two very soft glow accents — subtle warmth, not decoration.
  const glowA = ctx.createRadialGradient(w*0.2,h*0.16,0, w*0.2,h*0.16, w*0.7);
  glowA.addColorStop(0,'rgba(255,150,110,0.16)');
  glowA.addColorStop(1,'rgba(255,150,110,0)');
  ctx.fillStyle = glowA; ctx.fillRect(-10,-10,w+20,h+20);

  const glowB = ctx.createRadialGradient(w*0.82,h*0.9,0, w*0.82,h*0.9, w*0.7);
  glowB.addColorStop(0,'rgba(255,110,150,0.12)');
  glowB.addColorStop(1,'rgba(255,110,150,0)');
  ctx.fillStyle = glowB; ctx.fillRect(-10,-10,w+20,h+20);

  // Faint diagonal sheen — just enough texture so the gradient doesn't
  // look perfectly flat, still clean/uncluttered.
  const sheen = ctx.createLinearGradient(0,0,w,h);
  sheen.addColorStop(0,'rgba(255,255,255,0.05)');
  sheen.addColorStop(0.5,'rgba(255,255,255,0)');
  sheen.addColorStop(1,'rgba(255,255,255,0.04)');
  ctx.fillStyle = sheen; ctx.fillRect(-10,-10,w+20,h+20);

  // WATER MODE: the river artwork now sits behind the canvas (CSS on #donut-screen), so wipe the
  // chocolate background painted above and draw only the animated foam + ripples under the items.
  ctx.clearRect(-10,-10-(s.topExtra||0),w+20,h+20+(s.topExtra||0));
  if(window.CB_DONUT_WATER) window.CB_DONUT_WATER.draw(ctx, w, h, s.items);

  ctx.font = `${Math.round(h*0.07)}px sans-serif`;
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  // v7: items are only visible below the spawn line (Levels: below the HUD). playTop is 0 in Donut Catch → no clip.
  const dnClipTop = s.playTop || 0;
  if(dnClipTop > 0){ ctx.save(); ctx.beginPath(); ctx.rect(0, dnClipTop*h, w, h - dnClipTop*h); ctx.clip(); }
  s.items.forEach(it=>{
    if(it.bad){
      // Step 5: Premium custom chilli sprite with glossy finish and warning pulse,
      // instead of emoji. Visual upgrade only — collision/hitbox/gameplay unchanged.
      const visualR = h*0.075; // same size as donut emoji was
      donutDrawChilli(donutCtx, it.x*w, it.y*h, visualR, it.spawnTime, donutState.lastTime, it.chilliColor);
      return;
    }
    // Premium donut sprite. Visual radius is derived from the same h*0.07
    // reference the old emoji used, NOT from it.r (the collision radius),
    // so this can never affect catch detection. A brief spawn entrance
    // (scale/fade in) is computed purely from the item's current y — no
    // new state, no change to movement/spawn logic.
    const visualR = h*0.075;
    const entrance = Math.max(0, Math.min(1, (it.y - (it.dnTop || 0) + 0.06) / 0.13));
    const scale = 0.55 + 0.45*entrance;
    donutDrawSprite(ctx, it.x*w, it.y*h, visualR, donutIcingFor(it), scale, entrance);
  });
  if(dnClipTop > 0) ctx.restore();

  s.particles.forEach(p=> donutDrawSparkle(ctx, p));
  ctx.globalAlpha = 1;
  
  // Step 6: Draw pop effects for successful donut catches
  s.popEffects.forEach(pop=>{
    donutDrawPopEffect(ctx, pop.x, pop.y, pop.life);
  });
  
  // Step 4: Draw caught donut pop rings (premium burst effect for multi-catch)
  if(s.donutsCaughtThisFrame.length >= 3){
    for(let j=0; j<s.donutsCaughtThisFrame.length; j++){
      const caught = s.donutsCaughtThisFrame[j];
      if(caught.t < 0.2){
        const progress = caught.t / 0.2;
        const ringSize = (progress * 24) + 8;
        const ringAlpha = (1 - progress) * 0.5;
        ctx.save();
        ctx.globalAlpha = ringAlpha;
        ctx.strokeStyle = 'rgba(255,220,130, 1)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(caught.x, caught.y, ringSize, 0, Math.PI*2);
        ctx.stroke();
        ctx.restore();
      }
    }
  }

  // floating "+10" score popups — pop-in + rise + fade, one per catch
  // Step 4: Enhanced animation with premium smoothness
  ctx.font = `900 ${Math.round(h*0.045)}px sans-serif`;
  s.popups.forEach((p, idx)=>{
    // For 3+ multi-catch, stagger entry timing for cleaner effect
    const isMultiCatch = s.donutsCaughtThisFrame.length >= 3;
    const staggerDelay = isMultiCatch ? (idx * 0.08) : 0; // cascade effect
    const adjustedLife = Math.max(0, p.life - staggerDelay);
    
    if(adjustedLife > 0){
      // Premium pop-in: smooth overshoot feel
      let scale = 1;
      if(adjustedLife > 0.85){
        const popPhase = (1 - adjustedLife) / 0.15;
        scale = 1 + popPhase * 1.8; // smooth ease-out pop
      } else {
        scale = 1;
      }
      
      ctx.save();
      ctx.globalAlpha = Math.max(0, Math.min(1, adjustedLife * 1.3));
      ctx.translate(p.x, p.y);
      ctx.scale(scale, scale);
      ctx.fillStyle = '#ffd166';
      ctx.shadowColor = 'rgba(0,0,0,.5)';
      ctx.shadowBlur = 4;
      ctx.shadowOffsetX = 0;
      ctx.shadowOffsetY = 2;
      ctx.strokeStyle = 'rgba(0,0,0,.4)';
      ctx.lineWidth = 3;
      ctx.strokeText(p.text, 0, 0);
      ctx.fillText(p.text, 0, 0);
      ctx.restore();
    }
  });
  ctx.globalAlpha = 1;

  // SHARK CATCHER (v6: vector-drawn glossy shark; the old yellow oval/pointer is gone). Same position (plate centre x = plateVisualX,
  // y band 0.86-0.97h) and SAME width as the catch zone used by the game logic
  // (2 x plateHalfW / DONUT_LVL_CATCH_HALF_W = 0.22w), so what you see is what catches.
  // Drawing only: no game state is read or changed except the facing flag below.
  (function(){
    const px = s.plateVisualX*w;
    const dPlate = s.plateX - s.plateVisualX;
    if(dPlate > 0.004) s.sharkDir = 1; else if(dPlate < -0.004) s.sharkDir = -1;
    const img = donutGetSharkSprite();
    if(!img) return;
    const skW = 0.22*w, skH = skW*img.height/img.width;
    ctx.save();
    ctx.translate(px, 0.915*h);
    if(s.sharkDir === -1) ctx.scale(-1, 1);
    ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(img, -skW/2, -skH/2, skW, skH);
    ctx.restore();
  })();
  ctx.restore();
}
function donutGameOver(){
  stopDonutGame();
  playSound('gameover'); vibrate([30,40,30]);
  el('donut-final-score').textContent = donutState.score;
  showMiniGameOverlay(donutOverlayEl);
}
function donutSetPlateFromClientX(clientX){
  const rect = donutCanvasWrapEl.getBoundingClientRect();
  // v5: keep the shark's centre 0.11w (= its half-width = catch half-width) away from the side walls so the whole
  // shark stays on screen. Every donut spawn x (0.08-0.92 Catch, 0.06-0.94 Levels) is still inside the catch zone.
  donutState.plateX = Math.min(0.89, Math.max(0.11, (clientX - rect.left)/rect.width));
}
donutCanvasWrapEl.addEventListener('pointerdown', (e)=>{
  if(!donutState.active) return;
  donutState.pointerActive = true;
  donutSetPlateFromClientX(e.clientX);
});
window.addEventListener('pointermove', (e)=>{
  if(!donutState.active || !donutState.pointerActive) return;
  donutSetPlateFromClientX(e.clientX);
});
window.addEventListener('pointerup', ()=>{ donutState.pointerActive = false; });
window.addEventListener('pointercancel', ()=>{ donutState.pointerActive = false; });
window.addEventListener('resize', ()=>{ if(donutState.active) donutResize(); });

/* ---- Donut Game — Home + Level Selection + LEVELS mode ----
   Both panels are children of #donut-screen, so leaving the Donut screen
   (showScreen) hides them automatically. Donut Catch itself is untouched:
   the original donutLoop / scoring / game-over code is NOT edited. LEVELS
   mode reuses the same donutState / donutDraw() but runs its own single
   gameplay loop (donutLvlLoop), so it can never affect Donut Catch. Everything below is namespaced donutLvl* / dn-*. */
const DONUT_TOTAL_LEVELS = 50;
const DONUT_LVL_STORAGE_KEY = 'candyBlastDonutLevels';
const donutHomePanel = el('donut-home-panel');
const donutLevelsPanel = el('donut-levels-panel');
const donutLvlInfoEl = el('donut-lvl-info');
const donutLvlCompleteEl = el('donut-lvl-complete-overlay');
const donutLvlFailEl = el('donut-lvl-fail-overlay');
const donutLvlPauseEl = el('donut-lvl-pause-overlay');
const donutLvlPause = { paused:false, t0:0 };   // Level Mode pause state only
/* ---- LEVEL CONFIGURATION (used ONLY by LEVELS mode) ----
   One reusable gameplay system; each of the 50 levels is just a config
   object generated by donutLvlMakeConfig(). Donut Catch never reads these.
     scoreTarget  1,000 x level (L50 = 50,000) — the ONLY completion target.
                  Donuts caught are unlimited and purely informational; there
                  is no donut count that can end or cap a level. Unchanged.
     speed        base fall speed (fraction of board height / second)
     spread       random extra speed added per donut (kept proportional to speed)
     spawnDelay   ms between spawns
     varied       mid-fall speed wobble amplitude — 0 (predictable) until the
                  medium tiers begin, then ramps up for "unpredictable movement"
     chilli       chance a spawn is a chilli hazard (Donut Catch fixed = 0.16)

   DIFFICULTY TIERS — five bands, each interpolated smoothly from its start
   level to its end level, with a small deliberate step up at the start of
   the next tier so every 10-level band reads as a distinct difficulty step:
     L1–10   very easy / beginner friendly  — slow, predictable, spacious spawns
     L11–20  easy -> medium                  — slightly faster, still forgiving
     L21–30  medium                          — noticeably faster, more varied
     L31–40  medium -> hard                  — faster + more unpredictable, tighter timing
     L41–50  hard                            — fast, challenging patterns, frequent spawns
   The 6:00 timer is identical on every level (see DONUT_LVL_TIME_SECONDS) —
   only spawn/movement difficulty changes across tiers, never the time limit. */
function donutLvlLerp(n, pts){
  // pts: [[level, value], ...] sorted ascending by level; piecewise-linear
  // interpolation between the surrounding breakpoints (flat before/after).
  if(n <= pts[0][0]) return pts[0][1];
  for(let i=1; i<pts.length; i++){
    if(n <= pts[i][0]){
      const a = pts[i-1], b = pts[i];
      const t = (n - a[0]) / (b[0] - a[0]);
      return a[1] + (b[1]-a[1])*t;
    }
  }
  return pts[pts.length-1][1];
}
// Fall speed (board-heights/sec). Tier 1 stays close to the original gentle
// L1 value; each later tier steps up, ending at a clearly "hard" L50 speed.
const DONUT_LVL_SPEED_PTS  = [[1,0.14],[10,0.16], [11,0.17],[20,0.20], [21,0.21],[30,0.25], [31,0.26],[40,0.31], [41,0.32],[50,0.38]];
// Milliseconds between spawns — lower = busier board.
const DONUT_LVL_SPAWN_PTS  = [[1,1400],[10,1250], [11,1200],[20,1050], [21,1000],[30,850], [31,800],[40,680], [41,650],[50,520]];
// Mid-fall speed wobble amplitude — 0 through Tier 1 (fully predictable),
// then increasingly "unpredictable" through the later tiers.
const DONUT_LVL_VARIED_PTS = [[1,0],[10,0], [11,0.05],[20,0.10], [21,0.12],[30,0.18], [31,0.20],[40,0.27], [41,0.29],[50,0.34]];
// Chilli-hazard chance — rises gently alongside the rest of the difficulty.
const DONUT_LVL_CHILLI_PTS = [[1,0.08],[10,0.09], [11,0.095],[20,0.11], [21,0.115],[30,0.13], [31,0.14],[40,0.155], [41,0.16],[50,0.18]];
/* IN-LEVEL DIFFICULTY (Level Mode only): fall speed of donuts and of chillies is
   multiplied by a factor that rises smoothly and linearly from 1.0x at 06:00
   remaining to the max below at 00:00 (donuts ~+0.15x per minute: 1.15x @1:00 ...
   1.75x @5:00 -> 1.90x @6:00; chillies 1.4x @3:00, ~1.67x @5:00 -> 1.80x @6:00).
   It is derived from the existing elapsed time (L.timeStartTs), which Pause already
   shifts, so it freezes on pause and resets on every new attempt. Spawn rate,
   lateral drift, chilli chance and all rules are untouched. */
const DONUT_LVL_TIMEMUL_DONUT_MAX  = 1.9;
const DONUT_LVL_TIMEMUL_CHILLI_MAX = 1.8;
/* PROGRESSIVE CHILLI PRESSURE — Level Mode.
   The per-spawn chilli chance above is unchanged. On top of it, extra chillies are added on their own timer
   (so catchable donuts are never replaced and the score target stays fair):
     - nothing extra during a grace period (L1 12s -> L50 4s) = a manageable start,
     - then the gap between extra chillies shrinks linearly until 00:00
       (L1 4.2s -> 2.4s, L50 2.6s -> 0.9s),
     - chillies allowed on screen at once: L1 2 -> 4, L50 4 -> 6 (hard cap).
   Driven by the same elapsed-time clock as the other in-level difficulty, so it freezes on Pause and
   restarts on every attempt. Higher levels start the ramp sooner and end it harder. */
function donutLvlChilliPlan(n){
  const t = Math.max(0, Math.min(1, (n-1)/(DONUT_TOTAL_LEVELS-1)));   // 0 @L1 -> 1 @L50
  return {
    graceMs:  Math.round(12000 - 8000*t),
    startGap: Math.round(4200 - 1600*t),
    endGap:   Math.round(2400 - 1500*t),
    baseLive: 2 + Math.floor(t*2)
  };
}
function donutLvlMakeConfig(n){
  const speed = donutLvlLerp(n, DONUT_LVL_SPEED_PTS);
  return {
    level: n,
    scoreTarget: n*1000,
    tier: n<=10 ? 1 : n<=20 ? 2 : n<=30 ? 3 : n<=40 ? 4 : 5,
    difficulty: Math.round((speed/0.14)*100)/100,   // relative-to-L1 label, informational only
    speed: speed,
    spread: speed*0.35,                              // kept proportional to speed, as before
    spawnDelay: Math.max(400, Math.round(donutLvlLerp(n, DONUT_LVL_SPAWN_PTS))),
    varied: donutLvlLerp(n, DONUT_LVL_VARIED_PTS),
    chilli: donutLvlLerp(n, DONUT_LVL_CHILLI_PTS)
  };
}
const DONUT_LVL_CONFIGS = [];
for(let n=1; n<=DONUT_TOTAL_LEVELS; n++) DONUT_LVL_CONFIGS.push(donutLvlMakeConfig(n));
function donutLvlConfig(n){ return DONUT_LVL_CONFIGS[Math.max(1, Math.min(DONUT_TOTAL_LEVELS, n)) - 1]; }
/* ---- LEVEL MODE MOVEMENT / SPAWN VARIETY (Level Mode only) ----
   Layered on top of the fall speed / spawn delay above; scoring, targets, timer
   and catch zone are untouched. Every donut still falls the whole board; variety
   is added sideways, always smoothly (velocity is integrated, never jumped):
     driftChance  share of donuts that also travel diagonally
     vxMax        top sideways speed (board-widths/sec) = driftRatio x fall speed,
                  so a donut never crosses more than ~60% of the width while falling
     curveChance  share of donuts that weave in a smooth S-curve (sine sway)
     turnAvg      average seconds between smooth direction changes (0 = none)
     spawnJitter  +/- share the gap between spawns may vary (average stays the same)
   Fairness: sideways motion eases out over the last stretch before the plate,
   turns only happen in the upper part of the board, donuts are steered back
   inside a safe margin, and nothing ever teleports. Bands:
     L1-5    straight fall, constant spawn gap
     L6-10   a few gentle diagonals
     L11-20  more diagonals, slightly varied spawn spots / gaps
     L21-30  diagonals + curves, varied spawn timing
     L31-40  faster sideways travel, frequent smooth direction changes
     L41-50  widest mix of curves + drift, occasional turns, most varied timing */
const DONUT_LVL_DRIFT_CHANCE_PTS = [[1,0],[5,0],[6,0.15],[10,0.25], [11,0.30],[20,0.55], [21,0.60],[30,0.80], [31,0.85],[40,0.95], [41,0.95],[50,1.0]];
const DONUT_LVL_DRIFT_RATIO_PTS  = [[1,0.10],[10,0.14], [11,0.15],[20,0.28], [21,0.30],[30,0.42], [31,0.44],[40,0.55], [41,0.56],[50,0.65]];
const DONUT_LVL_CURVE_CHANCE_PTS = [[1,0],[20,0], [21,0.25],[30,0.50], [31,0.50],[40,0.65], [41,0.60],[50,0.75]];
const DONUT_LVL_CURVE_W_PTS      = [[21,1.6],[30,2.0], [31,2.1],[40,2.5], [41,2.6],[50,3.0]];   // rad/sec
const DONUT_LVL_TURN_PTS         = [[31,1.8],[40,1.3], [41,2.4],[50,1.8]];                       // avg seconds between turns
const DONUT_LVL_JITTER_PTS       = [[1,0],[10,0], [11,0.10],[20,0.15], [21,0.18],[30,0.25], [31,0.25],[40,0.32], [41,0.32],[50,0.40]];
const DONUT_LVL_MOTION = [];
for(let n=1; n<=DONUT_TOTAL_LEVELS; n++){
  const speed = donutLvlConfig(n).speed;
  const vxMax = donutLvlLerp(n, DONUT_LVL_DRIFT_RATIO_PTS) * speed;
  DONUT_LVL_MOTION.push({
    driftChance: donutLvlLerp(n, DONUT_LVL_DRIFT_CHANCE_PTS),
    vxMax: vxMax,
    curveChance: donutLvlLerp(n, DONUT_LVL_CURVE_CHANCE_PTS),
    curveVelAmp: vxMax * 1.2,
    curveW: donutLvlLerp(n, DONUT_LVL_CURVE_W_PTS),
    turnAvg: n <= 30 ? 0 : donutLvlLerp(n, DONUT_LVL_TURN_PTS),
    spawnJitter: donutLvlLerp(n, DONUT_LVL_JITTER_PTS),
    xMin: n <= 10 ? 0.12 : 0.08,
    xMax: n <= 10 ? 0.88 : 0.92,
    reroll: n > 10
  });
}
function donutLvlMotion(n){ return DONUT_LVL_MOTION[Math.max(1, Math.min(DONUT_TOTAL_LEVELS, n)) - 1]; }
function donutLvlScoreTarget(n){ return donutLvlConfig(n).scoreTarget; }
const donutLvlFmt = (n)=> Number(n).toLocaleString('en-US');
// Fixed 6-minute (360s) timer for every level. Isolated to Level Mode only —
// standalone Donut Catch has no timer and is never touched by this.
const DONUT_LVL_TIME_SECONDS = 360;
function donutLvlFmtTime(sec){
  sec = Math.max(0, Math.ceil(sec));
  const m = Math.floor(sec/60), s = sec%60;
  return (m<10?'0':'')+m+':'+(s<10?'0':'')+s;
}
const donutLvl = {
  on:false, phase:'idle',   // phase: 'idle' | 'playing' | 'done'
  level:1, unlocked:1, raf:null,
  lastEngineScore:0,        // last standalone-engine score seen (used only to spot new catches)
  timeStartTs:0              // performance.now() timestamp when the 6:00 countdown actually began
};
/* ---- LEVEL MODE SCORING (completely separate from Donut Catch) ----
   Each donut caught in a level is worth DONUT_LVL_POINTS_PER_DONUT level
   points. These two variables are the ONLY score/catch values Level Mode
   uses (HUD, completion, result screens, top score box). Donut Catch keeps
   its own donutState.score with its original +10 behaviour, untouched. */
const DONUT_LVL_POINTS_PER_DONUT = 20;
let donutLevelScore = 0;
let donutLevelDonutCount = 0;   // informational only — never caps or ends a level
let donutLevelTimeLeft = DONUT_LVL_TIME_SECONDS;
function donutLvlLoadProgress(){
  try{
    const v = parseInt(localStorage.getItem(DONUT_LVL_STORAGE_KEY), 10);
    if(v >= 1 && v <= DONUT_TOTAL_LEVELS) donutLvl.unlocked = v;
  }catch(e){}
}
function donutLvlSaveProgress(){
  try{ localStorage.setItem(DONUT_LVL_STORAGE_KEY, String(donutLvl.unlocked)); }catch(e){}
}
// Levels the player has actually completed (the unlock number above is the
// furthest playable level; this remembers which ones were beaten).
const DONUT_LVL_DONE_KEY = 'candyBlastDonutLevelsDone';
donutLvl.done = [];
function donutLvlLoadDone(){
  try{
    const v = JSON.parse(localStorage.getItem(DONUT_LVL_DONE_KEY));
    if(Array.isArray(v)) donutLvl.done = v.filter(x=> Number.isInteger(x) && x>=1 && x<=DONUT_TOTAL_LEVELS);
  }catch(e){}
}
function donutLvlSaveDone(){
  try{ localStorage.setItem(DONUT_LVL_DONE_KEY, JSON.stringify(donutLvl.done)); }catch(e){}
}
// Per-level BEST SCORES — its own key, independent of Donut Catch / Classic /
// Candy Blast storage. Shape: { "1": 5000, "2": 8000, ... } (only played levels).
const DONUT_LVL_BEST_KEY = 'donutLevelBestScores';
donutLvl.best = {};
donutLvl.lastNewBest = false;   // whether the attempt that just ended set a new best
function donutLvlLoadBest(){
  try{
    const v = JSON.parse(localStorage.getItem(DONUT_LVL_BEST_KEY));
    if(v && typeof v === 'object' && !Array.isArray(v)){
      for(let n=1; n<=DONUT_TOTAL_LEVELS; n++){
        const x = v[n];
        if(typeof x === 'number' && isFinite(x) && x >= 0) donutLvl.best[n] = Math.floor(x);
      }
    }
  }catch(e){}
}
function donutLvlSaveBest(){
  try{ localStorage.setItem(DONUT_LVL_BEST_KEY, JSON.stringify(donutLvl.best)); }catch(e){}
}
function donutLvlBestText(n){
  return donutLvl.best[n] === undefined ? '---' : donutLvlFmt(donutLvl.best[n]);
}
// Called once with the FINAL score of an attempt (level complete or Time Up).
// Only ever raises a level's best; a lower score never replaces it.
function donutLvlRecordBest(){
  const n = donutLvl.level, sc = donutLevelScore, prev = donutLvl.best[n];
  donutLvl.lastNewBest = false;
  if(prev === undefined){
    donutLvl.best[n] = sc; donutLvlSaveBest();
    donutLvl.lastNewBest = sc > 0;
  } else if(sc > prev){
    donutLvl.best[n] = sc; donutLvlSaveBest();
    donutLvl.lastNewBest = true;
  }
}
donutLvlLoadProgress();
donutLvlLoadDone();
donutLvlLoadBest();

function donutLvlStopTick(){
  if(donutLvl.raf){ cancelAnimationFrame(donutLvl.raf); donutLvl.raf = null; }
}
// Leave LEVELS mode completely (back to plain Donut Catch rendering).
function donutLvlExit(){
  donutLvlStopTick();
  donutLvlPauseReset();
  if(donutLvl.on) donutLvlClearDonuts();   // only when a level was active — Donut Catch untouched
  donutLvlMilestoneHide();
  donutLvl.on = false; donutLvl.phase = 'idle';
  donutScreen.classList.remove('dn-level-mode');
  donutLvlCompleteEl.classList.add('mg-hidden');
  donutLvlFailEl.classList.add('mg-hidden');
}
function donutShowHome(){
  stopDonutGame();
  donutLvlExit();
  donutLvlInfoEl.classList.add('mg-hidden');
  donutLevelsPanel.classList.add('dn-hidden');
  donutHomePanel.classList.remove('dn-hidden');
}
function donutShowLevels(){
  donutLvlExit();
  donutLvlRenderGrid();
  donutLvlInfoEl.classList.add('mg-hidden');
  donutHomePanel.classList.add('dn-hidden');
  donutLevelsPanel.classList.remove('dn-hidden');
}
// Levels above the saved "unlocked" number show the locked look.
function donutLvlRenderGrid(){
  const grid = el('donut-levels-grid');
  let html = '';
  for(let n=1; n<=DONUT_TOTAL_LEVELS; n++){
    const locked = n > donutLvl.unlocked;
    const done = donutLvl.done.indexOf(n) >= 0;
    // The one level a player would naturally play next: unlocked and not
    // yet completed. (A replayed/completed level just shows dn-done.)
    const current = !locked && !done && n === donutLvl.unlocked;
    let cls = 'dn-level';
    if(locked) cls += ' dn-locked';
    if(done) cls += ' dn-done';
    if(current) cls += ' dn-current';
    html += '<button class="' + cls + '" data-level="' + n +
            '" aria-label="Level ' + n + (locked ? ' (locked)' : done ? ' (completed)' : ' (available)') + '">' +
            '<span class="dn-level-lbl">LEVEL</span><span class="dn-level-num">' + n + '</span>' +
            (locked ? '' : '<span class="dn-level-best">BEST ' + donutLvlBestText(n) + '</span>') +
            (locked ? '<span class="dn-lock">🔒</span>' : (done ? '<span class="dn-done-mark">✓</span>' : '')) + '</button>';
  }
  grid.innerHTML = html;
}
// Brief, non-intrusive feedback for tapping a locked level: a quick shake
// plus a tiny tooltip that fades on its own — never a popup/modal.
let donutLvlLockedTipTimer = null;
function donutLvlLockedTap(btn){
  btn.classList.remove('dn-locked-shake');
  void btn.offsetWidth; // restart the animation if tapped again quickly
  btn.classList.add('dn-locked-shake');
  const tip = el('donut-lvl-locked-tip'), scrollWrap = el('donut-levels-grid').closest('.dn-levels-scroll');
  if(tip && scrollWrap){
    const r = btn.getBoundingClientRect(), pr = scrollWrap.getBoundingClientRect();
    tip.textContent = 'Complete previous level';
    tip.style.left = (r.left - pr.left + r.width/2) + 'px';
    tip.style.top = (r.top - pr.top) + 'px';
    tip.classList.remove('dn-show');
    void tip.offsetWidth;
    tip.classList.add('dn-show');
    clearTimeout(donutLvlLockedTipTimer);
    donutLvlLockedTipTimer = setTimeout(()=>{ tip.classList.remove('dn-show'); }, 900);
  }
}
el('donut-levels-grid').addEventListener('click', (e)=>{
  const b = e.target.closest('.dn-level');
  if(!b) return;
  if(b.classList.contains('dn-locked')){ donutLvlLockedTap(b); return; }
  playSound('button');
  donutLvlOpenInfo(parseInt(b.dataset.level, 10));
});
function donutLvlOpenInfo(n){
  donutLvl.level = n;
  el('donut-lvl-info-title').textContent = 'LEVEL ' + n;
  el('donut-lvl-info-score').textContent = donutLvlFmt(donutLvlScoreTarget(n));
  el('donut-lvl-info-time').textContent = donutLvlFmtTime(DONUT_LVL_TIME_SECONDS);
  el('donut-lvl-info-best').textContent = donutLvlBestText(n);
  // NOTE: this popup only shows the level's info — the 6:00 timer does NOT
  // start here. It starts only once START is pressed (see donutLvlBegin).
  showMiniGameOverlay(donutLvlInfoEl);
}
/* ---- LEVEL MODE SOUND & FEEDBACK (Step 21) ----
   A Level-Mode-only audio wrapper. It reuses the game's single AudioContext
   (via the existing ensureAudio(), unchanged) and the Sound setting, but routes
   its own short synthesized tones through a private gain bus, so it never
   touches playSound(), the shared sounds, or Donut Catch / other modes.
   No audio files, no per-frame allocation: each effect is a couple of tiny
   oscillators that stop themselves after well under a second. Pausing mutes
   the bus, which cleanly cuts anything still ringing. */
let donutLvlBus = null;
function donutLvlAudioReady(){
  if(!settings.sound) return false;
  ensureAudio();   // lazily creates/resumes the shared context (safe after the START tap)
  if(!audioCtx) return false;
  if(!donutLvlBus || donutLvlBus.context !== audioCtx){
    donutLvlBus = audioCtx.createGain();
    donutLvlBus.gain.value = 1;
    donutLvlBus.connect(audioCtx.destination);
  }
  return true;
}
function donutLvlBusMute(mute){
  if(!donutLvlBus || !audioCtx) return;
  const g = donutLvlBus.gain, t = audioCtx.currentTime;
  g.cancelScheduledValues(t);
  if(mute){ g.setValueAtTime(g.value, t); g.setTargetAtTime(0, t, 0.008); }
  else    { g.setValueAtTime(1, t); }
}
/* ---- DONUT COIN PICKUP (Donut Catch + Donut Levels) ----
   Short, bright two-note "coin" chime made with plain Web Audio oscillators:
   a quick B5 blip into a ringing E6 with a high sparkle overtone, all through a
   soft low-pass so it stays crisp but never harsh. A 70 ms guard means several
   donuts caught in the same instant/frame play ONE clean chime instead of a
   stack of overlapping ones. `dest` is the node to connect to. */
let donutCoinLastT = -1;
function donutCoinSfx(dest){
  if(!audioCtx || !dest) return;
  const t0 = audioCtx.currentTime;
  if(t0 - donutCoinLastT < 0.07) return;
  donutCoinLastT = t0;
  const out = audioCtx.createGain();
  out.gain.value = 1;
  const lp = audioCtx.createBiquadFilter();
  lp.type = 'lowpass'; lp.frequency.value = 6500;
  out.connect(lp); lp.connect(dest);
  function note(type, freq, start, dur, peak){
    const t = t0 + start;
    const o = audioCtx.createOscillator(), g = audioCtx.createGain();
    o.type = type; o.frequency.setValueAtTime(freq, t);
    g.gain.setValueAtTime(0, t);
    g.gain.linearRampToValueAtTime(peak, t + 0.004);
    g.gain.exponentialRampToValueAtTime(0.0008, t + dur);
    o.connect(g); g.connect(out);
    o.start(t); o.stop(t + dur + 0.03);
  }
  note('square', 987.77, 0,     0.07, 0.06);    // B5 blip
  note('square', 1318.51, 0.06, 0.26, 0.07);    // E6 ring
  note('sine',   2637.02, 0.06, 0.20, 0.05);    // E7 sparkle
  note('triangle', 1318.51, 0.06, 0.30, 0.06);  // body under the ring
}
function donutLvlTone(type, f0, f1, dur, gain, delay, direct){
  const t0 = audioCtx.currentTime + (delay || 0);
  const osc = audioCtx.createOscillator(), g = audioCtx.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(f0, t0);
  if(f1) osc.frequency.exponentialRampToValueAtTime(f1, t0 + dur);
  g.gain.setValueAtTime(0, t0);
  g.gain.linearRampToValueAtTime(gain, t0 + 0.006);
  g.gain.exponentialRampToValueAtTime(0.0008, t0 + dur);
  osc.connect(g); g.connect(direct ? audioCtx.destination : donutLvlBus);
  osc.start(t0); osc.stop(t0 + dur + 0.03);
}
function donutLvlSfx(name){
  const L = donutLvl;
  if(!L.on) return;
  const playing = L.phase === 'playing';
  if(name === 'catch'){ if(!playing || donutLvlPause.paused || !donutState.active) return; }
  else if(name === 'start' || name === 'resume'){ if(!playing) return; }
  else if(name === 'pause'){ if(!playing) return; }
  else if(name !== 'complete' && name !== 'timeup') return;
  if(!donutLvlAudioReady()) return;
  if(name === 'catch'){
    donutCoinSfx(donutLvlBus);   // same coin pickup as Donut Catch (routed via the level bus so pause/mute cut it)
  } else if(name === 'start'){
    donutLvlTone('sine', 523, 0, 0.12, 0.07, 0.09);
    donutLvlTone('sine', 784, 0, 0.16, 0.07, 0.19);
  } else if(name === 'complete'){
    const notes = [523, 659, 784, 1047];
    for(let i=0; i<notes.length; i++){
      donutLvlTone('triangle', notes[i], 0, i === notes.length-1 ? 0.3 : 0.15, 0.09, 0.14 + i*0.09);
    }
  } else if(name === 'timeup'){
    donutLvlTone('triangle', 440, 330, 0.18, 0.09, 0);
    donutLvlTone('triangle', 330, 220, 0.26, 0.09, 0.16);
  } else if(name === 'pause'){
    donutLvlTone('sine', 620, 420, 0.09, 0.06, 0, true);
  } else if(name === 'resume'){
    donutLvlTone('sine', 420, 640, 0.09, 0.06, 0);
  }
}
/* ---- LEVEL MODE STABILITY (Step 22) ---- */
// Removes every live donut/chilli of the current attempt so nothing from an old
// attempt can survive (Level Complete / Time Up / Levels / Restart).
function donutLvlClearDonuts(){
  donutState.items = [];
  donutState.pointerActive = false;
}
// Start / 🔄 debounce: a second START (or 🔄) within 400ms is ignored, so a
// double-tap can never create two starts, two sounds or a second loop.
let donutLvlLastBeginTs = -1e9;
// Start a level: same startDonutGame() Donut Catch uses, plus level tracking.
function donutLvlBegin(n){
  const beginTs = performance.now();
  if(beginTs - donutLvlLastBeginTs < 400) return;
  donutLvlLastBeginTs = beginTs;
  donutLvlStopTick();
  donutLvl.on = true; donutLvl.phase = 'playing'; donutLvl.level = n;
  donutLevelScore = 0; donutLevelDonutCount = 0; donutLvl.lastEngineScore = 0;
  donutLvl.msFired = 0; donutLvlMilestoneHide();
  // The 6:00 countdown starts right here — the exact moment actual gameplay
  // begins (never on the level-select screen or the info popup).
  donutLevelTimeLeft = DONUT_LVL_TIME_SECONDS;
  donutLvl.timeStartTs = performance.now();
  donutScreen.classList.add('dn-level-mode');
  donutLvlCompleteEl.classList.add('mg-hidden');
  donutLvlFailEl.classList.add('mg-hidden');
  el('donut-lvl-hud-level').textContent = 'LEVEL ' + n;
  // Same start-up as startDonutGame() (resize, reset, arm the engine state) but the
  // standalone donutLoop is NOT started — Level Mode runs its own single loop.
  stopDonutGame();
  donutResize();
  donutReset();
  donutState.active = true;
  donutState.lastTime = performance.now();
  donutLvl.hudSec = -1;
  donutLvl.nextDelay = 0; donutLvl.lastSpawnX = null;
  playEntranceAnim(donutCanvasWrapEl);
  donutLvlUpdateHud();
  donutLvlBusMute(false);
  donutLvlSfx('start');   // timer started above at this same instant
  donutLvl.raf = requestAnimationFrame(donutLvlLoop);
}
// Score-target milestones (50% / 75%) — visual only; never touches score, timer or
// gameplay. State lives on the existing donutLvl object and is reset per attempt.
function donutLvlMilestoneHide(){
  el('dn-hud-milestone').classList.remove('dn-show');
}
function donutLvlMilestone(pct){
  const L = donutLvl;
  if(!L.on || L.phase !== 'playing') return;
  if(pct >= 100){ donutLvlMilestoneHide(); return; }   // target reached: Level Complete takes over
  const fired = L.msFired || 0;
  let hit = 0;
  if(pct >= 75 && fired < 75) hit = 75;        // crossing both at once shows only the highest
  else if(pct >= 50 && fired < 50) hit = 50;
  if(!hit) return;
  L.msFired = hit;                              // each milestone shows once per attempt
  const m = el('dn-hud-milestone');
  m.textContent = hit + '% TARGET';
  m.classList.remove('dn-show'); void m.offsetWidth; m.classList.add('dn-show');
}
function donutLvlUpdateHud(){
  const n = donutLvl.level, sT = donutLvlScoreTarget(n);
  el('dn-hud-score').textContent = donutLvlFmt(donutLevelScore) + ' / ' + donutLvlFmt(sT);
  // Score progress bar: currentScore / target, clamped to 0–100%. A drop (new level /
  // restart) resets instantly instead of animating backwards; increases ease smoothly.
  const bar = el('dn-hud-score-bar'), pct = Math.max(0, Math.min(100, donutLevelScore/sT*100));
  if(pct < (parseFloat(bar.dataset.pct) || 0)){
    bar.style.transition = 'none'; bar.style.width = pct + '%'; void bar.offsetWidth; bar.style.transition = '';
  } else {
    bar.style.width = pct + '%';
  }
  bar.dataset.pct = pct;
  donutLvlMilestone(pct);
  el('dn-hud-score-track').setAttribute('aria-valuenow', String(Math.round(pct)));
  el('dn-hud-score-chip').classList.toggle('dn-done', donutLevelScore >= sT);
  // Donuts caught is informational only — no target, no cap, no bar.
  el('dn-hud-donuts').textContent = String(donutLevelDonutCount);
  el('dn-hud-time').textContent = donutLvlFmtTime(donutLevelTimeLeft);
}
function donutLvlResultRows(timeLabel){
  const n = donutLvl.level, sT = donutLvlScoreTarget(n);
  const sOk = donutLevelScore >= sT;
  return '<div class="dn-lvl-row"><span>Score</span><b class="' + (sOk ? 'dn-met' : '') + '">' + donutLvlFmt(donutLevelScore) + ' / ' + donutLvlFmt(sT) + '</b></div>' +
         '<div class="dn-lvl-row"><span>Best Score</span><b>' + donutLvlBestText(n) +
           (donutLvl.lastNewBest ? '<span class="dn-lvl-newbest">NEW BEST!</span>' : '') + '</b></div>' +
         '<div class="dn-lvl-row"><span>Donuts Caught</span><b>' + donutLevelDonutCount + '</b></div>' +
         '<div class="dn-lvl-row"><span>' + (timeLabel || 'Time') + '</span><b>' + donutLvlFmtTime(donutLevelTimeLeft) + '</b></div>';
}
function donutLvlComplete(){
  donutLvl.phase = 'done';
  donutLvlPauseReset();
  donutLvlRecordBest();
  if(donutState.active) stopDonutGame();
  donutLvlClearDonuts();
  donutLvlMilestoneHide();
  donutOverlayEl.classList.add('mg-hidden');
  if(donutLvl.done.indexOf(donutLvl.level) < 0){ donutLvl.done.push(donutLvl.level); donutLvlSaveDone(); }
  // Unlock the next level (never lowers progress when replaying older levels).
  if(donutLvl.level < DONUT_TOTAL_LEVELS && donutLvl.unlocked < donutLvl.level + 1){
    donutLvl.unlocked = donutLvl.level + 1;
    donutLvlSaveProgress();
  }
  const isFinalLevel = donutLvl.level >= DONUT_TOTAL_LEVELS;
  el('donut-lvl-complete-level').textContent = 'LEVEL ' + donutLvl.level;
  el('donut-lvl-complete-title').textContent = isFinalLevel ? 'ALL LEVELS COMPLETE' : 'LEVEL COMPLETE';
  el('donut-lvl-complete-rows').innerHTML = donutLvlResultRows('Time Left');
  // Level 50 has no Level 51: swap NEXT LEVEL for REPLAY LEVEL 50 instead.
  el('btn-donut-lvl-next').style.display = isFinalLevel ? 'none' : '';
  el('btn-donut-lvl-replay50').classList.toggle('mg-hidden', !isFinalLevel);
  donutLvlSfx('complete');
  showMiniGameOverlay(donutLvlCompleteEl);
}
// reason: 'time' when the 6:00 countdown ran out before the score target was
// reached; omitted (default) for the existing chilli game-over case. Either
// way the ONLY thing that ends a level is the score target or the timer —
// never the donut count.
function donutLvlFail(reason){
  donutLvl.phase = 'done';
  donutLvlPauseReset();
  donutLvlClearDonuts();
  donutLvlMilestoneHide();
  donutOverlayEl.classList.add('mg-hidden');
  const timeUp = reason === 'time';
  if(timeUp) donutLvlRecordBest(); else donutLvl.lastNewBest = false;
  el('donut-lvl-fail-level').textContent = 'LEVEL ' + donutLvl.level;
  el('donut-lvl-fail-title').textContent = timeUp ? 'TIME UP' : 'LEVEL FAILED';
  el('donut-lvl-fail-emoji').textContent = timeUp ? '⏰' : '🌶️';
  el('donut-lvl-fail-rows').innerHTML = donutLvlResultRows(timeUp ? 'Time' : 'Time Left');
  if(timeUp) donutLvlSfx('timeup');   // chilli case: the existing game-over sound already played
  showMiniGameOverlay(donutLvlFailEl);
}
/* ---- LEVEL MODE GAMEPLAY LOOP ----
   The ONLY animation loop while a level runs (the standalone Donut Catch loop
   is not started in Level Mode, and this one is not used by Donut Catch).
   It moves, spawns and catches donuts itself, using the level's config, and
   also drives the countdown and the win / time-up / chilli checks.

   - Movement is time-based (dt from the frame clock), each donut eases in from
     ~60% to full speed over its first 0.6s, and the plate glides toward the
     finger with frame-rate independent smoothing.
   - Catching uses an invisible, slightly generous zone (wider than the plate and
     swept between frames so fast donuts can't skip past it). Donut artwork and
     size are unchanged.
   - A caught donut is removed from the list at that instant, so it can never
     be scored twice; input events only move the plate and never score.
   - Pausing / Time Up / Level Complete / leaving all stop this loop. */
const DONUT_LVL_PLATE_K = 48;          // plate smoothing rate (≈ old 0.55/frame at 60fps)
const DONUT_LVL_CATCH_TOP = 0.86;      // vertical catch band (fraction of height)
const DONUT_LVL_CATCH_BOTTOM = 0.97;
const DONUT_LVL_CATCH_HALF_W = 0.11;   // plate half-width; the donut's own radius is added on top
function donutLvlSpawn(cfg, forceBad){
  const mo = donutLvlMotion(cfg.level), L = donutLvl;
  const top = donutRefreshPlayTop();   // v7: spawn just below the HUD, not behind it
  const bad = forceBad === true || Math.random() < cfg.chilli;
  let x = mo.xMin + Math.random()*(mo.xMax - mo.xMin);
  if(forceBad === true){
    // Extra (pressure) chilli: keep it off the column of anything that just spawned so it never forms an unfair wall.
    for(let k=0;k<8 && donutState.items.some(o=>o.y < top+0.22 && Math.abs(o.x-x) < 0.10);k++) x = mo.xMin + Math.random()*(mo.xMax - mo.xMin);
  } else {
    // From L11 avoid spawning right on top of the previous donut's column.
    if(mo.reroll && L.lastSpawnX != null && Math.abs(x - L.lastSpawnX) < 0.12){
      x = mo.xMin + Math.random()*(mo.xMax - mo.xMin);
    }
    L.lastSpawnX = x;
  }
  const it = {
    x: x, y: top - 0.06, dnTop: top, r: 0.055, speed: 0,
    bad, caught:false,
    spawnTime: performance.now(),
    chilliColor: bad ? (Math.random() < 0.5 ? 'red' : 'green') : null,
    dnLvl:true, dnKey:x,   // dnKey keeps the icing colour fixed while the donut moves sideways
    dnBase: cfg.speed + Math.random()*cfg.spread,
    dnPhase: Math.random()*Math.PI*2, age:0, mv:null
  };
  const drift = Math.random() < mo.driftChance, curve = Math.random() < mo.curveChance;
  if(drift || curve){
    const tv = drift ? (Math.random() < 0.5 ? -1 : 1) * mo.vxMax * (0.45 + 0.55*Math.random()) : 0;
    it.mv = {
      vx: tv, tvx: tv,
      curveAmp: curve ? mo.curveVelAmp*(0.7 + 0.3*Math.random()) : 0,
      curveW: mo.curveW*(0.85 + 0.3*Math.random()),
      curvePh: Math.random()*Math.PI*2,
      turnAt: (drift && mo.turnAvg > 0) ? mo.turnAvg*(0.6 + 0.8*Math.random()) : 0,
      turnAvg: mo.turnAvg, max: mo.vxMax
    };
  }
  donutState.items.push(it);
}
function donutLvlLoop(now){
  const L = donutLvl, s = donutState;
  L.raf = null;
  if(!L.on || L.phase !== 'playing') return;
  // Engine stopped from outside (left the Donut screen etc.): stop cleanly.
  if(!s.active){ donutLvlExit(); return; }
  const cfg = donutLvlConfig(L.level), mo = donutLvlMotion(L.level);
  const dt = Math.min(0.05, Math.max(0, (now - s.lastTime)/1000));
  s.lastTime = now;

  s.plateVisualX += (s.plateX - s.plateVisualX) * (1 - Math.exp(-dt*DONUT_LVL_PLATE_K));
  if(s.shakeT > 0) s.shakeT = Math.max(0, s.shakeT - dt*3.2);

  // Spawning: the configured delay, keeping the leftover time so spacing stays even.
  // The first gap is the plain configured delay; later gaps vary +/- spawnJitter
  // around it (same average), never shorter than 300ms.
  if(!L.nextDelay) L.nextDelay = cfg.spawnDelay;
  s.spawnTimer += dt*1000;
  if(s.spawnTimer >= L.nextDelay){
    s.spawnTimer = Math.min(s.spawnTimer - L.nextDelay, L.nextDelay);
    donutLvlSpawn(cfg);
    L.nextDelay = Math.max(300, cfg.spawnDelay*(1 - mo.spawnJitter + 2*mo.spawnJitter*Math.random())*donutScoreSpawnFactor(s.speedLevel));
  }
  // Progressive chilli pressure (see donutLvlChilliPlan): extra chillies on their own timer.
  const cpl = donutLvlChilliPlan(L.level), elapsedMs = now - L.timeStartTs;
  if(elapsedMs >= cpl.graceMs){
    const cp = Math.min(1, (elapsedMs - cpl.graceMs)/Math.max(1, DONUT_LVL_TIME_SECONDS*1000 - cpl.graceMs));
    const gap = (cpl.startGap + (cpl.endGap - cpl.startGap)*cp)*(s.chilliJit || 1);
    s.chilliTimer = (s.chilliTimer || 0) + dt*1000;
    if(s.chilliTimer >= gap){
      s.chilliTimer = 0; s.chilliJit = 0.85 + Math.random()*0.3;
      let liveChillies = 0;
      for(let k=0;k<s.items.length;k++) if(s.items[k].bad) liveChillies++;
      if(liveChillies < cpl.baseLive + Math.round(cp*2)) donutLvlSpawn(cfg, true);
    }
  }

  // Move + catch.
  s.donutsCaughtThisFrame = [];
  let caughtNow = 0;
  const plateX = s.plateX;
  // Level end lock: once the target is reached (or 00:00 has passed) nothing more can be caught.
  const lvlTarget = donutLvlScoreTarget(L.level);
  const lvlOver = (now - L.timeStartTs) >= DONUT_LVL_TIME_SECONDS*1000;
  const tFrac = Math.min(1, Math.max(0, (now - L.timeStartTs)/(DONUT_LVL_TIME_SECONDS*1000)));
  // Donuts: slow start, then a step-up every ~10 s (see donutTimeSpeedMul), capped at the same max as before.
  const donutMul  = donutTimeSpeedMul((now - L.timeStartTs)/1000, 0.06, DONUT_LVL_TIMEMUL_DONUT_MAX);
  const chilliMul = 1 + (DONUT_LVL_TIMEMUL_CHILLI_MAX - 1)*tFrac;
  for(let i=s.items.length-1; i>=0; i--){
    const it = s.items[i];
    const prevY = it.y;
    it.age += dt;
    const k = Math.min(1, it.age/0.6);
    const ease = 0.6 + 0.4*(k*k*(3-2*k));
    const wob = cfg.varied > 0 ? (1 + cfg.varied*Math.sin(it.dnPhase + it.age*5)) : 1;
    it.speed = it.dnBase * Math.max(0.05, wob) * ease * (it.bad ? chilliMul : donutMul) * s.scoreSpeedMul;
    it.y += it.speed*dt;
    if(it.mv){
      // Smooth sideways travel: velocity eases toward its target (no jumps), an optional
      // sine sway adds the curve, turns happen only in the upper board, donuts are steered
      // back inside the safe margin, and the motion eases out near the plate.
      const m = it.mv;
      if(m.turnAt > 0 && it.age >= m.turnAt && it.y < 0.6){
        const dir = (m.tvx > 0 ? -1 : 1) * (Math.random() < 0.75 ? 1 : -1);
        m.tvx = dir * m.max * (0.45 + 0.55*Math.random());
        m.turnAt = it.age + m.turnAvg*(0.6 + 0.8*Math.random());
      }
      if(it.x < 0.14 && m.tvx < 0) m.tvx = -m.tvx;
      else if(it.x > 0.86 && m.tvx > 0) m.tvx = -m.tvx;
      m.vx += (m.tvx - m.vx)*(1 - Math.exp(-2.5*dt));
      const lat = m.vx + (m.curveAmp ? m.curveAmp*Math.cos(m.curvePh + it.age*m.curveW) : 0);
      const settle = Math.min(1, Math.max(0.3, (0.92 - it.y)/0.25));
      it.x = Math.min(0.94, Math.max(0.06, it.x + lat*settle*dt));
    }
    if(!lvlOver && donutLevelScore < lvlTarget && it.y >= DONUT_LVL_CATCH_TOP && prevY <= DONUT_LVL_CATCH_BOTTOM &&
       Math.abs(it.x - plateX) <= DONUT_LVL_CATCH_HALF_W + it.r*0.9){
      it.caught = true;
      s.items.splice(i,1);   // gone immediately — can never be counted twice
      const px = it.x*s.w, py = it.y*s.h;
      if(it.bad){
        playSound('mg-chilli'); vibrate([25,30,60]);
        s.shakeT = 1;
        donutSpawnBurst(px, py, '255,90,60', 14);
        donutSpawnBurst(px, py, '255,209,102', 8);
        s.gameOverPending = true;
      } else {
        s.donutsCaughtThisFrame.push({x: px, y: py, scale: 1, t: 0});
        s.popEffects.push({x: px, y: py, life: 1, scale: 1});
        donutLevelScore += DONUT_LVL_POINTS_PER_DONUT;
        if(DONUT_SCORE_SPEED_IN_LEVELS) donutScoreSpeedCheck(donutLevelScore);   // v7
        donutLevelDonutCount += 1;   // unlimited — a running counter only
        caughtNow++;
        donutLvlSfx('catch');
        donutSpawnBurst(px, py, '255,209,102', 8);
        donutSpawnScorePopup(px, py, '+' + DONUT_LVL_POINTS_PER_DONUT);
      }
    } else if(it.y > 1.08){
      s.items.splice(i,1);   // missed donuts / chillies just leave the board
    }
  }
  if(caughtNow > 0){
    pulseScoreEl(donutScoreEl);
    donutScoreEl.textContent = donutLvlFmt(donutLevelScore);
  }

  // Same catch / particle / popup effects as Donut Catch.
  if(s.donutsCaughtThisFrame.length >= 3){
    s.multiCatchGlowT = 1;
    for(let j=0; j<s.donutsCaughtThisFrame.length; j++){
      const c = s.donutsCaughtThisFrame[j];
      donutSpawnBurst(c.x, c.y, '255,235,200', 6);
      donutSpawnBurst(c.x, c.y, '255,220,130', 5);
    }
  }
  if(s.multiCatchGlowT > 0) s.multiCatchGlowT = Math.max(0, s.multiCatchGlowT - dt*2.5);
  for(let j=0; j<s.donutsCaughtThisFrame.length; j++){
    const c = s.donutsCaughtThisFrame[j];
    c.t += dt;
    c.scale = c.t < 0.15 ? 1 + (1 - c.t/0.15)*0.35 : 1;
  }
  for(let i=s.particles.length-1; i>=0; i--){
    const p = s.particles[i];
    p.x += p.vx*dt*60; p.y += p.vy*dt*60; p.vy += dt*1.4;
    p.life -= dt*2.2;
    if(p.life<=0) s.particles.splice(i,1);
  }
  for(let i=s.popups.length-1; i>=0; i--){
    const p = s.popups[i];
    p.y -= dt*38;
    p.life -= dt*1.15;
    if(p.life<=0) s.popups.splice(i,1);
  }
  for(let i=s.popEffects.length-1; i>=0; i--){
    const pop = s.popEffects[i];
    pop.life -= dt*3.8;
    const progress = 1 - pop.life;
    pop.scale = progress < 0.2 ? 1 + (progress/0.2)*0.4 : 1.4*(1 - (progress-0.2)/0.8);
    if(pop.life<=0) s.popEffects.splice(i,1);
  }

  // Countdown from real elapsed time (never drifts with frame rate). The HUD is
  // only touched when the score / donut count / displayed second actually changed.
  donutLevelTimeLeft = Math.max(0, DONUT_LVL_TIME_SECONDS - (performance.now() - L.timeStartTs)/1000);
  const secShown = Math.ceil(donutLevelTimeLeft);
  if(caughtNow > 0 || secShown !== L.hudSec){ L.hudSec = secShown; donutLvlUpdateHud(); }

  donutDraw();

  // End conditions — same priority as before: target reached, then time up, then chilli.
  if(donutLevelScore >= donutLvlScoreTarget(L.level)){ donutLvlComplete(); return; }
  if(donutLevelTimeLeft <= 0){
    if(s.active) stopDonutGame();
    donutLvlFail('time'); return;
  }
  if(s.gameOverPending){
    stopDonutGame();
    playSound('gameover'); vibrate([30,40,30]);
    donutLvlFail(); return;
  }
  L.raf = requestAnimationFrame(donutLvlLoop);
}
el('btn-donut-home-back').addEventListener('click', ()=>{ playSound('button'); showScreen(moreGamesScreen); });
el('btn-donut-open-catch').addEventListener('click', ()=>{ playSound('button'); donutLvlExit(); donutHomePanel.classList.add('dn-hidden'); startDonutGame(); });
el('btn-donut-open-levels').addEventListener('click', ()=>{ playSound('button'); donutShowLevels(); });
el('btn-donut-levels-back').addEventListener('click', ()=>{ playSound('button'); donutShowHome(); });
el('btn-donut-lvl-info-back').addEventListener('click', ()=>{ playSound('button'); donutLvlInfoEl.classList.add('mg-hidden'); });
el('btn-donut-lvl-start').addEventListener('click', ()=>{
  if(donutLvl.on && donutLvl.phase === 'playing') return;   // a level is already running
  playSound('button');
  donutLvlInfoEl.classList.add('mg-hidden');
  donutLevelsPanel.classList.add('dn-hidden');
  donutLvlBegin(donutLvl.level);
});
// RETRY opens the same level's existing Level Start screen — it must NOT
// jump straight into gameplay. The 6:00 timer only starts once START is
// pressed there (same as NEXT LEVEL below).
el('btn-donut-lvl-retry').addEventListener('click', ()=>{
  playSound('button');
  donutShowLevels();
  donutLvlOpenInfo(donutLvl.level);
});
el('btn-donut-lvl-fail-levels').addEventListener('click', ()=>{ playSound('button'); donutShowLevels(); });
el('btn-donut-lvl-complete-levels').addEventListener('click', ()=>{ playSound('button'); donutShowLevels(); });
el('btn-donut-lvl-next').addEventListener('click', ()=>{
  playSound('button');
  const next = Math.min(DONUT_TOTAL_LEVELS, donutLvl.level + 1);
  donutShowLevels();
  donutLvlOpenInfo(next);
});
// Shown only after Level 50 is completed (no Level 51 exists) — replays
// Level 50 via its own Level Start screen, same as RETRY/NEXT LEVEL.
el('btn-donut-lvl-replay50').addEventListener('click', ()=>{
  playSound('button');
  donutShowLevels();
  donutLvlOpenInfo(DONUT_TOTAL_LEVELS);
});
// The 🔄 icon in LEVELS mode restarts the level through the Level Mode path
// (fresh score / count / 06:00) and never reaches the standalone Donut Catch
// handler, so only one loop can ever run. Ignored while paused. In standalone
// Donut Catch (donutLvl.on is false) this does nothing.
el('btn-donut-restart').addEventListener('click', (e)=>{
  if(!donutLvl.on) return;
  e.stopImmediatePropagation();
  if(donutLvlPause.paused) return;
  playSound('button');
  donutLvlBegin(donutLvl.level);
});

/* ---- LEVEL MODE PAUSE / RESUME (Donut Game → LEVELS only) ----
   Pausing stops the engine loop (spawning, movement, animation, catching,
   scoring) and the level tick (countdown) — nothing runs while paused, so
   the timer can never reach 00:00 while paused. On RESUME the countdown's
   start timestamp (and per-donut timestamps) are shifted forward by the
   paused duration, so the exact remaining time / state carries on. Standalone
   Donut Catch never has donutLvl.on set, so it can never be paused here. */
function donutLvlPauseReset(){
  donutLvlPause.paused = false;
  donutLvlPauseEl.classList.add('mg-hidden');
}
function donutLvlPauseGame(){
  const L = donutLvl, P = donutLvlPause;
  if(P.paused || !L.on || L.phase !== 'playing' || !donutState.active || donutState.gameOverPending) return;
  const now = performance.now();
  // Level is already decided (target reached / time out) — let the tick end it.
  if(donutLevelScore >= donutLvlScoreTarget(L.level)) return;
  if(DONUT_LVL_TIME_SECONDS - (now - L.timeStartTs)/1000 <= 0) return;
  donutLvlStopTick();
  stopDonutGame();
  donutState.pointerActive = false;
  P.paused = true; P.t0 = now;
  donutLvlBusMute(true);    // cut any level sound still ringing
  donutLvlSfx('pause');
  showMiniGameOverlay(donutLvlPauseEl);
}
function donutLvlResumeGame(){
  const L = donutLvl, P = donutLvlPause;
  if(!P.paused) return;
  if(!L.on || L.phase !== 'playing'){ donutLvlPauseReset(); return; }
  const now = performance.now(), gap = now - P.t0;
  L.timeStartTs += gap;   // remaining time stays exactly as it was
  const items = donutState.items;
  for(let i=0; i<items.length; i++){
    if(items[i].spawnTime != null) items[i].spawnTime += gap;
  }
  donutLvlPauseReset();
  donutResize();
  donutState.active = true;
  donutState.lastTime = now;
  donutLvlBusMute(false);
  donutLvlSfx('resume');
  donutLvlStopTick();
  L.raf = requestAnimationFrame(donutLvlLoop);
}
donutCanvasWrapEl.addEventListener('pointermove', (e)=>{
  if(e.pointerType !== 'mouse') return;
  if(!donutLvl.on || donutLvl.phase !== 'playing' || donutLvlPause.paused || !donutState.active) return;
  donutSetPlateFromClientX(e.clientX);
});
el('btn-donut-lvl-pause').addEventListener('pointerdown', (e)=>{ e.stopPropagation(); });
el('btn-donut-lvl-pause').addEventListener('click', ()=>{ playSound('button'); donutLvlPauseGame(); });
el('btn-donut-lvl-resume').addEventListener('click', ()=>{ playSound('button'); donutLvlResumeGame(); });
// RESTART: same level's Level Start screen, fresh state, timer 06:00 — NOT auto-started.
el('btn-donut-lvl-pause-restart').addEventListener('click', ()=>{
  playSound('button');
  if(!donutLvlPause.paused) return;
  const n = donutLvl.level;
  stopDonutGame();
  donutLevelScore = 0; donutLevelDonutCount = 0; donutLevelTimeLeft = DONUT_LVL_TIME_SECONDS;
  donutShowLevels();
  donutLvlOpenInfo(n);
});
// LEVELS: stop the level completely, back to Level Selection (progress untouched).
el('btn-donut-lvl-pause-levels').addEventListener('click', ()=>{
  playSound('button');
  stopDonutGame();
  donutShowLevels();
});
// While paused the top 🔄 button must not restart the frozen level behind the overlay
// (registered before the original 🔄 handler, so it can block it).
el('btn-donut-restart').addEventListener('click', (e)=>{ if(donutLvlPause.paused) e.stopImmediatePropagation(); });
// Keep the frozen frame correctly sized if the window/orientation changes while paused.
window.addEventListener('resize', ()=>{ if(donutLvlPause.paused){ donutResize(); donutDraw(); } });

/* ---------------- ICE CREAM STACK ---------------- */
const icestackCanvas = el('icestack-canvas');
const icestackCtx = icestackCanvas.getContext('2d');
const icestackOverlayEl = el('icestack-overlay');
const icestackCanvasWrapEl = el('icestack-canvas-wrap');
const icestackScoreEl = el('icestack-score');
const ICE_COLORS = ['#ff8fc0','#ffd166','#8f7bff','#5ee6c9','#ff9f6e','#7bd3ff'];
const icestackState = {
  active:false, rafId:null, lastTime:0,
  w:0, h:0, blockH:0,
  stack:[], // {x, width, row, squishT} in fraction-of-width units, bottom-up
  moving:null, // {x, width, dir, speed, row}
  particles:[],
  score:0, cameraShift:0, cameraShiftVisual:0
};
// Camera scroll eases toward its target (soft "water-like" glide) instead of
// jumping — still fast enough (few frames) to feel immediate.
const ICESTACK_CAMERA_SMOOTH = 0.22;
// Ice Cream Stack-specific settings (isolated from global settings)
let iceStackSettings = {sound:true, vibration:true};
const icestackSettingsOverlayEl = el('icestack-settings-overlay');
function loadIceStackSettings(){
  try{
    const v = JSON.parse(localStorage.getItem('iceStackSettings'));
    if(v) iceStackSettings = Object.assign(iceStackSettings, v);
  }catch(e){}
  renderIceStackSettingsUI();
}
function saveIceStackSettings(){
  try{ localStorage.setItem('iceStackSettings', JSON.stringify(iceStackSettings)); }catch(e){}
}
function renderIceStackSettingsUI(){
  const soundBtn = el('icestack-toggle-sound');
  const vibBtn = el('icestack-toggle-vibration');
  soundBtn.classList.toggle('on', iceStackSettings.sound);
  vibBtn.classList.toggle('on', iceStackSettings.vibration);
}
function openIceStackSettings(){
  icestackSettingsOverlayEl.classList.remove('mg-hidden');
}
function closeIceStackSettings(){
  icestackSettingsOverlayEl.classList.add('mg-hidden');
}
function icestackResize(){
  const rect = icestackCanvasWrapEl.getBoundingClientRect();
  icestackState.w = Math.max(1, Math.round(rect.width));
  icestackState.h = Math.max(1, Math.round(rect.height));
  const dpr = Math.min(window.devicePixelRatio||1, 2.5);
  icestackCanvas.width = Math.round(icestackState.w*dpr);
  icestackCanvas.height = Math.round(icestackState.h*dpr);
  icestackCtx.setTransform(dpr,0,0,dpr,0,0);
  icestackState.blockH = icestackState.h * 0.09;
}
function icestackSpawnMoving(width, fromRow){
  const dir = Math.random()<0.5 ? 1 : -1;
  // Progressive difficulty: speed starts at 0.45 and increases smoothly with score
  // Every 5 blocks adds ~0.025 to speed, capping at a max for fairness
  const speedIncrease = Math.min(0.65, icestackState.score * 0.015);
  const blockSpeed = 0.45 + speedIncrease;
  icestackState.moving = {
    x: dir>0 ? 0.02 : (0.98-width),
    width,
    dir,
    speed: blockSpeed,
    row: fromRow
  };
}
function icestackReset(){
  icestackState.stack = [{ x:0.5-0.19, width:0.38, row:0, squishT:0 }];
  icestackState.particles = [];
  icestackState.score = 0;
  icestackScoreEl.textContent = '0';
  icestackState.cameraShift = 0;
  icestackState.cameraShiftVisual = 0;
  icestackSpawnMoving(0.38, 1);
  icestackOverlayEl.classList.add('mg-hidden');
}
function startIceStackGame(){
  icestackResize();
  icestackReset();
  icestackState.active = true;
  icestackState.lastTime = performance.now();
  icestackState.rafId = requestAnimationFrame(icestackLoop);
  playEntranceAnim(icestackCanvasWrapEl);
}
function stopIceStackGame(){
  icestackState.active = false;
  if(icestackState.rafId){ cancelAnimationFrame(icestackState.rafId); icestackState.rafId = null; }
}
function icestackLoop(now){
  if(!icestackState.active) return;
  const dt = Math.min(0.05, (now-icestackState.lastTime)/1000);
  icestackState.lastTime = now;
  const s = icestackState, m = s.moving;
  if(m){
    m.x += m.dir*m.speed*dt;
    if(m.x <= 0.0){ m.x = 0.0; m.dir = 1; }
    if(m.x + m.width >= 1.0){ m.x = 1.0 - m.width; m.dir = -1; }
  }
  s.cameraShiftVisual += (s.cameraShift - s.cameraShiftVisual) * ICESTACK_CAMERA_SMOOTH;
  s.stack.forEach(b=>{ if(b.squishT>0) b.squishT = Math.max(0, b.squishT - dt*4.5); });
  for(let i=s.particles.length-1;i>=0;i--){
    const p = s.particles[i];
    p.x += p.vx*dt*60; p.y += p.vy*dt*60; p.vy += dt*1.2;
    p.life -= dt*2.4;
    if(p.life<=0) s.particles.splice(i,1);
  }
  icestackDraw();
  s.rafId = requestAnimationFrame(icestackLoop);
}
function icestackSpawnBurst(x, y, color){
  for(let i=0;i<7;i++){
    const ang = (Math.PI*2*i)/7 + Math.random()*0.3;
    icestackState.particles.push({ x, y, vx:Math.cos(ang)*0.6, vy:Math.sin(ang)*0.6-0.3, life:1, color });
  }
  if(icestackState.particles.length>56) icestackState.particles.splice(0, icestackState.particles.length-56);
}
function icestackDraw(){
  const ctx = icestackCtx, s = icestackState, w = s.w, h = s.h, bh = s.blockH;
  ctx.clearRect(0,0,w,h);
  /* background is now the wrapper's CSS image (#icestack-canvas-wrap); the canvas stays transparent */

  const baseY = h - bh - 6;
  s.stack.forEach((b)=>{
    const y = baseY - (b.row)*bh + s.cameraShiftVisual*bh;
    if(y < -bh || y > h) return;
    // brief vertical "squish" pop right after a block lands, for satisfying
    // tactile feedback instead of it just instantly appearing
    const squish = b.squishT>0 ? 1 + b.squishT*0.22 : 1;
    const bwh = (bh-3);
    const drawH = bwh*squish;
    ctx.fillStyle = ICE_COLORS[b.row % ICE_COLORS.length];
    ctx.save();
    ctx.shadowColor = 'rgba(0,0,0,.35)'; ctx.shadowBlur = 6; ctx.shadowOffsetY = 3;
    roundRectPath(ctx, b.x*w, y + (bwh-drawH), b.width*w, drawH, 6);
    ctx.fill();
    ctx.restore();
  });
  if(s.moving){
    const y = baseY - (s.moving.row)*bh + s.cameraShiftVisual*bh;
    ctx.save();
    ctx.shadowColor = 'rgba(255,255,255,.35)'; ctx.shadowBlur = 10;
    ctx.fillStyle = ICE_COLORS[s.moving.row % ICE_COLORS.length];
    roundRectPath(ctx, s.moving.x*w, y, s.moving.width*w, bh-3, 6);
    ctx.fill();
    ctx.restore();
    ctx.strokeStyle = 'rgba(255,255,255,.6)'; ctx.lineWidth = 2;
    roundRectPath(ctx, s.moving.x*w, y, s.moving.width*w, bh-3, 6);
    ctx.stroke();
  }
  s.particles.forEach(p=>{
    ctx.globalAlpha = Math.max(0,p.life);
    ctx.fillStyle = `rgba(${p.color},${Math.max(0,p.life)})`;
    ctx.beginPath();
    ctx.arc(p.x, p.y, 3.5*p.life+1, 0, Math.PI*2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;
}
function roundRectPath(ctx, x, y, w, h, r){
  ctx.beginPath();
  ctx.moveTo(x+r, y);
  ctx.arcTo(x+w, y, x+w, y+h, r);
  ctx.arcTo(x+w, y+h, x, y+h, r);
  ctx.arcTo(x, y+h, x, y, r);
  ctx.arcTo(x, y, x+w, y, r);
  ctx.closePath();
}
function icestackDrop(){
  if(!icestackState.active || !icestackState.moving) return;
  const s = icestackState, m = s.moving;
  const below = s.stack[s.stack.length-1];
  const overlapStart = Math.max(m.x, below.x);
  const overlapEnd = Math.min(m.x+m.width, below.x+below.width);
  const overlapW = overlapEnd - overlapStart;
  if(overlapW <= 0.02){
    if(iceStackSettings.sound && settings.sound) playSound('mg-stackfail');
    if(iceStackSettings.vibration && settings.vibration) vibrate([30,40,30]);
    icestackGameOver();
    return;
  }
  s.stack.push({ x: overlapStart, width: overlapW, row: m.row, squishT:1 });
  s.score++;
  pulseScoreEl(icestackScoreEl);
  icestackScoreEl.textContent = s.score;
  if(iceStackSettings.sound && settings.sound) playSound('mg-stack');
  const baseY = s.h - s.blockH - 6;
  const landY = baseY - m.row*s.blockH + s.cameraShiftVisual*s.blockH;
  icestackSpawnBurst((overlapStart+overlapW/2)*s.w, landY, '255,209,102');
  // scroll the "camera" upward once the tower gets tall enough that new
  // blocks would otherwise go off the top of the canvas
  const visibleRows = Math.floor(1/ (s.blockH/s.h));
  if(m.row >= visibleRows - 4){
    s.cameraShift = (m.row - (visibleRows-5));
  }
  icestackSpawnMoving(overlapW, m.row+1);
}
function icestackGameOver(){
  stopIceStackGame();
  closeIceStackSettings();
  if(settings.sound) playSound('gameover');
  el('icestack-final-score').textContent = icestackState.score;
  showMiniGameOverlay(icestackOverlayEl);
}
icestackCanvasWrapEl.addEventListener('pointerdown', ()=>{ icestackDrop(); });
window.addEventListener('keydown', (e)=>{
  if(!icestackState.active) return;
  if(e.code==='Space'){ e.preventDefault(); icestackDrop(); }
});
window.addEventListener('resize', ()=>{ if(icestackState.active) icestackResize(); });

/* ---------------- PUZZLE POP (match-3) ---------------- */
const puzzlepopGridEl = el('poppop-grid');
const puzzlepopOverlayEl = el('puzzlepop-overlay');
const puzzlepopWrapEl = el('puzzlepop-wrap');
const puzzlepopScoreEl = el('puzzlepop-score');
const puzzlepopComboEl = el('puzzlepop-combo');
const POP_EMOJIS = ['🍬','🍭','🍫','🍩','🍡','🍓'];
const POP_SPARKLES = ['✨','⭐','💥'];
const POP_SIZE = 6; // 6x6 match-3 board
const puzzlepopState = {
  active:false, timeoutId:null,
  tiles:[],        // flat array, length POP_SIZE*POP_SIZE, each a candy-type index (0..POP_EMOJIS.length-1)
  cellEls:[],      // matching flat array of DOM elements
  selected:-1,     // index of the currently-selected tile, or -1
  animating:false, // true while a swap/clear/cascade sequence is playing (input locked)
  score:0
};
function ppIdx(r,c){ return r*POP_SIZE+c; }
function ppInBounds(r,c){ return r>=0 && r<POP_SIZE && c>=0 && c<POP_SIZE; }
function ppRandType(){ return Math.floor(Math.random()*POP_EMOJIS.length); }

// SWIPE: drag a candy toward a neighbour (up/down/left/right) to swap it.
// Tap-then-tap still works exactly as before; both use puzzlepopAttemptSwap.
let puzzlepopSwipe = null;
function puzzlepopSwipeMove(e){
  const sw = puzzlepopSwipe;
  if(!sw || sw.done || e.pointerId!==sw.id) return;
  if(!puzzlepopState.active || puzzlepopState.animating) return;
  const dx = e.clientX - sw.x, dy = e.clientY - sw.y;
  const tileW = (puzzlepopState.cellEls[0] && puzzlepopState.cellEls[0].offsetWidth) || 40;
  const need = Math.max(12, tileW*0.35);
  if(Math.abs(dx)<need && Math.abs(dy)<need) return;
  // diagonal drag: ignore (keep tracking in case the finger straightens out)
  if(Math.min(Math.abs(dx),Math.abs(dy)) > Math.max(Math.abs(dx),Math.abs(dy))*0.6) return;
  sw.done = true;
  const r = Math.floor(sw.i/POP_SIZE), c = sw.i%POP_SIZE;
  let r2=r, c2=c;
  if(Math.abs(dx)>=Math.abs(dy)) c2 += dx>0 ? 1 : -1; else r2 += dy>0 ? 1 : -1;
  if(!ppInBounds(r2,c2)) return;
  puzzlepopState.cellEls.forEach(el=>el.classList.remove('selected'));
  puzzlepopState.selected = -1;
  puzzlepopAttemptSwap(sw.i, ppIdx(r2,c2));
}
function puzzlepopSwipeEnd(e){
  if(puzzlepopSwipe && e.pointerId===puzzlepopSwipe.id) puzzlepopSwipe = null;
}
window.addEventListener('pointermove', puzzlepopSwipeMove);
window.addEventListener('pointerup', puzzlepopSwipeEnd);
window.addEventListener('pointercancel', puzzlepopSwipeEnd);

function puzzlepopBuildGrid(){
  puzzlepopGridEl.style.gridTemplateColumns = `repeat(${POP_SIZE},1fr)`;
  puzzlepopGridEl.style.gridTemplateRows = `repeat(${POP_SIZE},1fr)`;
  puzzlepopGridEl.innerHTML = '';
  puzzlepopState.cellEls = [];
  for(let i=0;i<POP_SIZE*POP_SIZE;i++){
    const tile = document.createElement('div');
    tile.className = 'poppop-tile';
    tile.dataset.i = i;
    tile.addEventListener('pointerdown', (e)=>{
      puzzlepopSwipe = { i:i, x:e.clientX, y:e.clientY, id:e.pointerId, done:false };
      puzzlepopTapTile(i);
      if(puzzlepopState.animating) puzzlepopSwipe = null; // input lock
    });
    puzzlepopGridEl.appendChild(tile);
    puzzlepopState.cellEls.push(tile);
  }
}
// Finds every matched run (3+ in a row, horizontally or vertically) in the
// given flat tiles array. Returns a Set of matched indices.
function puzzlepopFindMatches(tiles){
  const matched = new Set();
  for(let r=0;r<POP_SIZE;r++){
    let runStart=0;
    for(let c=1;c<=POP_SIZE;c++){
      const same = c<POP_SIZE && tiles[ppIdx(r,c)]===tiles[ppIdx(r,runStart)] && tiles[ppIdx(r,runStart)]!==-1;
      if(!same){
        if(c-runStart>=3){ for(let k=runStart;k<c;k++) matched.add(ppIdx(r,k)); }
        runStart = c;
      }
    }
  }
  for(let c=0;c<POP_SIZE;c++){
    let runStart=0;
    for(let r=1;r<=POP_SIZE;r++){
      const same = r<POP_SIZE && tiles[ppIdx(r,c)]===tiles[ppIdx(runStart,c)] && tiles[ppIdx(runStart,c)]!==-1;
      if(!same){
        if(r-runStart>=3){ for(let k=runStart;k<r;k++) matched.add(ppIdx(k,c)); }
        runStart = r;
      }
    }
  }
  return matched;
}
// Scans every adjacent pair; true if swapping any pair would create a match.
// This is the exact rule used both to keep a freshly-built board playable
// and to decide the real GAME OVER condition (no swap anywhere helps).
function puzzlepopHasValidMove(tiles){
  for(let r=0;r<POP_SIZE;r++){
    for(let c=0;c<POP_SIZE;c++){
      const i = ppIdx(r,c);
      if(c+1<POP_SIZE){
        const j = ppIdx(r,c+1);
        [tiles[i],tiles[j]] = [tiles[j],tiles[i]];
        const hit = puzzlepopFindMatches(tiles).size>0;
        [tiles[i],tiles[j]] = [tiles[j],tiles[i]];
        if(hit) return true;
      }
      if(r+1<POP_SIZE){
        const j = ppIdx(r+1,c);
        [tiles[i],tiles[j]] = [tiles[j],tiles[i]];
        const hit = puzzlepopFindMatches(tiles).size>0;
        [tiles[i],tiles[j]] = [tiles[j],tiles[i]];
        if(hit) return true;
      }
    }
  }
  return false;
}
function puzzlepopGenerateBoard(){
  let tiles;
  let tries = 0;
  do{
    tiles = new Array(POP_SIZE*POP_SIZE);
    for(let i=0;i<tiles.length;i++){
      // avoid immediately-pre-matched rows/columns while generating
      let t;
      do{
        t = ppRandType();
      } while(
        (i%POP_SIZE>=2 && tiles[i-1]===t && tiles[i-2]===t) ||
        (Math.floor(i/POP_SIZE)>=2 && tiles[i-POP_SIZE]===t && tiles[i-2*POP_SIZE]===t)
      );
      tiles[i] = t;
    }
    tries++;
  } while(!puzzlepopHasValidMove(tiles) && tries<50);
  return tiles;
}
function puzzlepopRenderAll(){
  puzzlepopState.tiles.forEach((t,i)=>{
    puzzlepopState.cellEls[i].textContent = POP_EMOJIS[t];
  });
}
function puzzlepopReset(){
  puzzlepopState.tiles = puzzlepopGenerateBoard();
  puzzlepopState.selected = -1;
  puzzlepopState.animating = false;
  puzzlepopState.score = 0;
  puzzlepopScoreEl.textContent = '0';
  puzzlepopOverlayEl.classList.add('mg-hidden');
  puzzlepopComboEl.classList.remove('show');
  puzzlepopState.cellEls.forEach(el=>el.classList.remove('selected','mg-clear','mg-drop','mg-shake'));
  puzzlepopRenderAll();
}
function startPuzzlePopGame(){
  stopPuzzlePopGame(); // cancel any pending swap/cascade timer from a previous run
  if(puzzlepopState.cellEls.length===0 || puzzlepopState.cellEls.length!==POP_SIZE*POP_SIZE) puzzlepopBuildGrid();
  puzzlepopReset();
  puzzlepopState.active = true;
  playEntranceAnim(puzzlepopWrapEl);
}
function stopPuzzlePopGame(){
  puzzlepopState.active = false;
  puzzlepopState.animating = false;
  if(puzzlepopState.timeoutId){ clearTimeout(puzzlepopState.timeoutId); puzzlepopState.timeoutId = null; }
  puzzlepopState.selected = -1;
  puzzlepopSwipe = null;
  puzzlepopState.cellEls.forEach(e=>{
    e.classList.remove('selected','mg-clear','mg-drop','mg-shake');
    e.querySelectorAll('.poppop-sparkle').forEach(sp=>sp.remove());
  });
  puzzlepopComboEl.classList.remove('show');
}
function puzzlepopSpawnSparkles(tileEl){
  for(let i=0;i<4;i++){
    const s = document.createElement('span');
    s.className = 'poppop-sparkle';
    s.textContent = POP_SPARKLES[Math.floor(Math.random()*POP_SPARKLES.length)];
    const ang = (Math.PI*2*i)/4 + Math.random()*0.5;
    s.style.setProperty('--sx', Math.round(Math.cos(ang)*22)+'px');
    s.style.setProperty('--sy', Math.round(Math.sin(ang)*22)+'px');
    tileEl.appendChild(s);
    setTimeout(()=>{ if(s.parentNode) s.parentNode.removeChild(s); }, 520);
  }
}
function puzzlepopShowCombo(text){
  puzzlepopComboEl.classList.remove('show');
  void puzzlepopComboEl.offsetWidth;
  puzzlepopComboEl.textContent = text;
  puzzlepopComboEl.classList.add('show');
}
function puzzlepopTapTile(i){
  if(!puzzlepopState.active || puzzlepopState.animating) return;
  const sel = puzzlepopState.selected;
  if(sel===-1){
    puzzlepopState.selected = i;
    puzzlepopState.cellEls[i].classList.add('selected');
    playSound('button');
    return;
  }
  if(sel===i){
    puzzlepopState.cellEls[i].classList.remove('selected');
    puzzlepopState.selected = -1;
    return;
  }
  const r1=Math.floor(sel/POP_SIZE), c1=sel%POP_SIZE, r2=Math.floor(i/POP_SIZE), c2=i%POP_SIZE;
  const adjacent = Math.abs(r1-r2)+Math.abs(c1-c2)===1;
  puzzlepopState.cellEls[sel].classList.remove('selected');
  if(!adjacent){
    // move selection to the newly tapped tile instead (standard match-3 UX)
    puzzlepopState.selected = i;
    puzzlepopState.cellEls[i].classList.add('selected');
    playSound('button');
    return;
  }
  puzzlepopState.selected = -1;
  puzzlepopAttemptSwap(sel, i);
}
function puzzlepopAttemptSwap(i, j){
  const t = puzzlepopState.tiles;
  if(t[i]===t[j]){
    // same candy swiped into same candy: clear the pair via the normal
    // clear -> score -> gravity -> refill -> cascade pipeline
    puzzlepopState.animating = true;
    puzzlepopResolve(1, [i, j]);
    return;
  }
  [t[i], t[j]] = [t[j], t[i]];
  const matches = puzzlepopFindMatches(t);
  if(matches.size===0){
    // invalid swap — revert immediately with a soft shake, no score change,
    // no game state change of any kind
    // show the swap briefly, then swap back (tiles array is restored to
    // its original order only after the visual swap-back, so it always
    // matches what's on screen)
    puzzlepopState.animating = true;
    puzzlepopRenderAll(); // shows the swapped look
    playSound('invalid');
    puzzlepopState.timeoutId = setTimeout(()=>{
      if(!puzzlepopState.active) return;
      [t[i], t[j]] = [t[j], t[i]];
      puzzlepopRenderAll();
      const elI = puzzlepopState.cellEls[i], elJ = puzzlepopState.cellEls[j];
      [elI, elJ].forEach(e=>{
        e.classList.remove('mg-shake'); void e.offsetWidth; e.classList.add('mg-shake');
      });
      puzzlepopState.timeoutId = setTimeout(()=>{
        puzzlepopState.animating = false;
        puzzlepopState.timeoutId = null;
      }, 220);
    }, 160);
    return;
  }
  // valid swap: commit visually, then run the match/cascade pipeline
  puzzlepopState.animating = true;
  puzzlepopRenderAll();
  puzzlepopState.timeoutId = setTimeout(()=>puzzlepopResolve(1), 90);
}
// Repeatedly clears matches → applies gravity → refills → checks for chain
// matches, awarding an escalating combo bonus for each successive step
// triggered by the SAME original swap.
function puzzlepopResolve(chainCount, extraClear){
  if(!puzzlepopState.active) return;
  const t = puzzlepopState.tiles;
  const matches = puzzlepopFindMatches(t);
  if(extraClear) extraClear.forEach(k=>matches.add(k));
  if(matches.size===0){
    puzzlepopState.animating = false;
    if(!puzzlepopHasValidMove(t)){
      puzzlepopGameOver();
    }
    return;
  }
  // score: +10 per tile cleared, with each successive chain step in this
  // same cascade worth more (a real combo bonus), without altering the
  // base per-tile value
  const base = matches.size*10;
  const bonus = chainCount>1 ? base*(chainCount-1)*0.5 : 0;
  puzzlepopState.score += Math.round(base+bonus);
  pulseScoreEl(puzzlepopScoreEl);
  puzzlepopScoreEl.textContent = puzzlepopState.score;
  if(chainCount>=4) puzzlepopShowCombo('MEGA COMBO!');
  else if(chainCount===3) puzzlepopShowCombo('TRIPLE COMBO!');
  else if(chainCount===2) puzzlepopShowCombo('DOUBLE COMBO!');
  playSound('mg-pop'); vibrate(chainCount>1 ? 25 : 15);

  matches.forEach(idx=>{
    const el = puzzlepopState.cellEls[idx];
    el.classList.add('mg-clear');
    puzzlepopSpawnSparkles(el);
  });

  puzzlepopState.timeoutId = setTimeout(()=>{
    // gravity: for each column, drop remaining tiles down, fill gaps with
    // fresh random tiles at the top
    matches.forEach(idx=>{ t[idx] = -1; });
    const refilled = [];
    for(let c=0;c<POP_SIZE;c++){
      let writeR = POP_SIZE-1;
      for(let r=POP_SIZE-1;r>=0;r--){
        if(t[ppIdx(r,c)]!==-1){
          t[ppIdx(writeR,c)] = t[ppIdx(r,c)];
          if(writeR!==r) t[ppIdx(r,c)] = -1;
          writeR--;
        }
      }
      for(let r=writeR;r>=0;r--){
        t[ppIdx(r,c)] = ppRandType();
        refilled.push(ppIdx(r,c));
      }
    }
    puzzlepopState.cellEls.forEach(el=>el.classList.remove('mg-clear','mg-shake','mg-drop'));
    puzzlepopRenderAll();
    // freshly-spawned tiles get a little drop-in pop so refills feel alive
    refilled.forEach(idx=>{
      const el = puzzlepopState.cellEls[idx];
      void el.offsetWidth;
      el.classList.add('mg-drop');
    });
    puzzlepopState.timeoutId = setTimeout(()=>puzzlepopResolve(chainCount+1), 130);
  }, 230);
}
function puzzlepopGameOver(){
  stopPuzzlePopGame();
  playSound('gameover');
  el('puzzlepop-final-score').textContent = puzzlepopState.score;
  showMiniGameOverlay(puzzlepopOverlayEl);
}

/* ============================================================
   ARROW PUZZLE — full standalone puzzle game.
   Board of arrow tiles; an arrow can only exit (be cleared) in the
   direction it points if every cell between it and that edge of the
   board is empty. Tapping a blocked arrow costs a life. Level is won
   when every arrow is cleared; failed when lives reach 0. Levels are
   procedurally generated but ALWAYS guaranteed solvable (see
   arrowGenerateLevel below) and persist unlock/completion progress via
   localStorage, same pattern as Blast Journey.
============================================================ */
const arrowGridEl = el('arrow-grid');
const arrowBoardWrapEl = el('arrow-board-wrap');
const arrowScoreEl = el('arrow-score');
const arrowLivesEl = el('arrow-lives');
const arrowComboEl = el('arrow-combo');
const arrowToastEl = el('arrow-toast');
const arrowHintBtnEl = el('btn-arrow-hint');
const arrowHintCountEl = el('arrow-hint-count');
const arrowCompleteOverlayEl = el('arrow-complete-overlay');
const arrowFailOverlayEl = el('arrow-fail-overlay');
const ARROW_DIRS = ['up','down','left','right'];
const ARROW_DIR_VEC = { up:[-1,0], down:[1,0], left:[0,-1], right:[0,1] };
const ARROW_GLYPH = { up:'⬆️', down:'⬇️', left:'⬅️', right:'➡️' };
const ARROW_SPARKLES = ['✨','⭐','💥'];
// Word bank for the Hidden Alphabet Task: common, valid English words grouped by
// LENGTH (3..10). Each list is ordered roughly easy -> harder; a level takes the
// next unused word of its length, so words rarely repeat across the 100 levels.
const ARROW_WORDS_BY_LEN = {
  3: ['CAT','SUN','DOG','HAT','CUP','BED','KEY','MAP','SKY','SEA','PEN','BOX','TOY','BUS','EGG','ICE','OWL','FOX','BAT','JAR','PIG','NET','RUG','BAG','TEA','PIE','ANT','COW','BEE','LOG'],
  4: ['BOOK','TREE','MOON','STAR','FISH','BIRD','RAIN','SNOW','WIND','FIRE','LAKE','ROAD','DOOR','BELL','KITE','CAKE','SHIP','FARM','GAME','HOME','LEAF','MILK','NEST','RING','SAND','TOWN','WAVE','WORD','GOLD','JUMP'],
  5: ['PLANT','WATER','LIGHT','HEART','SMILE','CLOUD','RIVER','MUSIC','DREAM','HAPPY','BREAD','CHAIR','TABLE','HOUSE','APPLE','BEACH','TIGER','PIANO','STORM','OCEAN','CLOCK','FLAME','GRASS','PAINT','QUEEN','ROBOT','SUGAR','TRAIN','WORLD'],
  6: ['GARDEN','PUZZLE','BRIGHT','FOREST','ORANGE','BRIDGE','CASTLE','SUMMER','WINTER','ROCKET','SILVER','MARKET','ISLAND','SPRING','FLOWER','WINDOW','PLANET','DRAGON','CANDLE','MIRROR','BASKET','JUNGLE','COOKIE','SUNSET','TICKET'],
  7: ['JOURNEY','MORNING','RAINBOW','PICTURE','KITCHEN','CAPTAIN','MYSTERY','BALLOON','BICYCLE','CHICKEN','DOLPHIN','FREEDOM','HOLIDAY','LANTERN','MACHINE','PENGUIN','PRESENT','TEACHER','THUNDER','WEATHER','WARRIOR','BLANKET','HARVEST','LIBRARY','MONSTER'],
  8: ['MOUNTAIN','SUNSHINE','ELEPHANT','BIRTHDAY','TREASURE','SANDWICH','CHAMPION','LANGUAGE','PLATFORM','BASEBALL','BUILDING','DINOSAUR','FOOTBALL','HOSPITAL','KEYBOARD','NOTEBOOK','PAINTING','PASSWORD','PRINCESS','SUITCASE','UMBRELLA','MARATHON','STRANGER'],
  9: ['ADVENTURE','BUTTERFLY','CHOCOLATE','WATERFALL','PINEAPPLE','DISCOVERY','BLUEBERRY','SNOWFLAKE','SUNFLOWER','TELEPHONE','YESTERDAY','CELEBRATE','EDUCATION','EXCELLENT','HURRICANE','KNOWLEDGE','LIGHTNING','NIGHTMARE','DANGEROUS','FANTASTIC','IMAGINARY'],
  10: ['STRAWBERRY','BASKETBALL','LIGHTHOUSE','FRIENDSHIP','PLAYGROUND','SKYSCRAPER','BLACKBOARD','PEPPERMINT','DICTIONARY','ELECTRICAL','RESTAURANT','WATERMELON','WONDERLAND','UNDERWATER','HELICOPTER','EARTHQUAKE','CELEBRATED']
};
const ARROW_WORDS = [].concat.apply([], Object.keys(ARROW_WORDS_BY_LEN).map(k=>ARROW_WORDS_BY_LEN[k]));
// A small rotating palette];
// A small rotating palette of glossy candy-gradient colors assigned to
// tiles in sequence, purely decorative.
const ARROW_TILE_PALETTE = [
  ['#ff9fd6','#e0387f'], ['#7fd8ff','#2f9fe8'], ['#ffd36b','#ff9f1c'],
  ['#c9a8ff','#8a5cff'], ['#8ff0ae','#2fb86a'], ['#ff9a8b','#ff5f6d']
];
// RETRY-BUG FIX: every random choice made while BUILDING a level goes through
// arrowRand(). arrowGenerateLevel() installs a per-level seeded generator in
// arrowRng for the duration of the build, so level N always produces the exact
// same layout, target word, letter positions and decoys — on retry, on
// re-entry and across sessions. Outside level building (arrowRng === null)
// it is plain Math.random, so nothing else changes.
let arrowRng = null;
function arrowRand(){ return arrowRng ? arrowRng() : Math.random(); }
// Target-word length for a level: grows 3 -> 10 over the 100 levels, with a small
// repeating wobble (+1 / -1) so short and long words are mixed instead of one
// long monotone block.
function arrowWordLengthForLevel(levelNum){
  const L = Math.max(0, levelNum-1);
  const base = Math.min(10, 3 + Math.floor(L/13));
  const wobble = [0,1,0,-1,0][L%5];
  return Math.max(3, Math.min(10, base + wobble));
}
// Picks the level's word: the next unused word (in the list's easy->hard order)
// among the levels that share this word length. Fully deterministic.
function arrowPickWord(maxLen, minLen, levelNum){
  const len = Math.max(3, Math.min(10, maxLen));
  const pool = ARROW_WORDS_BY_LEN[len] || ARROW_WORDS_BY_LEN[3];
  let rank = 0;
  for(let n=1; n<levelNum; n++){ if(arrowWordLengthForLevel(n)===len) rank++; }
  return pool[rank % pool.length];
}

const arrowState = {
  active:false, level:1, size:4, arrows:[], cellEls:{},
  lives:3, hints:3, score:0, comboStreak:0, lastMoveTime:0,
  pendingTimeouts:[], toastTimeoutId:null, resolved:false,
  word:'', revealed:[] // Hidden Alphabet Task: target word + per-letter-position revealed flags
};

function arrowShuffle(arr){
  for(let i=arr.length-1;i>0;i--){
    const j = Math.floor(arrowRand()*(i+1));
    [arr[i],arr[j]] = [arr[j],arr[i]];
  }
  return arr;
}
// Checks whether the straight path from (r,c) to the board edge in `dir`
// is clear of every cell in `blockerCells` (a plain [{r,c},...] array).
function arrowPathClearOf(r, c, dir, size, blockerCells){
  const [dr,dc] = ARROW_DIR_VEC[dir];
  let rr=r+dr, cc=c+dc;
  while(rr>=0 && rr<size && cc>=0 && cc<size){
    if(blockerCells.some(b=>b.r===rr && b.c===cc)) return false;
    rr+=dr; cc+=dc;
  }
  return true;
}
// Builds one level by choosing a valid CLEAR ORDER first, then assigning
// each arrow's direction (working backwards from the last arrow to be
// cleared) so that, at the moment each arrow is due to exit, its path is
// guaranteed clear of every arrow that hasn't been cleared yet. This makes
// every generated level solvable by construction — never a random board
// that might turn out to be impossible.
// `hard` (0..1) = chance that an arrow gets the hardest-to-read valid direction:
// one that points at earlier arrows, preferably ones far away along the line, so
// it LOOKS blocked-or-free in a misleading way. Any direction chosen is still
// one of the "valid" ones, so solvability is never affected.
function arrowGenerateWithCount(size, count, similar, hard){
  const N = size*size;
  // Occupancy-array helpers (fast): is the ray from (r,c) in direction d free of occupied cells?
  function rayFree(occ, r, c, d){
    const v = ARROW_DIR_VEC[d]; let rr=r+v[0], cc=c+v[1];
    while(rr>=0 && rr<size && cc>=0 && cc<size){ if(occ[rr*size+cc]) return false; rr+=v[0]; cc+=v[1]; }
    return true;
  }
  function anyFree(occ, p){
    const r = (p/size)|0, c = p%size;
    return rayFree(occ,r,c,'up') || rayFree(occ,r,c,'down') || rayFree(occ,r,c,'left') || rayFree(occ,r,c,'right');
  }
  for(let attempt=0; attempt<80; attempt++){
    // Phase 1 - choose the cells, LAST-cleared first. A cell is only accepted if at least one of its
    // four rays is free of the cells already placed (= cleared after it), so every cell is guaranteed a
    // valid exit direction in phase 2. On a COMPLETELY filled board a placement must also leave every
    // other still-empty cell with a way out (placing a cell can only take rays away), otherwise the
    // attempt would dead-end - only the empty cells sharing its row/column can be affected.
    const cells = new Array(count);
    const occ = new Uint8Array(N);
    const idx = new Int16Array(N).fill(-1);          // cell -> its place in the clear order
    const dirs = new Array(count).fill(null);
    let ok = true;
    for(let k=count-1;k>=0 && ok;k--){
      const empties = [];
      for(let p=0;p<N;p++) if(!occ[p]) empties.push(p);
      arrowShuffle(empties);
      let placed = false;
      for(let e=0;e<empties.length && !placed;e++){
        const p = empties[e];
        if(!anyFree(occ,p)) continue;
        if(count===N){
          const pr = (p/size)|0, pc = p%size;
          occ[p] = 1;
          let good = true;
          for(let q=0;q<empties.length && good;q++){
            const o = empties[q]; if(o===p) continue;
            if(((o/size)|0)!==pr && (o%size)!==pc) continue;      // not in p's row/column: unaffected
            if(!anyFree(occ,o)) good = false;
          }
          occ[p] = 0;
          if(!good) continue;
        }
        cells[k] = {r:(p/size)|0, c:p%size}; occ[p] = 1; idx[p] = k; placed = true;
      }
      if(!placed) ok = false;
    }
    if(!ok) continue;
    // Phase 2 - directions, last-cleared first; `present` = cells that are cleared AFTER the current one.
    const present = new Uint8Array(N);
    for(let i=count-1;i>=0;i--){
      const r = cells[i].r, c = cells[i].c;
      const valid = ARROW_DIRS.filter(d=>rayFree(present,r,c,d));
      if(!valid.length){ ok=false; break; }
      let chosen = null;
      if(hard>0 && arrowRand()<hard){
        let bestScore = -1;
        arrowShuffle(valid.slice()).forEach(d=>{
          const [dr,dc] = ARROW_DIR_VEC[d];
          let rr=r+dr, cc=c+dc, dist=1, first=0, n=0;
          while(rr>=0 && rr<size && cc>=0 && cc<size){
            if(idx[rr*size+cc]>=0){ n++; if(!first) first=dist; }  // only earlier arrows can be here
            rr+=dr; cc+=dc; dist++;
          }
          const score = n ? first*2+n : 0;   // far-away first blocker + many blockers = harder to read
          if(score>bestScore){ bestScore=score; chosen=d; }
        });
      } else {
        let order = arrowShuffle(ARROW_DIRS.slice());
        // Harder levels: prefer repeating the previous arrow's direction so many
        // arrows look alike and the board is harder to read.
        if(similar && i<count-1 && arrowRand()<similar){
          const prevDir = dirs[i+1];
          order = [prevDir].concat(order.filter(d=>d!==prevDir));
        }
        chosen = order.find(d=>valid.indexOf(d)!==-1);
      }
      dirs[i] = chosen;
      present[r*size+c] = 1;
    }
    if(ok){
      return cells.map((cell,i)=>({ id:i, r:cell.r, c:cell.c, dir:dirs[i], cleared:false }));
    }
  }
  return null; // caller retries with a smaller count
}
// depth = how many "rounds" of clearing an arrow needs before it can leave
// (0 = free from the start). Ids are the clear order, so blockers always have
// a smaller id and their depth is already known.
function arrowComputeDepths(arrows, size){
  const occ = new Array(size*size).fill(-1);
  arrows.forEach((a,k)=>{ occ[a.r*size+a.c] = k; });
  let maxD = 0, sum = 0;
  arrows.forEach(a=>{
    const [dr,dc] = ARROW_DIR_VEC[a.dir];
    let rr=a.r+dr, cc=a.c+dc, d=-1;
    while(rr>=0 && rr<size && cc>=0 && cc<size){
      const j = occ[rr*size+cc];
      if(j>=0 && arrows[j].depth>d) d = arrows[j].depth;
      rr+=dr; cc+=dc;
    }
    a.depth = d+1;
    if(a.depth>maxD) maxD = a.depth;
    sum += a.depth;
  });
  return { maxD, mean: sum/arrows.length };
}
// Builds several candidate layouts (deterministic, same seeded generator) and keeps one:
// the most demanding (longest clearing chains, fewest free arrows at the start) normally, or - for the
// first few teaching levels (`easy`) - the most forgiving (many free arrows, short chains).
function arrowGenerateBest(size, count, similar, hard, tries, easy, freeW){
  if(freeW===undefined) freeW = 0.35;
  let best = null, bestScore = -Infinity;
  for(let t=0;t<tries;t++){
    const cand = arrowGenerateWithCount(size, count, similar, hard);
    if(!cand) break;
    const m = arrowComputeDepths(cand, size);
    const free0 = cand.filter(a=>a.depth===0).length;
    const score = easy ? (free0*2 - m.maxD*3 - m.mean*2)
                       : (m.maxD*1.5 + m.mean*2.5 - free0*freeW);
    if(score>bestScore){ bestScore = score; best = cand; }
  }
  return best;
}
// Difficulty curve. Everything is a pure function of the level number.
function arrowLevelProfile(levelNum){
  const L = Math.max(0, levelNum-1);
  return {
    L,
    // Every level is a COMPLETELY filled board (no empty areas). Bigger boards = more arrows to read:
    // 4x4 (L1-4) -> 5x5 (L5-14) -> 6x6 (L15-29) -> 7x7 (L30-54) -> 8x8 (L55-100).
    size:    L<4 ? 4 : L<14 ? 5 : L<29 ? 6 : L<54 ? 7 : 8,
    density: 1,
    similar: Math.min(0.6, L/120),                            // look-alike directions
    hard:    Math.min(0.97, Math.max(0, (L-2)/65)),           // misleading long-range blockers
    tries:   L<4 ? 10 : 10 + Math.min(16, Math.floor(L/4)),   // layouts compared per level
    freeW:   0.35 + L*0.02,                                   // later levels: fewer free arrows at the start
    easy:    L<4                                              // teaching levels: most forgiving layout
  };
}
function arrowGenerateLevel(levelNum){
  arrowRng = mulberry32(90001 + levelNum*7919);   // fixed seed per level => fixed content
  try{
    return arrowBuildLevelData(levelNum);
  } finally {
    arrowRng = null;
  }
}
function arrowBuildLevelData(levelNum){
  const P = arrowLevelProfile(levelNum);
  const L = P.L, size = P.size;
  const maxCount = size*size;
  let count = Math.max(4, Math.min(maxCount, Math.floor(maxCount*P.density)));
  let arrows = null;
  while(!arrows && count>=2){
    arrows = arrowGenerateBest(size, count, P.similar, P.hard, P.tries, P.easy, P.freeW);
    if(!arrows) count -= 1;
  }
  if(!arrows){ arrows = [{id:0, r:0, c:0, dir:'right', cleared:false}]; }
  arrowComputeDepths(arrows, size);

  // Hidden Alphabet Task: a real English word whose length grows 3 -> 10 across
  // the 100 levels, always capped at the number of arrows on the board.
  const desiredLen = Math.min(arrows.length, arrowWordLengthForLevel(levelNum));
  const word = arrowPickWord(Math.max(3, desiredLen), Math.max(3, desiredLen), levelNum);
  const letters = word.split('');
  // Harder levels hide the required letters on the DEEPEST arrows (the ones that
  // need the longest chains of other arrows cleared first), so more of the board
  // must be cleared before the word is complete. lateBias 0 = random spread.
  const lateBias = Math.min(0.9, L/80);
  const n1 = Math.max(1, arrows.length-1);
  const maxDepth = Math.max(1, arrows.reduce((m,a)=>Math.max(m,a.depth),0));
  const ranked = arrows.map((a,i)=>({ i, k:(1-lateBias)*arrowRand() + lateBias*(0.6*(a.depth/maxDepth) + 0.4*(i/n1)) }))
                       .sort((x,y)=>y.k-x.k).slice(0, letters.length).map(o=>o.i);
  const pickOrder = arrowShuffle(ranked);
  arrows.forEach(a=>{ a.letter=null; a.targetIndex=null; });
  pickOrder.forEach((arrIdx, wordPos)=>{
    arrows[arrIdx].letter = letters[wordPos];
    arrows[arrIdx].targetIndex = wordPos;
  });
  // Decoy tiles use letters that are NOT in the target word, so every tile that
  // shows a letter of the word is a real target tile (repeated letters such as
  // the two O's in BOOK each have their own tile and slot).
  const decoyPool = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').filter(ch=>letters.indexOf(ch)===-1);
  arrows.forEach(a=>{
    if(a.letter===null){
      a.letter = decoyPool[Math.floor(arrowRand()*decoyPool.length)];
    }
  });

  return { size, arrows, word };
}
function arrowPathClear(arrow){
  const stillPresent = arrowState.arrows.filter(a=>!a.cleared && a.id!==arrow.id).map(a=>({r:a.r,c:a.c}));
  return arrowPathClearOf(arrow.r, arrow.c, arrow.dir, arrowState.size, stillPresent);
}
// Early levels glow the free arrows to teach the rule; from level
// ARROW_GLOW_MAX_LEVEL+1 the glow is off and the player must read the paths.
// (Set ARROW_GLOW_MAX_LEVEL to 100 to bring the glow back everywhere.)
const ARROW_GLOW_MAX_LEVEL = 12;
function arrowUpdateFreeStates(){
  const glow = arrowState.level <= ARROW_GLOW_MAX_LEVEL;
  arrowState.arrows.forEach(a=>{
    if(a.cleared) return;
    const el2 = arrowState.cellEls[a.id];
    if(!el2) return;
    el2.classList.toggle('free', glow && arrowPathClear(a));
  });
}
function arrowUpdateLivesUI(){
  arrowLivesEl.textContent = '❤️'.repeat(Math.max(0,arrowState.lives)) + '🖤'.repeat(3-Math.max(0,arrowState.lives));
}
function arrowUpdateHintUI(){
  // Global hint entitlement (HintAccessManager) — same shared count as every
  // other hint button; "AD" once a rewarded ad is required.
  const avail = HintAccessManager.hintsAvailableWithoutAd();
  arrowHintCountEl.textContent = avail>0 ? '×'+avail : 'AD';
  arrowHintBtnEl.disabled = false;
}
function arrowShowToast(msg){
  if(arrowState.toastTimeoutId) clearTimeout(arrowState.toastTimeoutId);
  arrowToastEl.textContent = msg;
  arrowToastEl.classList.add('show');
  arrowState.toastTimeoutId = setTimeout(()=>arrowToastEl.classList.remove('show'), 1500);
}
function arrowShowCombo(text){
  arrowComboEl.classList.remove('show');
  void arrowComboEl.offsetWidth;
  arrowComboEl.textContent = text;
  arrowComboEl.classList.add('show');
}
function arrowSpawnSparkles(tileEl){
  for(let i=0;i<4;i++){
    const s = document.createElement('span');
    s.className = 'arrow-sparkle';
    s.textContent = ARROW_SPARKLES[Math.floor(Math.random()*ARROW_SPARKLES.length)];
    const ang = (Math.PI*2*i)/4 + Math.random()*0.5;
    s.style.setProperty('--sx', Math.round(Math.cos(ang)*22)+'px');
    s.style.setProperty('--sy', Math.round(Math.sin(ang)*22)+'px');
    tileEl.appendChild(s);
    const tid = setTimeout(()=>{ if(s.parentNode) s.parentNode.removeChild(s); }, 520);
    arrowState.pendingTimeouts.push(tid);
  }
}
function arrowRenderTaskPanel(){
  el('arrow-task-word-label').textContent = arrowState.word;
  const slotsEl = el('arrow-task-slots');
  slotsEl.innerHTML = '';
  arrowState.word.split('').forEach((ch,i)=>{
    const slot = document.createElement('div');
    slot.className = 'arrow-letter-slot';
    slot.id = 'arrow-slot-'+i;
    if(arrowState.revealed[i]){
      slot.textContent = ch;
      slot.classList.add('filled');
    }
    slotsEl.appendChild(slot);
  });
}
function arrowBuildBoard(){
  arrowGridEl.style.gridTemplateColumns = `repeat(${arrowState.size},1fr)`;
  arrowGridEl.style.gridTemplateRows = `repeat(${arrowState.size},1fr)`;
  arrowGridEl.innerHTML = '';
  arrowState.cellEls = {};
  arrowState.arrows.forEach((a,i)=>{
    const tile = document.createElement('div');
    tile.className = 'arrow-tile';
    tile.style.gridColumn = (a.c+1);
    tile.style.gridRow = (a.r+1);
    const palette = ARROW_TILE_PALETTE[i%ARROW_TILE_PALETTE.length];
    tile.style.setProperty('--tile-c1', palette[0]);
    tile.style.setProperty('--tile-c2', palette[1]);
    const letterSpan = document.createElement('span');
    letterSpan.className = 'arrow-tile-letter';
    letterSpan.textContent = a.letter || '';
    const arrowSpan = document.createElement('span');
    arrowSpan.className = 'arrow-tile-arrow';
    arrowSpan.textContent = ARROW_GLYPH[a.dir];
    tile.appendChild(letterSpan);
    tile.appendChild(arrowSpan);
    tile.addEventListener('pointerdown', ()=>arrowTap(a.id));
    arrowGridEl.appendChild(tile);
    arrowState.cellEls[a.id] = tile;
  });
  arrowUpdateFreeStates();
}
function arrowPlayExitAnimation(tileEl, arrow){
  const rect = arrowGridEl.getBoundingClientRect();
  const cellPx = rect.width / arrowState.size;
  const [dr,dc] = ARROW_DIR_VEC[arrow.dir];
  let dist = 1;
  if(dr===-1) dist = arrow.r+1;
  else if(dr===1) dist = arrowState.size-arrow.r;
  else if(dc===-1) dist = arrow.c+1;
  else if(dc===1) dist = arrowState.size-arrow.c;
  const ax = dc*(dist+0.6)*cellPx;
  const ay = dr*(dist+0.6)*cellPx;
  tileEl.style.setProperty('--ax', ax+'px');
  tileEl.style.setProperty('--ay', ay+'px');
  tileEl.classList.add('exiting');
  arrowSpawnSparkles(tileEl);
  const tid = setTimeout(()=>{
    if(tileEl.parentNode) tileEl.parentNode.removeChild(tileEl);
  }, 380);
  arrowState.pendingTimeouts.push(tid);
}
function arrowTap(id){
  if(!arrowState.active || arrowState.resolved) return;
  const arrow = arrowState.arrows.find(a=>a.id===id);
  if(!arrow || arrow.cleared) return; // already cleared / mid-exit — ignore duplicate taps
  const tileEl = arrowState.cellEls[id];
  if(arrowPathClear(arrow)){
    arrow.cleared = true; // logically clear immediately, so it stops blocking others right away
    arrowState.comboStreak++;
    const now = performance.now();
    const speedBonus = (now - arrowState.lastMoveTime) < 900 ? 5 : 0;
    arrowState.lastMoveTime = now;
    arrowState.score += 10 + speedBonus;
    pulseScoreEl(arrowScoreEl);
    arrowScoreEl.textContent = arrowState.score;
    playSound('mg-catch'); vibrate(12);
    if(arrowState.comboStreak===10) arrowShowCombo('AMAZING!');
    else if(arrowState.comboStreak===6) arrowShowCombo('GREAT!');
    else if(arrowState.comboStreak===3) arrowShowCombo('NICE!');

    // Hidden Alphabet Task: reveal this tile's letter (glow/scale, arrow
    // glyph fades away — see .arrow-tile.revealing CSS). If it's one of
    // the target word's letters, fill that exact slot in the task panel
    // (by its fixed word position, regardless of clear order) with a pop.
    tileEl.classList.add('revealing');
    if(arrow.targetIndex!==null && !arrowState.revealed[arrow.targetIndex]){
      arrowState.revealed[arrow.targetIndex] = true;
      const slotEl = el('arrow-slot-'+arrow.targetIndex);
      if(slotEl){
        slotEl.textContent = arrow.letter;
        slotEl.classList.add('filled');
        slotEl.classList.remove('pop'); void slotEl.offsetWidth; slotEl.classList.add('pop');
      }
      playSound('mg-hint');
    }

    arrowPlayExitAnimation(tileEl, arrow);
    arrowUpdateFreeStates();
    // The level is won once every required letter has been found — not
    // necessarily once every arrow is gone. A full-board-cleared check is
    // kept too as a pure safety net (by construction it can never actually
    // be needed, since target letters are always a subset of all arrows).
    const taskDone = arrowState.revealed.length>0 && arrowState.revealed.every(Boolean);
    if(taskDone || arrowState.arrows.every(a=>a.cleared)){
      arrowState.resolved = true;
      const tid = setTimeout(arrowLevelComplete, 420);
      arrowState.pendingTimeouts.push(tid);
    }
  } else {
    arrowState.comboStreak = 0;
    arrowState.lives--;
    arrowUpdateLivesUI();
    playSound('mg-bad'); vibrate(30);
    arrowShowToast('BLOCKED!');
    tileEl.classList.remove('mg-shake'); void tileEl.offsetWidth; tileEl.classList.add('mg-shake');
    if(arrowState.lives<=0){
      arrowState.resolved = true;
      const tid = setTimeout(arrowLevelFail, 320);
      arrowState.pendingTimeouts.push(tid);
    }
  }
}
// The unchanged hint behavior, run only once HintAccessManager has granted a
// hint. Returns false if it can't show one anymore so the entitlement is kept.
function arrowApplyHint(){
  if(!arrowState.active || arrowState.resolved) return false;
  const freeArrow = arrowState.arrows.find(a=>!a.cleared && arrowPathClear(a));
  if(!freeArrow) return false;
  arrowUpdateHintUI();
  playSound('mg-hint');
  const tileEl = arrowState.cellEls[freeArrow.id];
  tileEl.classList.add('hint-glow');
  const tid = setTimeout(()=>tileEl.classList.remove('hint-glow'), 1500);
  arrowState.pendingTimeouts.push(tid);
  return true;
}
function arrowUseHint(){
  if(!arrowState.active || arrowState.resolved) return;
  const freeArrow = arrowState.arrows.find(a=>!a.cleared && arrowPathClear(a));
  if(!freeArrow){ arrowShowToast('NO MOVE AVAILABLE'); return; }   // hint NOT consumed, no ad requested
  HintAccessManager.requestHint('arrow', arrowApplyHint, arrowShowToast);
}
const ARROW_PRAISE = ['Amazing Work! 🎉','Brilliant! You did it!','Fantastic Job! ⭐','Superb! Well Played!','Outstanding! Keep Going!'];
const ARROW_ENCOURAGE = ["Don't Give Up! You Can Do It!",'Every Attempt Makes You Better!','So Close! Try Again!',"Keep Going - You've Got This!"];
function arrowPickMsg(list){ return list[Math.floor(Math.random()*list.length)]; }
function arrowLevelComplete(){
  stopArrowGame();
  arrowProgress.unlocked = Math.max(arrowProgress.unlocked, arrowState.level+1);
  arrowProgress.completed[arrowState.level] = true;
  saveArrowProgress();
  playSound('levelcomplete'); vibrate([20,30,20,30,40]);
  el('arrow-complete-msg').textContent = arrowPickMsg(ARROW_PRAISE);
  showMiniGameOverlay(arrowCompleteOverlayEl);
}
function arrowLevelFail(){
  stopArrowGame();
  playSound('levelfailed'); vibrate([30,40,30]);
  el('arrow-fail-msg').textContent = arrowPickMsg(ARROW_ENCOURAGE);
  showMiniGameOverlay(arrowFailOverlayEl);
}
function arrowStartLevel(levelNum){
  arrowState.pendingTimeouts.forEach(id=>clearTimeout(id));
  arrowState.pendingTimeouts = [];
  if(arrowState.toastTimeoutId){ clearTimeout(arrowState.toastTimeoutId); arrowState.toastTimeoutId=null; }
  const gen = arrowGenerateLevel(levelNum);
  arrowState.level = levelNum;
  arrowState.size = gen.size;
  arrowState.arrows = gen.arrows;
  arrowState.word = gen.word;
  arrowState.revealed = new Array(gen.word.length).fill(false);
  arrowState.lives = 3;
  arrowState.hints = 3;
  arrowState.score = 0;
  arrowState.comboStreak = 0;
  arrowState.lastMoveTime = performance.now();
  arrowState.resolved = false;
  arrowState.active = true;
  el('arrow-level-num').textContent = levelNum;
  arrowScoreEl.textContent = '0';
  arrowUpdateLivesUI();
  arrowUpdateHintUI();
  arrowRenderTaskPanel();
  const hintTextEl = el('arrow-hint-text');
  if(hintTextEl) hintTextEl.textContent = (levelNum <= ARROW_GLOW_MAX_LEVEL)
    ? 'Tap a glowing (free) arrow to clear it!'
    : 'Tap an arrow whose path is clear!';
  // Arrow tip is now an opening pop-up (same style of pop-up as Puzzle Pop) instead of a permanent line on the board.
  const arrowOpenPopEl = el('arrow-open-popup');
  if(arrowOpenPopEl){
    arrowOpenPopEl.textContent = (levelNum <= ARROW_GLOW_MAX_LEVEL)
      ? 'Tap a glowing (free) arrow to clear it!'
      : 'Tap an arrow whose path is clear!';
    arrowOpenPopEl.classList.remove('show'); void arrowOpenPopEl.offsetWidth; arrowOpenPopEl.classList.add('show');
  }
  arrowCompleteOverlayEl.classList.add('mg-hidden');
  arrowFailOverlayEl.classList.add('mg-hidden');
  arrowComboEl.classList.remove('show');
  arrowBuildBoard();
  playEntranceAnim(arrowBoardWrapEl);
  if(levelNum === ARROW_GLOW_MAX_LEVEL+1) arrowShowToast('Free arrows no longer glow - read the paths!');
}
function stopArrowGame(){
  arrowState.active = false;
  arrowState.pendingTimeouts.forEach(id=>clearTimeout(id));
  arrowState.pendingTimeouts = [];
}
function arrowRenderLevelsGrid(){
  const gridEl = el('arrow-levels-grid');
  gridEl.innerHTML = '';
  for(let n=1; n<=ARROW_TOTAL_LEVELS; n++){
    const unlocked = n <= arrowProgress.unlocked;
    const card = document.createElement('button');
    card.className = 'level-card' + (unlocked?' unlocked':' locked') + (arrowProgress.completed[n]?' completed':'');
    if(unlocked){
      card.innerHTML = `<span class="level-card-num">${n}</span>`;
      card.addEventListener('click', ()=>{ playSound('button'); showScreen(arrowScreen); arrowStartLevel(n); });
    } else {
      card.innerHTML = `<span class="level-card-lock">🔒</span><span class="level-card-num level-card-num-locked">${n}</span>`;
      card.addEventListener('click', ()=>{ playSound('invalid'); });
    }
    gridEl.appendChild(card);
  }
}
function openArrowLevels(){
  playSound('button');
  loadArrowProgress();
  arrowRenderLevelsGrid();
  showScreen(arrowLevelsScreen);
}

