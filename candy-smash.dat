// Small candy-sparkle burst on tap for the 4 main home buttons — a handful
// of short-lived DOM nodes (auto-removed), no animation loop left running.
function spawnHomeButtonSparkle(x, y){
  const colors = ['#fff6cf','#ff9fd6','#9fe0ff','#ffe17a'];
  for(let i=0;i<7;i++){
    const p = document.createElement('div');
    p.className = 'home-btn-sparkle';
    const size = 4+Math.random()*5;
    p.style.width = size+'px'; p.style.height = size+'px';
    p.style.left = x+'px'; p.style.top = y+'px';
    p.style.background = colors[Math.floor(Math.random()*colors.length)];
    const angle = Math.random()*Math.PI*2;
    const dist = 22+Math.random()*26;
    p.style.setProperty('--hbs-pt', `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px)`);
    document.body.appendChild(p);
    setTimeout(()=>p.remove(), 520);
  }
}
document.querySelectorAll('.home-btn').forEach(btn=>{
  btn.addEventListener('pointerdown', (e)=>{
    spawnHomeButtonSparkle(e.clientX, e.clientY);
  });
});
