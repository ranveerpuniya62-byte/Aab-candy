            <span class="premium-go-row-icon">🍭</span>
            <span class="premium-go-row-label">Highest Combo</span>
            <span class="premium-go-row-value" id="go-combo">0</span>
          </div>
          <div class="premium-go-row">
            <span class="premium-go-row-icon">🌀</span>
            <span class="premium-go-row-label">Highest Streak</span>
            <span class="premium-go-row-value" id="go-streak">0</span>
          </div>
          <div class="premium-go-row">
            <span class="premium-go-row-icon">✳️</span>
            <span class="premium-go-row-label">Final Multiplier</span>
            <span class="premium-go-row-value" id="go-multiplier">1×</span>
          </div>
        </div>
        <div class="premium-go-buttons">
          <button class="premium-go-btn premium-go-btn-home" id="btn-go-home"><span class="premium-go-btn-icon">🏠</span><span>HOME</span></button>
          <button class="premium-go-btn premium-go-btn-restart" id="btn-go-restart"><span class="premium-go-btn-icon">🔄</span><span>RESTART</span></button>
        </div>
        <div class="premium-go-corner premium-go-corner-bl">🍇</div>
        <div class="premium-go-corner premium-go-corner-br">🍡</div>
      </div>
    </div>
  </div>

</div>

<script>
(function(){
"use strict";

/* ============================================================
   VIEWPORT SIZING (robust full-screen / responsive support)
   Some Android WebViews/browsers report inconsistent or stale vw/vh
   values (a common cause of a page rendering tiny and pinned to one
   corner). To make sizing bulletproof across devices, we measure the
   REAL visual viewport with JavaScript and expose it as CSS custom
   properties (--vh / --vw, each equal to 1% of the true viewport).
   CSS falls back to native vw/vh units automatically until this first
   runs, then uses these precise values everywhere after.
============================================================ */
function updateViewportUnits(){
  const vv = window.visualViewport;
  const width = (vv && vv.width) ? vv.width : window.innerWidth || document.documentElement.clientWidth;
  const height = (vv && vv.height) ? vv.height : window.innerHeight || document.documentElement.clientHeight;
  document.documentElement.style.setProperty('--vh', (height*0.01)+'px');
  document.documentElement.style.setProperty('--vw', (width*0.01)+'px');
}
updateViewportUnits();
window.addEventListener('resize', updateViewportUnits);
window.addEventListener('orientationchange', ()=>{
  updateViewportUnits();
  // Some devices report the post-rotation size a moment late.
  setTimeout(updateViewportUnits, 120);
  setTimeout(updateViewportUnits, 400);
});
if(window.visualViewport){
  window.visualViewport.addEventListener('resize', updateViewportUnits);
}

/* ============================================================
   CONSTANTS
============================================================ */
const SIZE = 8; // 8×8 board (64 cells) — all board/tray/clearing logic is driven off this constant
const THEMES = [
  {emoji:'🍬', c1:'#ff8fc7', c2:'#e14f95'},
  {emoji:'🍫', c1:'#a9764a', c2:'#6b4423'},
  {emoji:'🍩', c1:'#ffc98a', c2:'#e8873a'},
  {emoji:'🍓', c1:'#ff7a7a', c2:'#e02f3f'},
  {emoji:'🍉', c1:'#6fe08a', c2:'#1fa84f'},
  {emoji:'🍭', c1:'#c79bff', c2:'#8b4fe0'},
  {emoji:'🍪', c1:'#dcae76', c2:'#a06b34'},
  {emoji:'🧁', c1:'#ffe08a', c2:'#f2a93b'}
];

// ============================================================
// CLASSIC MODE — EXTRA CANDY VARIETY (Step 1)
// 20 additional candy "flavors" layered on top of THEMES above,
// using the exact same {emoji, c1, c2} shape THEMES already uses.
// Rendering (gradient background + emoji glyph + the existing glossy
// .cell/.filled CSS — rounded corners, inset highlight/shadow, etc.)
// is entirely reused, so every one of these automatically gets the
// same "glossy, rounded, 3D, premium candy" look as the original 8,
// on every existing piece shape, at every screen size — nothing new
// to build there.
// IMPORTANT: this pool is additive and Classic-only (see CLASSIC_THEMES
// and makeSmartClassicPiece below). THEMES itself is left completely
// untouched, so Blast Journey (which reads THEMES/CANDY_TYPE_MAP
// directly) is unaffected.
//
// STEP 9 — CENTRAL CANDY DEFINITIONS: this array is the single source of
// truth for every one of the 20 Classic-only candies. Every field a
// system anywhere in the game needs (id, internal debug name, emoji
// glyph, gradient colours, and now which clear-pop "material" group it
// belongs to — see Step 7) lives here, on the one object, so nothing
// downstream (piece generation, rendering, dragging, clearing, the Step 7
// animation system) ever hard-codes its own separate copy of this data.
// `name` is for code/debug purposes only (console warnings, comments) —
// never rendered on the actual gameplay board (see point 6 of Step 9).
// `material` feeds the Step 7 clear-pop system (classicCandyMaterialGroup
// below now simply reads it from here instead of its own switch/case) —
// candies with no special material (the plain fruit types) simply omit
// the field and fall back to the existing generic clear-pop, unchanged.
// ============================================================
const CLASSIC_EXTRA_THEMES = [
  // STEP 10: `material` added on each of these (previously only the 6
  // candies further below carried one) purely so the clear-pop/particle
  // effect matches that candy's own identity — see classicCandyMaterialGroup.
  // Colours, emoji, ids and everything else are untouched.
  {id:'strawberry', name:'Strawberry Candy', emoji:'🍓', c1:'#ff9a9e', c2:'#e0324f', material:'glossy'},
  {id:'cherry',     name:'Cherry Candy',     emoji:'🍒', c1:'#ff5f6d', c2:'#b0163a', material:'fragment'},
  {id:'orange',     name:'Orange Candy',     emoji:'🍊', c1:'#ffb347', c2:'#e6790c', material:'sparkle'},
  {id:'lemon',      name:'Lemon Candy',      emoji:'🍋', c1:'#fff176', c2:'#e0c400', material:'sparkle'},
  {id:'apple',      name:'Apple Candy',      emoji:'🍎', c1:'#ff6b6b', c2:'#c1121f', material:'glossy'},
  {id:'blueberry',  name:'Blueberry Candy',  emoji:'🫐', c1:'#7aa6ff', c2:'#33418f', material:'fragment'},
  {id:'grape',      name:'Grape Candy',      emoji:'🍇', c1:'#c48bff', c2:'#6a2fb0', material:'fragment'},
  {id:'watermelon2',name:'Watermelon Candy', emoji:'🍉', c1:'#8ef2a0', c2:'#1f9e4c', material:'fragment'},
  {id:'pineapple',  name:'Pineapple Candy',  emoji:'🍍', c1:'#ffe985', c2:'#e0a400', material:'fragment'},
  {id:'kiwi',       name:'Kiwi Candy',       emoji:'🥝', c1:'#c6e26b', c2:'#5a8a1f', material:'sparkle'},
  {id:'peach',      name:'Peach Candy',      emoji:'🍑', c1:'#ffc1a1', c2:'#f0703a', material:'fragment'},
  {id:'lollipop2',  name:'Lollipop Candy',   emoji:'🍭', c1:'#ff9ad6', c2:'#d63aa0', material:'sparkle'},
  // Rainbow Candy (Classic-only cosmetic; unrelated to Journey's
  // rainbow-collectible mechanic, which is keyed off rainbowCells, not
  // this emoji).
  {id:'rainbow2',   name:'Rainbow Candy',    emoji:'🌈', c1:'#ffd1ff', c2:'#7ad6ff', material:'rainbow'},
  {id:'hard',       name:'Hard Candy',       emoji:'🍬', c1:'#ffffff', c2:'#ff4d6d', material:'shard'},
  {id:'chocolate2', name:'Chocolate Candy',  emoji:'🍫', c1:'#c48a52', c2:'#5c3a1e', material:'choc'},
  {id:'jelly',      name:'Jelly Candy',      emoji:'🍮', c1:'#ffe29a', c2:'#e08a3c', material:'soft'},
  {id:'gummy',      name:'Gummy Candy',      emoji:'🐻', c1:'#ff9f43', c2:'#c25a00', material:'soft'},
  // Swirl Candy — mint/teal (was near-duplicate pink of Lollipop, see STEP 6)
  {id:'swirl',      name:'Swirl Candy',      emoji:'🍥', c1:'#d5fff5', c2:'#2bb8a0', material:'sparkle'},
  {id:'star',       name:'Star Candy',       emoji:'⭐', c1:'#fff59d', c2:'#f2b400', material:'star'},
  {id:'crystal',    name:'Crystal Candy',    emoji:'💎', c1:'#b3f5ff', c2:'#3fc6e0', material:'shard'}
];

// ============================================================
// CLASSIC MODE — PREMIUM CANDY GRAPHICS (Step 2)
// One small inline-SVG "art" function per id above. Each draws a
// unique, recognizable silhouette (not a plain circle/emoji) using the
// piece's own c1/c2 colors for a glossy radial gradient body, plus a
// tiny highlight + soft drop shadow for depth. Pure vector shapes —
// no images, no continuous animation, so this stays cheap even with a
// full 8x8 board of these on screen. Classic-only: Blast Journey keeps
// rendering the original 8 THEMES via plain emoji (see refreshCellVisual
// and buildPieceGrid below — both only look this up when a candyId is
// present, and only these 20 extra themes ever carry one).
// ============================================================
let _candyGradSeq = 0;
const CANDY_ART = {
  // STRAWBERRY - Glossy fruit with realistic seeds
  // ============================================================
  strawberry:(g)=>`
    <defs>
      <radialGradient id="${g}sh" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.78"/><stop offset="30%" stop-color="#fff" stop-opacity="0.252"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="${g}stem" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#5aad5e"/><stop offset="100%" stop-color="#3a7d3e"/>
      </linearGradient>
      <linearGradient id="${g}depth" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fff" stop-opacity=".35"/><stop offset="50%" stop-color="#fff" stop-opacity="0"/><stop offset="100%" stop-color="#000" stop-opacity=".25"/>
      </linearGradient>
    </defs>
    <g id="${g}berry">
      <ellipse cx="50" cy="33" rx="16" ry="9" fill="#5aad5e" opacity=".9"/>
      <polygon points="50,30 52,26 48,26" fill="#3a7d3e"/>
      <ellipse cx="50" cy="33" rx="15" ry="8" fill="#5aad5e"/>
      <path d="M50 29 C72 29 82 50 72 80 C65 90 35 90 28 80 C18 50 28 29 50 29 Z" fill="url(#${g})" stroke="none"/>
      <path d="M50 29 C72 29 82 50 72 80 C65 90 35 90 28 80 C18 50 28 29 50 29 Z" fill="url(#${g}depth)" stroke="none"/>
      <g fill="#f4d76e" opacity=".75">
        <circle cx="42" cy="48" r="1.8"/><circle cx="58" cy="48" r="1.8"/><circle cx="50" cy="60" r="1.8"/><circle cx="40" cy="65" r="1.6"/><circle cx="60" cy="65" r="1.6"/><circle cx="48" cy="73" r="1.5"/><circle cx="52" cy="73" r="1.5"/>
      </g>
      <ellipse cx="41" cy="46" rx="9" ry="5.5" fill="#fff" opacity=".34" transform="rotate(-28 41 46)"/>
      <circle cx="33" cy="35" r="3.2" fill="#fff" opacity=".88"/>
    </g>`,
    
  // ============================================================
  // CHERRY - Dual glossy cherries with stem
  // ============================================================
  cherry:(g)=>`
    <defs>
      <linearGradient id="${g}stem" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#5a8a3a"/><stop offset="100%" stop-color="#3a5a1a"/>
      </linearGradient>
      <linearGradient id="${g}cherry" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ff6b8a"/><stop offset="50%" stop-color="#ff4d6d"/><stop offset="100%" stop-color="#d63a5c"/>
      </linearGradient>
      <radialGradient id="${g}light" cx="35%" cy="30%" r="50%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.73"/><stop offset="30%" stop-color="#fff" stop-opacity="0.231"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <path d="M50 18 L56 35" stroke="url(#${g}stem)" stroke-width="3" stroke-linecap="round" fill="none" opacity=".85"/>
    <path d="M56 35 L64 20" stroke="url(#${g}stem)" stroke-width="3" stroke-linecap="round" fill="none" opacity=".85"/>
    <circle cx="39" cy="62" r="20" fill="url(#${g}cherry)" stroke="#c63a4c" stroke-width=".8" opacity=".95"/>
    <circle cx="65" cy="62" r="20" fill="url(#${g}cherry)" stroke="#c63a4c" stroke-width=".8" opacity=".95"/>
    <circle cx="39" cy="62" r="20" fill="url(#${g}light)"/>
    <circle cx="65" cy="62" r="20" fill="url(#${g}light)"/>
    <ellipse cx="32" cy="54" rx="7" ry="4" fill="#fff" opacity=".48"/>
    <ellipse cx="58" cy="54" rx="7" ry="4" fill="#fff" opacity=".48"/>
    <circle cx="29" cy="51" r="2.2" fill="#fff" opacity=".88"/>
    <circle cx="55" cy="51" r="2.2" fill="#fff" opacity=".88"/>`,
    
  // ============================================================
  // ORANGE - Sphere with peel texture
  // ============================================================
  orange:(g)=>`
    <defs>
      <radialGradient id="${g}grad" cx="35%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#ffcc88"/><stop offset="40%" stop-color="#ffb347"/><stop offset="100%" stop-color="#e6790c"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="32%" cy="28%" r="45%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.68"/><stop offset="30%" stop-color="#fff" stop-opacity="0.21"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <circle cx="50" cy="52" r="34" fill="url(#${g}grad)" stroke="#d66b00" stroke-width=".9" opacity=".92"/>
    <circle cx="50" cy="52" r="34" fill="url(#${g}shine)"/>
    <g stroke="#e0a422" stroke-width="1.2" stroke-opacity=".35" stroke-linecap="round">
      <line x1="50" y1="19" x2="50" y2="85"/><line x1="19" y1="52" x2="81" y2="52"/>
      <line x1="27" y1="29" x2="73" y2="75"/><line x1="73" y1="29" x2="27" y2="75"/>
    </g>
    <g fill="#c25a0a" opacity=".08">
      <circle cx="44" cy="60" r="1.3"/><circle cx="61" cy="47" r="1.2"/><circle cx="55" cy="68" r="1.1"/><circle cx="37" cy="46" r="1.1"/><circle cx="68" cy="55" r="1.2"/>
    </g>
    <ellipse cx="36" cy="36" rx="11" ry="6" fill="#fff" opacity=".44"/>
    <circle cx="31" cy="32" r="2.8" fill="#fff" opacity=".87"/>`,
    
  // ============================================================
  // LEMON - Teardrop citrus shape
  // ============================================================
  lemon:(g)=>`
    <defs>
      <radialGradient id="${g}body" cx="50%" cy="55%" r="55%">
        <stop offset="0%" stop-color="#fffba0"/><stop offset="50%" stop-color="#fff176"/><stop offset="100%" stop-color="#e0c400"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="35%" cy="30%" r="45%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.66"/><stop offset="30%" stop-color="#fff" stop-opacity="0.202"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <path d="M17 52 C17 32 34 18 50 18 C66 18 83 32 83 52 C83 72 66 85 50 85 C34 85 17 72 17 52 Z" fill="url(#${g}body)" stroke="#d4a500" stroke-width=".9"/>
    <path d="M17 52 C17 32 34 18 50 18 C66 18 83 32 83 52 C83 72 66 85 50 85 C34 85 17 72 17 52 Z" fill="url(#${g}shine)"/>
    <path d="M17 52 C12 50 10 48 8 46" stroke="#d4a500" stroke-width="2.8" stroke-linecap="round" fill="none" opacity=".75"/>
    <path d="M83 52 C88 50 90 48 92 46" stroke="#d4a500" stroke-width="2.8" stroke-linecap="round" fill="none" opacity=".75"/>
    <g fill="#d4a500" opacity=".06"><circle cx="44" cy="58" r="1.2"/><circle cx="60" cy="48" r="1.1"/><circle cx="50" cy="70" r="1"/></g>
    <ellipse cx="36" cy="35" rx="11" ry="7" fill="#fff" opacity=".42"/>
    <circle cx="31" cy="32" r="2.5" fill="#fff" opacity=".86"/>`,
    
  // ============================================================
  // APPLE - Glossy apple with leaf and stem
  // ============================================================
  apple:(g)=>`
    <defs>
      <radialGradient id="${g}body" cx="45%" cy="45%" r="60%">
        <stop offset="0%" stop-color="#ff8a8a"/><stop offset="50%" stop-color="#ff6b6b"/><stop offset="100%" stop-color="#c1121f"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="32%" cy="28%" r="50%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.68"/><stop offset="30%" stop-color="#fff" stop-opacity="0.21"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <path d="M50 30 C69 26 83 40 81 58 C79 76 65 87 50 87 C35 87 21 76 19 58 C17 40 31 26 50 30 Z" fill="url(#${g}body)" stroke="#a00a1a" stroke-width=".8"/>
    <path d="M50 30 C69 26 83 40 81 58 C79 76 65 87 50 87 C35 87 21 76 19 58 C17 40 31 26 50 30 Z" fill="url(#${g}shine)"/>
    <path d="M50 30 C48 23 50 16 57 14" stroke="#6a3a1a" stroke-width="2.5" fill="none" stroke-linecap="round" opacity=".88"/>
    <path d="M57 16 C63 12 69 17 67 24 C63 26 59 24 57 16 Z" fill="#4aae56" opacity=".88"/>
    <g fill="#8a0a1a" opacity=".08"><circle cx="56" cy="70" r="1.3"/><circle cx="63" cy="60" r="1.1"/></g>
    <ellipse cx="37" cy="45" rx="11" ry="7" fill="#fff" opacity=".44"/>
    <circle cx="32" cy="42" r="2.7" fill="#fff" opacity=".87"/>`,
    
  // ============================================================
  // BLUEBERRY - Sphere with bloom
  // ============================================================
  blueberry:(g)=>`
    <defs>
      <radialGradient id="${g}berry" cx="40%" cy="40%" r="60%">
        <stop offset="0%" stop-color="#8ac5ff"/><stop offset="50%" stop-color="#7aa6ff"/><stop offset="100%" stop-color="#33418f"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="35%" cy="28%" r="48%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.68"/><stop offset="30%" stop-color="#fff" stop-opacity="0.21"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <circle cx="50" cy="55" r="30" fill="url(#${g}berry)" stroke="#22308f" stroke-width=".7"/>
    <circle cx="50" cy="55" r="30" fill="url(#${g}shine)"/>
    <g stroke="#1a2a6a" stroke-width="2" stroke-linecap="round" opacity=".7">
      <line x1="50" y1="25" x2="50" y2="32"/><line x1="44" y1="26" x2="47" y2="33"/><line x1="56" y1="26" x2="53" y2="33"/>
    </g>
    <g fill="#e8f0ff" opacity=".15"><circle cx="55" cy="60" r="1.3"/><circle cx="45" cy="65" r="1.1"/></g>
    <ellipse cx="38" cy="41" rx="9" ry="5" fill="#fff" opacity=".4"/>
    <circle cx="34" cy="38" r="2.3" fill="#fff" opacity=".86"/>`,
    
  // ============================================================
  // GRAPE - Triple cluster
  // ============================================================
  grape:(g)=>`
    <defs>
      <radialGradient id="${g}grape" cx="38%" cy="35%" r="55%">
        <stop offset="0%" stop-color="#d8a5ff"/><stop offset="50%" stop-color="#c48bff"/><stop offset="100%" stop-color="#6a2fb0"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="35%" cy="25%" r="50%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.66"/><stop offset="30%" stop-color="#fff" stop-opacity="0.202"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <circle cx="39" cy="42" r="16" fill="url(#${g}grape)" stroke="#5a1fa0" stroke-width=".7"/>
    <circle cx="61" cy="42" r="16" fill="url(#${g}grape)" stroke="#5a1fa0" stroke-width=".7"/>
    <circle cx="50" cy="65" r="16" fill="url(#${g}grape)" stroke="#5a1fa0" stroke-width=".7"/>
    <circle cx="39" cy="42" r="16" fill="url(#${g}shine)"/>
    <circle cx="61" cy="42" r="16" fill="url(#${g}shine)"/>
    <circle cx="50" cy="65" r="16" fill="url(#${g}shine)"/>
    <ellipse cx="33" cy="35" rx="6" ry="3.5" fill="#fff" opacity=".42"/>
    <circle cx="30" cy="33" r="2" fill="#fff" opacity=".85"/>
    <ellipse cx="56" cy="57" rx="5" ry="3" fill="#fff" opacity=".35"/>`,
    
  // ============================================================
  // WATERMELON - Melon with slice
  // ============================================================
  watermelon2:(g)=>`
    <defs>
      <radialGradient id="${g}rind" cx="50%" cy="50%" r="55%">
        <stop offset="0%" stop-color="#98ff98"/><stop offset="70%" stop-color="#8ef2a0"/><stop offset="100%" stop-color="#1f9e4c"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="35%" cy="30%" r="48%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.63"/><stop offset="30%" stop-color="#fff" stop-opacity="0.189"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <circle cx="50" cy="52" r="35" fill="url(#${g}rind)" stroke="#0f6e2c" stroke-width=".9"/>
    <circle cx="50" cy="52" r="35" fill="url(#${g}shine)"/>
    <circle cx="50" cy="52" r="25" fill="#ff6b6b" opacity=".8"/>
    <g stroke="#fff" stroke-opacity=".4" stroke-width="1.5">
      <line x1="50" y1="52" x2="75" y2="52"/><line x1="50" y1="52" x2="50" y2="77"/><line x1="50" y1="52" x2="65" y2="67"/>
    </g>
    <g fill="#2a8a4a" opacity=".1"><circle cx="45" cy="58" r="1.1"/><circle cx="60" cy="46" r="1"/></g>
    <ellipse cx="40" cy="38" rx="12" ry="7" fill="#fff" opacity=".4"/>
    <circle cx="35" cy="35" r="2.8" fill="#fff" opacity=".85"/>`,
    
  // ============================================================
  // PINEAPPLE - Textured fruit with crown
  // ============================================================
  pineapple:(g)=>`
    <defs>
      <radialGradient id="${g}body" cx="45%" cy="50%" r="58%">
        <stop offset="0%" stop-color="#fef5a8"/><stop offset="50%" stop-color="#ffe985"/><stop offset="100%" stop-color="#e0a400"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="32%" cy="28%" r="48%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.66"/><stop offset="30%" stop-color="#fff" stop-opacity="0.202"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <g id="${g}crown">
      <path d="M38 20 L42 12 L46 18 L50 10 L54 18 L58 12 L62 20" stroke="#4aae56" stroke-width="1.8" stroke-linecap="round" fill="none" opacity=".85"/>
      <polygon points="45,20 50,15 55,20" fill="#4aae56" opacity=".7"/>
    </g>
    <ellipse cx="50" cy="65" rx="28" ry="32" fill="url(#${g}body)" stroke="#d48a00" stroke-width=".8"/>
    <ellipse cx="50" cy="65" rx="28" ry="32" fill="url(#${g}shine)"/>
    <g stroke="#d48a00" stroke-width="1.1" stroke-opacity=".25" stroke-linecap="round">
      <line x1="30" y1="48" x2="70" y2="48"/><line x1="28" y1="65" x2="72" y2="65"/><line x1="30" y1="82" x2="70" y2="82"/>
      <line x1="32" y1="40" x2="68" y2="90"/><line x1="68" y1="40" x2="32" y2="90"/>
    </g>
    <ellipse cx="38" cy="45" rx="10" ry="6" fill="#fff" opacity=".4"/>
    <circle cx="34" cy="42" r="2.5" fill="#fff" opacity=".84"/>`,
    
  // ============================================================
  // KIWI - Fruit with seed pattern
  // ============================================================
  kiwi:(g)=>`
    <defs>
      <radialGradient id="${g}fruit" cx="50%" cy="55%" r="58%">
        <stop offset="0%" stop-color="#d6e66b"/><stop offset="50%" stop-color="#c6e26b"/><stop offset="100%" stop-color="#5a8a1f"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="35%" cy="30%" r="48%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.63"/><stop offset="30%" stop-color="#fff" stop-opacity="0.189"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
