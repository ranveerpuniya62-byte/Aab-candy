        <button class="btn-hint" id="btn-arrow-hint"><svg viewBox="0 0 24 24" fill="#ffd45e" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/><path d="M9.5 19h5M10.5 21.5h3" fill="none"/></svg> HINT <span id="arrow-hint-count">×3</span></button>
      </div>
      <div id="arrow-toast"></div>
    </div>
  </div>

  <!-- SETTINGS SCREEN -->
  <div id="settings-screen" class="screen">
    <div class="settings-title">SETTINGS</div>
    <div class="settings-list">
      <div class="setting-row">
        <div class="s-label">🔊 Sound</div>
