/* ============================================================
   SPLASH SCREEN
============================================================ */
function spawnSplashParticles(){
  const container = el('splash-particles');
  const count = 14;
  for(let i=0;i<count;i++){
    const p = document.createElement('div');
    p.className='splash-particle';
    const size = 3 + Math.random()*5;
    p.style.width = size+'px';
    p.style.height = size+'px';
    p.style.left = (Math.random()*100)+'%';
    p.style.top = (Math.random()*100)+'%';
    p.style.animationDelay = (Math.random()*3.6)+'s';
    p.style.animationDuration = (2.8+Math.random()*2)+'s';
    container.appendChild(p);
  }
}
function runSplashScreen(){
  const splash = el('splash-screen');
  spawnSplashParticles();
  // Tech Arena Studio intro VIDEO. The splash is still dismissed exactly the way it
  // always was (add .splash-hide, then display:none after the 480ms fade), so the
  // home banner / launch summary / privacy overlay, which watch that state, are unaffected.
  const vid = el('splash-video');
  // The Privacy Policy no longer holds the splash: it is shown on the home screen afterwards,
  // so the splash always leaves by itself when the video ends.
  const accepted = true;
  let done = false;
  function hideSplash(){
    if(done) return; done = true;
    splash.classList.add('splash-hide');
    try{ if(window.AndroidIntro && AndroidIntro.pageReady) AndroidIntro.pageReady(); }catch(e){}
    try{ if(window.AndroidConsent && AndroidConsent.splashDone) AndroidConsent.splashDone(); }catch(e){}
    setTimeout(()=>{ splash.style.display = 'none'; }, 480);
  }
  if(vid && vid.__native){
    // Native intro: leave the splash exactly when Android reports the video has finished.
    const nativeEnded = ()=>{ hideSplash(); };
    window.__introEnded = nativeEnded;
    try{ if(window.AndroidIntro && AndroidIntro.ended()){ nativeEnded(); return; } }catch(e){}
    const iv = setInterval(()=>{
      let e = false;
      try{ e = !!(window.AndroidIntro && AndroidIntro.ended()); }catch(x){ e = true; }
      if(e){ clearInterval(iv); nativeEnded(); }
    }, 150);
    setTimeout(()=>{ clearInterval(iv); nativeEnded(); }, 12000);
    return;
  }
  if(!vid){ if(accepted) setTimeout(hideSplash, 1520); return; }
  // Stop the intro's sound the moment the splash goes away by ANY route
  // (video finished, or the privacy "accept" path hiding it).
  try{
    new MutationObserver(()=>{
      if(splash.classList.contains('splash-hide') || splash.style.display === 'none'){ try{ vid.pause(); }catch(e){} }
    }).observe(splash, { attributes:true, attributeFilter:['class','style'] });
  }catch(e){}
  vid.addEventListener('ended', ()=>{ hideSplash(); });
  vid.addEventListener('error', ()=>{ if(accepted) setTimeout(hideSplash, 800); });
  // The video now starts before this code runs, so it may already be over (or have failed).
  if(vid.ended) hideSplash();
  else if(vid.error) setTimeout(hideSplash, 800);
  // Safety net: never trap the player on the splash if the video stalls.
  if(accepted) setTimeout(hideSplash, 7000);
  // Play with sound; if the WebView/browser blocks sound-autoplay, retry muted.
  try{
    if(!vid.__earlyStarted){ vid.currentTime = parseFloat(vid.getAttribute('data-start')) || 0; }
    const p = vid.play();   // no-op when the early start is already playing
    if(p && p.catch){
      p.catch((err)=>{
        // Only a genuine autoplay block mutes the intro; other errors keep the sound and are
        // handled by the early sound-first retry above.
        if(err && err.name && err.name !== 'NotAllowedError'){ return; }
        vid.muted = true; if(vid.__armUnmute) vid.__armUnmute();
        const p2 = vid.play();
        if(p2 && p2.catch) p2.catch(()=>{ if(accepted) setTimeout(hideSplash, 1500); });
      });
    }
  }catch(e){ if(accepted) setTimeout(hideSplash, 1500); }
}

/* ============================================================
   INIT
============================================================ */
function init(){
  // Loading saved data is wrapped so that even if something unexpected
  // fails here (e.g. localStorage blocked by the browser/app the game is
  // opened in), the splash screen still dismisses and the home screen
  // still becomes interactive — instead of the whole game silently
  // freezing on the splash screen with no buttons responding.
  try{
    initCandyTypeMap();
    loadSettings();
    loadIceStackSettings();
    best = loadBest();
    loadJourneyProgress();
    updateScoreUI();
    renderSettingsUI();
  }catch(e){}
  showScreen(homeScreen);
  runSplashScreen();
}
// Keep every hint button's label in sync with the single global hint count.
HintAccessManager.subscribe(updateHintUI);
HintAccessManager.subscribe(arrowUpdateHintUI);
init();

})();
</script>

<script id="candyblast-privacy-js">
(function(){
  'use strict';

  var KEY = 'candyBlastPrivacyAccepted_v1';
  var overlay = document.getElementById('privacy-consent-overlay');
  var checkbox = document.getElementById('cb-privacy-checkbox');
  var accept = document.getElementById('cb-privacy-accept');
  var splash = document.getElementById('splash-screen');

  // true  = the Privacy Policy page appears 2s after the HOME screen opens on EVERY app launch
  //         (so it can always be seen/tested, even after it was accepted before).
  // false = it appears only until the player accepts it once (normal first-launch behaviour).
  // Set this to false before the final Play Store release build.
  var SHOW_EVERY_LAUNCH = false;

  // The acceptance is stored in TWO places (localStorage + a long-lived cookie) so that if one
  // of them is cleared or unavailable in the WebView, the other still remembers it and the
  // Privacy Policy does not come back. If only one has it, it is copied to the other.
  function readLS(){
    try { return localStorage.getItem(KEY) === 'yes'; } catch(e){ return false; }
  }
  function readCookie(){
    try { return document.cookie.indexOf(KEY + '=yes') !== -1; } catch(e){ return false; }
  }
  function writeLS(){
    try { localStorage.setItem(KEY, 'yes'); } catch(e) {}
  }
  function writeCookie(){
    try { document.cookie = KEY + '=yes; max-age=315360000; path=/; SameSite=Lax'; } catch(e) {}
  }

  function isAccepted(){
    var a = readLS(), b = readCookie();
    if(a && !b) writeCookie();
    else if(b && !a) writeLS();
    return a || b;
  }

  function markAccepted(){
    writeLS();
    writeCookie();
  }

  function closeConsentAndContinue(){
    markAccepted();
    if(overlay) overlay.classList.remove('cb-show', 'cb-wait');
  }

  function showConsent(){
    if(overlay) overlay.classList.add('cb-show');
    if(checkbox) checkbox.focus();
  }

  if(checkbox){
    checkbox.addEventListener('change', function(){
      if(accept) accept.disabled = !checkbox.checked;
    });
  }

  if(accept){
    accept.addEventListener('click', function(){
      if(!checkbox || !checkbox.checked) return;
      closeConsentAndContinue();
    });
  }

  window.CandyBlastPrivacy = Object.freeze({
    isAccepted: isAccepted,
    show: showConsent
  });

  // First launch: the Privacy Policy is no longer part of the splash. The splash plays and
  // leaves on its own; the policy then appears over the HOME screen 2 seconds later.
  // Until it is shown (and until accepted) the overlay keeps its cb-show class so the
  // existing ad-banner / launch-summary gates behave exactly as before.
  if(SHOW_EVERY_LAUNCH || !isAccepted()){
    if(overlay) overlay.classList.add('cb-show', 'cb-wait');
    var revealed = false;
    var reveal = function(){
      if(revealed) return; revealed = true;
      setTimeout(function(){
        if(!SHOW_EVERY_LAUNCH && isAccepted()) return;
        if(overlay) overlay.classList.remove('cb-wait');
        if(checkbox) checkbox.focus({ preventScroll:true });   // keep the policy opened at its title
      }, 2000);
    };
    if(!splash || splash.style.display === 'none'){ reveal(); }
    else {
      var mo = new MutationObserver(function(){
        if(splash.style.display === 'none'){ mo.disconnect(); reveal(); }
      });
      mo.observe(splash, { attributes:true, attributeFilter:['style'] });
      // Safety net: if the splash never reports being gone, the policy still appears
      // (the splash itself force-hides after 7s, so this only matters if that ever fails).
      setTimeout(function(){ mo.disconnect(); reveal(); }, 10000);
    }
  }
})();
</script>


<script id="candyblast-ump-js">
(function(){
  'use strict';
  // Bridge to the native Google UMP consent flow (see ConsentManager.kt).
  // Native exposes a JavascriptInterface "AndroidConsent":
  //   canRequestAds(): boolean, isPrivacyOptionsRequired(): boolean, showPrivacyOptions()
  // and calls window.CandyBlastConsent.update() after the consent flow finishes.
  var btn = document.getElementById('btn-ad-privacy');
  function native(){ return window.AndroidConsent || null; }
  function refresh(){
    var n = native(), need = false;
    try{ need = !!(n && typeof n.isPrivacyOptionsRequired === 'function' && n.isPrivacyOptionsRequired()); }catch(e){}
    if(btn) btn.style.display = need ? '' : 'none';
  }
  if(btn){
    btn.addEventListener('click', function(){
      var n = native();
      try{ if(n && typeof n.showPrivacyOptions === 'function') n.showPrivacyOptions(); }catch(e){}
    });
  }
  window.CandyBlastConsent = Object.freeze({ update: function(){ refresh(); try{ window.HomeBannerController.sync(); }catch(e){} } });
  refresh();
})();
</script>

<script id="candyblast-banner-js">
(function(){
  'use strict';
  // Home-screen banner: shown ONLY on the Home screen, only after the privacy
  // acknowledgement is done and only when consent allows ads. Hidden everywhere else.
  // Native exposes a JavascriptInterface "AndroidBanner":
  //   showBanner(String adUnitId), hideBanner()
  var shown = false;
  function wanted(){
    var home = document.getElementById('home-screen');
    if(!home || !home.classList.contains('active')) return false;
    var ov = document.getElementById('privacy-consent-overlay');
    if(ov && ov.classList.contains('cb-show')) return false;
    var sp = document.getElementById('splash-screen');
    if(sp && sp.style.display !== 'none' && !sp.classList.contains('splash-hide')) return false;
    try{
      var c = window.AndroidConsent;
      if(c && typeof c.canRequestAds === 'function' && !c.canRequestAds()) return false;
    }catch(e){ return false; }
    return !!(window.AdConfig && window.AdConfig.getUnitId('homeScreen'));
  }
  function sync(){
    var n = window.AndroidBanner;
    if(!n) return;
    var want = wanted();
    if(want === shown) return;
    try{
      if(want){ n.showBanner(String(window.AdConfig.getUnitId('homeScreen'))); }
      else { n.hideBanner(); }
      shown = want;
    }catch(e){}
  }
  window.HomeBannerController = Object.freeze({ sync: sync });
  setInterval(sync, 1000);   // cheap: only talks to native when the wanted state changes
  sync();
})();
</script>

<script id="candyblast-arrow-skin-js">
(function(){
  'use strict';
  /* ARROW PUZZLE — presentation-only skin. This script never reads or writes any
     game state, never calls game functions, and never touches ads/hints. It only
     (1) tags each arrow tile with its direction so CSS can draw the navy 3D arrow, and
     (2) swaps the emoji hearts in the LIVES box for SVG hearts. It reacts to DOM
     changes made by the unmodified game code. If it is removed, the old emoji show. */
  var GLYPH_DIR = { '\u2B06':'up', '\u2B07':'down', '\u2B05':'left', '\u27A1':'right' };

  var grid = document.getElementById('arrow-grid');
  function tagTiles(){
    if(!grid) return;
    var tiles = grid.querySelectorAll('.arrow-tile');
    for(var i=0;i<tiles.length;i++){
      var t = tiles[i];
      if(t.getAttribute('data-dir')) continue;
      var a = t.querySelector('.arrow-tile-arrow');
      if(!a) continue;
      var d = GLYPH_DIR[(a.textContent || '').charAt(0)];
      if(d) t.setAttribute('data-dir', d);
    }
  }
  if(grid){
    new MutationObserver(tagTiles).observe(grid, { childList:true });
    tagTiles();
  }

  var lives = document.getElementById('arrow-lives');
  var HEART = 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z';
  function heartSVG(on){
    return '<svg class="ap-heart ' + (on ? 'on' : 'off') + '" viewBox="0 0 24 24" aria-hidden="true"><path d="' + HEART + '"/>' +
      (on ? '<path d="M6.6 6.6c.9-.9 2.3-1 3.2-.2" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="1.5" stroke-linecap="round"/>' : '') +
      '</svg>';
  }
  function skinLives(){
    if(!lives) return;
    var txt = lives.textContent || '';
    if(!txt.trim() && lives.querySelector('.ap-heart')) return;   // already skinned
    var n = (txt.match(/\u2764/g) || []).length;
    var h = '';
    for(var i=0;i<3;i++) h += heartSVG(i < n);
    lives.innerHTML = h;
    lives.setAttribute('aria-label', n + ' lives');
  }
  if(lives){
    new MutationObserver(skinLives).observe(lives, { childList:true, characterData:true, subtree:true });
    skinLives();
  }
})();
</script>


<script id="candyblast-water-js">
/* Donut Catch / Donut Levels water effects — visual only. Reads item positions
   (x, y, bad) but never writes to game state. Foam texture is pre-rendered once
   per canvas size, so each frame is a handful of drawImage calls + a few strokes
   per donut. */
(function(){
  'use strict';
  var foam = null, key = '', maskG = null;
  function rng(seed){ var s = seed; return function(){ s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; }; }
  function build(w, h, dpr){
    var layers = [];
    for(var L = 0; L < 2; L++){
      var c = document.createElement('canvas');
      c.width = Math.round(w * dpr); c.height = Math.round(h * dpr);
      var g = c.getContext('2d'); g.scale(dpr, dpr); g.lineCap = 'round';
      g.shadowColor = 'rgba(255,255,255,0.9)'; g.shadowBlur = 3;     // soft, foamy edges
      var r = rng(4321 + L * 977), n = L === 0 ? 78 : 52;
      for(var i = 0; i < n; i++){
        var u = r(), x;
        if(u < 0.46) x = w * (0.01 + r() * 0.22);          // splashing along the left bank
        else if(u < 0.92) x = w * (0.77 + r() * 0.22);     // splashing along the right bank
        else x = w * (0.25 + r() * 0.5);                   // a few lighter crests mid-stream
        var edge = (x < w * 0.26 || x > w * 0.74);
        var y = r() * h;
        var len = edge ? 9 + r() * 24 : 7 + r() * 14;      // short wave crests, not long lines
        var wid = edge ? 1.6 + r() * 3.2 : 1.2 + r() * 1.8;
        var a = edge ? 0.30 + r() * 0.38 : 0.14 + r() * 0.16;
        var tilt = (r() - 0.5) * 1.1, bend = (r() - 0.5) * len * 1.3;
        for(var o = -1; o <= 1; o++){                      // wrap vertically => seamless scrolling
          var yy = y + o * h;
          g.beginPath();
          g.moveTo(x, yy);
          g.quadraticCurveTo(x + bend + tilt * len * 0.5, yy + len * 0.5, x + tilt * len, yy + len);
          g.strokeStyle = 'rgba(255,255,255,' + a.toFixed(3) + ')'; g.lineWidth = wid; g.stroke();
          if(edge && r() < 0.6){                           // tiny spray droplets
            g.fillStyle = 'rgba(255,255,255,' + (a * 0.9).toFixed(3) + ')';
            for(var d = 0; d < 3; d++){
              g.beginPath(); g.arc(x + (r() - 0.5) * 24, yy + (r() - 0.5) * 24, 0.7 + r() * 1.6, 0, 6.2832); g.fill();
            }
          }
        }
      }
      layers.push(c);
    }
    var f = document.createElement('canvas'); f.width = Math.round(w * dpr); f.height = Math.round(h * dpr);
    var fg = f.getContext('2d');
    var m = fg.createLinearGradient(0, 0, 0, f.height);    // soft fade at top/bottom of the play area
    m.addColorStop(0, 'rgba(0,0,0,0)'); m.addColorStop(0.10, 'rgba(0,0,0,1)');
    m.addColorStop(0.90, 'rgba(0,0,0,1)'); m.addColorStop(1, 'rgba(0,0,0,0)');
    foam = { layers: layers, frame: f, fg: fg, mask: m, W: f.width, H: f.height };
  }
  function draw(ctx, w, h, items){
    try{
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var k = w + 'x' + h + 'x' + dpr;
      if(k !== key){ build(w, h, dpr); key = k; }
      var t = performance.now() / 1000;

      // flowing foam: two layers drifting downstream at different speeds (parallax)
      var fg = foam.fg, W = foam.W, H = foam.H;
      fg.globalCompositeOperation = 'source-over';
      fg.clearRect(0, 0, W, H);
      var sp = [H * 0.075, H * 0.042];
      for(var L = 0; L < 2; L++){
        var off = (t * sp[L]) % H;
        fg.drawImage(foam.layers[L], 0, off); fg.drawImage(foam.layers[L], 0, off - H);
      }
      fg.globalCompositeOperation = 'destination-in';
      fg.fillStyle = foam.mask; fg.fillRect(0, 0, W, H);
      ctx.drawImage(foam.frame, 0, 0, w, h);

      // ripples + splash collar around each floating donut (drawn before the donut sprite)
      var R = h * 0.075;
      for(var i = 0; i < items.length; i++){
        var it = items[i];
        if(it.bad) continue;
        var ent = Math.max(0, Math.min(1, (it.y - (it.dnTop || 0) + 0.06) / 0.13));
        if(ent <= 0) continue;
        var sc = 0.55 + 0.45 * ent, cx = it.x * w, cy = it.y * h + R * 0.30 * sc;
        var ph = (t * 0.9 + it.x * 7) % 1;
        ctx.save();
        ctx.translate(cx, cy); ctx.scale(1, 0.62);
        var gr = ctx.createRadialGradient(0, 0, R * 0.72 * sc, 0, 0, R * 1.5 * sc);
        gr.addColorStop(0, 'rgba(255,255,255,0)');
        gr.addColorStop(0.34, 'rgba(255,255,255,' + (0.55 * ent).toFixed(3) + ')');
        gr.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.fillStyle = gr; ctx.beginPath(); ctx.arc(0, 0, R * 1.5 * sc, 0, 6.2832); ctx.fill();
        ctx.lineWidth = 2;
        for(var q = 0; q < 2; q++){
          var p = (ph + q * 0.5) % 1;
          ctx.strokeStyle = 'rgba(255,255,255,' + ((1 - p) * 0.5 * ent).toFixed(3) + ')';
          ctx.beginPath(); ctx.arc(0, 0, R * sc * (1.05 + p * 0.95), 0, 6.2832); ctx.stroke();
        }
        ctx.restore();
        // water parting around the donut + a few droplets (tiny sin wobble, no state kept)
        ctx.save();
        ctx.strokeStyle = 'rgba(255,255,255,' + (0.6 * ent).toFixed(3) + ')'; ctx.lineWidth = 2.2; ctx.lineCap = 'round';
        var ry = it.y * h - R * 0.55 * sc, rr = R * sc;
        ctx.beginPath(); ctx.arc(cx, ry + rr * 0.9, rr * 1.08, Math.PI * 1.08, Math.PI * 1.42); ctx.stroke();
        ctx.beginPath(); ctx.arc(cx, ry + rr * 0.9, rr * 1.08, Math.PI * 1.58, Math.PI * 1.92); ctx.stroke();
        ctx.fillStyle = 'rgba(255,255,255,' + (0.7 * ent).toFixed(3) + ')';
        for(var d = 0; d < 5; d++){
          var ang = Math.PI * (1.05 + d * 0.22), wob = Math.sin(t * 5 + d * 1.7 + it.x * 9) * 1.5;
          ctx.beginPath(); ctx.arc(cx + Math.cos(ang) * (rr * 1.22 + wob), ry + rr * 0.9 + Math.sin(ang) * (rr * 1.15 + wob), 1.2 + (d % 2), 0, 6.2832); ctx.fill();
        }
        ctx.restore();
      }
    }catch(e){ /* never let a cosmetic effect interrupt the game loop */ }
  }
  window.CB_DONUT_WATER = { draw: draw };
})();
</script>

<style id="candyblast-medals-css">
/* CANDY BLAST — MEDAL GRAB & ACHIEVEMENTS (additive only; every selector is cbm- prefixed) */
#cbm-gift{
  position:absolute; z-index:6; right:calc(var(--safe-right, env(safe-area-inset-right, 0px)) + 12px);
  top:calc(var(--safe-top, env(safe-area-inset-top, 0px)) + 12px);
  width:54px; height:54px; border-radius:18px; border:2px solid rgba(255,255,255,.75);
  background:linear-gradient(180deg,#ff9fd0,#ff6fb0); box-shadow:0 5px 0 #c23f7f,0 8px 16px rgba(0,0,0,.28);
  font-size:28px; line-height:1; display:flex; align-items:center; justify-content:center;
  cursor:pointer; padding:0; touch-action:manipulation; -webkit-tap-highlight-color:transparent;
  animation:cbmGiftBob 2.6s ease-in-out infinite;
}
#cbm-gift:active{ transform:translateY(3px); box-shadow:0 2px 0 #c23f7f; }
#cbm-gift .cbm-dot{
  position:absolute; top:-5px; right:-5px; min-width:20px; height:20px; border-radius:10px; padding:0 5px;
  background:#2ed573; border:2px solid #fff; color:#fff; font:800 11px/16px var(--font-body,system-ui,sans-serif);
  text-align:center; display:none; box-sizing:border-box;
}
#cbm-gift.cbm-has-new .cbm-dot{ display:block; }
@keyframes cbmGiftBob{ 0%,100%{transform:translateY(0) rotate(-3deg);} 50%{transform:translateY(-4px) rotate(3deg);} }

.cbm-screen{
  position:fixed; inset:0; z-index:9000; display:none; flex-direction:column; align-items:center;
  background:linear-gradient(180deg,var(--bg-top,#3b1f5c),var(--bg-bottom,#1a0f33));
  color:var(--text,#fff6ff); font-family:var(--font-body,'Nunito',system-ui,sans-serif);
  padding:var(--safe-top, env(safe-area-inset-top, 0px)) var(--safe-right, env(safe-area-inset-right, 0px)) var(--safe-bottom, env(safe-area-inset-bottom, 0px)) var(--safe-left, env(safe-area-inset-left, 0px));
  box-sizing:border-box;
}
.cbm-screen.cbm-on{ display:flex; animation:cbmIn .22s ease-out both; }
@keyframes cbmIn{ from{opacity:0; transform:scale(.97);} to{opacity:1; transform:none;} }
.cbm-head{ width:100%; max-width:520px; display:flex; align-items:center; gap:10px; padding:12px 14px 8px; box-sizing:border-box; }
.cbm-back{
  width:42px; height:42px; border-radius:14px; border:2px solid rgba(255,255,255,.4); background:rgba(255,255,255,.12);
  color:#fff; font-size:26px; line-height:1; cursor:pointer; padding:0 0 3px; touch-action:manipulation;
}
.cbm-title{ flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font:800 clamp(14px,4.9vw,22px)/1.1 var(--font-heading,'Baloo 2',system-ui,sans-serif); letter-spacing:.2px; }
.cbm-coins{ background:rgba(255,209,102,.18); border:2px solid rgba(255,209,102,.6); color:#ffd166; border-radius:14px; padding:6px 11px; font-weight:900; font-size:14px; white-space:nowrap; }
/* short phones (e.g. 320x568) with the Ad Privacy row visible: keep BACK on screen */
@media (max-height:620px){ #cbm-grab-btn, #cbm-ach-btn{ margin-top:4px !important; padding-top:8px; padding-bottom:8px; } }
@media (max-width:380px){ .cbm-head{ padding-left:10px; padding-right:10px; gap:8px; } .cbm-back{ width:38px; height:38px; } .cbm-coins{ padding:5px 8px; font-size:13px; } }
.cbm-body{
  width:100%; max-width:520px; flex:1; overflow-y:auto; -webkit-overflow-scrolling:touch;
  touch-action:pan-y; overscroll-behavior:contain; padding:6px 14px 34px; box-sizing:border-box;
}
.cbm-sec{ font:800 15px/1 var(--font-heading,system-ui,sans-serif); color:#ffd166; letter-spacing:.8px; margin:16px 2px 8px; text-transform:uppercase; }
.cbm-card{ background:rgba(255,255,255,.09); border:1.5px solid rgba(255,255,255,.16); border-radius:18px; padding:12px; margin-bottom:10px; }
.cbm-3{ display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
.cbm-stat{ text-align:center; background:rgba(255,255,255,.09); border:1.5px solid rgba(255,255,255,.16); border-radius:16px; padding:10px 4px; }
.cbm-stat b{ display:block; font:800 24px/1.1 var(--font-heading,system-ui,sans-serif); color:#fff; }
.cbm-stat span{ font-size:11px; font-weight:800; color:var(--muted,#c9b6e8); letter-spacing:.5px; text-transform:uppercase; }
.cbm-row{ display:flex; align-items:center; gap:10px; }
.cbm-ico{ font-size:26px; width:34px; text-align:center; flex:none; }
.cbm-grow{ flex:1; min-width:0; }
.cbm-name{ font-weight:900; font-size:15px; }
.cbm-desc{ font-size:12px; color:var(--muted,#c9b6e8); font-weight:700; margin-top:1px; }
.cbm-bar{ height:11px; border-radius:6px; background:rgba(0,0,0,.35); overflow:hidden; margin-top:7px; }
.cbm-bar i{ display:block; height:100%; border-radius:6px; background:linear-gradient(90deg,#ff6fb0,#ffd166); transition:width .4s ease; }
.cbm-bar.cbm-full i{ background:linear-gradient(90deg,#2ed573,#7bed9f); }
.cbm-meta{ display:flex; justify-content:space-between; font-size:12px; font-weight:800; margin-top:5px; color:#fff6ff; }
.cbm-meta em{ font-style:normal; color:#ffd166; }
.cbm-medals{ display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin-top:8px; }
.cbm-medals.cbm-one{ grid-template-columns:1fr; justify-items:start; }
.cbm-mcell{ text-align:center; font-size:10.5px; font-weight:800; color:var(--muted,#c9b6e8); }
.cbm-mcell small{ display:block; opacity:.85; }
.cbm-medal{ width:100%; max-width:62px; height:auto; display:block; margin:0 auto 2px; filter:drop-shadow(0 3px 3px rgba(0,0,0,.35)); }
.cbm-medal.cbm-lock{ filter:grayscale(1) brightness(.5) contrast(.9); opacity:.75; }
.cbm-earned-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
.cbm-empty{ text-align:center; color:var(--muted,#c9b6e8); font-weight:700; font-size:13px; padding:10px 6px; }
.cbm-table{ width:100%; border-collapse:collapse; font-size:13px; font-weight:800; }
.cbm-table th{ color:var(--muted,#c9b6e8); font-size:11px; text-transform:uppercase; letter-spacing:.5px; text-align:right; padding:4px 4px; }
.cbm-table th:first-child,.cbm-table td:first-child{ text-align:left; }
.cbm-table td{ text-align:right; padding:7px 4px; border-top:1px solid rgba(255,255,255,.1); }
.cbm-list{ list-style:none; margin:0; padding:0; }
.cbm-list li{ display:flex; justify-content:space-between; gap:8px; padding:7px 2px; border-top:1px solid rgba(255,255,255,.1); font-size:13px; font-weight:800; }
.cbm-list li:first-child{ border-top:0; }
.cbm-list li span:last-child{ color:var(--muted,#c9b6e8); white-space:nowrap; }
.cbm-cheer{ text-align:center; font-weight:800; font-size:13px; color:#ffd166; margin:14px 6px 0; }

/* --- rewards UI cleanup: Medal Grab (collection) / Achievements (stats & progress) --- */
.cbm-hero{ text-align:center; background:linear-gradient(180deg,rgba(255,111,176,.22),rgba(255,255,255,.08)); border-color:rgba(255,209,102,.55); }
.cbm-hero-top{ display:flex; justify-content:space-around; gap:8px; }
.cbm-hero-top b{ display:block; font:800 24px/1.1 var(--font-heading,system-ui,sans-serif); color:#fff; }
.cbm-hero-top span{ font-size:11px; font-weight:800; color:var(--muted,#c9b6e8); letter-spacing:.5px; text-transform:uppercase; }
.cbm-chips{ display:flex; flex-wrap:wrap; justify-content:center; gap:6px; margin-top:10px; }
.cbm-chip{ background:rgba(255,255,255,.14); border:1.5px solid rgba(255,255,255,.2); border-radius:12px; padding:4px 10px; font-weight:900; font-size:13px; }
.cbm-celebrate{ display:flex; align-items:center; gap:10px; margin-bottom:10px; padding:11px 14px; border-radius:18px; color:#4a2500;
  background:linear-gradient(180deg,#ffe38a,#ffc83d); border:2px solid #fff3a8; box-shadow:0 4px 0 #c98a00; animation:cbmPop .55s cubic-bezier(.22,1.4,.36,1) both; }
.cbm-celebrate b{ display:block; font:800 16px/1.1 var(--font-heading,system-ui,sans-serif); }
.cbm-celebrate small{ display:block; font-size:12px; font-weight:800; opacity:.8; }
.cbm-spark{ font-size:30px; animation:cbmWob 1.4s ease-in-out infinite; }
@keyframes cbmPop{ from{ opacity:0; transform:scale(.85); } to{ opacity:1; transform:none; } }
@keyframes cbmWob{ 0%,100%{ transform:rotate(-10deg) scale(1); } 50%{ transform:rotate(10deg) scale(1.15); } }
.cbm-scope{ flex:none; align-self:flex-start; font-size:10px; font-weight:900; text-transform:uppercase; letter-spacing:.4px; color:#ffd166; background:rgba(255,209,102,.16); border:1.5px solid rgba(255,209,102,.45); border-radius:10px; padding:3px 7px; }
.cbm-medals.cbm-three{ grid-template-columns:repeat(3,1fr); }
.cbm-mcell{ position:relative; }
.cbm-mcell.cbm-newm::after{ content:'NEW'; position:absolute; top:-2px; right:0; background:#ff4d6d; color:#fff; font-size:9px; font-weight:900; letter-spacing:.4px; border-radius:8px; padding:2px 5px; box-shadow:0 2px 0 #a8203c; }
.cbm-next{ margin-top:9px; text-align:center; font-size:12px; font-weight:800; color:#ffd166; }
.cbm-next.cbm-ok{ color:#7bed9f; }
.cbm-linkbtn{ display:block; width:100%; margin-top:14px; padding:13px 10px; border:0; border-radius:16px; color:#fff; cursor:pointer; touch-action:manipulation;
  font:800 15px var(--font-body,system-ui,sans-serif); letter-spacing:.4px; background:linear-gradient(180deg,#ff8fc0,#ff6fb0); box-shadow:0 4px 0 #c23f7f; }
.cbm-linkbtn:active{ transform:translateY(3px); box-shadow:0 1px 0 #c23f7f; }
.cbm-linknote{ text-align:center; font-size:11.5px; font-weight:700; color:var(--muted,#c9b6e8); margin-top:7px; }
.cbm-center{ text-align:center; }
.cbm-bigline{ font:800 18px/1.2 var(--font-heading,system-ui,sans-serif); }
.cbm-sub{ font-size:12px; font-weight:900; color:var(--muted,#c9b6e8); text-transform:uppercase; letter-spacing:.6px; margin:12px 2px 6px; }
.cbm-subin{ font-size:11px; font-weight:900; color:#ffd166; text-transform:uppercase; letter-spacing:.6px; margin:2px 0 2px; }
.cbm-subin:not(:first-child){ margin-top:10px; }
.cbm-p3{ gap:6px; }
.cbm-pcard{ text-align:center; background:rgba(255,255,255,.09); border:1.5px solid rgba(255,255,255,.16); border-radius:16px; padding:9px 4px 8px; min-width:0; }
.cbm-plbl{ display:block; font-size:10.5px; font-weight:900; color:#ffd166; letter-spacing:.5px; text-transform:uppercase; }
.cbm-pcard b{ display:block; font:800 26px/1.1 var(--font-heading,system-ui,sans-serif); color:#fff; margin-top:2px; }
.cbm-punit{ display:block; font-size:10px; font-weight:800; color:var(--muted,#c9b6e8); text-transform:uppercase; }
.cbm-pcard ul{ list-style:none; margin:7px 0 0; padding:6px 0 0; border-top:1px solid rgba(255,255,255,.12); font-size:10.5px; font-weight:800; line-height:1.55; }
.cbm-tiles{ display:grid; grid-template-columns:repeat(2,1fr); gap:8px; }
.cbm-tile{ background:rgba(255,255,255,.09); border:1.5px solid rgba(255,255,255,.16); border-radius:16px; padding:10px 6px; text-align:center; min-width:0; }
.cbm-tile span{ font-size:20px; }
.cbm-tile b{ display:block; font:800 21px/1.15 var(--font-heading,system-ui,sans-serif); color:#fff; }
.cbm-tile small{ font-size:11px; font-weight:800; color:var(--muted,#c9b6e8); text-transform:uppercase; letter-spacing:.4px; }

#cbm-toast{
  position:fixed; z-index:9500; left:50%; top:calc(var(--safe-top, env(safe-area-inset-top, 0px)) + 8px);
  transform:translate(-50%,-140%); max-width:min(92vw,380px); pointer-events:none;
  background:linear-gradient(180deg,#ff8fc0,#ff6fb0); color:#fff; border:2px solid rgba(255,255,255,.8);
  border-radius:16px; padding:8px 14px; font:800 13px/1.25 var(--font-body,system-ui,sans-serif); text-align:center;
  box-shadow:0 5px 0 #c23f7f,0 8px 18px rgba(0,0,0,.35); transition:transform .28s cubic-bezier(.22,1,.36,1); opacity:0;
}
#cbm-toast.cbm-show{ transform:translate(-50%,0); opacity:1; pointer-events:auto; cursor:pointer; }
/* Home-screen Medal Grab button (slim, sits under SETTINGS) */
#cbm-home-btn{ position:relative; align-self:center; width:100%; padding:10px 16px; font-size:14px; letter-spacing:1.5px; background:linear-gradient(180deg,#ff9fd0,#ff6fb0); box-shadow:0 5px 0 #c23f7f; color:#fff; text-shadow:0 1px 2px rgba(120,20,70,.4); touch-action:manipulation; }
#cbm-home-btn:active{ transform:translateY(3px); box-shadow:0 2px 0 #c23f7f; }
#cbm-home-btn .cbm-dot{ display:none; margin-left:8px; min-width:20px; height:20px; border-radius:10px; padding:0 6px; background:#2ed573; border:2px solid #fff; color:#fff; font:800 11px/16px system-ui,sans-serif; letter-spacing:0; text-align:center; box-sizing:border-box; vertical-align:middle; }
#cbm-home-btn.cbm-has-new .cbm-dot{ display:inline-block; }

#cbm-sum{
  position:fixed; z-index:9400; left:50%; top:calc(var(--safe-top, env(safe-area-inset-top, 0px)) + 78px); transform:translate(-50%,-14px);
  width:min(92vw,350px); box-sizing:border-box; display:none; opacity:0;
  background:linear-gradient(180deg,#4a2a7a,#2a1450); color:#fff6ff; border:2px solid #ffd166; border-radius:20px;
  padding:14px 14px 12px; box-shadow:0 8px 0 rgba(0,0,0,.25),0 14px 30px rgba(0,0,0,.45);
  font-family:var(--font-body,system-ui,sans-serif); transition:opacity .25s ease, transform .25s ease;
}
#cbm-sum.cbm-on{ display:block; }
#cbm-sum.cbm-show{ opacity:1; transform:translate(-50%,0); }
#cbm-sum h4{ margin:0 0 6px; font:800 17px/1.1 var(--font-heading,system-ui,sans-serif); color:#ffd166; }
#cbm-sum ul{ list-style:none; margin:0 0 8px; padding:0; font-size:13px; font-weight:800; }
#cbm-sum li{ padding:3px 0; }
#cbm-sum p{ margin:0 0 10px; font-size:12.5px; font-weight:700; color:#e9dcff; }
.cbm-sum-btns{ display:flex; gap:8px; }
.cbm-sum-btns button{
  flex:1; border:0; border-radius:12px; padding:9px 6px; font:800 13px var(--font-body,system-ui,sans-serif);
  cursor:pointer; touch-action:manipulation; color:#fff; background:rgba(255,255,255,.15);
}
.cbm-sum-btns button.cbm-pri{ background:linear-gradient(180deg,#ff8fc0,#ff6fb0); box-shadow:0 3px 0 #c23f7f; }
@media (prefers-reduced-motion:reduce){
  #cbm-gift{ animation:none; } .cbm-screen.cbm-on{ animation:none; } .cbm-celebrate,.cbm-spark{ animation:none; }
  #cbm-toast,#cbm-sum{ transition:none; } .cbm-bar i{ transition:none; }
}
</style>
<script id="candyblast-medals-js">
(function(){
'use strict';
/* CANDY BLAST — MEDAL GRAB & ACHIEVEMENTS (additive; Candy Blast only).
   Zero edits to existing game code: Classic Mode events are inferred from the
   HUD elements the game already updates (#streak-val, #score-val, #combo-popup,
   #mode-tag). Storage: one localStorage key. No network, no analytics,
   no permissions, and nothing here touches the ad / consent / hint code. */
var KEY = 'candyBlastMedals_v1';
var TIERS = [
  {k:'bronze',  nm:'Bronze',  e:'🥉', c:10},
  {k:'silver',  nm:'Silver',  e:'🥈', c:25},
  {k:'gold',    nm:'Gold',    e:'🥇', c:50},
  {k:'diamond', nm:'Diamond', e:'💎', c:100}
];
var TB = {}; TIERS.forEach(function(t){ TB[t.k] = t; });
/* Definitions. "combo" = a streak step of 2+ (the game's own COMBO!/STREAK HUD). */
var CH = [
  {id:'streak', scope:'session', metric:'streak', icon:'🔥', name:'Combo Streak',  desc:'Reach a combo streak in ONE game', t:[4,6,8,12]},
  {id:'score',  scope:'session', metric:'score',  icon:'⭐', name:'Sweet Score',   desc:'Reach a score in ONE game',        t:[2500,7500,15000,30000]},
  {id:'dcombo', scope:'day',     metric:'combos', icon:'🍬', name:'Daily Combos',  desc:'Total combos made TODAY',          t:[15,40,80,150]},
  {id:'wcombo', scope:'week',    metric:'combos', icon:'🍭', name:'Weekly Combos', desc:'Total combos this WEEK (Mon–Sun)', t:[100,250,500,900]},
  {id:'mcombo', scope:'month',   metric:'combos', icon:'🍩', name:'Monthly Combos',desc:'Total combos this MONTH',          t:[400,1000,2000,3500]}
];
var RECS = [
  {id:'rec_day',   p:'day',   tier:'silver',  icon:'📈', name:'Daily Record',   floor:15,  desc:'Beat your best daily combo total'},
  {id:'rec_week',  p:'week',  tier:'gold',    icon:'🏆', name:'Weekly Record',  floor:100, desc:'Beat your best weekly combo total (awarded when the week ends)'},
  {id:'rec_month', p:'month', tier:'diamond', icon:'👑', name:'Monthly Record', floor:400, desc:'Beat your best monthly combo total (awarded when the month ends)'}
];
var SCOPE_LBL = {session:'One game', day:'Today', week:'This week', month:'This month'};
var VALID = {};
CH.forEach(function(c){ TIERS.forEach(function(t){ VALID[c.id+'_'+t.k] = 1; }); });
RECS.forEach(function(r){ VALID[r.id] = 1; });
var TOTAL_MEDALS = Object.keys(VALID).length;
var CHEER = [
  'Keep playing, build your combo, and grab your next medal!',
  'Chain those clears — your next medal is closer than you think!',
  'Every combo counts. Go grab that next medal!'
];

/* ---------------- data ---------------- */
var D = null;
var S = {score:0, streak:0, run:0};      // current Classic game (session) only
var saveT = null;

function np(k){ return {k:k||'', combos:0, multi:0, streak:0, score:0}; }
function def(){
  return {v:1, lastSeen:0, coins:0, seen:0, tot:{combos:0, multi:0},
    day:np(), week:np(), month:np(),
    rec:{streak:0, score:0, day:0, week:0, month:0},
    awarded:{}, done:{}, ev:[], sum:{ts:0, sig:''}};
}
function n0(x, max){ x = Number(x); if(!isFinite(x) || x < 0) return 0; x = Math.floor(x); return Math.min(x, max || 1e9); }
function sp(o){
  o = (o && typeof o === 'object') ? o : {};
  return {k:(typeof o.k === 'string' && /^[A-Za-z0-9-]{0,16}$/.test(o.k)) ? o.k : '',
    combos:n0(o.combos), multi:n0(o.multi), streak:n0(o.streak, 999), score:n0(o.score, 1e8)};
}
function san(o){
  if(!o || typeof o !== 'object' || Array.isArray(o)) return null;
  var d = def(), i, k;
  d.lastSeen = n0(o.lastSeen, 4e12); d.coins = n0(o.coins, 1e9); d.seen = n0(o.seen, 999);
  var t = (o.tot && typeof o.tot === 'object') ? o.tot : {};
  d.tot.combos = n0(t.combos); d.tot.multi = n0(t.multi);
  d.day = sp(o.day); d.week = sp(o.week); d.month = sp(o.month);
  var r = (o.rec && typeof o.rec === 'object') ? o.rec : {};
  d.rec = {streak:n0(r.streak, 999), score:n0(r.score, 1e8), day:n0(r.day), week:n0(r.week), month:n0(r.month)};
  if(o.awarded && typeof o.awarded === 'object'){
    for(k in o.awarded){ if(VALID[k] && isFinite(Number(o.awarded[k]))) d.awarded[k] = n0(o.awarded[k], 4e12); }
  }
  if(o.done && typeof o.done === 'object'){
    var dk = Object.keys(o.done).filter(function(x){ return /^[a-z_]+:[A-Za-z0-9-]{1,16}$/.test(x) && VALID[x.split(':')[0]] && isFinite(Number(o.done[x])); });
    dk.sort(function(a, b){ return Number(o.done[b]) - Number(o.done[a]); });
    dk.slice(0, 600).forEach(function(x){ d.done[x] = n0(o.done[x], 4e12); });
  }
  if(Array.isArray(o.ev)){
    o.ev.slice(-60).forEach(function(e){
      if(e && typeof e.msg === 'string') d.ev.push({t:e.t === 'chal' ? 'chal' : 'medal', id:String(e.id || '').slice(0, 24), msg:e.msg.slice(0, 120), ts:n0(e.ts, 4e12), sh:e.sh ? 1 : 0});
    });
  }
  var s = (o.sum && typeof o.sum === 'object') ? o.sum : {};
  d.sum = {ts:n0(s.ts, 4e12), sig:typeof s.sig === 'string' ? s.sig.slice(0, 60) : ''};
  return d;
}
function load(){
  var raw = null;
  try{ raw = localStorage.getItem(KEY); }catch(e){ return def(); }
  if(raw === null || raw === undefined) return def();
  try{
    var d = san(JSON.parse(raw));
    if(d) return d;
    throw new Error('bad');
  }catch(e){
    try{ if(localStorage.getItem(KEY + '_corrupt') === null) localStorage.setItem(KEY + '_corrupt', String(raw).slice(0, 20000)); }catch(e2){}
    return def();
  }
}
function saveNow(){
  clearTimeout(saveT); saveT = null;
  try{ localStorage.setItem(KEY, JSON.stringify(D)); }catch(e){}
}
function scheduleSave(){ if(!saveT) saveT = setTimeout(saveNow, 500); }

/* ---------------- time (device-local day / Monday-start week / month) ---------------- */
function pad(n){ return n < 10 ? '0' + n : '' + n; }
function keys(ms){
  var d = new Date(ms);
  var day = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
  var w = new Date(d.getFullYear(), d.getMonth(), d.getDate());
  w.setDate(w.getDate() - ((w.getDay() + 6) % 7));
  return {day:day, month:day.slice(0, 7), week:'W' + w.getFullYear() + '-' + pad(w.getMonth() + 1) + '-' + pad(w.getDate())};
}
function nowMs(){
  var t = Date.now(), ls = D.lastSeen || 0;
  if(t < ls && ls - t < 129600000) t = ls;   // small backwards clock jump: hold; large one = clock corrected, accept
  D.lastSeen = t; return t;
}
function fin(p){
  var P = D[p]; if(!P.k) return;
  if(p === 'day'){ D.rec.day = Math.max(D.rec.day, P.combos); return; }
  var r = RECS[p === 'week' ? 1 : 2];
  if(D.rec[p] >= r.floor && P.combos > D.rec[p]) grant(r.id, r.tier, r.name, P.k);
  D.rec[p] = Math.max(D.rec[p], P.combos);
}
function roll(now){
  var K = keys(now);
  ['day', 'week', 'month'].forEach(function(p){
    if(D[p].k !== K[p]){ fin(p); D[p] = np(K[p]); }
  });
}

/* ---------------- awards (idempotent) ---------------- */
function fmt(n){ return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
function pushEv(kind, id, msg){
  D.ev.push({t:kind, id:id, msg:msg, ts:D.lastSeen, sh:0});
  if(D.ev.length > 60) D.ev.splice(0, D.ev.length - 60);
}
/* pk = period key for repeatable period challenges, null for one-time session medals */
function grant(mid, tk, title, pk){
  var first = !D.awarded[mid];
  if(pk){
    var dk = mid + ':' + pk;
    if(D.done[dk]) return;
    D.done[dk] = D.lastSeen;
  } else if(!first) return;
  if(first) D.awarded[mid] = D.lastSeen;
  var coins = TB[tk].c; if(!first) coins = Math.max(5, Math.round(coins / 4));
  D.coins += coins;
  saveUrgent = true;
  pushEv(first ? 'medal' : 'chal', mid,
    (first ? TB[tk].e + ' ' + TB[tk].nm + ' medal: ' : '✅ Challenge complete: ') + title + ' (+' + coins + ' 🪙)');
}
function evalSession(){
  CH.forEach(function(c){
    if(c.scope !== 'session') return;
    var v = c.metric === 'streak' ? S.streak : S.score;
    c.t.forEach(function(n, i){
      if(v >= n) grant(c.id + '_' + TIERS[i].k, TIERS[i].k, c.name + (c.metric === 'streak' ? ' ×' + n : ' ' + fmt(n)), null);
    });
  });
}
function evalPeriod(p){
  CH.forEach(function(c){
    if(c.scope !== p) return;
    c.t.forEach(function(n, i){
      if(D[p].combos >= n) grant(c.id + '_' + TIERS[i].k, TIERS[i].k, c.name + ' ' + n, D[p].k);
    });
  });
}

/* ---------------- Classic events ---------------- */
var gameScreen, modeTag, streakEl, scoreEl, popupEl;
function inClassic(){
  return !!(gameScreen && modeTag && gameScreen.classList.contains('active') &&
    String(modeTag.textContent || '').trim().toUpperCase() === 'CLASSIC');
}
var saveUrgent = false;   // set by grant(): persist right away so a crash/kill can't lose a just-earned reward
function afterEvent(){ if(saveUrgent){ saveUrgent = false; saveNow(); } else scheduleSave(); updateDot(); flushLive(); }
function onCombo(n){
  roll(nowMs());
  D.tot.combos++;
  ['day', 'week', 'month'].forEach(function(p){ D[p].combos++; if(n > D[p].streak) D[p].streak = n; });
  if(n > S.streak) S.streak = n;
  if(n > D.rec.streak) D.rec.streak = n;
  if(D.rec.day >= RECS[0].floor && D.day.combos > D.rec.day) grant(RECS[0].id, RECS[0].tier, RECS[0].name, D.day.k);
  evalSession(); evalPeriod('day'); evalPeriod('week'); evalPeriod('month');
  afterEvent();
}
function onScore(v){
  roll(nowMs());
  if(v > D.rec.score) D.rec.score = v;
  ['day', 'week', 'month'].forEach(function(p){ if(v > D[p].score) D[p].score = v; });
  evalSession();
  afterEvent();
}
function onMulti(){
  roll(nowMs());
  D.tot.multi++;
  ['day', 'week', 'month'].forEach(function(p){ D[p].multi++; });
  afterEvent();
}
function watchStreak(){
  var t = parseInt(streakEl.textContent, 10) || 0;
  if(t === 0){ S.run = 0; return; }              // game (re)started
  if(!inClassic()) return;
  if(t >= 2 && (t === 2 || t === S.run + 1)){ S.run = t; onCombo(t); }
  else if(t >= 2){ S.run = t; }                  // out-of-sequence value: resync, never award
}
function watchScore(){
  var v = parseInt(scoreEl.textContent, 10);
  if(isNaN(v)) return;
  if(v === 0){ S.score = 0; S.streak = 0; S.run = 0; return; }
  if(!inClassic()) return;
  if(v > S.score){ S.score = v; onScore(v); }
}
function watchPopup(){
  if(inClassic() && /^(DOUBLE|TRIPLE|MEGA) CLEAR!/.test(String(popupEl.textContent || '').trim())) onMulti();
}

/* ---------------- progress helpers ---------------- */
function curVal(c){
  if(c.scope === 'session') return c.metric === 'streak' ? D.rec.streak : D.rec.score;
  return D[c.scope].combos;
}
function nextIdx(c){
  var v = curVal(c), i;
  for(i = 0; i < c.t.length; i++){
    if(c.scope === 'session' ? !D.awarded[c.id + '_' + TIERS[i].k] : c.t[i] > v) return i;
  }
  return -1;
}
function bestProgress(){
  var best = null;
  CH.forEach(function(c){
    var i = nextIdx(c); if(i < 0) return;
    var v = curVal(c), n = c.t[i];
    if(v <= 0) return;
    var ratio = v / n;
    if(!best || ratio > best.ratio) best = {c:c, i:i, v:v, n:n, ratio:ratio};
  });
  return best;
}

/* ---------------- toast (in-game, non-blocking) ---------------- */
var toastEl, toastQ = [], toasting = false;
function toast(msg){
  if(!toastEl) return;
  toastQ.push(msg); if(toastQ.length > 3) toastQ.shift();
  if(!toasting) pump();
}
function pump(){
  var m = toastQ.shift();
  if(!m){ toasting = false; return; }
  toasting = true;
  toastEl.textContent = m + '  \u2022 Tap to grab \ud83c\udf81';
  toastEl.classList.add('cbm-show');
  setTimeout(function(){
    toastEl.classList.remove('cbm-show');
    setTimeout(pump, 320);
  }, 2600);
}
function flushLive(){
  if(!inClassic()) return;
  var any = false;
  D.ev.forEach(function(e){ if(!e.sh){ e.sh = 1; any = true; toast(e.msg); } });
  if(any) scheduleSave();
}

/* ---------------- medal artwork ---------------- */
var DEFS = '<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>' +
  '<linearGradient id="cbm-g-bronze" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffd0a0"/><stop offset=".55" stop-color="#cd7f32"/><stop offset="1" stop-color="#8a4a18"/></linearGradient>' +
  '<linearGradient id="cbm-g-silver" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset=".55" stop-color="#b9c2d3"/><stop offset="1" stop-color="#7d8aa3"/></linearGradient>' +
  '<linearGradient id="cbm-g-gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff3a8"/><stop offset=".5" stop-color="#ffc83d"/><stop offset="1" stop-color="#c98a00"/></linearGradient>' +
  '<linearGradient id="cbm-g-diamond" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e6fdff"/><stop offset=".5" stop-color="#5fd0ff"/><stop offset="1" stop-color="#b57bff"/></linearGradient>' +
  '</defs></svg>';
function medalSVG(tier, icon, locked){
  var g = 'url(#cbm-g-' + tier + ')';
  var body = tier === 'diamond'
    ? '<polygon points="32,22 48,31 48,49 32,62 16,49 16,31" fill="' + g + '" stroke="#effcff" stroke-width="2.5" stroke-linejoin="round"/><polygon points="32,22 48,31 32,38 16,31" fill="rgba(255,255,255,.45)"/>'
    : '<circle cx="32" cy="42" r="20" fill="' + g + '" stroke="rgba(255,255,255,.85)" stroke-width="3"/><circle cx="32" cy="42" r="14.5" fill="none" stroke="rgba(255,255,255,.4)" stroke-width="1.6" stroke-dasharray="3 3"/>';
  return '<svg class="cbm-medal' + (locked ? ' cbm-lock' : '') + '" viewBox="0 0 64 64" aria-hidden="true">' +
    '<path d="M21 2h10l5 22-9 3z" fill="#ff6fb0"/><path d="M43 2H33l-5 22 9 3z" fill="#ffd166"/>' + body +
    '<text x="32" y="' + (tier === 'diamond' ? 49 : 49) + '" font-size="17" text-anchor="middle">' + (locked ? '🔒' : icon) + '</text></svg>';
}

/* ---------------- screens ---------------- */
var grabEl, achEl, giftEl, sumEl;
function fmtDate(ts){
  var d = new Date(ts); return isNaN(d.getTime()) ? '' : d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
}
function bar(pct, full){ return '<div class="cbm-bar' + (full ? ' cbm-full' : '') + '"><i style="width:' + pct + '%"></i></div>'; }
var RECTIER = {}; RECS.forEach(function(r){ RECTIER[r.id] = r.tier; });
var grabFrom = null, achFrom = null;   // which screen opened this one (so Back returns correctly)
function tierCounts(){
  var c = {bronze:0, silver:0, gold:0, diamond:0};
  Object.keys(D.awarded).forEach(function(k){
    var t = RECTIER[k] || (VALID[k] ? k.split('_')[1] : null);
    if(t && c[t] !== undefined) c[t]++;
  });
  return c;
}
function chips(){
  var c = tierCounts();
  return '<div class="cbm-chips">' + TIERS.map(function(t){ return '<span class="cbm-chip">' + t.e + ' ' + c[t.k] + '</span>'; }).join('') + '</div>';
}
/* medals earned since the player last opened Medal Grab (real data: awarded timestamps vs. D.seen) */
function newMedals(){
  var keys = Object.keys(D.awarded), n = Math.max(0, keys.length - D.seen), ids = {};
  keys.sort(function(x, y){ return D.awarded[y] - D.awarded[x]; }).slice(0, n).forEach(function(k){ ids[k] = 1; });
  return {n:n, ids:ids};
}
/* ---- challenge-progress cards: used ONLY by Achievements ---- */
function chalCard(c){
  var i = nextIdx(c), v = curVal(c), pct, meta;
  if(i < 0){ pct = 100; meta = '<span>All tiers complete ' + (c.scope === 'session' ? '🏆' : '🎉') + '</span><em></em>'; }
  else {
    var n = c.t[i]; pct = Math.min(100, Math.floor(v / n * 100));
    meta = '<span>' + fmt(v) + ' / ' + fmt(n) + '</span><em>' + TIERS[i].e + ' ' + TIERS[i].nm + ' · +' + TIERS[i].c + ' 🪙</em>';
  }
  return '<div class="cbm-card"><div class="cbm-row"><div class="cbm-ico">' + c.icon + '</div><div class="cbm-grow"><div class="cbm-name">' + c.name +
    '</div><div class="cbm-desc">' + c.desc + '</div></div></div>' + bar(pct, pct >= 100) + '<div class="cbm-meta">' + meta + '</div></div>';
}
function recCard(r){
  var P = D[r.p], target = Math.max(D.rec[r.p] + 1, r.floor), pct = Math.min(100, Math.floor(P.combos / target * 100));
  var done = !!D.done[r.id + ':' + P.k];
  return '<div class="cbm-card"><div class="cbm-row"><div class="cbm-ico">' + r.icon + '</div><div class="cbm-grow"><div class="cbm-name">' + r.name +
    '</div><div class="cbm-desc">' + r.desc + (D.rec[r.p] < r.floor ? ' (needs ' + r.floor + '+)' : '') + '</div></div></div>' +
    bar(done ? 100 : pct, done) + '<div class="cbm-meta"><span>' + (done ? 'Done ✅' : fmt(P.combos) + ' / ' + fmt(target)) +
    '</span><em>Best: ' + fmt(Math.max(D.rec[r.p], P.combos)) + '</em></div></div>';
}
function chalGroup(scope, label){
  var h = '';
  CH.forEach(function(c){ if(c.scope === scope) h += chalCard(c); });
  RECS.forEach(function(r){ if(r.p === scope) h += recCard(r); });
  return '<div class="cbm-sub">' + label + '</div>' + h;
}
/* ---- medal collection cards: used ONLY by Medal Grab ---- */
function nextLine(c){
  var i = nextIdx(c);
  if(i < 0) return '<div class="cbm-next cbm-ok">All 4 medals collected 🎉</div>';
  var t = TIERS[i], n = c.t[i], v = curVal(c), st = c.metric === 'streak';
  return '<div class="cbm-next">Next: ' + t.e + ' ' + t.nm + ' at ' + (st ? '×' + n : fmt(n)) + ' · your best ' + (st ? '×' + v : fmt(v)) + '</div>';
}
function medalCard(c, ids){
  var h = '<div class="cbm-card"><div class="cbm-row"><div class="cbm-ico">' + c.icon + '</div><div class="cbm-grow"><div class="cbm-name">' + c.name +
    '</div><div class="cbm-desc">' + c.desc + '</div></div><span class="cbm-scope">' + SCOPE_LBL[c.scope] + '</span></div><div class="cbm-medals">';
  c.t.forEach(function(n, i){
    var t = TIERS[i], id = c.id + '_' + t.k, got = !!D.awarded[id];
    h += '<div class="cbm-mcell' + (got && ids[id] ? ' cbm-newm' : '') + '">' + medalSVG(t.k, c.icon, !got) + t.nm + '<small>' + (c.metric === 'streak' ? '×' + n : fmt(n)) + '</small></div>';
  });
  return h + '</div>' + nextLine(c) + '</div>';
}
function recMedalCard(ids){
  var h = '<div class="cbm-card"><div class="cbm-row"><div class="cbm-ico">📈</div><div class="cbm-grow"><div class="cbm-name">Personal Record Medals</div>' +
    '<div class="cbm-desc">Beat your best combo total for a day, week or month</div></div></div><div class="cbm-medals cbm-three">';
  RECS.forEach(function(r){
    var got = !!D.awarded[r.id];
    h += '<div class="cbm-mcell' + (got && ids[r.id] ? ' cbm-newm' : '') + '">' + medalSVG(r.tier, r.icon, !got) + r.name.replace(' Record', '') + '<small>' + TB[r.tier].nm + ' · ' + r.floor + '+</small></div>';
  });
  return h + '</div><div class="cbm-next">Weekly and monthly records are awarded when the week or month ends.</div></div>';
}
function cheer(){ return '<div class="cbm-cheer">' + CHEER[D.tot.combos % CHEER.length] + '</div>'; }
function renderGrab(info){
  var earned = Object.keys(D.awarded).length, h = '';
  if(info && info.n > 0){
    h += '<div class="cbm-celebrate"><span class="cbm-spark">🎉</span><div><b>' + info.n + ' new medal' + (info.n > 1 ? 's' : '') + '!</b><small>Marked NEW below — nice work!</small></div></div>';
  }
  h += '<div class="cbm-card cbm-hero"><div class="cbm-hero-top"><div><b>🏅 ' + earned + ' / ' + TOTAL_MEDALS + '</b><span>Medals collected</span></div>' +
    '<div><b>🪙 ' + fmt(D.coins) + '</b><span>Total coins</span></div></div>' + chips() + '</div>' +
    '<div class="cbm-sec">Medal collection</div>';
  CH.forEach(function(c){ h += medalCard(c, info ? info.ids : {}); });
  h += recMedalCard(info ? info.ids : {});
  if(grabFrom !== 'ach') h += '<button class="cbm-linkbtn" data-cbm="toach">📊 View Achievements</button><div class="cbm-linknote">Stats, personal records &amp; challenge progress</div>';
  h += cheer();
  el('cbm-grab-body').innerHTML = h;
  el('cbm-grab-coins').textContent = '🪙 ' + fmt(D.coins);
}
function periodCard(lbl, p){
  return '<div class="cbm-pcard"><span class="cbm-plbl">' + lbl + '</span><b>' + fmt(p.combos) + '</b><span class="cbm-punit">combos</span><ul>' +
    '<li>💥 ' + fmt(p.multi) + ' multi-line</li><li>🔥 ×' + fmt(p.streak) + ' streak</li><li>⭐ ' + fmt(p.score) + '</li></ul></div>';
}
function tile(ico, lbl, val){ return '<div class="cbm-tile"><span>' + ico + '</span><b>' + val + '</b><small>' + lbl + '</small></div>'; }
function renderAch(){
  var h = '<div class="cbm-3 cbm-p3">' + periodCard('Today', D.day) + periodCard('This week', D.week) + periodCard('This month', D.month) + '</div>' +
    '<div class="cbm-sec">Classic Mode statistics</div><div class="cbm-tiles">' +
    tile('🍬', 'Total combos', fmt(D.tot.combos)) + tile('💥', 'Multi-line clears', fmt(D.tot.multi)) +
    tile('🔥', 'Best streak', '×' + fmt(D.rec.streak)) + tile('⭐', 'Best score', fmt(D.rec.score)) + '</div>' +
    '<div class="cbm-sec">Personal records</div><div class="cbm-card"><div class="cbm-subin">Single game</div><ul class="cbm-list">' +
    '<li><span>⭐ Best score (one game)</span><span>' + fmt(D.rec.score) + '</span></li>' +
    '<li><span>🔥 Best streak (one game)</span><span>×' + fmt(D.rec.streak) + '</span></li></ul>' +
    '<div class="cbm-subin">Combo totals</div><ul class="cbm-list">' +
    '<li><span>🍬 Best daily total</span><span>' + fmt(Math.max(D.rec.day, D.day.combos)) + '</span></li>' +
    '<li><span>🍭 Best weekly total</span><span>' + fmt(Math.max(D.rec.week, D.week.combos)) + '</span></li>' +
    '<li><span>🍩 Best monthly total</span><span>' + fmt(Math.max(D.rec.month, D.month.combos)) + '</span></li></ul></div>' +
    '<div class="cbm-sec">Challenge progress</div>' +
    chalGroup('session', 'Single game — streak &amp; score') + chalGroup('day', 'Daily totals') + chalGroup('week', 'Weekly totals') + chalGroup('month', 'Monthly totals');
  var names = {}; CH.forEach(function(c){ TIERS.forEach(function(t){ names[c.id + '_' + t.k] = {t:t, n:c.name, i:c.icon}; }); });
  RECS.forEach(function(r){ names[r.id] = {t:TB[r.tier], n:r.name, i:r.icon}; });
  var list = Object.keys(D.done).sort(function(a, b){ return D.done[b] - D.done[a]; }).slice(0, 15);
  h += '<div class="cbm-sec">Completed challenges · ' + Object.keys(D.done).length + '</div><div class="cbm-card">';
  h += list.length ? '<ul class="cbm-list">' + list.map(function(k){
    var m = names[k.split(':')[0]]; if(!m) return '';
    return '<li><span>' + m.i + ' ' + m.n + ' · ' + m.t.nm + '</span><span>' + fmtDate(D.done[k]) + '</span></li>';
  }).join('') + '</ul>' : '<div class="cbm-empty">Nothing completed yet — you\'ve got this!</div>';
  h += '</div><div class="cbm-sec">Earned medals</div><div class="cbm-card cbm-center"><div class="cbm-bigline">🏅 ' + Object.keys(D.awarded).length + ' / ' + TOTAL_MEDALS + ' collected</div>' + chips() +
    (achFrom === 'grab' ? '' : '<button class="cbm-linkbtn" data-cbm="tograb">🎁 View Medal Grab</button>') + '</div>' + cheer();
  el('cbm-ach-body').innerHTML = h;
  el('cbm-ach-coins').textContent = '🪙 ' + fmt(D.coins);
}
function el(id){ return document.getElementById(id); }
function updateDot(){
  if(!giftEl) return;
  var unseen = D.ev.filter(function(e){ return !e.sh; }).length;
  var newMedals = Math.max(0, Object.keys(D.awarded).length - D.seen);
  var n = Math.max(unseen, newMedals);
  giftEl.classList.toggle('cbm-has-new', n > 0);
  var d = giftEl.querySelector('.cbm-dot'); if(d) d.textContent = n > 9 ? '9+' : String(n);
}
function markSeen(){
  D.ev.forEach(function(e){ e.sh = 1; });
  D.seen = Object.keys(D.awarded).length;
  saveNow(); updateDot();
}
function openScreen(which, from){
  roll(nowMs());
  hideSummary(true);
  if(which === 'grab'){
    var info = newMedals();            // read BEFORE markSeen() so new medals can be celebrated
    markSeen();
    grabFrom = from || null;
    renderGrab(info);
    achEl.style.zIndex = ''; grabEl.style.zIndex = '9002';
    grabEl.classList.add('cbm-on'); el('cbm-grab-body').scrollTop = 0;
  } else {
    achFrom = from || null;
    renderAch();
    grabEl.style.zIndex = ''; achEl.style.zIndex = '9002';
    achEl.classList.add('cbm-on'); el('cbm-ach-body').scrollTop = 0;
  }
}
function closeScreens(){
  /* Back returns to the screen that opened this one */
  if(achEl && achEl.classList.contains('cbm-on') && achFrom === 'grab'){ achEl.classList.remove('cbm-on'); achFrom = null; return; }
  if(grabEl && grabEl.classList.contains('cbm-on') && grabFrom === 'ach'){ grabEl.classList.remove('cbm-on'); grabFrom = null; return; }
  if(grabEl) grabEl.classList.remove('cbm-on');
  if(achEl) achEl.classList.remove('cbm-on');
  grabFrom = achFrom = null;
}

var launchDone = false, sumTimer = null;
function hideSummary(instant){
  clearTimeout(sumTimer);
  if(!sumEl) return;
  sumEl.classList.remove('cbm-show');
  if(instant) sumEl.classList.remove('cbm-on');
  else setTimeout(function(){ sumEl.classList.remove('cbm-on'); }, 280);
}
function homeReady(){
  var home = el('home-screen'), ov = el('privacy-consent-overlay'), sp = el('splash-screen');
  if(!home || !home.classList.contains('active')) return false;
  if(ov && ov.classList.contains('cb-show')) return false;
  if(sp && sp.style.display !== 'none' && !sp.classList.contains('splash-hide')) return false;
  if(grabEl.classList.contains('cbm-on') || achEl.classList.contains('cbm-on')) return false;
  return true;
}
function escHtml(t){ return String(t).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function tryLaunchSummary(){
  if(launchDone) return true;
  if(!homeReady()) return false;
  launchDone = true;
  roll(nowMs());
  var unseen = D.ev.filter(function(e){ return !e.sh; });
  var sig = [D.day.combos, D.week.combos, D.month.combos, Object.keys(D.awarded).length].join('|');
  var active = D.day.combos + D.week.combos + D.month.combos > 0;
  if(!unseen.length && (!active || sig === D.sum.sig)){ updateDot(); return true; }
  var bp = bestProgress(), h = '<h4>🍬 ' + (unseen.length ? 'New rewards!' : 'Your progress') + '</h4><ul>';
  unseen.slice(-4).forEach(function(e){ h += '<li>' + escHtml(e.msg) + '</li>'; });
  if(unseen.length > 4) h += '<li>…and ' + (unseen.length - 4) + ' more</li>';
  if(bp) h += '<li>🎯 ' + bp.c.name + ': ' + fmt(bp.v) + ' / ' + fmt(bp.n) + ' (' + TIERS[bp.i].nm + ')</li>';
  h += '<li>📅 Today ' + fmt(D.day.combos) + ' · Week ' + fmt(D.week.combos) + ' · Month ' + fmt(D.month.combos) + ' combos</li></ul>' +
    '<p>' + CHEER[0] + '</p><div class="cbm-sum-btns"><button data-cbm="sumclose">Later</button><button class="cbm-pri" data-cbm="sumopen">🎁 Medal Grab</button></div>';
  sumEl.innerHTML = h;
  unseen.forEach(function(e){ e.sh = 1; });
  D.sum = {ts:D.lastSeen, sig:sig};
  saveNow(); updateDot();
  sumEl.classList.add('cbm-on');
  setTimeout(function(){ sumEl.classList.add('cbm-show'); }, 30);
  sumTimer = setTimeout(function(){ hideSummary(false); }, 9000);
  return true;
}

/* ---------------- boot ---------------- */
function build(){
  var wrap = document.createElement('div');
  wrap.id = 'cbm-root';
  wrap.innerHTML = DEFS +
    '<div class="cbm-screen" id="cbm-grab" role="dialog" aria-label="Medal Grab"><div class="cbm-head"><button class="cbm-back" data-cbm="close" aria-label="Back">‹</button><div class="cbm-title">🎁 MEDAL GRAB</div><div class="cbm-coins" id="cbm-grab-coins">🪙 0</div></div><div class="cbm-body" id="cbm-grab-body"></div></div>' +
    '<div class="cbm-screen" id="cbm-ach" role="dialog" aria-label="Achievements"><div class="cbm-head"><button class="cbm-back" data-cbm="close" aria-label="Back">‹</button><div class="cbm-title">🏅 ACHIEVEMENTS</div><div class="cbm-coins" id="cbm-ach-coins">🪙 0</div></div><div class="cbm-body" id="cbm-ach-body"></div></div>' +
    '<div id="cbm-toast" role="status" aria-live="polite"></div><div id="cbm-sum" role="status"></div>';
  document.body.appendChild(wrap);
  grabEl = el('cbm-grab'); achEl = el('cbm-ach'); toastEl = el('cbm-toast'); sumEl = el('cbm-sum');
  wrap.addEventListener('click', function(e){
    var t = e.target.closest ? e.target.closest('[data-cbm]') : null;
    if(!t) return;
    var a = t.getAttribute('data-cbm');
    if(a === 'close') closeScreens();
    else if(a === 'sumclose') hideSummary(false);
    else if(a === 'sumopen') openScreen('grab');
    else if(a === 'toach') openScreen('ach', 'grab');
    else if(a === 'tograb') openScreen('grab', 'ach');
  });
  toastEl.addEventListener('click', function(){
    toastQ.length = 0; toastEl.classList.remove('cbm-show');
    openScreen('grab');
  });
  var hb = document.querySelector('#home-screen .home-buttons');
  if(hb){
    var hbtn = document.createElement('button');
    hbtn.className = 'btn'; hbtn.id = 'cbm-home-btn'; hbtn.type = 'button';
    hbtn.innerHTML = '\ud83c\udf81 MEDAL GRAB<span class="cbm-dot"></span>';
    hbtn.addEventListener('click', function(){ openScreen('grab'); });
    hb.appendChild(hbtn); giftEl = hbtn;
  }
  var reset = el('btn-reset-best');
  if(reset && reset.parentNode){
    var b = document.createElement('button');
    b.className = 'btn btn-tertiary'; b.id = 'cbm-ach-btn'; b.type = 'button'; b.style.marginTop = '14px';
    b.textContent = '🏅 ACHIEVEMENTS';
    b.addEventListener('click', function(){ openScreen('ach'); });
    var g = document.createElement('button');
    g.className = 'btn btn-tertiary'; g.id = 'cbm-grab-btn'; g.type = 'button'; g.style.marginTop = '14px';
    g.textContent = '🎁 MEDAL GRAB';
    g.addEventListener('click', function(){ openScreen('grab'); });
    reset.parentNode.insertBefore(g, reset);
    reset.parentNode.insertBefore(b, reset);
  }
}
function init(){
  D = load();
  roll(nowMs());
  gameScreen = el('game-screen'); modeTag = el('mode-tag'); streakEl = el('streak-val'); scoreEl = el('score-val'); popupEl = el('combo-popup');
  if(document.body){
    try{ build(); }catch(e){}
  }
  var mo = {childList:true, characterData:true, subtree:true};
  try{
    if(streakEl && window.MutationObserver) new MutationObserver(watchStreak).observe(streakEl, mo);
    if(scoreEl && window.MutationObserver) new MutationObserver(watchScore).observe(scoreEl, mo);
    if(popupEl && window.MutationObserver) new MutationObserver(watchPopup).observe(popupEl, mo);
  }catch(e){}
  /* launch summary is a Home-screen card: dismiss it the moment Home stops being the active screen
     (e.g. player taps CLASSIC) so it never lingers over gameplay */
  try{
    var hs = el('home-screen');
    if(hs && window.MutationObserver) new MutationObserver(function(){ if(!hs.classList.contains('active')) hideSummary(true); }).observe(hs, {attributes:true, attributeFilter:['class']});
  }catch(e){}
  updateDot();
  saveNow();
  window.addEventListener('pagehide', saveNow);
  document.addEventListener('visibilitychange', function(){
    if(document.hidden) saveNow(); else { try{ roll(nowMs()); updateDot(); scheduleSave(); }catch(e){} }
  });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeScreens(); });
  if(sumEl){
    var tries = 0, iv = setInterval(function(){
      tries++;
      var done = false;
      try{ done = tryLaunchSummary(); }catch(e){ done = true; }
      if(done || tries > 120) clearInterval(iv);
    }, 500);
  }
  window.CBMedals = Object.freeze({openMedalGrab:function(){ openScreen('grab'); }, openAchievements:function(){ openScreen('ach'); }});
}
try{ init(); }catch(e){ /* the reward system must never affect the game */ }
})();
</script>
</body>
</html>
