      <button class="btn btn-primary" id="btn-settings-back" style="margin-top:6px;">BACK</button>
    </div>

    <!-- ABOUT US (a view inside Settings; shown only while #settings-screen has .about-open) -->
    <div id="about-us-panel" role="region" aria-label="About Us">
      <div class="settings-title">ABOUT US</div>
      <div class="settings-list about-us-list">
        <div class="setting-row about-row">
          <div class="s-label">🍬 Game Name</div>
          <div class="about-v">Candy Smash</div>
        </div>
        <div class="setting-row about-row">
          <div class="s-label">🎮 Developer</div>
          <div class="about-v">Tech Arena Studio</div>
        </div>
        <div class="setting-row about-row">
          <div class="s-label">📖 About the Game</div>
          <div class="about-v">Candy Smash is a fun and colorful candy-matching puzzle game designed to provide an enjoyable casual gaming experience.</div>
        </div>
        <div class="setting-row about-row">
          <div class="s-label">✉️ Contact</div>
          <div class="about-v"><a id="about-email" href="mailto:techarenastudio@gmail.com">techarenastudio@gmail.com</a></div>
        </div>
      </div>
      <div class="settings-list about-us-back">
        <button class="btn btn-primary" id="btn-about-back">BACK</button>
      </div>
    </div>
  </div>

  <!-- GAME OVER SCREEN -->
  <div id="gameover-screen" class="screen">
    <div class="premium-go-backdrop"></div>
    <div class="premium-go-wrap">
      <div class="premium-go-character-zone">
        <div class="premium-go-sparkle pgs-1">✦</div>
        <div class="premium-go-sparkle pgs-2">✦</div>
