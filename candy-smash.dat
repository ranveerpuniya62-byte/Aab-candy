  187: { count: 2, hitsRequired: 2 }, 188: { count: 2, hitsRequired: 2 },
  189: { count: 2, hitsRequired: 2 }, 190: { count: 3, hitsRequired: 2 },
  191: { count: 2, hitsRequired: 2 }, 192: { count: 3, hitsRequired: 2 },
  193: { count: 2, hitsRequired: 2 }, 194: { count: 2, hitsRequired: 2 },
  195: { count: 2, hitsRequired: 2 }, 196: { count: 2, hitsRequired: 2 },
