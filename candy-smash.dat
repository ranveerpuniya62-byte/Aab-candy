/* ============================================================
   SCREEN NAV
============================================================ */
function showScreen(target){
  const miniGameScreens = [donutScreen, icestackScreen, puzzlepopScreen, arrowScreen];
  if(!miniGameScreens.includes(target)){
    // Always stop any running mini-game loop/timers the moment we navigate
    // to a non-mini-game screen, regardless of which button triggered the
    // navigation — this is the single choke point that guarantees no
    // requestAnimationFrame loop or timer is ever left running in the
    // background after leaving a mini-game.
    stopAllMiniGames();
  }
  if(target !== gameScreen){
    // Leaving the Classic board entirely (home, settings, game over,
    // journey screens, more games, mini-games) — cancel any pending or
    // in-flight rare Tornado event so it can never fire off-screen and no
    // stray timer is ever left running in the background.
    cancelTornadoSession();
    hideJourneyLevelIntro();
    if(bossIntroTimeoutId){ clearTimeout(bossIntroTimeoutId); bossIntroTimeoutId = null; }
    el('boss-intro-overlay').classList.add('boss-intro-hidden');
  }
  [homeScreen, gameScreen, settingsScreen, gameoverScreen, journeyLevelsScreen, journeyPreviewScreen, journeyCompleteScreen, journeyFailedScreen, moreGamesScreen, donutScreen, icestackScreen, puzzlepopScreen, arrowLevelsScreen, arrowScreen].forEach(s=>s.classList.remove('active'));
  target.classList.add('active');
  try{ if(window.HomeBannerController) window.HomeBannerController.sync(); }catch(e){}
}

