  <!-- MINI-GAME: DONUT DROP -->
  <div id="donut-screen" class="screen minigame-screen">
    <div class="minigame-topbar">
      <button class="icon-btn" id="btn-donut-back">⬅️</button>
      <div class="minigame-hud">
        <div class="score-box"><div class="lbl">SCORE</div><div class="val" id="donut-score">0</div></div>
      </div>
      <div style="display:flex; gap:8px;">
        <button class="icon-btn" id="btn-donut-restart">🔄</button>
        <button class="icon-btn" id="btn-donut-home">🏠</button>
      </div>
    </div>
    <div class="minigame-stage">
      <div class="minigame-canvas-wrap" id="donut-canvas-wrap">
        <canvas id="donut-canvas"></canvas>
        <div class="minigame-overlay mg-hidden" id="donut-overlay">
          <div class="minigame-overlay-panel">
            <div class="minigame-overlay-emoji">🌶️</div>
            <div class="minigame-overlay-title">GAME OVER</div>
            <div class="minigame-overlay-score">Score: <b id="donut-final-score">0</b></div>
            <div class="go-buttons">
              <button class="btn btn-tertiary" id="btn-donut-go-back">BACK</button>
              <button class="btn btn-primary" id="btn-donut-go-restart">RESTART</button>
            </div>
          </div>
        </div>
        <!-- Levels mode: objectives HUD (hidden unless #donut-screen.dn-level-mode) -->
        <div class="dn-lvl-hud" id="donut-lvl-hud">
          <div class="dn-lvl-hud-level" id="donut-lvl-hud-level">LEVEL 1</div>
          <div class="dn-lvl-milestone" id="dn-hud-milestone" aria-live="polite"></div>
          <div class="dn-lvl-hud-row">
            <div class="dn-lvl-chip" id="dn-hud-score-chip">
              <div class="dn-lvl-chip-top"><span class="dn-lvl-chip-lbl">SCORE</span><span class="dn-lvl-chip-val" id="dn-hud-score">0 / 1,000</span></div>
              <div class="dn-lvl-bar" id="dn-hud-score-track" role="progressbar" aria-label="Score progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i id="dn-hud-score-bar"></i></div>
            </div>
            <div class="dn-lvl-chip" id="dn-hud-time-chip">
              <div class="dn-lvl-chip-top"><span class="dn-lvl-chip-lbl">TIME</span><span class="dn-lvl-chip-val" id="dn-hud-time">06:00</span></div>
            </div>
          </div>
          <div class="dn-lvl-hud-row">
            <div class="dn-lvl-chip" id="dn-hud-donuts-chip">
              <div class="dn-lvl-chip-top"><span class="dn-lvl-chip-lbl">DONUTS CAUGHT</span><span class="dn-lvl-chip-val" id="dn-hud-donuts">0</span></div>
            </div>
