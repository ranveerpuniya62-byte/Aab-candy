  // (kept separate, same pattern as CUSTOM_LEVEL_BOMBS/chocolate) — these
  // entries are only the level's OTHER objectives. 181-192 are rainbow-only
  // (empty array — an empty array is still truthy, so this custom branch
  // is still taken); 193-196 add a normal candy target; 197-199 each pair
  // Rainbow with one existing mechanic (frozen/locked/jelly).
  181: [], 182: [], 183: [], 184: [],
  185: [], 186: [], 187: [], 188: [],
  189: [], 190: [], 191: [], 192: [],
  193: [{ type: 'pink', target: 8 }],
  194: [{ type: 'blue', target: 8 }],
  195: [{ type: 'yellow', target: 10 }],
