/* ============================================================
   PERSISTENCE
============================================================ */
function loadBest(){
  try{
    const v = localStorage.getItem('candyBlastBest');
    return v ? parseInt(v,10) : 0;
  }catch(e){ return 0; }
}
let _saveBestT = 0;
function flushBest(){ if(_saveBestT){ clearTimeout(_saveBestT); _saveBestT = 0; } try{ localStorage.setItem('candyBlastBest', String(best)); }catch(e){} }
window.addEventListener('pagehide', ()=>{ if(_saveBestT) flushBest(); });
document.addEventListener('visibilitychange', ()=>{ if(document.hidden && _saveBestT) flushBest(); });
function saveBest(){
  // Root cause (perf): a synchronous localStorage write ran inside the tap/release handler whenever the score beat the best.
  if(!_saveBestT) _saveBestT = setTimeout(flushBest, 400);
  // Every score site calls updateScoreUI() BEFORE it raises `best`, so Home / in-game Best
  // lagged behind (e.g. Home 1041 while the real best was 1068). Refresh them right here,
  // the moment the best value changes.
  bestValEl.textContent = best;
  homeBestEl.textContent = best;
}
function loadSettings(){
  try{
    const v = JSON.parse(localStorage.getItem('candyBlastSettings'));
    if(v) settings = Object.assign(settings, v);
  }catch(e){}
}
function saveSettings(){
  try{ localStorage.setItem('candyBlastSettings', JSON.stringify(settings)); }catch(e){}
}
// Validates a raw saved level-keyed object (completed / stars) against the
// real 1..JOURNEY_TOTAL_LEVELS range, dropping anything invalid/corrupted
// (non-numeric keys, out-of-range levels, NaN values) instead of trusting
// it as-is. Never lets bad storage data reach the UI as undefined/NaN.
function sanitizeJourneyLevelMap(raw, isStars){
  const out = {};
  if(!raw || typeof raw!=='object') return out;
  for(const key in raw){
    const n = parseInt(key, 10);
    if(!Number.isInteger(n) || n<1 || n>JOURNEY_TOTAL_LEVELS) continue;
    if(isStars){
      const s = parseInt(raw[key], 10);
      if(Number.isInteger(s) && s>=0 && s<=3) out[n] = s;
    } else {
      if(raw[key]) out[n] = true;
    }
  }
  return out;
}
function loadJourneyProgress(){
  try{
    const v = JSON.parse(localStorage.getItem('candyBlastJourneyProgress'));
    if(v && typeof v==='object'){
      // Clamp "unlocked" to a valid level number — corrupted/tampered
      // storage (e.g. unlocked:99999 or unlocked:0) can never unlock a
      // level that shouldn't exist or lock out Level 1.
      let unlocked = parseInt(v.unlocked, 10);
      if(!Number.isInteger(unlocked) || unlocked<1) unlocked = 1;
      if(unlocked>JOURNEY_TOTAL_LEVELS) unlocked = JOURNEY_TOTAL_LEVELS;
      journeyProgress.unlocked = unlocked;
      journeyProgress.completed = sanitizeJourneyLevelMap(v.completed, false);
      journeyProgress.stars = sanitizeJourneyLevelMap(v.stars, true);
    } else {
      // Nothing saved yet, or the stored value wasn't an object (corrupted
      // JSON) — fall back to a clean, valid default state rather than
      // leaving journeyProgress in a partial/undefined condition.
      journeyProgress.unlocked = 1;
      journeyProgress.completed = {};
      journeyProgress.stars = {};
    }
  }catch(e){
    // JSON.parse failed (corrupted localStorage value) — recover safely
    // with the same clean default instead of crashing or leaving stale data.
    journeyProgress.unlocked = 1;
    journeyProgress.completed = {};
    journeyProgress.stars = {};
  }
}
function saveJourneyProgress(){
  try{ localStorage.setItem('candyBlastJourneyProgress', JSON.stringify(journeyProgress)); }catch(e){}
}
function loadArrowProgress(){
  try{
    const v = JSON.parse(localStorage.getItem('candyBlastArrowProgress'));
    if(v && typeof v==='object'){
      arrowProgress.unlocked = v.unlocked || 1;
      arrowProgress.completed = v.completed || {};
    }
  }catch(e){}
}
function saveArrowProgress(){
  try{ localStorage.setItem('candyBlastArrowProgress', JSON.stringify(arrowProgress)); }catch(e){}
}

/* ============================================================
   AUDIO — Web Audio API only, no external files, fully offline.
   A single reusable AudioContext is created lazily on the player's
   first interaction (never autoplayed), and a single reusable noise
   buffer is generated once and reused for every "sparkle"/"poof"
   texture, so nothing expensive is recreated on repeated plays.
============================================================ */
let noiseBuffer = null;

function ensureAudio(){
  if(!audioCtx){
    try{ audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){}
  }
  if(audioCtx && audioCtx.state==='suspended'){
    audioCtx.resume().catch(()=>{});
  }
}

// One-time global listeners so the AudioContext is created/resumed the
// instant the player first touches or clicks anywhere, per mobile autoplay
// rules (never attempted before a real user gesture).
function primeAudioOnFirstInteraction(){
  ensureAudio();
  setTimeout(()=>{ try{ if(audioCtx) getNoiseBuffer(); }catch(e){} }, 400);
  document.removeEventListener('pointerdown', primeAudioOnFirstInteraction);
  document.removeEventListener('touchstart', primeAudioOnFirstInteraction);
  document.removeEventListener('click', primeAudioOnFirstInteraction);
}
document.addEventListener('pointerdown', primeAudioOnFirstInteraction, {once:true});
document.addEventListener('touchstart', primeAudioOnFirstInteraction, {once:true});
document.addEventListener('click', primeAudioOnFirstInteraction, {once:true});

function getNoiseBuffer(){
  if(noiseBuffer) return noiseBuffer;
  const duration = 0.45;
  const sampleRate = audioCtx.sampleRate;
  const length = Math.max(1, Math.floor(sampleRate*duration));
  const buffer = audioCtx.createBuffer(1, length, sampleRate);
  const data = buffer.getChannelData(0);
  for(let i=0;i<length;i++){
    data[i] = (Math.random()*2-1) * Math.pow(1 - i/length, 1.6);
  }
  noiseBuffer = buffer;
  return buffer;
}

// A single pitched tone with a soft attack and exponential decay, optionally
// sweeping from one frequency to another (used for the little "bounce" in
// candy pops). Kept short and gentle — no harsh beeps.
function playTone(opts){
  if(!audioCtx) return;
  const t0 = audioCtx.currentTime + (opts.delay||0);
  const osc = audioCtx.createOscillator();
  const gainNode = audioCtx.createGain();
  osc.type = opts.type || 'sine';
  osc.frequency.setValueAtTime(Math.max(20,opts.freq), t0);
  if(opts.freqEnd){
    osc.frequency.exponentialRampToValueAtTime(Math.max(20,opts.freqEnd), t0+opts.dur);
  }
  const g = opts.gain!=null ? opts.gain : 0.15;
  gainNode.gain.setValueAtTime(0, t0);
  gainNode.gain.linearRampToValueAtTime(g, t0+(opts.attack||0.008));
  gainNode.gain.exponentialRampToValueAtTime(0.0008, t0+opts.dur);
  osc.connect(gainNode); gainNode.connect(audioCtx.destination);
  osc.start(t0); osc.stop(t0+opts.dur+0.03);
}

// A short filtered burst of the shared noise buffer — used for the
// "sparkle"/candy-fizz texture on clears, and the soft "poof" on bombs.
function playNoiseBurst(freqStart, freqEnd, dur, gainVal, delay, filterType){
  if(!audioCtx) return;
  const t0 = audioCtx.currentTime + (delay||0);
  const src = audioCtx.createBufferSource();
  src.buffer = getNoiseBuffer();
  const filter = audioCtx.createBiquadFilter();
  filter.type = filterType || 'bandpass';
  filter.frequency.setValueAtTime(freqStart, t0);
  if(freqEnd){ filter.frequency.exponentialRampToValueAtTime(Math.max(60,freqEnd), t0+dur); }
  filter.Q.value = 1.1;
  const gainNode = audioCtx.createGain();
  gainNode.gain.setValueAtTime(0, t0);
  gainNode.gain.linearRampToValueAtTime(gainVal, t0+0.01);
  gainNode.gain.exponentialRampToValueAtTime(0.0008, t0+dur);
  src.connect(filter); filter.connect(gainNode); gainNode.connect(audioCtx.destination);
  src.start(t0); src.stop(t0+dur+0.02);
}

/* ---- Individual candy-themed sound designs ---- */

// 🍬 Block placement: a crisp candy "click" transient plus a bright layered
// bell chime — clearly different character from the old soft swoop, and
// still with a tiny random pitch variance each time so repeated
// placements never sound perfectly identical. Fires on every single
// placement (normal pieces, Bomb, Tornado, every special) since it's
// called unconditionally at the top of commitPlacement().
function soundPlace(){
  const variance = 1 + (Math.random()*0.12 - 0.06); // ±6%
  const base = 520*variance;
  playTone({freq:base, freqEnd:base*1.55, dur:0.075, type:'square', gain:0.075, attack:0.002});
  playTone({freq:base*2.25, dur:0.09, type:'sine', gain:0.09, delay:0.012, attack:0.003});
  playTone({freq:base*3.4,  dur:0.07, type:'sine', gain:0.05, delay:0.03, attack:0.003});
}

// 🍭✨ Row/column clear: bright sweet pop + a short candy-sparkle fizz +
// a gentle rising chime tail — clearly different from the placement sound.
function soundClear(){
  const base = 640;
  playTone({freq:base, freqEnd:base*1.35, dur:0.13, type:'sine', gain:0.15, attack:0.004});
  playNoiseBurst(3200, 5400, 0.12, 0.05, 0.02, 'bandpass');
  [0, 0.075].forEach((d,i)=>{
    playTone({freq:base*1.3*(1+i*0.3), dur:0.15, type:'sine', gain:0.09-(i*0.02), delay:0.05+d, attack:0.005});
  });
}

// 🎉 Multi-line combo: the base clear sound, scaled up with extra layers
// depending on how many lines cleared at once — more lines, more excitement,
// but volume stays capped so it never gets harsh or too loud.
function soundCombo(lines){
  const n = lines || 2;
  soundClear();
  const riseNotes = n>=3 ? [0, 0.09, 0.17] : [0, 0.1];
  const startFreq = 700;
  riseNotes.forEach((d,i)=>{
    playTone({freq:startFreq*Math.pow(1.26,i+1), dur:0.15, type:'triangle', gain:Math.max(0.055,0.11-i*0.018), delay:0.14+d, attack:0.004});
  });
  if(n>=3){
    playNoiseBurst(4200, 7000, 0.16, 0.04, 0.2, 'highpass');
  }
}

// 💥 Bomb: short playful cartoon "poof" — a quick descending pop, a soft
// low-passed noise puff (not harsh white noise), and a couple of light
// sparkle notes after, keeping the candy-blast feel rather than anything
// realistic or scary.
function soundBomb(){
  const base = 150 + Math.random()*20;
  playTone({freq:base*1.6, freqEnd:base*0.5, dur:0.2, type:'triangle', gain:0.14, attack:0.003});
  playNoiseBurst(1100, 280, 0.2, 0.1, 0, 'lowpass');
  [0.15, 0.21].forEach((d,i)=>{
    playTone({freq:900+i*280, dur:0.09, type:'sine', gain:0.045, delay:d});
  });
}

// Soft, gentle descending game-over cue — not scary or dramatic.
function soundGameOver(){
  [520,430,340].forEach((f,i)=>{
    playTone({freq:f, dur:0.22, type:'sine', gain:0.1, delay:i*0.14, attack:0.008});
  });
}

// Tiny neutral UI click for buttons.
function soundButton(){
  playTone({freq:560, dur:0.05, type:'sine', gain:0.07, attack:0.002});
}

// Soft "can't place that" cue for invalid drops.
function soundInvalid(){
  playTone({freq:220, freqEnd:170, dur:0.11, type:'square', gain:0.06, attack:0.003});
}

/* ---- Blast Journey sounds ---- */

// Short candy sparkle when a level starts.
function soundLevelStart(){
  playTone({freq:700, freqEnd:950, dur:0.14, type:'sine', gain:0.12, attack:0.006});
  playNoiseBurst(3500, 5500, 0.1, 0.04, 0.05, 'bandpass');
}

// Small POP when a target candy is collected.
function soundCollect(){
  const variance = 1 + (Math.random()*0.1 - 0.05);
  playTone({freq:820*variance, freqEnd:1100*variance, dur:0.08, type:'sine', gain:0.1, attack:0.004});
}

// Brighter sparkle the moment a specific target is fully completed.
function soundTargetDone(){
  playTone({freq:700, freqEnd:1050, dur:0.14, type:'triangle', gain:0.12, attack:0.004});
  playNoiseBurst(4000, 6500, 0.12, 0.045, 0.03, 'highpass');
}

// Happy candy celebration for level complete.
function soundLevelComplete(){
  [523,659,784,1047].forEach((f,i)=>{
    playTone({freq:f, dur:0.18, type:'sine', gain:0.13, delay:i*0.09, attack:0.006});
  });
  playNoiseBurst(3000, 6000, 0.2, 0.05, 0.15, 'bandpass');
}

// Soft descending cue for a failed level — same gentle character as game-over.
function soundLevelFailed(){
  [400,320,250].forEach((f,i)=>{
    playTone({freq:f, dur:0.2, type:'sine', gain:0.1, delay:i*0.13, attack:0.008});
  });
}

/* ---- Tornado power-up sounds (Classic mode only) ---- */

// 🌪️ Warning: a soft rising wind whoosh just before the tornado appears.
function soundTornadoWarn(){
  playNoiseBurst(500, 1600, 0.35, 0.06, 0, 'bandpass');
  playTone({freq:300, freqEnd:520, dur:0.3, type:'sine', gain:0.05, attack:0.03});
}
// 🌪️ Spawn: a magical rising sweep as the funnel grows in.
function soundTornadoSpawn(){
  playTone({freq:260, freqEnd:820, dur:0.4, type:'triangle', gain:0.1, attack:0.02});
  playTone({freq:520, freqEnd:1200, dur:0.35, type:'sine', gain:0.06, delay:0.06, attack:0.02});
  playNoiseBurst(800, 2600, 0.4, 0.05, 0.05, 'bandpass');
}
// 🌪️ Suction: a light continuous swirl texture while candies spiral in.
function soundTornadoSuck(){
  playNoiseBurst(1200, 2600, 0.6, 0.045, 0, 'bandpass');
  playTone({freq:700, freqEnd:1000, dur:0.5, type:'sine', gain:0.035, attack:0.05});
}
// 🌪️💥 Clear: a strong, satisfying candy-blast pop/whoosh for the big 6×6 clear.
function soundTornadoClear(){
  soundClear();
  playTone({freq:200, freqEnd:70, dur:0.3, type:'triangle', gain:0.13, attack:0.004});
  playNoiseBurst(2600, 6000, 0.28, 0.08, 0.03, 'bandpass');
  [0,0.09,0.18].forEach((d,i)=>{
    playTone({freq:900*Math.pow(1.22,i+1), dur:0.16, type:'sine', gain:0.07-i*0.015, delay:0.12+d, attack:0.004});
  });
}
// 🌪️✨ Disappear: a soft fading sparkle as the funnel shrinks away.
function soundTornadoDisappear(){
  playTone({freq:1200, freqEnd:1700, dur:0.22, type:'sine', gain:0.06, attack:0.006});
  playNoiseBurst(4000, 6000, 0.18, 0.035, 0.05, 'highpass');
}

function playSound(name, arg){
  if(!settings.sound) return;
  ensureAudio();
  if(!audioCtx) return;
  if(name==='place') soundPlace();
  else if(name==='clear') soundClear();
  else if(name==='combo') soundCombo(arg);
  else if(name==='bomb') soundBomb();
  else if(name==='gameover') soundGameOver();
  else if(name==='button') soundButton();
  else if(name==='invalid') soundInvalid();
  else if(name==='levelstart') soundLevelStart();
  else if(name==='collect') soundCollect();
  else if(name==='targetdone') soundTargetDone();
  else if(name==='levelcomplete') soundLevelComplete();
  else if(name==='levelfailed') soundLevelFailed();
  else if(name==='tornadowarn') soundTornadoWarn();
  else if(name==='tornadospawn') soundTornadoSpawn();
  else if(name==='tornadosuck') soundTornadoSuck();
  else if(name==='tornadoclear') soundTornadoClear();
  else if(name==='tornadodisappear') soundTornadoDisappear();
  // ---- Mini-game sounds (More Games) — reuse the same lightweight
  // Web Audio primitives as the main game, no external audio files.
  else if(name==='donut-coin') donutCoinSfx(audioCtx.destination);
  else if(name==='mg-catch') playTone({type:'triangle', freq:520, freqEnd:760, dur:0.14, gain:0.16, attack:0.005});
  else if(name==='mg-bad') playTone({type:'sawtooth', freq:200, freqEnd:90, dur:0.22, gain:0.14, attack:0.004});
  else if(name==='mg-miss') playNoiseBurst(500, 180, 0.16, 0.1, 0, 'lowpass');
  else if(name==='mg-stack') playTone({type:'square', freq:420, freqEnd:600, dur:0.09, gain:0.13, attack:0.003});
  else if(name==='mg-stackfail') playNoiseBurst(300, 90, 0.3, 0.14, 0, 'lowpass');
  else if(name==='mg-pop') playTone({type:'sine', freq:660, freqEnd:900, dur:0.11, gain:0.15, attack:0.004});
  else if(name==='mg-hint') playTone({type:'sine', freq:880, freqEnd:1080, dur:0.13, gain:0.13, attack:0.004});
  else if(name==='mg-chilli'){
    playTone({type:'sawtooth', freq:180, freqEnd:70, dur:0.28, gain:0.18, attack:0.003});
    playTone({type:'square', freq:900, freqEnd:1200, dur:0.15, gain:0.1, attack:0.002, delay:0.05});
  }
}
function vibrate(ms){
  if(settings.vibration && navigator.vibrate){ navigator.vibrate(ms); }
}

/* ============================================================
   BOARD LOGIC
============================================================ */
function createEmptyBoard(){
  const b = [];
  for(let r=0;r<SIZE;r++){
    const row=[];
    for(let c=0;c<SIZE;c++){ row.push({filled:false, obstacle:false, void:false, c1:null, c2:null, emoji:null}); }
    b.push(row);
  }
  return b;
}
// A void cell is "outside" the level's board shape — permanently blocked
// for placement, never contributes to a line clear, and is rendered fully
// invisible so the playable cells form the level's silhouette. Classic
// mode's board (built via createEmptyBoard() directly, never touched by
// the shape-mask system below) never has any void cells.
function isBlocked(r,c){ return board[r][c].filled || board[r][c].obstacle || board[r][c].void; }
function inBounds(r,c){ return r>=0 && r<SIZE && c>=0 && c<SIZE; }

function canPlaceShape(cells, rOff, cOff){
  for(const [r,c] of cells){
    const nr=rOff+r, nc=cOff+c;
    if(!inBounds(nr,nc)) return false;
    if(isBlocked(nr,nc)) return false;
  }
  return true;
}

/* ============================================================
   BLAST JOURNEY — LEVEL GENERATION
   200 levels are generated programmatically from a deterministic seeded
   RNG keyed on the level number, so every level number always produces
   the SAME level (progress is meaningful and repeatable) while every
   level is DIFFERENT from every other one. Difficulty (target counts,
   number of target types, starting-board occupancy/obstacles) scales
   smoothly from level 1 to level 200, always staying within safe,
   guaranteed-playable bounds.
============================================================ */
function mulberry32(seed){
  let a = seed >>> 0;
  return function(){
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

