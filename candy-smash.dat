    <g fill="#fff" opacity=".65">
      <circle cx="45" cy="53" r="1.5"/><circle cx="55" cy="53" r="1.5"/><circle cx="50" cy="63" r="1.5"/><circle cx="42" cy="60" r="1.4"/><circle cx="58" cy="60" r="1.4"/><circle cx="50" cy="50" r="1.3"/>
    </g>
    <ellipse cx="40" cy="40" rx="10" ry="6" fill="#fff" opacity=".42"/>
    <circle cx="35" cy="37" r="2.4" fill="#fff" opacity=".85"/>`,
    
  // ============================================================
  // PEACH - Fuzzy with gradient
  // ============================================================
  peach:(g)=>`
    <defs>
      <radialGradient id="${g}body" cx="45%" cy="45%" r="62%">
        <stop offset="0%" stop-color="#ffd4b3"/><stop offset="50%" stop-color="#ffc1a1"/><stop offset="100%" stop-color="#f0703a"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="32%" cy="28%" r="50%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.66"/><stop offset="30%" stop-color="#fff" stop-opacity="0.202"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <circle cx="50" cy="56" r="33" fill="url(#${g}body)" stroke="#d05820" stroke-width=".8"/>
    <circle cx="50" cy="56" r="33" fill="url(#${g}shine)"/>
    <path d="M50 28 L48 22 L50 18 L52 22 Z" fill="#8a6a3a" opacity=".6"/>
    <g fill="none" stroke="#e0804a" stroke-width="1.2" stroke-opacity=".15" stroke-linecap="round">
      <path d="M40 35 Q50 45 60 35"/><path d="M38 50 Q50 58 62 50"/><path d="M40 70 Q50 75 60 70"/>
    </g>
    <g fill="#c85010" opacity=".08"><circle cx="46" cy="62" r="1.2"/><circle cx="60" cy="50" r="1.1"/></g>
    <ellipse cx="38" cy="42" rx="11" ry="7" fill="#fff" opacity=".42"/>
    <circle cx="33" cy="39" r="2.6" fill="#fff" opacity=".86"/>`,
    
  // ============================================================
  // LOLLIPOP - Spiraled stick candy
  // ============================================================
  lollipop2:(g)=>`
    <defs>
      <radialGradient id="${g}pop" cx="40%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#ffb3e6"/><stop offset="50%" stop-color="#ff9ad6"/><stop offset="100%" stop-color="#d63aa0"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="30%" cy="25%" r="55%">
