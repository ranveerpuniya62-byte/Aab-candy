// ============================================================
// CANDY PATH / SWEET ROUTE — per-level config (data-driven, but UNLIKE
// every mechanic above, positions here ARE explicit — an ordered array of
// { row, col } steps, hand-authored so the route is guaranteed connected
// and valid within that level's actual board-shape mask (see
// JOURNEY_BOARD_SHAPES/getJourneyBoardShapeForLevel), per spec ("Do NOT
// randomly generate paths unless the generated path is guaranteed to be
// valid and connected"). initializePathCells() below turns this straight
// into pathCells/pathSequence at level start — no randomness involved. A
// level with no entry here has no Candy Path at all. Introduced gradually
// per spec: 191-192 (4-5 cells), 193-194 (6-7), 195-196 (8-10), 197-199
// (alongside one existing obstacle — see CUSTOM_LEVEL_OBJECTIVES: 197
// frozen, 198 locked, 199 jelly — and already alongside Rainbow/Treasure
// too, both configured above for this same 181-199 range).
// ============================================================
const CUSTOM_LEVEL_PATH = {
  191: [{row:0,col:3},{row:0,col:4},{row:1,col:4},{row:1,col:5}],
  192: [{row:7,col:3},{row:7,col:4},{row:6,col:4},{row:6,col:5},{row:5,col:5}],
  193: [{row:0,col:1},{row:0,col:2},{row:0,col:3},{row:1,col:3},{row:1,col:4},{row:1,col:5},{row:2,col:5}],
  194: [{row:7,col:6},{row:7,col:5},{row:7,col:4},{row:6,col:4},{row:6,col:3},{row:6,col:2},{row:5,col:2}],
  195: [{row:0,col:0},{row:0,col:1},{row:0,col:2},{row:1,col:2},{row:1,col:3},{row:2,col:3},{row:2,col:4},{row:3,col:4},{row:4,col:4},{row:4,col:3}],
  196: [{row:7,col:7},{row:7,col:6},{row:7,col:5},{row:6,col:5},{row:6,col:4},{row:5,col:4},{row:5,col:3},{row:4,col:3},{row:3,col:3}],
  197: [{row:0,col:3},{row:0,col:4},{row:1,col:4},{row:1,col:3},{row:2,col:3},{row:2,col:4}],
  198: [{row:7,col:4},{row:7,col:3},{row:6,col:3},{row:6,col:4},{row:5,col:4},{row:5,col:3}],
  199: [{row:0,col:2},{row:0,col:3},{row:1,col:3},{row:2,col:3},{row:2,col:4},{row:3,col:4}],
  // Level 200's own short route — its board shape mask is a full, unmasked
  // 8×8 (see JOURNEY_BOARD_SHAPES), so any in-bounds coordinates are valid.
  200: [{row:3,col:3},{row:3,col:4},{row:4,col:4},{row:4,col:5},{row:5,col:5}]
};

// ============================================================
// LIMITED MOVES — per-level move limit (data-driven: change a
// number here to retune a level, no logic changes needed).
// A level with no entry here plays with unlimited moves (null).
// ============================================================
const CUSTOM_LEVEL_MOVES = {
  81: 20, 82: 19, 83: 19, 84: 18, 85: 18,
  86: 18, 87: 17, 88: 17, 89: 16, 90: 16,
  91: 16, 92: 15, 93: 15, 94: 14, 95: 14,
  96: 15, 97: 14, 98: 13, 99: 13, 100: 12,
  200: 25 // Final boss level — deliberately generous, never unfair (per spec)
};

// Maps candy type names to their theme data
// Updated to match actual THEMES emojis
const CANDY_TYPE_MAP = {
  'pink': null,      // 🍬 pink candy
  'blue': null,      // 🍭 purple lollipop (closest to blue)
  'yellow': null,    // 🧁 yellow cupcake
  'green': null,     // 🍉 green watermelon
  'red': null,       // 🍓 red strawberry
  'orange': null,    // 🍩 orange donut
  'purple': null,    // 🍭 purple lollipop
  'brown': null      // 🍫 brown chocolate
};

// Initialize candy type map from THEMES
function initCandyTypeMap(){
  // Map types to themes by emoji
  CANDY_TYPE_MAP['pink'] = THEMES.find(t=>t.emoji==='🍬');
  CANDY_TYPE_MAP['red'] = THEMES.find(t=>t.emoji==='🍓');
  CANDY_TYPE_MAP['orange'] = THEMES.find(t=>t.emoji==='🍩');
  CANDY_TYPE_MAP['green'] = THEMES.find(t=>t.emoji==='🍉');
  CANDY_TYPE_MAP['purple'] = THEMES.find(t=>t.emoji==='🍭');
  CANDY_TYPE_MAP['brown'] = THEMES.find(t=>t.emoji==='🍫');
  CANDY_TYPE_MAP['yellow'] = THEMES.find(t=>t.emoji==='🧁');
  CANDY_TYPE_MAP['blue'] = THEMES.find(t=>t.emoji==='🍭'); // Use purple as closest blue
}

// Get theme by type name
function getThemeByType(type){
  if(!CANDY_TYPE_MAP[type]){
    CANDY_TYPE_MAP[type] = THEMES[Math.floor(Math.random()*THEMES.length)];
  }
  return CANDY_TYPE_MAP[type] || THEMES[0];
}

function generateLevelConfig(n){
  // Use custom objectives for levels 1-20 (and beyond if custom config exists)
  if(CUSTOM_LEVEL_OBJECTIVES[n]){
    const objectives = CUSTOM_LEVEL_OBJECTIVES[n];
    // CHOCOLATE — pulled out of the objectives array before the per-target
    // mapping below, since it drives board setup (how many chocolate cells
    // to place + spread config), not just a candy target.
    const chocoObj = objectives.find(o=>o.type==='chocolate');
    const targets = objectives.filter(o=>o.type!=='chocolate' && o.type!=='boss').map(obj=>{
      if(obj.isJelly){
        // Jelly is its own standalone objective — tracked as "🫧
        // collected/required" alongside the candy targets, but it is
        // NEVER placed as a collectible candy on the board (see the
        // targetEmojis filter just below), since '🫧' isn't a real
        // candy theme/emoji.
        return {
          emoji: '🫧',
          required: obj.jellyCount || 1,
          collected: 0,
          isJelly: true
        };
      }
      if(obj.type==='combo'){
        // COMBO CHALLENGE — its own standalone objective, same pattern as
        // jelly above: tracked as "⚡ collected/required" but NEVER placed
        // as a collectible candy on the board (excluded from targetEmojis
        // just below, since '⚡' isn't a real candy theme/emoji). Progress
        // increases only via the game's EXISTING multi-line combo event —
        // see collectJourneyCombo(), called from processLineClears().
        return {
          emoji: '⚡',
          required: obj.target,
          collected: 0,
          isCombo: true
        };
      }
      const theme = getThemeByType(obj.type);
      return { 
        emoji: theme.emoji, 
        c1: theme.c1, 
        c2: theme.c2, 
        required: obj.target, 
        collected: 0,
        type: obj.type,
        locked: obj.locked || 0,  // 0 = not locked, 1 = locked (needs unlocking)
        frozen: obj.frozen || 0   // 0 = not frozen, 1 = frozen (needs ice break)
      };
    });
    if(chocoObj){
      // CHOCOLATE — same standalone-objective pattern as jelly/combo: "🍫
      // collected/required", never placed as a collectible candy (see the
      // targetEmojis filter below). Progress increases only when a real
      // row/column clear includes the chocolate-covered cell itself — see
      // processChocolateBreaks(), called from the same spots as jelly.
      targets.push({
        emoji: '🍫',
        required: chocoObj.count,
        collected: 0,
        isChocolate: true
      });
    }
    // BOSS (Level 200 only) — same standalone-objective pattern as every
    // mechanic above: "👑 collected/required", never a collectible candy
    // (excluded from targetEmojis below). "collected" here doubles as
    // "damage dealt" — it only ever increases via damageBossOnClear(),
    // called from processLineClears() on the SAME real row/column clear
    // event every other mechanic above reacts to. Reaching required (0 HP
    // left) makes isJourneyLevelComplete() true exactly like any other
    // fully-collected target — no separate win-condition system needed.
    const bossObj = objectives.find(o=>o.type==='boss');
    if(bossObj){
      targets.push({
        emoji: '👑',
        required: bossObj.hp,
        collected: 0,
        isBoss: true
      });
    }
    // CANDY BOMB — pulled from its own data table (CUSTOM_LEVEL_BOMBS),
    // same reason as chocolate above: it drives board setup (how many
    // bomb cells to place + starting countdown), not just a candy target.
    // Same standalone-objective pattern: "💣 collected/required", never a
    // collectible candy (excluded from targetEmojis below). Progress
    // increases only when a real row/column clear directly defuses a bomb
    // cell — see processBombDefuses(), called from the same spots as
    // chocolate/jelly.
    const bombConfig = CUSTOM_LEVEL_BOMBS[n];
    if(bombConfig){
      targets.push({
        emoji: '💣',
        required: bombConfig.count,
        collected: 0,
        isBomb: true
      });
    }
    // RAINBOW CANDY — pulled from its own data table (CUSTOM_LEVEL_RAINBOW),
    // same reason as chocolate/bomb above: it drives board setup (how many
    // rainbow candies to place), not just a candy target. Same standalone-
    // objective pattern: "🌈 collected/required", and normal candies never
    // count toward it (collectJourneyCandies explicitly skips a rainbow
    // cell — see there). Progress increases only when a real row/column
    // clear directly collects the rainbow cell — see
    // processRainbowCollection(), called from the same spots as chocolate/
    // bomb, and only once any locked/frozen/jelly on that SAME cell has
    // already been cleared first (existing obstacle rules aren't bypassed).
    const rainbowConfig = CUSTOM_LEVEL_RAINBOW[n];
    if(rainbowConfig){
      targets.push({
        emoji: '🌈',
        required: rainbowConfig.count,
        collected: 0,
        isRainbow: true
      });
    }
    // TREASURE BOX — pulled from its own data table (CUSTOM_LEVEL_TREASURE),
    // same reason as chocolate/bomb/rainbow above: it drives board setup
    // (how many treasure cells to place + hits required per box), not just
    // a candy target. Same standalone-objective pattern: "🎁
    // collected/required", never a collectible candy (excluded from
    // targetEmojis below). Progress increases only when a real row/column
    // clear directly hits the Treasure Box cell itself — see
    // processTreasureBoxHits(), called from the same spots as chocolate/
    // bomb/rainbow, and only once any locked/frozen/jelly on that SAME
    // cell has already been cleared first (existing obstacle rules aren't
    // bypassed, per spec).
    const treasureConfig = CUSTOM_LEVEL_TREASURE[n];
    if(treasureConfig){
      targets.push({
        emoji: '🎁',
        required: treasureConfig.count,
        collected: 0,
        isTreasure: true
      });
    }
    // CANDY PATH — pulled from its own data table (CUSTOM_LEVEL_PATH),
    // same reason as chocolate/bomb/rainbow/treasure above: it drives
    // board setup (the exact ordered route), not just a candy target.
    // Same standalone-objective pattern: "🛤️ collected/required", never a
    // collectible candy (excluded from targetEmojis below). Progress
    // increases only as real row/column clears reach each step of the
    // route IN ORDER — see processPathProgress(), called from the same
    // spots as chocolate/bomb/rainbow/treasure. The raw ordered step list
    // is carried on the returned config itself (config.pathCells below,
    // same idea as config.moves) since, unlike every count-only table
    // above, initializePathCells() needs the actual coordinates.
    const pathConfig = CUSTOM_LEVEL_PATH[n];
    if(pathConfig){
      targets.push({
        emoji: '🛤️',
        required: pathConfig.length,
        collected: 0,
        isPath: true
      });
    }
    
    return {
      number: n,
      difficulty: Math.min(1, (n-1)/40),
      targets,
      targetEmojis: targets.filter(t=>!t.isJelly && !t.isCombo && !t.isChocolate && !t.isBomb && !t.isRainbow && !t.isTreasure && !t.isPath && !t.isBoss).map(t=>t.emoji),
      isMultiObjective: true,
      hasBoss: !!bossObj,
      bossMaxHealth: bossObj ? bossObj.hp : 0,
      hasLockedCandies: targets.some(t=>t.locked),
      hasFrozenCandies: targets.some(t=>t.frozen),
      hasJellyCells: targets.some(t=>t.isJelly),
      hasComboChallenge: targets.some(t=>t.isCombo),
      hasChocolate: !!chocoObj,
      chocolateCount: chocoObj ? chocoObj.count : 0,
      chocolateSpreadEvery: chocoObj ? (chocoObj.spreadEvery || 0) : 0, // 0 = spreading disabled
      maxChocolateCells: chocoObj ? (chocoObj.maxCells || chocoObj.count) : 0,
      hasBombs: !!bombConfig,
      bombCount: bombConfig ? bombConfig.count : 0,
      bombCountdown: bombConfig ? bombConfig.countdown : 0,
      hasRainbow: !!rainbowConfig,
      rainbowCount: rainbowConfig ? rainbowConfig.count : 0,
      hasTreasure: !!treasureConfig,
      treasureCount: treasureConfig ? treasureConfig.count : 0,
      treasureHitsRequired: treasureConfig ? (treasureConfig.hitsRequired || 2) : 2,
      hasPath: !!pathConfig,
      pathCells: pathConfig || null,
      moves: CUSTOM_LEVEL_MOVES[n] || null // Limited Moves (null = unlimited)
    };
  }
  
  // For levels 21+, use existing random generation
  const rng = mulberry32(1000 + n*97);
  const difficulty = Math.min(1, (n-1)/(JOURNEY_TOTAL_LEVELS-1));

  const numTargets = difficulty < 0.25 ? 3 : difficulty < 0.65 ? 4 : (rng() < 0.5 ? 4 : 5);

  const shuffled = THEMES.slice();
  for(let i=shuffled.length-1; i>0; i--){
    const j = Math.floor(rng()*(i+1));
    const tmp = shuffled[i]; shuffled[i] = shuffled[j]; shuffled[j] = tmp;
  }
  const chosen = shuffled.slice(0, numTargets);

  const targets = chosen.map(theme=>{
    const range = 2 + Math.floor(difficulty*4); // grows from 2 to 6
    const required = Math.max(2, Math.min(8, 2 + Math.floor(rng()*range)));
    return { emoji:theme.emoji, c1:theme.c1, c2:theme.c2, required, collected:0 };
  });

  return {
    number: n,
    difficulty,
    targets,
    targetEmojis: targets.map(t=>t.emoji),
    moves: CUSTOM_LEVEL_MOVES[n] || null // Limited Moves (null = unlimited)
  };
}

// Builds a level's predefined starting board. Occupied/obstacle cells are
// scattered with a per-row/column cap that always leaves at least 2 empty
// PLAYABLE cells in every row and column, so a starting layout can never
// already be (or be one placement away from) an unfair or impossible
// position — now computed relative to each level's board shape rather
// than the full 7×7 grid, since void cells are permanently unusable.
function buildStartingBoard(n, targetEmojis, minOccupied){
  const rng = mulberry32(5000 + n*131);
  const difficulty = Math.min(1, (n-1)/(JOURNEY_TOTAL_LEVELS-1));
  const b = createEmptyBoard();

  const shape = getJourneyBoardShapeForLevel(n);
  applyBoardShapeMask(b, shape);

  const rowPlayable = new Array(SIZE).fill(0);
  const colPlayable = new Array(SIZE).fill(0);
  let playableTotal = 0;
  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      if(!b[r][c].void){ rowPlayable[r]++; colPlayable[c]++; playableTotal++; }
    }
  }
  // Per-row/column cap: always leave at least 2 empty playable cells (or,
  // for a very narrow row/column that has fewer than 2 playable cells to
  // begin with, leave it completely empty rather than clamping below 0).
  const rowMax = rowPlayable.map(p=>Math.max(0,p-2));
  const colMax = colPlayable.map(p=>Math.max(0,p-2));

  // Both counts are scaled relative to the level's ACTUAL playable area
  // (not the full 49 cells) so every board shape carries the same
  // relative density/difficulty regardless of how much of the grid its
  // silhouette actually uses.
  // BUGFIX (Step 17 QA): at low difficulty this formula can round down to
  // 0-2 filled cells, which starved Locked/Frozen candy placement on
  // several early levels (e.g. 22, 24-40, 41-60) — the level's own
  // objectives require `minOccupied` real candy cells to host those
  // obstacles, so the floor below guarantees enough exist without
  // changing the density (and therefore difficulty) of any other level.
  const occupiedCount = Math.max(Math.floor(difficulty * playableTotal * (14/64)), minOccupied||0);
  const obstacleTotal = Math.floor(difficulty * playableTotal * (5/64));

  const rowCounts = new Array(SIZE).fill(0);
  const colCounts = new Array(SIZE).fill(0);

  let placed = 0, attempts = 0;
  while(placed < occupiedCount && attempts < 500){
    attempts++;
    const r = Math.floor(rng()*SIZE), c = Math.floor(rng()*SIZE);
    if(b[r][c].void || b[r][c].filled || b[r][c].obstacle) continue;
    if(rowCounts[r] >= rowMax[r] || colCounts[c] >= colMax[c]) continue;
    const useTarget = targetEmojis.length>0 && rng() < 0.5;
    // Pick the random index ONCE, before the lookup — computing it inside
    // the .find() predicate would re-call rng() (and get a different index)
    // on every element .find() checks, which could search past all themes
    // without ever matching and return undefined.
    let theme;
    if(useTarget){
      const pickedEmoji = targetEmojis[Math.floor(rng()*targetEmojis.length)];
      theme = THEMES.find(t=>t.emoji===pickedEmoji);
    } else {
      theme = THEMES[Math.floor(rng()*THEMES.length)];
    }
    b[r][c] = {filled:true, obstacle:false, void:false, c1:theme.c1, c2:theme.c2, emoji:theme.emoji};
    rowCounts[r]++; colCounts[c]++;
    placed++;
  }

  let obstaclesPlaced = 0; attempts = 0;
  while(obstaclesPlaced < obstacleTotal && attempts < 500){
    attempts++;
    const r = Math.floor(rng()*SIZE), c = Math.floor(rng()*SIZE);
    if(b[r][c].void || b[r][c].filled || b[r][c].obstacle) continue;
    if(rowCounts[r] >= rowMax[r] || colCounts[c] >= colMax[c]) continue;
    b[r][c] = {filled:false, obstacle:true, void:false, c1:null, c2:null, emoji:null};
    rowCounts[r]++; colCounts[c]++;
    obstaclesPlaced++;
  }

  return b;
}

function buildBoardDOM(){
  boardEl.innerHTML='';
  boardEl.style.gridTemplateColumns = `repeat(${SIZE},1fr)`;
  boardEl.style.gridTemplateRows = `repeat(${SIZE},1fr)`;
  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      const cell = document.createElement('div');
      cell.className='cell';
      cell.dataset.r=r; cell.dataset.c=c;
      boardEl.appendChild(cell);
    }
  }
}
function getCellDOM(r,c){
  return boardEl.children[r*SIZE+c];
}
function refreshCellVisual(r,c){
  const data = board[r][c];
  const dom = getCellDOM(r,c);
  // BUG FIX (Step 14 audit): 'clearing' and its 'data-candy-material'
  // attribute were never in this reset list. processLineClears() clears
  // the underlying board DATA immediately but defers removing the
  // 'clearing' class/attribute for ~320ms purely for the fade animation
  // (see its own comment). If a player placed a new piece into that same
  // cell inside that ~320ms window — perfectly legal, since the data
  // model already shows it empty — commitPlacement's refreshCellVisual()
  // call would draw the new candy while the OLD cell still carried
  // 'clearing' (whose clearFlash animation ends on
  // opacity:0/transform:scale(.2) with fill-mode:forwards), making the
  // brand-new candy render invisible/shrunk until the original 320ms
  // timeout happened to fire and redraw it — exactly the "stuck
  // animation" / "invisible candy" class of bug this step asks to root
  // out. Stripping both here means every redraw is a clean slate
  // regardless of timing; the later setTimeout in processLineClears still
  // runs too, but is now a harmless no-op in this scenario since there's
  // nothing stale left for it to remove.
  dom.classList.remove('filled','obstacle','void','special-candy','special-striped-h','special-striped-v','special-bomb','special-colorblast','locked-candy','unlocking','frozen-candy','breaking','cracking','jelly-cell','jelly-breaking','jelly-crack','chocolate-cell','chocolate-breaking','chocolate-spreading','candy-bomb-cell','bomb-warn-3','bomb-warn-2','bomb-warn-1','bomb-defusing','bomb-expiring','rainbow-candy','rainbow-collecting','treasure-box','treasure-crack','treasure-opening','path-cell','path-active','path-completed','path-completing','premium-candy','clearing');
  dom.style.background='';
  dom.textContent='';
  dom.removeAttribute('data-bomb-count');
  dom.removeAttribute('data-treasure-hits');
  dom.removeAttribute('data-path-marker');
  dom.removeAttribute('data-candy-material');
  if(data.void){
    dom.classList.add('void');
    return;
  }
  if(data.obstacle){
    dom.classList.add('obstacle');
  } else if(data.filled){
    dom.classList.add('filled');
    dom.style.background = `linear-gradient(160deg, ${data.c1}, ${data.c2})`;
    const key = `${r},${c}`;
    
    // Check if this is a frozen candy (highest priority visual)
    if(frozenCandies[key]){
      dom.classList.add('frozen-candy');
    } else if(lockedCandies[key]){
      // Check if this is a locked candy
      dom.classList.add('locked-candy');
    } else if(jellyCells[key]){
      // Check if this cell has jelly on it
      dom.classList.add('jelly-cell');
    } else if(journeyBombCells[key]){
      // CANDY BOMB — always sits on a filled cell (see initializeBombCells),
      // mutually exclusive with frozen/locked/jelly/rainbow by construction
      // (each init function skips a cell the others already claimed).
      dom.classList.add('candy-bomb-cell');
      const bomb = journeyBombCells[key];
      dom.setAttribute('data-bomb-count', Math.max(0,bomb.countdown));
      if(bomb.countdown===3) dom.classList.add('bomb-warn-3');
      else if(bomb.countdown===2) dom.classList.add('bomb-warn-2');
      else if(bomb.countdown<=1) dom.classList.add('bomb-warn-1');
    } else if(rainbowCells[key]){
      // RAINBOW CANDY — only rendered in its own glossy premium look once
      // no obstacle overlay is active on this cell. A rainbow candy that's
      // ALSO still locked/frozen/jellied simply looks like that obstacle
      // in the meantime (same as any other candy underneath one) — a
      // single DOM element only has one ::before/::after to give, so this
      // keeps every overlay's pseudo-elements from fighting over the same
      // two slots. Collection itself (processRainbowCollection) already
      // enforces "unlock/break/de-jelly first" independently of this, so
      // nothing here bypasses those existing rules — it's a display-only
      // simplification once the obstacle is already gone.
      dom.classList.add('rainbow-candy');
      dom.style.background = ''; // the glossy rainbow ::after fully replaces the plain candy colour
    } else if(treasureCells[key]){
      // TREASURE BOX — only rendered in its own glossy chest look once no
      // obstacle overlay is active on this cell, same display-only
      // simplification used for rainbow above (a cell still locked/frozen/
      // jellied just looks like that obstacle in the meantime; the real
      // hit logic in processTreasureBoxHits already enforces "unlock/
      // break/de-jelly first" independently of this).
      dom.classList.add('treasure-box');
      dom.style.background = ''; // the glossy chest ::after fully replaces the plain candy colour
      dom.textContent = '🎁';
      dom.setAttribute('data-treasure-hits', Math.max(0, treasureCells[key].hitsRemaining));
    } else if(data.specialType){
      // Special candy: same coloured background as a normal candy (keeps
      // it readably "part of the board"), plus a distinct glowing overlay
      // and icon from the CSS above, and its own emoji swapped for a
      // clear special-type icon so it reads as tappable, not decorative.
      dom.classList.add('special-candy', 'special-'+data.specialType);
      const icon = data.specialType==='striped-h' ? '↔️' : data.specialType==='striped-v' ? '↕️' : data.specialType==='bomb' ? '💥' : '🌈';
      dom.textContent = icon;
    } else {
      // Premium Classic-only candy art (Step 2): only the 20
      // CLASSIC_EXTRA_THEMES carry a candyId, so Blast Journey's own
      // THEMES candies fall straight through to the original plain emoji.
      const svg = data.candyId ? buildCandySVG(data.candyId, data.c1, data.c2) : null;
      if(svg){
        dom.innerHTML = svg;
        dom.classList.add('premium-candy');
      } else {
        dom.textContent = data.emoji||'';
      }
    }
  }
  // CHOCOLATE — layered on top independent of filled/obstacle state (unlike
  // frozen/locked/jelly above, it can cover an EMPTY playable cell too, so
  // this check sits outside the filled/obstacle branch entirely).
  if(chocolateCells[`${r},${c}`]){
    dom.classList.add('chocolate-cell');
  }
  // CANDY PATH — same reason as chocolate just above: layered on top
  // independent of filled/obstacle state, since a path cell can start out
  // empty and only becomes part of a real clear once the player later
  // places a piece there. Mutually exclusive with every obstacle overlay
  // (locked/frozen/jelly/chocolate/bomb/rainbow/treasure all skip a
  // pathCells cell at placement — see initializePathCells running FIRST
  // in startJourneyLevel), so it never has to compete for ::before/::after
  // with any of them.
  const pathHere = pathCells[`${r},${c}`];
  if(pathHere){
    dom.classList.add('path-cell');
    if(pathHere.completed){
      dom.classList.add('path-completed');
    } else if(pathSequence[pathNextIndex] === `${r},${c}`){
      dom.classList.add('path-active');
    }
    if(pathHere.order===0) dom.setAttribute('data-path-marker','🍭');
    else if(pathHere.order===pathSequence.length-1) dom.setAttribute('data-path-marker','🏁');
  }
}
function refreshAllCells(){
  for(let r=0;r<SIZE;r++) for(let c=0;c<SIZE;c++) refreshCellVisual(r,c);
}

/* ============================================================
   PIECE GENERATION
============================================================ */
function randomShape(){
  return SHAPES[Math.floor(Math.random()*SHAPES.length)];
}
function randomTheme(themePool){
  const pool = themePool || THEMES;
  return pool[Math.floor(Math.random()*pool.length)];
}
// Classic-only: avoids repeating the exact same candy twice in a row when
// there's a bigger pool to pick from, per spec ("avoid generating the exact
// same candy repeatedly if the existing piece-generation system can
// reasonably prevent that... however, do NOT make the random system
// unfair"). Purely cosmetic (which flavor/color a piece shows) — never
// touches shape selection, special-piece odds, or which shapes fit the
// board, so it can't make anything unfair. Journey is untouched: it never
// passes a themePool, so it always takes the plain randomTheme() path above.
// STEP 8 QA FIX: several of the 20 premium candy skins intentionally reuse
// an original THEMES emoji glyph (e.g. Strawberry vs the plain THEMES 🍓,
// Chocolate vs the plain THEMES 🍫, Hard Candy vs the plain THEMES 🍬,
// Lollipop vs the plain THEMES 🍭, Watermelon vs the plain THEMES 🍉— same
// reasoning already documented on candyColorKey below). Comparing by raw
// emoji here would treat two visually-distinct candies as "the same candy"
// for anti-repeat purposes. Comparing by id (falling back to emoji for the
// 8 plain THEMES entries, which carry no id) fixes that, matching the same
// identity rule candyColorKey already uses elsewhere.
let lastClassicThemeKey = null;
function randomClassicTheme(){
  let theme = randomTheme(CLASSIC_THEMES);
  if(CLASSIC_THEMES.length>1){
    let tries = 0;
    while((theme.id||theme.emoji)===lastClassicThemeKey && tries<5){
      theme = randomTheme(CLASSIC_THEMES);
      tries++;
    }
  }
  lastClassicThemeKey = theme.id||theme.emoji;
  return theme;
}
function specialChance(){
  let base = mode==='journey' ? 0.10 : 0.08;
  const bonus = Math.min(0.10, Math.floor(score/400)*0.02);
  return base + bonus;
}
function makePiece(forceNoSpecial, useClassicThemes){
  const shapePool = SHAPES.filter(s=>s.cells.length<=6); // keep sq3 rare-ish via weighting below
  let shape = Math.random()<0.06 ? SHAPES.find(s=>s.name==='sq3') : shapePool[Math.floor(Math.random()*shapePool.length)];
  const theme = useClassicThemes ? randomClassicTheme() : randomTheme();
  let special = null;
  if(!forceNoSpecial && Math.random() < specialChance()){
    special = SPECIAL_TYPES[Math.floor(Math.random()*SPECIAL_TYPES.length)];
    shape = SHAPES.find(s=>s.name==='single');
  }
  return { shape, theme, special };
}

// Can this shape be placed anywhere at all on the current board? Reuses the
// exact same canPlaceShape() check that dragging/placement itself relies on.
function shapeFitsSomewhere(shape){
  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      if(canPlaceShape(shape.cells, r, c)) return true;
    }
  }
  return false;
}

/* ============================================================
   CLASSIC MODE — SMARTER, BOARD-AWARE PIECE GENERATION
   Classic-only. Journey keeps calling makePiece() directly, completely
   untouched, exactly as before. Nothing here ever runs for Journey, and
   none of it goes anywhere near drag/drop/placement — it only decides
   WHICH shape a freshly-generated Classic piece gets, using the exact
   same SHAPES list, canPlaceShape() and board data that already existed.
   Goal: keep the Classic board from slowly clogging up by leaning the
   piece pool toward smaller/more flexible shapes as the board fills, and
   by occasionally handing the player a shape that can complete an
   almost-finished row/column — without ever forcing/auto-placing anything.
============================================================ */

// Shapes grouped by how "easy" they are to fit, purely for weighting which
// shape gets picked — the shapes themselves (SHAPES array) are untouched.
const CLASSIC_SHAPE_TIERS = {
  tiny:     ['single'],                                              // 1 cell — always fits somewhere short of a full board
  small:    ['h2','v2'],                                             // 2 cells
  compact3: ['h3','v3','corner1','corner2','corner3','corner4'],     // 3 cells, small footprint
  compact4: ['sq2','L1','L2','L3','L4','T','Trot','Z','S'],          // 4 cells, still a fairly compact footprint
  long4:    ['h4','v4'],                                             // 4 cells but needs 4 free cells in a straight line
  big:      ['plus','sq3']                                           // 5 / 9 cells — needs generous open space
};

// How strongly each tier is favored, chosen by current board occupancy.
// Emptier board → normal variety (close to the original random pool).
// Fuller board → weight shifts hard toward tiny/small/compact shapes, and
// the awkward long/big shapes become rare-to-negligible, so the tray keeps
// offering pieces that realistically fit instead of ones that just pile up.
function classicShapeTierWeights(occupancy){
  if(occupancy < 0.35){
    return {tiny:1, small:2, compact3:3, compact4:3, long4:1.5, big:0.6};
  } else if(occupancy < 0.65){
    return {tiny:1.5, small:2.5, compact3:3, compact4:2, long4:0.6, big:0.15};
  } else {
    return {tiny:3, small:3, compact3:2, compact4:0.8, long4:0.1, big:0.02};
  }
}

// Board occupancy (0..1) used purely as a balancing signal for piece
// selection below — never touches rendering or placement.
function classicBoardOccupancy(){
  let filled = 0;
  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      if(isBlocked(r,c)) filled++;
    }
  }
  return filled/(SIZE*SIZE);
}

// Builds the weighted {shape, weight} list for the current occupancy tier.
function classicShapePool(occupancy){
  const weights = classicShapeTierWeights(occupancy);
  const entries = [];
  for(const tier in CLASSIC_SHAPE_TIERS){
    const w = weights[tier];
    if(!w || w<=0) continue;
    CLASSIC_SHAPE_TIERS[tier].forEach(name=>{
      const shape = SHAPES.find(s=>s.name===name);
      if(shape) entries.push({shape, weight:w});
    });
  }
  return entries;
}

function classicWeightedPick(entries){
  const total = entries.reduce((s,e)=>s+e.weight, 0);
  let r = Math.random()*total;
  for(const e of entries){
    if(r < e.weight) return e.shape;
    r -= e.weight;
  }
  return entries[entries.length-1].shape;
}

// Would placing `cells` at (rOff,cOff) complete at least one row or column?
// Caller already knows the placement itself is valid (canPlaceShape).
function classicWouldCompleteLine(cells, rOff, cOff){
  const placed = new Set(cells.map(([r,c])=>(rOff+r)+','+(cOff+c)));
  const rows = new Set(cells.map(([r])=>rOff+r));
  const cols = new Set(cells.map(([,c])=>cOff+c));
  for(const r of rows){
    let complete = true;
    for(let c=0;c<SIZE;c++){
      if(board[r][c].void) continue;
      if(isBlocked(r,c) || placed.has(r+','+c)) continue;
      complete = false; break;
    }
    if(complete) return true;
  }
  for(const c of cols){
    let complete = true;
    for(let r=0;r<SIZE;r++){
      if(board[r][c].void) continue;
      if(isBlocked(r,c) || placed.has(r+','+c)) continue;
      complete = false; break;
    }
    if(complete) return true;
  }
  return false;
}

// Chance a freshly-generated Classic piece is deliberately one that CAN
// complete an almost-finished row/column somewhere on the board, if one
// exists — "occasionally", per the brief, so the player still makes real
// decisions the rest of the time instead of the game feeling automatic.
const CLASSIC_LINE_OPPORTUNITY_CHANCE = 0.35;

// Looks for a shape (from the given weighted pool, deduped) that has some
// valid spot on the board where placing it would complete a row/column.
// Cheap: only ever called once per new piece, never during drag.
function classicFindLineCompletingShape(poolEntries){
  const seen = new Set();
  const candidates = [];
  for(const e of poolEntries){
    if(seen.has(e.shape.name)) continue;
    seen.add(e.shape.name);
    candidates.push(e.shape);
  }
  // Shuffle so repeated calls don't always favor the same shape first.
  for(let i=candidates.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    const tmp=candidates[i]; candidates[i]=candidates[j]; candidates[j]=tmp;
  }
  for(const shape of candidates){
    for(let r=0;r<SIZE;r++){
      for(let c=0;c<SIZE;c++){
        if(canPlaceShape(shape.cells, r, c) && classicWouldCompleteLine(shape.cells, r, c)){
          return shape;
        }
      }
    }
  }
  return null;
}

// One Classic candidate piece: same special-candy chance/rules as
// makePiece() (untouched), but the NORMAL shape choice is now
// occupancy-aware and occasionally opportunity-driven instead of a flat
// random pick across the whole SHAPES list.
function makeClassicPieceCandidate(forceNoSpecial, occupancy){
  const theme = randomClassicTheme();
  if(!forceNoSpecial && Math.random() < specialChance()){
    const special = SPECIAL_TYPES[Math.floor(Math.random()*SPECIAL_TYPES.length)];
    return { shape: SHAPES.find(s=>s.name==='single'), theme, special };
  }
  const pool = classicShapePool(occupancy);
  if(Math.random() < CLASSIC_LINE_OPPORTUNITY_CHANCE){
    const opportunityShape = classicFindLineCompletingShape(pool);
    if(opportunityShape) return { shape: opportunityShape, theme, special:null };
  }
  return { shape: classicWeightedPick(pool), theme, special:null };
}

// Classic-only, smarter piece generation: keeps the exact same shape pool,
// rarity weighting and special-piece chance as makePiece() above (nothing
// about the shapes themselves changes) — it just re-rolls a piece that
// can't currently be placed anywhere on the board, up to a handful of
// tries. As the board fills up, big/awkward shapes fail this check more
// often than small ones, so the tray naturally leans toward pieces the
// player can actually use — no more "spawned into an unfair game over".
// If nothing fits after several tries the board genuinely is (almost) full,
// so it falls back to the smallest possible piece rather than forcing
// something guaranteed to be a dead piece.
function makeSmartClassicPiece(forceNoSpecial){
  const occupancy = classicBoardOccupancy();
  const maxAttempts = 25;
  for(let i=0;i<maxAttempts;i++){
    const candidate = makeClassicPieceCandidate(forceNoSpecial, occupancy);
    if(shapeFitsSomewhere(candidate.shape)) return candidate;
  }
  return { shape: SHAPES.find(s=>s.name==='single'), theme: randomClassicTheme(), special:null };
}

function newTray(){
  for(let i=0;i<3;i++){
    const noSpecial = placementsSinceStart < 1 && i===0;
    trayPieces[i] = (mode==='classic') ? makeSmartClassicPiece(noSpecial) : makePiece(noSpecial);
  }
  placementsSinceStart++;
  renderTray();
}

/* ============================================================
   TRAY RENDER + DRAG
============================================================ */
function computeCellSize(){
  const rect = boardEl.getBoundingClientRect();
  // ROOT-CAUSE FIX: this used to hardcode padding=8/gap=3, but #board's
  // real CSS is padding:0 with a gap that itself changes across responsive
  // breakpoints (4px / 3.5px / 3px — see the #board rules). That mismatch
  // (especially the phantom 8px padding that doesn't exist) made
  // boardCellSize (and therefore every "step" used to convert a release
  // point into a board row/col) systematically wrong, and increasingly so
  // for cells further from the top-left corner — which is exactly why a
  // piece dragged and released over the board would compute as landing
  // outside the board or on an already-"occupied" cell and silently bounce
  // back to the tray instead of ever being committed. Reading the real
  // computed padding/gap keeps this in sync with whatever the CSS actually
  // renders, on every breakpoint.
  const cs = getComputedStyle(boardEl);
  boardPadding = parseFloat(cs.paddingLeft) || 0;
  boardGap = parseFloat(cs.columnGap || cs.gap) || 0;
  // SIZE columns have (SIZE-1) gaps between them — derive this from SIZE
  // rather than hardcoding it, so the board math always matches whatever
  // SIZE actually is.
  boardCellSize = (rect.width - boardPadding*2 - boardGap*(SIZE-1)) / SIZE;
}
function trayCellSize(){
  // Tray piece cells scale up with the board's own cell size so pieces look
  // proportional to the (now wider) board, but are also capped by the
  // actual available width of a tray slot for the widest existing piece
  // shape (4 columns), so a piece can never overflow/clip its slot no
  // matter how large the screen is.
  const maxShapeCols = 4;
  const trayRect = trayEl.getBoundingClientRect();
  const trayWidth = trayRect.width > 0 ? trayRect.width : boardCellSize * SIZE;
  const trayHorizontalPadding = 8;  // matches #tray's padding:6px 4px 10px (4px each side)
  const slotGap = 6;                // matches #tray's gap:6px
  const numSlots = 3;
  const perSlot = (trayWidth - trayHorizontalPadding - slotGap*(numSlots-1)) / numSlots;
  const pieceGridGap = 4 * (maxShapeCols-1); // matches .piece-grid's gap:4px
  const maxCellFromSlot = (perSlot - pieceGridGap) / maxShapeCols;
  return Math.max(22, Math.min(boardCellSize*0.86, maxCellFromSlot, 46));
}

function renderTray(){
  // Only the 3 piece-slots are rebuilt here.
  trayEl.querySelectorAll('.piece-slot').forEach(s=>s.remove());
  computeCellSize();
  const _trayPx = trayCellSize();      // same value every slot gets; measured once instead of a forced layout per slot
  for(let i=0;i<3;i++){
    const slot = document.createElement('div');
    slot.className='piece-slot';
    slot.dataset.slot=i;
    const piece = trayPieces[i];
    if(piece){
      const grid = buildPieceGrid(piece, _trayPx);
      grid.dataset.slot = i;
      // Step 12: brief entrance for a freshly generated piece, Classic
      // only (mode check) — Journey's tray render path is byte-for-byte
      // unaffected. Every render either does or doesn't apply the class
      // consistently, so it never re-triggers on drag/placement redraws
      // of pieces that already existed (renderTray() only ever rebuilds
      // the full tray from trayPieces, and any not-yet-placed piece
      // getting this class again on an incidental redraw is harmless —
      // it's a subtle 220ms pop, not a gameplay-relevant state).
      if(mode==='classic'){
        grid.classList.add('tray-enter');
        // CRITICAL FIX: the entrance animation's fill-mode ("both") keeps
        // its final transform (scale(1) translateY(0)) applied FOREVER as
        // long as this class stays on the element — and a CSS animation's
        // value for a property always wins over that same property set
        // later via inline JS style (el.style.transform = ...), no matter
        // what. Since this class was never removed, EVERY classic piece's
        // drag transform (see tick() in the drag code) was being silently
        // overridden by this leftover animation the instant it tried to
        // move the piece — the piece never visually moved at all, which
        // is exactly why dragging looked completely dead in Classic mode.
        // Removing the class once the animation naturally finishes lets
        // the (already-applied) inline drag transform take effect again.
        const clearTrayEnter = ()=>{ grid.classList.remove('tray-enter'); };
        grid.addEventListener('animationend', clearTrayEnter, {once:true});
        setTimeout(clearTrayEnter, 260); // safety net if animationend never fires
      }
      attachDragHandlers(grid, i);
      slot.appendChild(grid);
    }
    trayEl.appendChild(slot);
  }
}

function buildPieceGrid(piece, cellPx){
  const cells = piece.shape.cells;
  let maxR=0, maxC=0;
  for(const [r,c] of cells){ if(r>maxR)maxR=r; if(c>maxC)maxC=c; }
  const rows = maxR+1, cols = maxC+1;
  const grid = document.createElement('div');
  grid.className='piece-grid';
  grid.style.setProperty('--pcell', cellPx+'px');
  grid.style.gridTemplateColumns = `repeat(${cols}, var(--pcell))`;
  grid.style.gridTemplateRows = `repeat(${rows}, var(--pcell))`;
  grid.dataset.rows = rows; grid.dataset.cols = cols;
  for(const [r,c] of cells){
    const b = document.createElement('div');
    b.className='piece-block';
    b.style.gridColumn = (c+1);
    b.style.gridRow = (r+1);
    b.style.background = `linear-gradient(160deg, ${piece.theme.c1}, ${piece.theme.c2})`;
    if(piece.special){
      b.classList.add('special-icon');
      b.textContent = piece.special.icon;
    } else {
      const svg = piece.theme.id ? buildCandySVG(piece.theme.id, piece.theme.c1, piece.theme.c2) : null;
      if(svg){
        b.innerHTML = svg;
        b.classList.add('premium-candy');
      } else {
        b.textContent = piece.theme.emoji;
      }
    }
    grid.appendChild(b);
  }
  return grid;
}

// NOTE: the dragged piece now tracks the pointer with ZERO lag (see tick()
// below) — it is set directly to the pointer-derived target position every
// rendered frame, not eased toward it. An eased/spring-following piece
// (the previous behavior) visibly trails a fast-moving finger and then
// "catches up" a frame or two later, which reads as stutter/lag/skipped
// movement — exactly the "atak-atak" complaint. Direct 1:1 tracking is
// what real touch/mouse dragging feels like (the piece IS glued to the
// pointer), and it's still driven from inside the requestAnimationFrame
// loop rather than directly from the pointermove handler, so the actual
// DOM write (setting the CSS transform) is still batched to at most once
// per rendered frame instead of once per raw pointer event — that's what
// keeps it smooth/cheap even on touch hardware that reports movement much
// faster than 60Hz, without reintroducing any lag.

// Finds the actual CSS containing block an element would get once it is
// position:fixed. Per spec this is normally the viewport, BUT any ancestor
// with a transform/perspective/filter/backdrop-filter (or will-change /
// contain implying one of those) turns THAT ancestor into the containing
// block instead. #game-screen is exactly such a case: its entrance
// animation (`animation:screenZoomIn ... both`) leaves a permanent
// `transform:scale(1)` behind via fill-mode "both" — a visual no-op, but
// still a real transform as far as this rule is concerned.
// NOTE: element.offsetParent is NOT reliable here — per spec it returns
// null for any position:fixed element regardless of ancestor transforms,
// so it can't be used to detect this case. We have to walk the ancestor
// chain ourselves and check computed styles directly.
function findFixedContainingBlock(el){
  let node = el.parentElement;
  while(node && node !== document.body && node !== document.documentElement){
    const cs = getComputedStyle(node);
    if(
      (cs.transform && cs.transform !== 'none') ||
      (cs.perspective && cs.perspective !== 'none') ||
      (cs.filter && cs.filter !== 'none') ||
      (cs.backdropFilter && cs.backdropFilter !== 'none') ||
      (cs.willChange && /transform|perspective|filter/.test(cs.willChange)) ||
      (cs.contain && /paint|layout|strict|content/.test(cs.contain))
    ){
      return node;
    }
    node = node.parentElement;
  }
  return null; // no such ancestor — containing block really is the viewport
}

function attachDragHandlers(gridEl, slotIndex){
  const onDown = (e)=>{
    // Root cause (stuck/unresponsive input): after an invalid drop or a plain tap the piece animates back for ~100ms and stays
    // pointer-events:none until cleanup (up to 130ms), so a new press on it in that window was ignored. Finish the return first.
    if(e.__cbPicked) return;
    e.__cbPicked = true;
    if(gridEl._cbReturnCleanup) gridEl._cbReturnCleanup();
    // Stuck-drag recovery: a NEW primary pointer (first finger / mouse) can only start when no other
    // pointer is down, so a leftover dragInfo here means its pointerup/pointercancel was lost.
    // Cancel that stale drag (piece returns to tray) so it can never block every later pickup.
    if(dragInfo && e.isPrimary){
      try{ document.documentElement.releasePointerCapture(dragInfo.pointerId); }catch(err){}
      dragInfo.lastValid = false;
      endDrag();
    }
    if(dragInfo || gamePaused) return;
    if(mode==='journey' && journeyMovesRemaining===0) return; // out of moves — no further placement
    clearHintHighlights();
    ensureAudio();
    const piece = trayPieces[slotIndex];
    if(!piece) return;
    e.preventDefault();
    const rect = gridEl.getBoundingClientRect();
    // Captured on <html> (a stable element whose box never changes during
    // the drag) rather than on gridEl itself — see comment above for why.
    try{ document.documentElement.setPointerCapture(e.pointerId); }catch(err){}
    dragInfo = {
      pointerId: e.pointerId,
      slotIndex,
      piece,
      gridEl,
      // offset between pointer and the piece's anchor (top-left = shape cell 0,0).
      // Captured once, kept constant for the whole drag so the piece never
      // shifts relative to the finger/mouse.
      dx: e.clientX - rect.left,
      dy: e.clientY - rect.top,
      originLeft: rect.left,
      originTop: rect.top,
      originWidth: rect.width,
      originHeight: rect.height,
      lift: boardCellSize*1.15,
      // The board's bounding rect, read ONCE here instead of every single
      // animation frame. getBoundingClientRect() forces the browser to
      // flush layout, so calling it 60+ times a second (once per rAF tick)
      // was pure wasted work — the board never actually moves during a
      // drag, so one read up front is all that's needed. Kept fresh across
      // orientation/resize via the 'resize' listener further below.
      boardRect: boardEl.getBoundingClientRect(),
      // current smoothed on-screen position (starts exactly at the origin so
      // there is zero jump the instant the piece is picked up)
      visualLeft: rect.left,
      visualTop: rect.top,
      // instantaneous, unsmoothed target position derived straight from the
      // pointer — used for board-cell math so placement is always accurate
      targetLeft: rect.left,
      targetTop: rect.top,
      // NaN/null sentinels (never equal to any real offset or boolean) so
      // the very first frame always counts as "changed" and renders once.
      rowOffset:NaN, colOffset:NaN, wasNearBoard:null,
      lastValid:false,
      placed:false,
      rafId:null,
      // Raw pointer position as last reported by the browser, and a flag
      // saying whether that's newer than the last processed frame — the
      // cheap part of tracking (recorded on every pointermove) is kept
      // separate from the expensive part (grid math + DOM preview
      // updates, throttled to once per rendered frame in the rAF loop).
      lastClientX: e.clientX,
      lastClientY: e.clientY,
      needsUpdate: false
    };
    gridEl.classList.add('dragging');
    // Drag-only: a still-running tray-enter animation (fill-mode:both) overrides the inline
    // drag transform, so grabbing a freshly spawned piece within ~220ms made it feel stuck.
    gridEl.classList.remove('tray-enter');
    // CRITICAL FIX: Set position:fixed ONLY, use transform for movement
    gridEl.style.position = 'fixed';
    gridEl.style.zIndex = '9999';
    gridEl.style.width = rect.width+'px';
    gridEl.style.height = rect.height+'px';
    // FIX: left/top must be set in the coordinate space of whatever
    // element actually becomes this fixed piece's containing block —
    // NOT raw viewport coordinates, and NOT '0'. See findFixedContainingBlock()
    // above for why (leftover transform:scale(1) on #game-screen from its
    // entrance animation). Convert the viewport-relative rect into that
    // ancestor's coordinate space so the piece renders exactly where it
    // visually already is, instead of jumping off to the wrong spot.
    const fcb = findFixedContainingBlock(gridEl);
    const fixedContainerRect = fcb ? fcb.getBoundingClientRect() : {left:0, top:0};
    gridEl.style.left = (rect.left - fixedContainerRect.left)+'px';
    gridEl.style.top = (rect.top - fixedContainerRect.top)+'px';
    gridEl.style.transform = 'translate3d(0,0,0) scale(1.06)';
    gridEl.style.willChange = 'transform';
    gridEl.style.pointerEvents = 'none';
    gridEl.style.transition = 'none !important';
    handlePointerMove(e.clientX, e.clientY);
    updateDragVisualAndPreview();
    startDragLoop();
    // A tiny pickup tick — purely a nice-to-have polish, so it's wrapped
    // defensively and silently does nothing on devices/browsers (iOS
    // Safari, desktop) that don't support the Vibration API at all.
    // (Moved to AFTER the first position update so the native call can never delay the pickup.)
    try{ if(navigator.vibrate) navigator.vibrate(8); }catch(err){}
  };
  gridEl.addEventListener('pointerdown', onDown);
  gridEl._cbPick = onDown;
  // Long-press / native drag must never pop a context menu or start a browser drag on a tray piece.
  gridEl.addEventListener('contextmenu', (e)=>{ e.preventDefault(); });
  gridEl.addEventListener('dragstart', (e)=>{ e.preventDefault(); });
}

// pointermove/pointerup/pointercancel are bound ONCE on window (not on each
// piece element) and matched purely by pointerId. This is deliberately more
// robust than relying only on setPointerCapture: capture support/behavior is
// inconsistent across some Android WebViews, and if capture silently fails
// the browser falls back to normal hit-testing — meaning a fast finger
// movement can land on the board or another element instead of the piece
// being dragged, and a listener attached only to that piece would simply
// never see the rest of the drag (this is the root cause of "block doesn't
// move" / drags that randomly stop responding). Listening on window removes
// that dependency entirely: wherever the pointer actually is, the drag
// keeps tracking it correctly.
window.addEventListener('pointermove', (e)=>{
  if(!dragInfo || e.pointerId!==dragInfo.pointerId) return;
  if(e.pointerType==='mouse' && e.buttons===0){        // button released outside the window without a pointerup: never stay stuck
    try{ document.documentElement.releasePointerCapture(e.pointerId); }catch(err){}
    dragInfo.lastValid = false; endDrag(); return;
  }
  e.preventDefault();
  handlePointerMove(e.clientX, e.clientY);
}, {passive:false});
window.addEventListener('pointerup', (e)=>{
  if(!dragInfo || e.pointerId!==dragInfo.pointerId) return;
  e.preventDefault();
  try{ document.documentElement.releasePointerCapture(e.pointerId); }catch(err){}
  // FIX (release -> validation -> placement pipeline only — nothing above
  // this line changes): dragInfo.boardRect is normally cached once at
  // pointerdown and only refreshed on a window 'resize' event (see
  // attachDragHandlers/the resize listener above), which is deliberate —
  // re-reading layout every rAF frame during the drag itself would force
  // a layout flush 60+ times a second. But on real phones the browser's
  // address-bar/toolbar can collapse or expand mid-drag (e.g. the touch
  // itself, or a scroll attempt, triggers it) and change the board's
  // on-screen position WITHOUT always firing 'resize' in time — so by the
  // moment the finger lifts, the cached boardRect can be stale, which
  // throws off exactly the release-point -> target-cell math and can make
  // a visually-valid drop compute as invalid (or land on the wrong cell)
  // and bounce back to the tray instead of committing. Re-reading the
  // board's rect ONCE here, synchronously, right before the final
  // validation/commit decision, costs a single layout read at the exact
  // moment it matters and guarantees that decision always uses the true
  // current board position.
  dragInfo.boardRect = boardEl.getBoundingClientRect();
  // Record and apply the EXACT release coordinates synchronously (not
  // waiting for the next rAF tick) so the placement decision always uses
  // the true final finger/mouse position, never a throttled frame that's
  // up to ~16ms stale.
  handlePointerMove(e.clientX, e.clientY);
  updateDragVisualAndPreview();
  endDrag();
});
window.addEventListener('pointercancel', (e)=>{
  if(!dragInfo || e.pointerId!==dragInfo.pointerId) return;
  try{ document.documentElement.releasePointerCapture(e.pointerId); }catch(err){}
  dragInfo.lastValid = false; // interrupted touch: cancel the drag, never place the piece
  endDrag();
});
// Capture lost while the drag is still running (it is also fired after every normal release, when dragInfo is already null).
// The window listeners keep tracking either way, so first try to take the capture back; if the pointer is no longer active
// (touch already ended without a pointerup) there is nothing left to wait for -> cancel, the piece returns to the tray.
document.documentElement.addEventListener('lostpointercapture', (e)=>{
  if(!dragInfo || e.pointerId!==dragInfo.pointerId) return;
  try{ document.documentElement.setPointerCapture(e.pointerId); }
  catch(err){ dragInfo.lastValid = false; endDrag(); }
});
// A press inside the tray while a piece is still returning (see onDown above): finish that return and pick up whatever is under the finger.
trayEl.addEventListener('pointerdown', (e)=>{
  if(dragInfo || e.__cbPicked) return;
  const ret = trayEl.querySelector('.piece-grid.dragging');
  if(!ret || !ret._cbReturnCleanup) return;
  ret._cbReturnCleanup();
  const t = document.elementFromPoint(e.clientX, e.clientY);
  const g = t && t.closest ? t.closest('.piece-grid') : null;
  if(g && g._cbPick) g._cbPick(e);
}, true);
// If the app/tab is hidden mid-drag the pointerup can be lost; cancel (piece returns to the tray)
// so a stuck drag can never block every later pickup.
document.addEventListener('visibilitychange', ()=>{
  if(document.hidden && dragInfo){
    try{ document.documentElement.releasePointerCapture(dragInfo.pointerId); }catch(err){}
    dragInfo.lastValid = false;
    endDrag();
  }
});
// Keeps the cached board rect (see attachDragHandlers) correct if the
// viewport changes shape mid-drag — a real edge case (rotating the phone
// while holding a piece) but a one-line safety net for it.
window.addEventListener('resize', ()=>{
  if(dragInfo) dragInfo.boardRect = boardEl.getBoundingClientRect();
});

// Records the raw pointer position immediately (essentially free — no DOM
// work at all) every time the browser reports movement, however often
// that is. The actual grid-cell math and preview DOM updates are done at
// most once per rendered frame by updateDragVisualAndPreview() below,
// which is what keeps pointermove itself lightweight even on touch
// hardware that reports far faster than 60Hz.
function handlePointerMove(clientX, clientY){
  const d = dragInfo;
  if(!d) return;
  d.lastClientX = clientX;
  d.lastClientY = clientY;
  d.needsUpdate = true;
  if(!d.rafId) d.rafId = requestAnimationFrame(dragFrame);     // grid math / preview at most once per frame, only while moving
  // Donut-style direct follow: move the piece the moment the pointer moves instead of waiting
  // for the next rAF tick. Identical formula to tick() (clientX-dx-originLeft, clientY-dy-lift-originTop);
  // grid math / preview still run in the rAF loop, placement logic is untouched.
  d.gridEl.style.transform = `translate3d(${clientX - d.dx - d.originLeft}px, ${clientY - d.dy - d.lift - d.originTop}px, 0) scale(1.06)`;
}

// Computes the exact target grid cells from the latest recorded pointer
// position (instant, unsmoothed — this is the single source of truth used
// for BOTH the preview and the final placement, so what you see is always
// exactly where it lands). Called from the rAF loop during normal
// dragging, and called once more synchronously on release (see the
// pointerup handler) so the very last pixel of finger movement is always
// reflected before the placement decision is made.
function updateDragVisualAndPreview(){
  const d = dragInfo;
  if(!d || !d.needsUpdate) return;
  d.needsUpdate = false;
  const clientX = d.lastClientX, clientY = d.lastClientY;
  
  const boardRect = d.boardRect;
  const step = boardCellSize + boardGap; // real cell pitch, matching the CSS actually rendering #board
  
  // Calculate piece's visual screen position
  const logicalLeft = clientX - d.dx;
  const logicalTop = clientY - d.dy;
  const visualTop = logicalTop - d.lift;
  
  // Check if piece is actually near/over the board
  const nearBoard = logicalLeft > boardRect.left - step && logicalLeft < boardRect.right + step &&
                     visualTop > boardRect.top  - step && visualTop < boardRect.bottom + step;

  // CRITICAL FIX: Only calculate board placement when piece is ACTUALLY over board
  // If piece is still over tray, set offsets to invalid values
  let rowOffset = -999;
  let colOffset = -999;
  let valid = false;
  
  if(nearBoard){
    const cells = d.piece.shape.cells;
    
    // Find piece's anchor cell (top-left cell in its shape)
    let minRow = 0, minCol = 0;
    for(const [r, c] of cells){
      if(r < minRow) minRow = r;
      if(c < minCol) minCol = c;
    }
    
    // ROOT-CAUSE FIX: the piece being dragged is rendered at its OWN cell
    // size (trayCellSize, set via the --pcell custom property when the
    // piece-grid was built — see buildPieceGrid()), which is generally
    // SMALLER than the board's own cell size. The old code assumed the
    // piece's anchor cell was exactly one board "step" wide/tall when
    // finding its on-screen center — a real, on-screen pixel mismatch of
    // several/many pixels that got treated as a whole extra fraction of a
    // board cell, on top of the padding bug fixed in computeCellSize().
    // Reading the piece's actual rendered cell size gives the TRUE
    // on-screen center of its anchor cell.
    const pieceCellPx = parseFloat(d.gridEl.style.getPropertyValue('--pcell')) || boardCellSize;
    const pieceStep = pieceCellPx + boardGap; // approx spacing between the piece's own cells, only used for its internal (minRow/minCol) offset
    const pieceAnchorOffsetX = minCol * pieceStep;
    const pieceAnchorOffsetY = minRow * pieceStep;
    
    // Piece anchor (its own top-left cell) center, in real screen pixels
    const pieceAnchorScreenX = logicalLeft + pieceAnchorOffsetX + (pieceCellPx / 2);
    const pieceAnchorScreenY = visualTop + pieceAnchorOffsetY + (pieceCellPx / 2);
    
    // Convert to board-relative coordinates, accounting for #board's real
    // padding (see computeCellSize()) so this always matches where the
    // board's cells are actually drawn on screen.
    const relativeX = pieceAnchorScreenX - boardRect.left - boardPadding;
    const relativeY = pieceAnchorScreenY - boardRect.top - boardPadding;
    
    // relativeX/Y is now a true screen-space point, and since it's the
    // CENTER of the anchor cell it always falls strictly inside whichever
    // board cell it belongs to — so floor() gives the exact cell index
    // (no rounding ambiguity at cell boundaries).
    colOffset = Math.floor(relativeX / step);
    rowOffset = Math.floor(relativeY / step);
    
    // Calculate validity
    valid = canPlaceShape(cells, rowOffset, colOffset);
  }

  const offsetChanged = rowOffset !== d.rowOffset || colOffset !== d.colOffset || nearBoard !== d.wasNearBoard;
  d.rowOffset = rowOffset;
  d.colOffset = colOffset;
  d.wasNearBoard = nearBoard;

  // Only set lastValid if over board
  d.lastValid = nearBoard ? valid : false;
  
  if(offsetChanged && dragInfo){
    clearPreview();
    // Green = piece fits here, red = it doesn't. Uses the exact same
    // canPlaceShape() result (`valid`) computed above for the drop decision.
    if(nearBoard){
      const pvCls = valid ? 'preview-valid' : 'preview-invalid';
      for(const [pr, pc] of d.piece.shape.cells){
        const nr = rowOffset + pr, nc = colOffset + pc;
        if(inBounds(nr, nc) && !board[nr][nc].void) getCellDOM(nr, nc).classList.add(pvCls);
      }
    }
  }

  // Target position is where the piece should be drawn on screen
  d.targetLeft = logicalLeft;
  d.targetTop = visualTop;
}

// Smoothly eases the piece's rendered position toward its current target
// every animation frame using GPU-friendly transforms (no layout thrashing),
// which is what gives continuous, non-jittery motion. Also where the
// throttled preview/validity update actually runs (see above).
function dragFrame(){
  const d = dragInfo;
  if(!d) return;
  d.rafId = null;
  updateDragVisualAndPreview();   // the piece itself is already positioned by handlePointerMove (direct follow)
}
function startDragLoop(){ if(dragInfo && !dragInfo.rafId) dragInfo.rafId = requestAnimationFrame(dragFrame); }

function clearPreview(){
  const previewed = boardEl.querySelectorAll('.preview-valid,.preview-invalid');
  previewed.forEach(c=>c.classList.remove('preview-valid','preview-invalid'));
}

function endDrag(){
  const d = dragInfo;
  if(!d) return;
  
  // NULL dragInfo IMMEDIATELY so any pending RAF tick exits early without
  // re-adding preview classes. This is the critical fix for the "stuck
  // green preview" bug — if we waited to null it after commitPlacement,
  // a pending rAF could still run, call updateDragVisualAndPreview(), and
  // re-apply the preview classes we're about to clear.
  dragInfo = null;
  
  // Now that dragInfo is null, cancel the RAF safely (it won't run again)
  if(d.rafId) cancelAnimationFrame(d.rafId);
  
  // Clear preview immediately with zero chance of re-application
  clearPreview();
  
  // Placement validation and commitment — all synchronous, instant
  if(d.lastValid && canPlaceShape(d.piece.shape.cells, d.rowOffset, d.colOffset)){
    d.placed = true;
    d.gridEl.remove();
    trayPieces[d.slotIndex] = null;
    
    // A bomb piece runs its own timed pulse -> blast -> clear sequence and
    // calls afterPlacement() itself once that finishes (see runBombSequence),
    // so we must NOT call afterPlacement() immediately in that case —
    // otherwise the next-piece/game-over checks would run before the bomb
    // has actually cleared its area.
    const bombSequenceRunning = commitPlacement(d.piece, d.rowOffset, d.colOffset, d.gridEl);
    
    if(!bombSequenceRunning){
      afterPlacement();
    }
  } else {
    // Smoothly animate the exact same element back to its original tray
    // position — never a duplicate, never a resize, just a return trip.
    playSound('invalid');
    const gridEl = d.gridEl;
    // STEP 5 — brief invalid-drop visual pulse (brightness/saturation dip,
    // see .piece-grid.invalid-drop above). Purely cosmetic, auto-removed,
    // never touches transform/position so the existing return animation
    // below is completely unaffected.
    gridEl.classList.add('invalid-drop');
    setTimeout(()=>gridEl.classList.remove('invalid-drop'), 320);
    
    // Return the piece to its original tray position smoothly using transform
    gridEl.style.transition = 'transform 0.10s ease';
    gridEl.style.transform = 'translate3d(0, 0, 0) scale(1)';
    
    let cleaned = false;
    const cleanup = ()=>{
      if(cleaned) return;
      cleaned = true;
      gridEl.classList.remove('dragging');
      gridEl.style.transition='';
      gridEl.style.transform='';
      gridEl.style.willChange='';
      gridEl.style.position='';
      gridEl.style.zIndex='';
      gridEl.style.left=''; 
      gridEl.style.top='';
      gridEl.style.width=''; 
      gridEl.style.height='';
      gridEl.style.pointerEvents='';
      gridEl.removeEventListener('transitionend', cleanup);
    };
    gridEl.addEventListener('transitionend', cleanup);
    gridEl._cbReturnCleanup = ()=>{ gridEl._cbReturnCleanup = null; cleanup(); };
    setTimeout(()=>{ gridEl._cbReturnCleanup = null; cleanup(); }, 130);
  }
}

/* ============================================================
   PLACEMENT / CLEARING
============================================================ */
function commitPlacement(piece, rowOffset, colOffset, sourceGridEl){
  const cells = piece.shape.cells;
  const boardRect = cbBoardRect();           // read BEFORE any DOM write of this move -> cheap; reused by every later reader
  
  // Update board state and visuals SYNCHRONOUSLY — no delays
  for(const [r,c] of cells){
    const nr = rowOffset+r, nc = colOffset+c;
    board[nr][nc] = {filled:true, obstacle:false, c1:piece.theme.c1, c2:piece.theme.c2, emoji: piece.special? piece.special.icon : piece.theme.emoji, candyId: piece.special? null : piece.theme.id};
    refreshCellVisual(nr,nc);
  }
  
  // Sound + vibration feedback (instant)
  playSound('place'); 
  vibrate(12);
  
  // Visual feedback particles (async, doesn't block placement)
  const _fxX = boardRect.left + (colOffset+0.5)*(boardCellSize+3) + 5, _fxY = boardRect.top + (rowOffset+0.5)*(boardCellSize+3) + 5;
  if(mode==='classic'){
    // Classic only: particles + sheen create DOM nodes and the sheen forces a layout read. They are cosmetic, so they run in the
    // next frame instead of inside the pointerup handler (the cell data/visual, sound, score and clears above/below stay synchronous).
    requestAnimationFrame(()=>{ spawnPlaceParticles(_fxX, _fxY, piece.theme.c1); spawnClassicPlaceSheen(rowOffset, colOffset); });
  } else {
    requestAnimationFrame(()=>spawnPlaceParticles(_fxX, _fxY, piece.theme.c1));
  }

  // +30 points per successful placement action (Classic Mode only — flat
  // per placement, not per cell — Journey doesn't display score and its
  // own internal formula is left completely untouched).
  const isTornadoPiece = !!(piece.special && piece.special.type==='tornado');
  if(mode==='classic' && !isTornadoPiece){
    const placeBonus = 30;
    const oldScore = score;
    score += placeBonus;
    updateScoreUI();
    animateScoreCountUp(scoreValEl, oldScore, score);
    if(score>best){ best=score; saveBest(); }
    requestAnimationFrame(()=>spawnScoreFloat(_fxX, _fxY, '+'+placeBonus, {small:true}));
  }

  // Special piece sequences (bomb and tornado) handle their own timing
  if(piece.special && piece.special.type==='bomb'){
    runBombSequence(rowOffset, colOffset);
    return true; // tells endDrag() not to call afterPlacement() yet
  }
  if(isTornadoPiece){
    runTornadoFromPlacement(rowOffset, colOffset);
    return true; // tells endDrag() not to call afterPlacement() yet
  }

  // Standard line clearing and scoring
  let bonus = 0;
  if(piece.special){
    bonus += applySpecial(piece.special.type, rowOffset, colOffset);
  }
  const lineResult = processLineClears();
  
  const total = lineResult.points + bonus;
  if(total>0){
    const oldScore = score;
    score += total;
    updateScoreUI();
    if(mode==='classic') animateScoreCountUp(scoreValEl, oldScore, score);
    if(mode==='classic' && score>best){ best=score; saveBest(); }
  }
  
  return false; // placement is complete, afterPlacement() should be called
}

/* ---- Bomb: pulse in place, then blast, clear its area and score ---- */
function runBombSequence(r, c){
  const cellDom = getCellDOM(r, c);
  cellDom.classList.add('bomb-pulse');
  const onPulseEnd = ()=>{
    cellDom.removeEventListener('animationend', onPulseEnd);
    cellDom.classList.remove('bomb-pulse');
    triggerBombBlast(r, c);
  };
  cellDom.addEventListener('animationend', onPulseEnd);
  // Safety fallback in case animationend never fires (e.g. a browser with
  // reduced-motion settings skipping the animation) so the bomb can never
  // get the game stuck waiting on it.
  setTimeout(()=>{
    if(cellDom.classList.contains('bomb-pulse')){
      cellDom.removeEventListener('animationend', onPulseEnd);
      cellDom.classList.remove('bomb-pulse');
      triggerBombBlast(r, c);
    }
  }, 460);
}

/* ============================================================
   BLAST JOURNEY — CANDY COLLECTION
   Called with the list of [row,col] cells about to be cleared (by a
   row/column clear, a bomb blast, or a line/area special), BEFORE the
   board data for those cells is wiped — so the candy emoji each cell
   was holding is still readable here. Only has any effect in journey
   mode with an active level; a no-op in Classic mode.
============================================================ */
function isJourneyLevelComplete(){
  return !!journeyLevel && journeyLevel.targets.every(t=>t.collected>=t.required);
}

function collectJourneyCandies(cellsList){
  if(mode!=='journey' || !journeyLevel) return;
  let anyCollected = false;
  let anyTargetJustCompleted = false;
  cellsList.forEach(([r,c])=>{
    const cell = board[r][c];
    if(!cell || !cell.filled || !cell.emoji) return;
    // A Rainbow Candy is its own separate objective (see
    // processRainbowCollection) — it never also counts toward a normal
    // candy-color target, even though the underlying cell still carries
    // an ordinary emoji/color under the hood.
    if(rainbowCells[`${r},${c}`]) return;
    // A candy still covered by an unopened Treasure Box is its own
    // separate objective too (see processTreasureBoxHits) — same reason
    // as the rainbow exclusion just above.
    if(treasureCells[`${r},${c}`]) return;
    // A candy still covered by an unbroken jelly cell doesn't count toward
    // its target yet. processJellyCellBreaks runs earlier in this same
    // clear pass and marks the jelly `broken` the instant it pops, so a
    // candy under jelly that just broke on THIS clear is still collectible
    // right away — only a candy under jelly that hasn't broken is skipped.
    const jellyHere = jellyCells[`${r},${c}`];
    if(jellyHere && !jellyHere.broken) return;
    // FIX: the Chocolate objective uses the same 🍫 glyph as the ordinary brown candy; it must only ever
    // progress by breaking chocolate cells (processChocolateBreaks), never by clearing a 🍫 candy.
    const target = journeyLevel.targets.find(t=>t.emoji===cell.emoji && !t.isChocolate && t.collected<t.required);
    if(target){
      target.collected++;
      anyCollected = true;
      if(target.collected>=target.required) anyTargetJustCompleted = true;
    }
  });
  if(anyCollected){
    playSound(anyTargetJustCompleted ? 'targetdone' : 'collect');
    updateJourneyHUD();
    pulseJourneyHUD();
  }
}

// ---------- COMBO CHALLENGE ----------
// Called once per placement, only when the existing multi-line clear
// event (totalLines>=2 in processLineClears) actually happens — never
// for a plain single-line clear, an empty/invalid placement, or dragging.
// A no-op outside Journey mode or on a level with no combo objective.
function collectJourneyCombo(){
  if(mode!=='journey' || !journeyLevel) return;
  const comboTarget = journeyLevel.targets.find(t=>t.isCombo && t.collected<t.required);
  if(!comboTarget) return;
  comboTarget.collected++;
  showComboText('COMBO!');
  spawnJourneyComboParticles();
  boardEl.classList.remove('journey-combo-pulse');
  void boardEl.offsetWidth;
  boardEl.classList.add('journey-combo-pulse');
  updateJourneyHUD();
  pulseJourneyHUD();
}
// Small candy-coloured particle burst at the board's centre, reusing the
// existing spawnChainParticles() visual (same style already used for
// Classic Mode's color chains) — no new particle system.
function spawnJourneyComboParticles(){
  const rect = boardEl.getBoundingClientRect();
  const colors = ['#ffd166','#ff6fb0','#8fe3ff','#b6ff9c'];
  spawnChainParticles(rect.left+rect.width/2, rect.top+rect.height/2, colors[Math.floor(Math.random()*colors.length)]);
}

// ============================================================
// LEVEL 200 — "CANDY CASTLE" FINAL BOSS
// All of this is additive on top of the existing Journey systems above:
// the boss is just one more standalone target (see the isBoss branch in
// generateLevelConfig), damaged by the SAME real row/column clear event
// every other mechanic reacts to (processLineClears), and its defeat is
// detected by the SAME isJourneyLevelComplete()/triggerLevelComplete()
// used by every other level. Nothing here rewrites those systems.
// ============================================================
function bossTargetOf(){
  return (journeyLevel && journeyLevel.targets) ? journeyLevel.targets.find(t=>t.isBoss) : null;
}
function bossPhaseForHpPercent(pct){
  if(pct>70) return 1;
  if(pct>30) return 2;
  return 3;
}
// Shows/hides all Level-200-only DOM (castle scene, boss HP HUD) and
// resets the boss's per-attempt state. Called once from startJourneyLevel
// for every level — a no-op (just hides everything) on any level that
// isn't the boss level, so nothing here can affect levels 1-199.
function setupBossVisuals(n){
  bossActive = (n===BOSS_LEVEL_NUMBER) && !!bossTargetOf();
  bossPhase = 1;
  bossCelebrationShown = false;
  bossVictorySequencePlaying = false;
  const scene = el('boss-castle-scene');
  const king = el('boss-king');
  king.classList.remove('boss-king-enter','boss-king-hit','boss-king-victory');
  el('boss-victory-overlay').classList.add('boss-victory-hidden');
  if(bossActive){
    scene.classList.remove('boss-scene-hidden');
    renderBossHUD();
  } else {
    scene.classList.add('boss-scene-hidden','boss-celebration');
    scene.classList.remove('boss-celebration');
    el('boss-health-hud').classList.add('boss-hud-hidden');
  }
}
function renderBossHUD(){
  const bt = bossTargetOf();
  const hud = el('boss-health-hud');
  if(!bossActive || !bt){ hud.classList.add('boss-hud-hidden'); return; }
  hud.classList.remove('boss-hud-hidden');
  const hp = Math.max(0, bt.required-bt.collected);
  const pct = bt.required>0 ? Math.max(0, Math.min(100, Math.round((hp/bt.required)*100))) : 0;
  el('boss-hp-fill').style.width = pct+'%';
  el('boss-hp-text').textContent = hp+' / '+bt.required;
  el('boss-phase-badge').textContent = 'PHASE '+bossPhase;
  el('boss-king-face').textContent = hp<=0 ? '🤩' : bossPhase===3 ? '😖' : bossPhase===2 ? '😧' : '😀';
}
// Small emoji burst around the King, reusing the same lightweight
// short-lived-DOM-node pattern as every other particle effect in this
// file (auto-removed, no animation loop left running).
function spawnBossHitParticles(){
  const host = el('boss-hit-particles');
  const glyphs = ['🍬','✨','🍭'];
  const colors = ['#ffd166','#ff6fb0','#8fe3ff','#b6ff9c'];
  for(let i=0;i<8;i++){
    const p = document.createElement('span');
    p.className = 'boss-hit-particle';
    p.textContent = glyphs[i%glyphs.length];
    p.style.color = colors[i%colors.length];
    p.style.left = (38+Math.random()*24)+'%';
    p.style.setProperty('--dx', ((Math.random()*2-1)*70)+'px');
    p.style.setProperty('--dy', (-(40+Math.random()*60))+'px');
    host.appendChild(p);
    setTimeout(()=>p.remove(), 900);
  }
}
function playBossHitReaction(){
  const king = el('boss-king');
  king.classList.remove('boss-king-hit'); void king.offsetWidth; king.classList.add('boss-king-hit');
  const label = el('boss-hit-label');
  label.classList.remove('boss-hit-label-show'); void label.offsetWidth; label.classList.add('boss-hit-label-show');
  spawnBossHitParticles();
}
// Short, lightweight "Candy Castle Celebration" flourish at ~50% HP —
// once per level attempt. No new sound is added; reuses the existing
// level-complete fanfare, same as the spirit of every other reused effect
// in this file.
function playBossCelebration(){
  const scene = el('boss-castle-scene');
  scene.classList.add('boss-celebration');
  playSound('levelcomplete');
  vibrate([15,20,15]);
  setTimeout(()=>scene.classList.remove('boss-celebration'), 1800);
}
// Called from processLineClears() on every real clear (totalLines>=1),
// Level 200 only. Damage is capped per move so a big multi-line clear
// can't instantly defeat the boss (per spec) — a normal placement with no
// clear never reaches this function at all (processLineClears returns
// early on totalLines===0, well before this call site).
function damageBossOnClear(totalLines){
  const bt = bossTargetOf();
  if(!bt || bt.collected>=bt.required) return; // already defeated — no further damage
  const dmg = Math.min(totalLines, BOSS_DAMAGE_CAP_PER_MOVE, bt.required-bt.collected);
  if(dmg<=0) return;
  bt.collected += dmg;
  const hp = bt.required-bt.collected;
  const pct = Math.round((hp/bt.required)*100);
  bossPhase = bossPhaseForHpPercent(pct);
  renderBossHUD();
  playBossHitReaction();
  if(!bossCelebrationShown && pct<=50){
    bossCelebrationShown = true;
    playBossCelebration();
  }
}
// Plays a short premium victory flourish (crown pop, particles, rainbow
// glow, confetti, victory sound) BEFORE calling the existing
// triggerLevelComplete() — see the afterPlacement() win-check, which
// calls this instead of the normal setTimeout(triggerLevelComplete,420)
// only when bossActive. Every other level's win flow is untouched.
function playBossVictorySequence(){
  const king = el('boss-king');
  const scene = el('boss-castle-scene');
  const overlay = el('boss-victory-overlay');
  playSound('levelcomplete');
  vibrate([20,30,20,30,60]);
  king.classList.add('boss-king-victory');
  scene.classList.add('boss-celebration');
  setTimeout(()=>{
    overlay.classList.remove('boss-victory-hidden');
    spawnLevelCompleteConfetti(true, gameScreen); // reuses the existing confetti burst, just targeted at the live game screen instead of the (not-yet-shown) complete screen
  }, 450);
  setTimeout(()=>{
    overlay.classList.add('boss-victory-hidden');
    scene.classList.remove('boss-celebration');
    king.classList.remove('boss-king-victory');
    triggerLevelComplete(); // existing, unmodified level-complete system
  }, 2500);
}
// ---------- Boss intro cinematic ("Candy Blast Journey" -> "Candy
// Castle" -> "FINAL CHALLENGE" -> King appears), with a SKIP button that
// always works — the player is never forced to sit through it. ----------
function showBossIntro(){
  const overlay = el('boss-intro-overlay');
  const lineEl = el('boss-intro-line');
  if(bossIntroTimeoutId){ clearTimeout(bossIntroTimeoutId); bossIntroTimeoutId = null; }
  overlay.classList.remove('boss-intro-hidden');
  let i = 0;
  function showNext(){
    if(i>=BOSS_INTRO_LINES.length){ finishBossIntro(); return; }
    lineEl.textContent = BOSS_INTRO_LINES[i];
    lineEl.classList.remove('boss-intro-line-pop'); void lineEl.offsetWidth; lineEl.classList.add('boss-intro-line-pop');
    i++;
    bossIntroTimeoutId = setTimeout(showNext, 750);
  }
  showNext();
}
function finishBossIntro(){
  if(bossIntroTimeoutId){ clearTimeout(bossIntroTimeoutId); bossIntroTimeoutId = null; }
  el('boss-intro-overlay').classList.add('boss-intro-hidden');
  if(bossActive){
    const king = el('boss-king');
    king.classList.remove('boss-king-enter'); void king.offsetWidth; king.classList.add('boss-king-enter');
  }
}

function renderJourneyHUD(){
  if(!journeyLevel) return;
  journeyHudTargetsEl.innerHTML = '';
  journeyLevel.targets.forEach(t=>{
    const chip = document.createElement('div');
    chip.className = 'target-chip' + (t.collected>=t.required ? ' done' : '');
    chip.innerHTML = `<span class="target-chip-emoji">${t.emoji}</span><span class="target-chip-count">${Math.min(t.collected,t.required)}/${t.required}${t.collected>=t.required?' ✓':''}</span>`;
    journeyHudTargetsEl.appendChild(chip);
  });
  el('journey-level-num').textContent = journeyLevel.number;
  updateMovesUI();
}
function updateJourneyHUD(){ renderJourneyHUD(); }
function pulseJourneyHUD(){
  journeyHudEl.classList.remove('hud-pulse');
  void journeyHudEl.offsetWidth;
  journeyHudEl.classList.add('hud-pulse');
}
function showJourneyHUD(visible){
  journeyHudEl.classList.toggle('journey-hud-hidden', !visible);
}

// ---------- LIMITED MOVES: HUD badge ----------
function updateMovesUI(){
  if(journeyMovesRemaining===null || journeyMovesRemaining===undefined){
    journeyMovesBadgeEl.classList.add('journey-moves-hidden');
    journeyMovesBadgeEl.classList.remove('moves-low');
    return;
  }
  journeyMovesBadgeEl.classList.remove('journey-moves-hidden');
  const shown = Math.max(0, journeyMovesRemaining);
  journeyMovesValueEl.textContent = shown;
  journeyMovesValueEl.classList.remove('moves-changed');
  void journeyMovesValueEl.offsetWidth; // reflow to restart the animation
  journeyMovesValueEl.classList.add('moves-changed');
  // Gentle pulse once only 3 moves (or fewer) remain — never while already at 0
  journeyMovesBadgeEl.classList.toggle('moves-low', shown<=3 && shown>0);
}

/* ============================================================
   CLASSIC IN-GAME MENU (⚙️)
============================================================ */
function setClassicTopbar(isClassic){
  btnHomeIngameEl.style.display = isClassic ? 'none' : 'flex';
  btnRestartIngameEl.style.display = isClassic ? 'none' : 'flex';
  btnClassicMenuEl.style.display = isClassic ? 'flex' : 'none';
}
function openClassicMenu(){
  playSound('button');
  classicMenuOpen = true;
  gamePaused = true;
  classicMenuOverlayEl.classList.remove('classic-menu-hidden');
}
function closeClassicMenu(){
  classicMenuOpen = false;
  // Only lift the input-block if nothing else (e.g. a Tornado clear still
  // animating) also needs it paused — fixes a bug where closing the pause
  // menu mid-Tornado-animation let the player place another piece while
  // the board was still being mutated by the tornado clear.
  gamePaused = tornadoActive;
  classicMenuOverlayEl.classList.add('classic-menu-hidden');
}

function triggerBombBlast(r, c){
  const boardRect = boardEl.getBoundingClientRect();
  const step = boardCellSize + 3;
  // Blast is positioned from the bomb's real board-cell coordinates (never
  // fixed screen coordinates), so it lands correctly on any phone, tablet
  // or desktop and at any board size.
  const centerX = boardRect.left + 8 + (c+0.5)*step;
  const centerY = boardRect.top + 8 + (r+0.5)*step;

  // Explosion sound plays at the exact moment the blast visual begins.
  playSound('bomb');
  vibrate(30);
  spawnBombGlowAndRing(centerX, centerY);
  spawnBombParticles(r, c);
  // Ash/smoke drift — Classic Mode only, per request. Journey mode's bomb
  // blast keeps its exact previous visual (glow + ring + colored debris
  // only).
  if(mode==='classic') spawnBombAshParticles(centerX, centerY);

  // 3x3 area centered on the bomb, clipped to the board — never touches
  // anything outside the grid, and never touches cells beyond this area.
  const affected = [];
  for(let dr=-1; dr<=1; dr++){
    for(let dc=-1; dc<=1; dc++){
      const nr = r+dr, nc = c+dc;
      if(inBounds(nr,nc)) affected.push([nr,nc]);
    }
  }

  // Affected cells briefly glow/pop before they actually disappear.
  affected.forEach(([nr,nc])=>{ getCellDOM(nr,nc).classList.add('bomb-affected'); });

  setTimeout(()=>{
    let bonus = 20; // base bomb bonus, same as the existing scoring system
    // Collect journey candies (no-op outside journey mode) BEFORE the cells
    // are wiped, so their emoji is still readable here.
    processJellyCellBreaks(affected);    // Process jelly breaks first so a
                                          // candy under jelly that just
                                          // popped counts on this same clear
    processChocolateBreaks(affected);    // Process chocolate breaks (Journey-only)
    processBombDefuses(affected);        // Process bomb defuses (Journey-only)
    collectJourneyCandies(affected);
    processLockedCandyUnlocks(affected); // Process locked candy unlocks
    processFrozenCandyBreaks(affected);  // Process frozen candy breaks
    processRainbowCollection(affected);  // Process rainbow candy collection (Journey-only)
    processTreasureBoxHits(affected);    // Process Treasure Box hits (Journey-only)
    processPathProgress(affected);       // Process Candy Path progression (Journey-only)
    affected.forEach(([nr,nc])=>{
      if(!(nr===r && nc===c) && (board[nr][nc].filled || board[nr][nc].obstacle)){
        bonus += 5; // same per-cell bonus as before
      }
      board[nr][nc] = {filled:false, obstacle:false, c1:null, c2:null, emoji:null};
    });
    affected.forEach(([nr,nc])=>{
      const dom = getCellDOM(nr,nc);
      dom.classList.remove('bomb-affected');
      refreshCellVisual(nr,nc);
    });

    // Checked fresh against the post-blast board state, so any row/column
    // the blast happens to complete is scored correctly with no double
    // counting against the bomb's own area-clear bonus above.
    const lineResult = processLineClears();
    const total = lineResult.points + bonus;
    if(total>0){
      const oldScore = score;
      score += total;
      updateScoreUI();
      if(mode==='classic') animateScoreCountUp(scoreValEl, oldScore, score);
      if(mode==='classic' && score>best){ best=score; saveBest(); }
    }
    afterPlacement();
  }, 260);
}

function spawnBombGlowAndRing(x, y){
  const glowSize = Math.max(70, boardCellSize*3.2);
  const ringSize = Math.max(90, boardCellSize*4.2);

  const glow = document.createElement('div');
  glow.className = 'bomb-glow';
  glow.style.left = x+'px';
  glow.style.top = y+'px';
  glow.style.width = glowSize+'px';
  glow.style.height = glowSize+'px';
  document.body.appendChild(glow);
  setTimeout(()=>glow.remove(), 600);

  const ring = document.createElement('div');
  ring.className = 'bomb-ring';
  ring.style.left = x+'px';
  ring.style.top = y+'px';
  ring.style.width = ringSize+'px';
  ring.style.height = ringSize+'px';
  document.body.appendChild(ring);
  setTimeout(()=>ring.remove(), 520);
}

/* ============================================================
   TORNADO 6×6 POWER-UP (Classic Mode only)
   A rare, PLAYER-ACTIVATED power-up. A hidden setTimeout chain decides
   only when the tornado ICON is allowed to appear next to the tray (2-3
   times per Classic session, at long, unpredictable gaps) — it never
   touches the board by itself. The player must tap the icon, then tap a
   spot on the board to confirm a target, before anything clears. Once
   confirmed, the exact same 5-step animation (warning -> spawn -> suction
   -> big clear -> disappear) plays over the chosen 6×6 area, clipped to
   the 7×7 grid, and the actual clear is fed through the exact same
   processLineClears()/classicRegisterClear() scoring pipeline as every
   other clear in the game — so combo/streak/multiplier and the multi-line
   bonus all apply normally. Completely inert in Journey mode and the
   More Games mini-games.
============================================================ */
function tornadoRandomDelay(isFirst){
  // Long, unpredictable gaps — not a fixed interval. The first tornado
  // piece takes a while to show up; later ones are spaced even further
  // apart.
  return isFirst ? (26000 + Math.random()*20000) : (32000 + Math.random()*26000);
}
// Called once per new Classic game (and on every restart) to fully reset
// the rare-tornado system and (re)schedule the first check. A no-op
// safety reset in Journey mode — it clears any leftover timer/state but
// never schedules anything outside Classic.
function resetTornadoSession(){
  if(tornadoTimerId){ clearTimeout(tornadoTimerId); tornadoTimerId = null; }
  tornadoActive = false;
  tornadoOfferState = 'idle';
  tornadoOffersShown = 0;
  tornadoMaxOffers = Math.random()<0.5 ? 2 : 3; // 2-3 rare tornado pieces per session
  hideTornadoBadge();
  if(mode==='classic' && !CLASSIC_TAP_FILL){
    tornadoTimerId = setTimeout(tornadoOfferCheck, tornadoRandomDelay(true));
  }
}
// Cancels everything — pending timer and any in-progress animation state —
// called any time the player leaves the Classic board (home, settings,
// game over, journey, more games, mini-games) so a tornado piece can
// never appear off-screen and no stray timer is ever left running in the
// background.
function cancelTornadoSession(){
  if(tornadoTimerId){ clearTimeout(tornadoTimerId); tornadoTimerId = null; }
  tornadoActive = false;
  hideTornadoBadge();
}
// Schedules the NEXT rare tornado piece after a long gap, as long as the
// session's quota (2-3 total) hasn't already been used up.
function scheduleNextTornadoOffer(){
  if(mode!=='classic' || tornadoOffersShown>=tornadoMaxOffers) return;
  tornadoTimerId = setTimeout(tornadoOfferCheck, tornadoRandomDelay(false));
}
// Fires when a scheduled check is due. Verifies every real-world condition
// (still Classic, board actually visible, not paused, no piece mid-drag,
// no tornado piece already pending, board has enough real content, quota
// not used up) before actually placing the tornado into the tray — if any
// check fails it just quietly retries a little later rather than
// cancelling outright.
// IMPORTANT: this function only ever calls injectTornadoIntoTray() (drop a
// tornado piece into the tray) — it never touches the board and never
// calls the clear animation directly. The clear only ever happens once the
// player actually drags that piece onto the board themselves.
function tornadoOfferCheck(){
  tornadoTimerId = null;
  if(mode!=='classic' || tornadoOffersShown>=tornadoMaxOffers) return;
  const screenActive = gameScreen.classList.contains('active');
  if(!screenActive || gamePaused || tornadoOfferState!=='idle' || dragInfo){
    tornadoTimerId = setTimeout(tornadoOfferCheck, 3500 + Math.random()*2000);
    return;
  }
  let filled = 0;
  for(let r=0;r<SIZE;r++) for(let c=0;c<SIZE;c++){ if(board[r][c].filled || board[r][c].obstacle) filled++; }
  if(filled < 8){
    // Board too empty to be worth a big clear yet — check again shortly.
    tornadoTimerId = setTimeout(tornadoOfferCheck, 5000 + Math.random()*4000);
    return;
  }
  injectTornadoIntoTray();
}
// Replaces one of the currently-occupied tray slots with a Tornado piece —
// visually and mechanically just like the Bomb special piece: a single
// glowing tornado icon the player drags onto the board like any other
// piece. Nothing on the board changes until they actually do that.
function injectTornadoIntoTray(){
  const occupied = [];
  for(let i=0;i<3;i++){ if(trayPieces[i]) occupied.push(i); }
  if(occupied.length===0){
    // All 3 slots mid-refill right this instant (rare timing edge case) —
    // just try again shortly rather than losing this opportunity.
    tornadoTimerId = setTimeout(tornadoOfferCheck, 2000);
    return;
  }
  tornadoOffersShown++; // an "opportunity" is consumed the moment it's given, used or not
  tornadoOfferState = 'pending';
  const slot = occupied[Math.floor(Math.random()*occupied.length)];
  trayPieces[slot] = { shape: SHAPES.find(s=>s.name==='single'), theme: randomTheme(), special:{type:'tornado', icon:'🌪️'} };
  renderTray();
  playSound('tornadowarn');
  vibrate(12);
}
function showTornadoBadge(state){
  tornadoBadgeEl.classList.remove('tornado-badge-hidden');
  tornadoBadgeEl.classList.toggle('tornado-warn', state==='warn');
  tornadoBadgeEl.classList.toggle('tornado-live', state==='active');
  tornadoBadgeLabelEl.textContent = state==='active' ? '6×6 CLEAR!' : 'TORNADO!';
}
function hideTornadoBadge(){
  tornadoBadgeEl.classList.add('tornado-badge-hidden');
  tornadoBadgeEl.classList.remove('tornado-warn','tornado-live');
}
// Builds the tornado's overlay container, sized/positioned in exact
// board-local pixel coordinates from the real cell elements — so it is
// always pixel-accurate and automatically clipped by #board's own
// overflow:hidden + rounded corners on any screen size.
function buildTornadoZoneDOM(originR, originC){
  const c1 = getCellDOM(originR, originC);
  const c2 = getCellDOM(originR+TORNADO_AREA-1, originC+TORNADO_AREA-1);
  const zone = document.createElement('div');
  zone.className = 'tornado-zone';
  zone.style.left = c1.offsetLeft+'px';
  zone.style.top = c1.offsetTop+'px';
  zone.style.width = ((c2.offsetLeft+c2.offsetWidth)-c1.offsetLeft)+'px';
  zone.style.height = ((c2.offsetTop+c2.offsetHeight)-c1.offsetTop)+'px';
  boardEl.appendChild(zone);
  return zone;
}
// Clamps a candidate 6×6 top-left origin so the area always stays fully
// inside the board — always valid, always clipped, never touches cells
// outside it.
function clampTornadoOrigin(r,c){
  const maxOff = SIZE - TORNADO_AREA;
  return { r: Math.max(0, Math.min(maxOff, r)), c: Math.max(0, Math.min(maxOff, c)) };
}
// The player dropped the Tornado piece at board cell (r,c) — like Bomb,
// the 6×6 clear is centred as closely as possible on exactly where they
// placed it, clamped so it always stays fully on the board.
function runTornadoFromPlacement(r, c){
  const half = Math.floor((TORNADO_AREA-1)/2);
  const origin = clampTornadoOrigin(r-half, c-half);
  executeTornadoAt(origin.r, origin.c);
}
// STEP 1 — WIND WARNING: a soft glowing highlight over the target area, a
// few floating particles, and a whoosh, before anything else appears.
// Only ever called from runTornadoFromPlacement() above, i.e. only after
// the player has explicitly dragged the piece to this exact spot.
function executeTornadoAt(originR, originC){
  tornadoActive = true;
  gamePaused = true; // blocks drag input for the duration of the sequence
  clearHintHighlights();
  const zone = buildTornadoZoneDOM(originR, originC);

  showTornadoBadge('warn');
  playSound('tornadowarn');
  vibrate(15);

  const warnRing = document.createElement('div');
  warnRing.className = 'tornado-warn-ring';
  zone.appendChild(warnRing);
  for(let i=0;i<6;i++){
    const p = document.createElement('div');
    p.className = 'tornado-warn-particle';
    p.style.left = (10+Math.random()*80)+'%';
    p.style.top = (10+Math.random()*80)+'%';
    p.style.animationDelay = (Math.random()*0.6)+'s';
    zone.appendChild(p);
  }

  setTimeout(()=>{
    warnRing.remove();
    zone.querySelectorAll('.tornado-warn-particle').forEach(p=>p.remove());
    spawnTornadoFunnel(zone, originR, originC);
  }, 780);
}
// STEP 2 — TORNADO SPAWN: the funnel grows smoothly from the centre to
// full size (never a sudden pop), with rotating wind-ring layers and a
// gentle continuous sway once fully grown.
function spawnTornadoFunnel(zone, originR, originC){
  playSound('tornadospawn');
  const outer = document.createElement('div');
  outer.className = 'tornado-funnel-outer';
  outer.innerHTML =
    '<div class="tornado-funnel-inner">' +
      '<svg viewBox="0 0 200 240" class="tornado-svg" preserveAspectRatio="xMidYMid meet">' +
        '<defs>' +
          '<linearGradient id="tornadoGrad" x1="0" y1="0" x2="0" y2="1">' +
            '<stop offset="0%" stop-color="#e8fbff"/>' +
            '<stop offset="38%" stop-color="#7fd8ff"/>' +
            '<stop offset="72%" stop-color="#5a8dff"/>' +
            '<stop offset="100%" stop-color="#9a6bff"/>' +
          '</linearGradient>' +
        '</defs>' +
        '<g class="tornado-cloud">' +
          '<circle cx="72" cy="34" r="30" fill="url(#tornadoGrad)" opacity="0.55"/>' +
          '<circle cx="112" cy="27" r="34" fill="url(#tornadoGrad)" opacity="0.6"/>' +
          '<circle cx="140" cy="42" r="25" fill="url(#tornadoGrad)" opacity="0.5"/>' +
          '<circle cx="100" cy="18" r="22" fill="#f2fdff" opacity="0.4"/>' +
        '</g>' +
        '<g class="tornado-body">' +
          '<ellipse cx="100" cy="60" rx="82" ry="20" fill="url(#tornadoGrad)" opacity="0.85"/>' +
          '<ellipse class="tornado-windline" cx="100" cy="80" rx="70" ry="17" fill="none" stroke="#eafcff" stroke-width="4" opacity="0.75"/>' +
          '<ellipse cx="100" cy="102" rx="58" ry="14" fill="url(#tornadoGrad)" opacity="0.85"/>' +
          '<ellipse class="tornado-windline" cx="100" cy="124" rx="46" ry="11" fill="none" stroke="#eafcff" stroke-width="3.6" opacity="0.7"/>' +
          '<ellipse cx="100" cy="145" rx="35" ry="9" fill="url(#tornadoGrad)" opacity="0.88"/>' +
          '<ellipse class="tornado-windline" cx="100" cy="165" rx="25" ry="7" fill="none" stroke="#eafcff" stroke-width="3" opacity="0.7"/>' +
          '<ellipse cx="100" cy="184" rx="16" ry="5.5" fill="url(#tornadoGrad)" opacity="0.9"/>' +
          '<ellipse cx="100" cy="200" rx="8" ry="3.5" fill="#eafcff" opacity="0.95"/>' +
          '<ellipse cx="66" cy="72" rx="13" ry="6" fill="#b48bff" opacity="0.5"/>' +
          '<ellipse cx="132" cy="112" rx="10" ry="5" fill="#b48bff" opacity="0.45"/>' +
        '</g>' +
      '</svg>' +
      '<div class="tornado-ring r1"></div>' +
      '<div class="tornado-ring r2"></div>' +
      '<div class="tornado-ring r3"></div>' +
    '</div>';
  zone.appendChild(outer);
  requestAnimationFrame(()=>{ outer.classList.add('tornado-grow'); });
  setTimeout(()=>{
    const inner = outer.querySelector('.tornado-funnel-inner');
    if(inner) inner.classList.add('tornado-sway');
    showTornadoBadge('active');
    startTornadoSuction(zone, originR, originC, (cells)=>{
      finishTornadoClear(zone, outer, cells);
    });
  }, 600);
}
// STEP 3 — SUCTION: candies inside the 6×6 area shrink/rotate/fade as if
// pulled toward the funnel's core, plus extra candy-coloured sparks that
// visibly spiral in — all smooth and controlled, nothing flies off-board.
function startTornadoSuction(zone, originR, originC, callback){
  playSound('tornadosuck');
  const cells = [];
  for(let dr=0; dr<TORNADO_AREA; dr++){
    for(let dc=0; dc<TORNADO_AREA; dc++){
      const nr = originR+dr, nc = originC+dc;
      if(inBounds(nr,nc)){
        cells.push([nr,nc]);
        if(board[nr][nc].filled || board[nr][nc].obstacle){
          getCellDOM(nr,nc).classList.add('tornado-pulled');
        }
      }
    }
  }
  const filledCount = cells.filter(([nr,nc])=>board[nr][nc].filled||board[nr][nc].obstacle).length;
  const sparkCount = Math.min(14, 6 + Math.floor(filledCount/3));
  for(let i=0;i<sparkCount;i++){
    const p = document.createElement('div');
    p.className = 'tornado-suck-particle';
    const angle = Math.random()*Math.PI*2;
    const dist = 30 + Math.random()*42;
    p.style.setProperty('--sx', (Math.cos(angle)*dist)+'%');
    p.style.setProperty('--sy', (Math.sin(angle)*dist)+'%');
    const theme = THEMES[Math.floor(Math.random()*THEMES.length)];
    const size = 6+Math.random()*6;
    p.style.width = size+'px'; p.style.height = size+'px';
    p.style.background = theme.c1;
    p.style.animationDuration = (600+Math.random()*300)+'ms';
    p.style.animationDelay = (Math.random()*150)+'ms';
    zone.appendChild(p);
    setTimeout(()=>p.remove(), 1100);
  }

  setTimeout(()=>{
    cells.forEach(([nr,nc])=>getCellDOM(nr,nc).classList.remove('tornado-pulled'));
    callback(cells);
  }, 720);
}
// STEP 4 — BIG CLEAR: a bright flash + outward shockwave + candy-coloured
// burst, and the actual board mutation, fed straight into the same
// processLineClears()/classicRegisterClear() pipeline as any other clear
// so combo/streak/multiplier/multi-line bonuses all apply exactly as
// normal — no separate, inconsistent scoring path.
function finishTornadoClear(zone, outer, cells){
  playSound('tornadoclear');
  vibrate(35);
  // Soft screen shake on the big 6×6 clear, reusing the same lightweight
  // .board-shake CSS animation already used for cascaded special-candy
  // activations — no new animation system, no extra listeners.
  boardEl.classList.remove('board-shake'); void boardEl.offsetWidth; boardEl.classList.add('board-shake');
  const inner = outer.querySelector('.tornado-funnel-inner');
  if(inner) inner.classList.add('tornado-pulse');

  const flash = document.createElement('div');
  flash.className = 'tornado-clear-flash';
  zone.appendChild(flash);
  const shock = document.createElement('div');
  shock.className = 'tornado-shockwave';
  const shockSize = Math.max(zone.offsetWidth, zone.offsetHeight);
  shock.style.width = shockSize+'px';
  shock.style.height = shockSize+'px';
  zone.appendChild(shock);

  collectJourneyCandies(cells); // no-op outside Journey mode; tornado is Classic-only anyway
  // Flat 300-point tornado bonus (per updated scoring request) — any
  // rows/columns the clear happens to complete still add their own points
  // separately via the normal processLineClears() pipeline below, exactly
  // like every other clear in the game. Awarded exactly once, only here —
  // only when the 6×6 clear actually executes, never on selection/preview.
  let bonus = cells.length>0 ? 300 : 0;
  cells.forEach(([nr,nc])=>{
    board[nr][nc] = {filled:false, obstacle:false, void:false, c1:null, c2:null, emoji:null};
  });
  cells.forEach(([nr,nc])=>{
    getCellDOM(nr,nc).classList.remove('tornado-pulled');
    refreshCellVisual(nr,nc);
  });

  const lineResult = processLineClears();
  const total = lineResult.points + bonus;
  const zr = zone.getBoundingClientRect();
  if(total>0){
    const oldScore = score;
    score += total;
    updateScoreUI();
    animateScoreCountUp(scoreValEl, oldScore, score);
    if(score>best){ best = score; saveBest(); }
    spawnScoreFloat(zr.left+zr.width/2, zr.top+zr.height/2, '+'+total);
  }
  spawnTornadoBurstParticles(zr.left+zr.width/2, zr.top+zr.height/2);

  setTimeout(()=>{
    flash.remove();
    shock.remove();
    // STEP 5 — DISAPPEAR: shrink smoothly away, fade the rings, then
    // return the board to normal gameplay with no stuck overlay.
    playSound('tornadodisappear');
    outer.classList.remove('tornado-grow');
    outer.classList.add('tornado-shrink');
    setTimeout(()=>{
      zone.remove();
      tornadoActive = false;
      tornadoOfferState = 'idle';
      hideTornadoBadge();
      // Don't force-unpause if the player opened the Classic pause menu
      // during the animation — leave input blocked until they close it.
      gamePaused = classicMenuOpen;
      afterPlacement();
      scheduleNextTornadoOffer();
    }, 520);
  }, 300);
}
// Candy-coloured particles exploding outward from the clear's centre,
// reusing the same lightweight fixed-position particle system as the
// bomb blast (spawnBombParticles) for a consistent, proven visual style.
function spawnTornadoBurstParticles(x,y){
  for(let i=0;i<12;i++){
    const p = document.createElement('div');
    p.className = 'particle';
    const size = 6+Math.random()*8;
    p.style.width = size+'px'; p.style.height = size+'px';
    p.style.left = x+'px'; p.style.top = y+'px';
    const theme = THEMES[Math.floor(Math.random()*THEMES.length)];
    p.style.background = theme.c1;
    const angle = Math.random()*Math.PI*2;
    const dist = 40+Math.random()*46;
    p.style.setProperty('--pt', `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px)`);
    document.body.appendChild(p);
    setTimeout(()=>p.remove(), 700);
  }
  for(let i=0;i<6;i++){
    const p = document.createElement('div');
    p.className = 'particle';
    const size = 4+Math.random()*4;
    p.style.width = size+'px'; p.style.height = size+'px';
    p.style.left = x+'px'; p.style.top = y+'px';
    p.style.background = ['#eafcff','#9fdcff','#c9a8ff'][Math.floor(Math.random()*3)];
    const angle = Math.random()*Math.PI*2;
    const dist = 55+Math.random()*35;
    p.style.setProperty('--pt', `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px)`);
    document.body.appendChild(p);
    setTimeout(()=>p.remove(), 620);
  }
}

function applySpecial(type, r, c){
  let bonus = 0;
  if(type==='line'){
    playSound('bomb'); vibrate(25);
    const cellsHere = [];
    for(let cc=0;cc<SIZE;cc++) cellsHere.push([r,cc]);
    processJellyCellBreaks(cellsHere);
    processChocolateBreaks(cellsHere);
    processBombDefuses(cellsHere);
    collectJourneyCandies(cellsHere);
    processLockedCandyUnlocks(cellsHere);
    processFrozenCandyBreaks(cellsHere);
    processRainbowCollection(cellsHere);
    processTreasureBoxHits(cellsHere);
    processPathProgress(cellsHere);
    for(let cc=0;cc<SIZE;cc++){
      if(board[r][cc].filled || board[r][cc].obstacle) bonus+=3;
      board[r][cc] = {filled:false, obstacle:false, c1:null,c2:null,emoji:null};
    }
    bonus += 15;
    refreshAllCells();
  } else if(type==='area'){
    playSound('bomb'); vibrate(20);
    const cellsHere = [];
    for(let dr=0;dr<=1;dr++){
      for(let dc=0;dc<=1;dc++){
        const nr=r+dr, nc=c+dc;
        if(inBounds(nr,nc)) cellsHere.push([nr,nc]);
      }
    }
    processJellyCellBreaks(cellsHere);
    processChocolateBreaks(cellsHere);
    processBombDefuses(cellsHere);
    collectJourneyCandies(cellsHere);
    processLockedCandyUnlocks(cellsHere);
    processFrozenCandyBreaks(cellsHere);
    processRainbowCollection(cellsHere);
    processTreasureBoxHits(cellsHere);
    processPathProgress(cellsHere);
    cellsHere.forEach(([nr,nc])=>{
      if(board[nr][nc].filled || board[nr][nc].obstacle) bonus+=4;
      board[nr][nc] = {filled:false, obstacle:false, c1:null,c2:null,emoji:null};
    });
    bonus += 12;
    refreshAllCells();
  }
  return bonus;
}

function processLineClears(){
  const rowsToClear = [];
  const colsToClear = [];
  // A row/column is "complete" when every PLAYABLE (non-void) cell in it
  // is blocked (filled or obstacle). Void cells are skipped entirely —
  // they never need to be filled and never count toward completion. A
  // row made up of nothing but void cells can never clear (guarded via
  // hasPlayable). Classic boards have zero void cells, so this is
  // identical to the original all-49-cells check there.
  for(let r=0;r<SIZE;r++){
    let full = true, hasPlayable = false;
    for(let c=0;c<SIZE;c++){
      if(board[r][c].void) continue;
      hasPlayable = true;
      if(!isBlocked(r,c)){ full=false; break; }
    }
    if(full && hasPlayable) rowsToClear.push(r);
  }
  for(let c=0;c<SIZE;c++){
    let full = true, hasPlayable = false;
    for(let r=0;r<SIZE;r++){
      if(board[r][c].void) continue;
      hasPlayable = true;
      if(!isBlocked(r,c)){ full=false; break; }
    }
    if(full && hasPlayable) colsToClear.push(c);
  }
  const totalLines = rowsToClear.length + colsToClear.length;
  if(totalLines===0){
    // A move that didn't clear anything breaks the Classic streak/multiplier.
    // No-op in Journey/mini-games (classicBreakStreak itself is a no-op
    // outside classic mode).
    classicBreakStreak();
    return {points:0, lines:0};
  }

  // CLASSIC 3D CLEAR FX: per-clear plan (null in Blast Journey / reduced-motion => original visuals)
  const cfxPlan = (mode==='classic') ? classicClearPlan(rowsToClear, colsToClear) : null;
  // mark clearing animation
  const cellsToClear = new Set();
  rowsToClear.forEach(r=>{ for(let c=0;c<SIZE;c++){ if(!board[r][c].void) cellsToClear.add(r+'_'+c); } });
  colsToClear.forEach(c=>{ for(let r=0;r<SIZE;r++){ if(!board[r][c].void) cellsToClear.add(r+'_'+c); } });
  // PERF (Step 4 — input responsiveness): this used to read getComputedStyle(dom) INSIDE the per-cell loop below, right after
  // the previous cell's DOM writes (ghost append + 'clearing' class), which forced a fresh style recalculation for every
  // cleared cell (read/write interleaving). A 9-line clear (64 cells) spent ~15 of its ~21ms pointerup handler time there.
  // All the reads now happen up-front in one pass, before any write; the values are plain strings copied out of the live
  // CSSStyleDeclaration, so each ghost still gets exactly the paint the cell had BEFORE its 'clearing' class was applied.
  // (The only '.clearing' CSS rule is a same-cell child selector, so one cell's write can never change another's read.)
  const ghostPaint = new Map();
  cellsToClear.forEach(key=>{
    const [r,c] = key.split('_').map(Number);
    const dom = getCellDOM(r,c);
    if(!dom.querySelector(':scope > .clear-ghost')){
      const cs = getComputedStyle(dom);
      ghostPaint.set(key, {bi:cs.backgroundImage, bc:cs.backgroundColor, bs:cs.boxShadow, fs:cs.fontSize});
    }
  });
  cellsToClear.forEach(key=>{
    const [r,c] = key.split('_').map(Number);
    const dom = getCellDOM(r,c);
    // GRID-VISIBILITY FIX: the clear animation used to scale/fade the WHOLE
    // cell element, so the empty grid tile shrank, brightened and vanished
    // together with the candy. Now the candy is copied into a disposable
    // .clear-ghost child that alone plays the pop/fade, while the cell itself
    // stays put as a normal empty grid tile (see .cell.clearing in CSS). The
    // ghost is wiped by refreshCellVisual()'s existing textContent reset.
    // (Read the cell's paint BEFORE the 'clearing' class changes it.)
    const gp = ghostPaint.get(key);
    if(gp){
      const ghost = document.createElement('div');
      ghost.className = 'clear-ghost';
      ghost.style.backgroundImage = gp.bi;
      ghost.style.backgroundColor = gp.bc;
      ghost.style.boxShadow = gp.bs;
      ghost.style.fontSize = gp.fs;
      // cloneNode(true) of each child yields the identical subtree as innerHTML=dom.innerHTML, without serialize+reparse of the SVG art
      for(let ch=dom.firstChild; ch; ch=ch.nextSibling) ghost.appendChild(ch.cloneNode(true));
      dom.appendChild(ghost);
      if(cfxPlan) classicTagClearGhost(ghost, r, c, cfxPlan);
    }
    if(cfxPlan) dom._cfxTok = cfxPlan.tok;
    dom.classList.add('clearing');
    // Classic Mode Step 7: tag the cell with its candy's material group
    // (read BEFORE the board data below is wiped) so the CSS clear-pop
    // variant matches that candy's identity. Only ever set for a
    // Classic-only candyId (see classicCandyMaterialGroup) — Blast
    // Journey's THEMES candies never carry one, so this attribute is
    // simply never present there and Journey's clear pop is unaffected.
    const material = classicCandyMaterialGroup(board[r][c] && board[r][c].candyId);
    if(material) dom.setAttribute('data-candy-material', material);
    else dom.removeAttribute('data-candy-material');
  });

  let points;
  if(mode==='classic'){
    // Advanced Classic scoring: basePoints (per actual block cleared) +
    // multi-line-in-one-move bonus + consecutive-clear streak bonus, all
    // multiplied by the current streak multiplier. Journey/mini-games never
    // reach this branch, so their scoring is completely untouched below.
    points = classicRegisterClear(cellsToClear.size, totalLines, rowsToClear, colsToClear);
  } else {
    // Original, unchanged Journey formula (Journey doesn't display score
    // anyway, but internal bookkeeping stays exactly as it always was).
    points = 0;
    for(let i=1;i<=totalLines;i++) points += i*10;
  }

  playSound(totalLines>=2 ? 'combo' : 'clear', totalLines);
  vibrate(totalLines>=2 ? 40 : 18);
  let cfxDone = false;
  if(cfxPlan){ try{ cfxDone = CFX.play(rowsToClear, colsToClear, cfxPlan); }catch(e){ cfxDone = false; } }
  if(!cfxDone) spawnLineClearParticles(rowsToClear, colsToClear);
  // STEP 5 — premium energy sweep + soft shockwave, fired at the exact
  // same moment as the particle burst above (purely additive overlay,
  // see spawnLineClearSweep — never touches timing/state below).
  if(!cfxDone) spawnLineClearSweep(rowsToClear, colsToClear);
  // COMBO CHALLENGE: a real combo, by the game's existing definition, is
  // this same totalLines>=2 event already driving the sound/vibration
  // above — reused here rather than a separate scoring system.
  if(totalLines>=2) collectJourneyCombo();
  // LEVEL 200 BOSS: a "successful clear" is exactly this same event (we're
  // already past the totalLines===0 early return above) — reused as-is,
  // no separate clear-detection logic. No-op whenever bossActive is false.
  if(bossActive) damageBossOnClear(totalLines);

  // Clear the DATA model immediately so game-state checks (game over, next
  // placement validity) are always correct. Only the VISUAL fade-out is
  // delayed, purely for the animation. (cellsToClear never contains void
  // cells — see the two forEach loops above — so this never disturbs a
  // level's board-shape mask.)
  const cellsToClearArr = [...cellsToClear].map(key=>key.split('_').map(Number));
  processJellyCellBreaks(cellsToClearArr);    // Process jelly breaks (Journey-only) first, so a
                                               // candy under jelly that just popped still counts below
  processChocolateBreaks(cellsToClearArr);    // Process chocolate breaks (Journey-only)
  processBombDefuses(cellsToClearArr);        // Process bomb defuses (Journey-only)
  collectJourneyCandies(cellsToClearArr); // no-op outside journey mode; reads emoji before it's wiped below
  processLockedCandyUnlocks(cellsToClearArr); // Process locked candy unlocks (Journey-only)
  processFrozenCandyBreaks(cellsToClearArr);   // Process frozen candy breaks (Journey-only)
  processRainbowCollection(cellsToClearArr);   // Process rainbow candy collection (Journey-only)
  processTreasureBoxHits(cellsToClearArr);     // Process Treasure Box hits (Journey-only)
  processPathProgress(cellsToClearArr);        // Process Candy Path progression (Journey-only)
  cellsToClearArr.forEach(([r,c])=>{
    board[r][c] = {filled:false, obstacle:false, void:false, c1:null,c2:null,emoji:null};
  });

  setTimeout(()=>{
    cellsToClear.forEach(key=>{
      const [r,c] = key.split('_').map(Number);
      const dom = getCellDOM(r,c);
      // Classic 3D FX: skip a cell that was already redrawn (player tapped it) or re-cleared by a newer
      // clear — its own timeout will clean it, and we must not cut that animation short.
      if(cfxPlan && (dom._cfxTok!==cfxPlan.tok || !dom.classList.contains('clearing'))) return;
      dom.classList.remove('clearing');
      dom.removeAttribute('data-candy-material');
      refreshCellVisual(r,c);
    });
  }, cfxPlan ? cfxPlan.cleanupMs : 320);

  return {points, lines: totalLines};
}

/* ============================================================
   NEW CLEARING SYSTEM — connected-color chains & special candies
   Classic Mode only (mode==='classic'), and purely ADDITIVE on top of the
   existing row/column clearing above: it runs once, right after a
   placement's row/column clears have already been resolved, scanning the
   ACTUAL post-clear board for 4+ orthogonally-connected same-colour
   candies. Journey mode explicitly keeps its own existing rules and never
   calls into any of this.
============================================================ */
const CHAIN_MIN_SIZE = 4;

// Colour identity for chain-matching/colorblast: several of the 20 Classic
// candy skins intentionally reuse an original THEMES emoji (e.g. Strawberry
// 🍓 vs the original red 🍓, Chocolate 🍫 vs the original brown 🍫, Hard
// Candy 🍬 vs the original pink 🍬, Lollipop 🍭 vs the original purple 🍭,
// Watermelon 🍉 vs the original green 🍉) but renders completely different
// premium art/colours via candyId. Matching on raw emoji would therefore
// flood-fill/colorblast two visually-different candies together as if they
// were the same colour — a real bug, not a cosmetic one. candyId (when
// present) is the true visual identity, so it takes priority; only candies
// with no candyId (the plain original THEMES look) fall back to emoji.
function candyColorKey(cell){
  return cell.candyId || cell.emoji;
}
// Real flood-fill over the live board — never visual-only. Returns every
// group of 4+ orthogonally-connected cells that share the same candy
// colour identity (see candyColorKey), skipping obstacles/void/already-special cells.
function findColorChains(){
  const visited = Array.from({length:SIZE}, ()=>new Array(SIZE).fill(false));
  const chains = [];
  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      if(visited[r][c]) continue;
      visited[r][c] = true;
      const cell = board[r][c];
      if(!cell.filled || cell.obstacle || cell.void || cell.specialType) continue;
      const targetKey = candyColorKey(cell);
      const targetEmoji = cell.emoji;
      const stack = [[r,c]];
      const group = [[r,c]];
      while(stack.length){
        const [cr,cc] = stack.pop();
        [[cr-1,cc],[cr+1,cc],[cr,cc-1],[cr,cc+1]].forEach(([nr,nc])=>{
          if(!inBounds(nr,nc) || visited[nr][nc]) return;
          const ncell = board[nr][nc];
          if(!ncell.filled || ncell.obstacle || ncell.void || ncell.specialType || candyColorKey(ncell)!==targetKey) return;
          visited[nr][nc] = true;
          group.push([nr,nc]);
          stack.push([nr,nc]);
        });
      }
      if(group.length>=CHAIN_MIN_SIZE){
        chains.push({cells:group, emoji:targetEmoji, colorKey:targetKey, c1:cell.c1, c2:cell.c2});
      }
    }
  }
  return chains;
}
// Chooses which cell of a matched chain becomes the special candy: the one
// closest to the chain's own centroid, so it always appears "inside" the
// shape rather than at an arbitrary corner.
function pickChainHost(cells){
  let sr=0, sc=0;
  cells.forEach(([r,c])=>{ sr+=r; sc+=c; });
  const cr = sr/cells.length, cc = sc/cells.length;
  let best = cells[0], bestD = Infinity;
  cells.forEach(([r,c])=>{
    const d = (r-cr)*(r-cr)+(c-cc)*(c-cc);
    if(d<bestD){ bestD=d; best=[r,c]; }
  });
  return best;
}
function chainOrientation(cells){
  let minR=99, maxR=-1, minC=99, maxC=-1;
  cells.forEach(([r,c])=>{ if(r<minR)minR=r; if(r>maxR)maxR=r; if(c<minC)minC=c; if(c>maxC)maxC=c; });
  return (maxC-minC) >= (maxR-minR) ? 'h' : 'v';
}
// Candy-coloured particle burst, matching the style already used for line
// clears/bombs elsewhere — a handful of short-lived DOM nodes, no loop.
function spawnChainParticles(x,y,color){
  for(let i=0;i<8;i++){
    const p = document.createElement('div');
    p.className = 'particle';
    const size = 5+Math.random()*5;
    p.style.width = size+'px'; p.style.height = size+'px';
    p.style.left = x+'px'; p.style.top = y+'px';
    p.style.background = color;
    const angle = Math.random()*Math.PI*2, dist = 20+Math.random()*26;
    p.style.setProperty('--pt', `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px)`);
    document.body.appendChild(p);
    setTimeout(()=>p.remove(), 620);
  }
}
// Runs once per placement, right after row/column clears are resolved.
// Bigger chains create more powerful special candies (4-6 -> striped,
// 7-9 -> bomb, 10+ -> colour blast); every chain always clears its own
// cells, so there's no "dead" match. Returns the points earned (already
// run through the existing Classic streak multiplier) — the caller adds
// this to the move's total exactly like any other bonus.
function processChainClears(){
  if(mode!=='classic') return 0; // Journey keeps its own existing rules, untouched
  const chains = findColorChains();
  if(chains.length===0) return 0;

  const boardRect = boardEl.getBoundingClientRect();
  const step = boardCellSize+3;
  let totalPoints = 0;

  chains.forEach(chain=>{
    chain.cells.forEach(([r,c])=>{ getCellDOM(r,c).classList.add('chain-glow'); });
    const host = pickChainHost(chain.cells);
    const specialType = chain.cells.length>=10 ? 'colorblast'
                       : chain.cells.length>=7 ? 'bomb'
                       : 'striped-'+chainOrientation(chain.cells);
    const bonus = specialType==='colorblast' ? 150 : specialType==='bomb' ? 90 : 60;
    totalPoints += Math.round((chain.cells.length*15 + bonus) * classicMultiplier);

    setTimeout(()=>{
      chain.cells.forEach(([r,c])=>{
        getCellDOM(r,c).classList.remove('chain-glow');
        if(r===host[0] && c===host[1]){
          board[r][c] = {filled:true, obstacle:false, void:false, c1:chain.c1, c2:chain.c2, emoji:chain.emoji, specialType, blastColor:chain.colorKey};
        } else {
          board[r][c] = {filled:false, obstacle:false, void:false, c1:null, c2:null, emoji:null};
        }
        refreshCellVisual(r,c);
      });
      const cx = boardRect.left+8+(host[1]+0.5)*step, cy = boardRect.top+8+(host[0]+0.5)*step;
      spawnChainParticles(cx, cy, chain.c1);
    }, 260);
  });

  playSound('combo', 2);
  vibrate(30);
  showComboText(chains.length>1 ? 'MULTI CHAIN!' : 'CHAIN!');
  const firstHost = pickChainHost(chains[0].cells);
  spawnScoreFloat(boardRect.left+8+(firstHost[1]+0.5)*step, boardRect.top+8+(firstHost[0]+0.5)*step-18, '+'+totalPoints);
  return totalPoints;
}

// PHASE 1 of special-candy activation: a pure traversal that gathers every
// cell an activation (and any chain-reaction it triggers) will affect,
// WITHOUT mutating the board yet — this is what makes reading each chained
// special's real type/colour always accurate, however deep the cascade
// goes, and it's what guarantees the cascade always terminates (the
// `visited` set can never revisit the same special twice).
function gatherSpecialActivation(r, c, visited, out){
  const key = r+'_'+c;
  if(visited.has(key)) return;
  visited.add(key);
  const cellData = board[r][c];
  if(!cellData || !cellData.specialType) return;
  const type = cellData.specialType;
  const blastColor = cellData.blastColor;
  out.activations.push({r,c,type});

  let affected = [];
  if(type==='striped-h'){ for(let cc=0;cc<SIZE;cc++){ if(!board[r][cc].void) affected.push([r,cc]); } }
  else if(type==='striped-v'){ for(let rr=0;rr<SIZE;rr++){ if(!board[rr][c].void) affected.push([rr,c]); } }
  else if(type==='bomb'){
    for(let dr=-1;dr<=1;dr++) for(let dc=-1;dc<=1;dc++){
      const nr=r+dr, nc=c+dc;
      if(inBounds(nr,nc) && !board[nr][nc].void) affected.push([nr,nc]);
    }
  } else if(type==='colorblast'){
    for(let rr=0;rr<SIZE;rr++) for(let cc=0;cc<SIZE;cc++){
      const cell = board[rr][cc];
      if((cell.filled||cell.specialType) && !cell.obstacle && !cell.void && candyColorKey(cell)===blastColor) affected.push([rr,cc]);
    }
  }

  affected.forEach(([nr,nc])=>{
    out.cells.add(nr+'_'+nc);
    const cell = board[nr][nc];
    if(cell && cell.specialType && !visited.has(nr+'_'+nc)){
      gatherSpecialActivation(nr, nc, visited, out); // real chain reaction — another special caught in the blast
    }
  });
}
// PHASE 2: the player tapped special candy (r,c) — gather the full
// cascade, then apply every resulting clear at once, award score (bigger
// for deeper cascades), and hand back to the normal line-clear/afterPlacement
// pipeline exactly like any other clear.
function activateSpecialCandy(r, c){
  if(mode!=='classic' || gamePaused || dragInfo) return;
  const cellData = board[r][c];
  if(!cellData || !cellData.specialType) return;

  const visited = new Set();
  const out = { cells:new Set(), activations:[] };
  gatherSpecialActivation(r, c, visited, out);
  if(out.activations.length===0) return;

  const cascaded = out.activations.length>1;
  playSound('bomb');
  vibrate(cascaded ? 45 : 25);
  if(cascaded || out.activations[0].type!=='striped-h' && out.activations[0].type!=='striped-v'){
    boardEl.classList.remove('board-shake'); void boardEl.offsetWidth; boardEl.classList.add('board-shake');
  }

  const boardRect = boardEl.getBoundingClientRect();
  const step = boardCellSize+3;
  let cellCount = 0;
  out.cells.forEach(key=>{
    const [nr,nc] = key.split('_').map(Number);
    const cell = board[nr][nc];
    if(cell && (cell.filled||cell.obstacle)) cellCount++;
    board[nr][nc] = {filled:false, obstacle:false, void:false, c1:null, c2:null, emoji:null};
    refreshCellVisual(nr,nc);
  });
  spawnChainParticles(boardRect.left+8+(c+0.5)*step, boardRect.top+8+(r+0.5)*step, '#fff2b0');

  let bonus = 0;
  out.activations.forEach((a,i)=>{
    bonus += (a.type==='colorblast'?200 : a.type==='bomb'?90 : 70) + i*40;
  });
  const points = Math.round((cellCount*15 + bonus) * classicMultiplier);
  const label = cascaded ? 'CHAIN REACTION!'
    : out.activations[0].type==='colorblast' ? 'COLOR BLAST!'
    : out.activations[0].type==='bomb' ? 'BOOM!' : 'STRIPE BLAST!';
  showComboText(label);
  spawnScoreFloat(boardRect.left+8+(c+0.5)*step, boardRect.top+8+(r+0.5)*step-18, '+'+points);

  const oldScore = score;
  score += points;
  updateScoreUI();
  animateScoreCountUp(scoreValEl, oldScore, score);
  if(score>best){ best=score; saveBest(); }

  // A big enough clear can complete rows/columns too — run the exact same
  // scoring pipeline as every other clear in the game for full consistency.
  const lineResult = processLineClears();
  if(lineResult.points>0){
    const old2 = score;
    score += lineResult.points;
    updateScoreUI();
    animateScoreCountUp(scoreValEl, old2, score);
    if(score>best){ best=score; saveBest(); }
  }
  afterPlacement();
}
// Tap-to-activate: a lightweight listener on the board itself (separate
// from the tray's drag system, so it can never conflict with dragging a
// piece) that only ever reacts to an actual special-candy cell.
boardEl.addEventListener('pointerdown', (e)=>{
  if(dragInfo || gamePaused || mode!=='classic') return;
  const cellEl = e.target.closest('.cell.special-candy');
  if(!cellEl || !boardEl.contains(cellEl)) return;
  const r = parseInt(cellEl.dataset.r,10), c = parseInt(cellEl.dataset.c,10);
  activateSpecialCandy(r, c);
});

/* ============================================================
   CLASSIC MODE — TAP-TO-FILL
   Tap an empty cell -> one candy is placed there. Reuses commitPlacement()
   (board data, sound, particles, +30 placement score, line clearing, streak
   scoring) and afterPlacement() (game-over check) exactly as the old drag
   drop did for a 1-cell piece. Occupied cells and non-primary / non-main
   pointers are ignored, and a single touch only ever fires one pointerdown,
   so a double tap can never place two candies in the same cell.
============================================================ */
function classicTapFill(r, c){
  if(!CLASSIC_TAP_FILL || mode!=='classic' || gamePaused || classicTapOver) return false;
  if(!gameScreen.classList.contains('active')) return false;
  if(!inBounds(r,c) || isBlocked(r,c)){
    playSound('invalid');
    return false;
  }
  const piece = { shape: SHAPES.find(s=>s.name==='single'), theme: randomClassicTheme(), special: null };
  commitPlacement(piece, r, c, null);
  afterPlacement();
  return true;
}
/* ============================================================
   CLASSIC MODE — DRAW-TO-FILL (added on top of tap-to-fill; board is the only interaction area)
   * Tap (finger/mouse moves less than ~half a cell) -> classicTapFill() on release: exactly one cell.
   * Press + move -> a path is drawn cell by cell. Only ORTHOGONAL neighbours are accepted (no diagonal
     jumps), occupied cells / cells off the board are never added, a cell can't be added twice, and
     stepping back onto the previous cell retracts the path. The pointer track is sampled finely
     (quarter-cell steps), so fast swipes can't skip cells.
   * Release -> all path cells are filled TOGETHER as one placement through the existing
     commitPlacement() (board data, sound, particles, +30 placement score, line clears + streak scoring)
     and afterPlacement() (game-over check). Nothing is filled while drawing.
============================================================ */
let ccPath = null;            // active gesture {pointerId, cells:[[r,c]], set:Set, g, px, py, lastX, lastY, armed, warned}
let ccShown = new Set();      // cell keys currently highlighted
let ccSvg = null, ccSvgGlow = null, ccSvgCore = null, ccSvgHead = null;
function ccGeom(){
  // ROOT-CAUSE FIX: the grid maths used to read the cells' own getBoundingClientRect(). Right after a drawing the drawn cells sit in
  // the 'ccPop' animation (fill-mode both -> scale(.45) for up to ~0.8s), so a rapid next drawing got a skewed grid (~8px off)
  // and cells were skipped / mis-detected. The board box + its padding/gap are never animated that way, so derive from those.
  const br = boardEl.getBoundingClientRect(), cs = getComputedStyle(boardEl);
  const sc = boardEl.offsetWidth ? br.width/boardEl.offsetWidth : 1;                 // tolerate a scaled board
  const f = (v)=>parseFloat(v)||0;
  const bl = f(cs.borderLeftWidth), bt = f(cs.borderTopWidth), pl = f(cs.paddingLeft), pt = f(cs.paddingTop);
  const inner = br.width/sc - bl - f(cs.borderRightWidth) - pl - f(cs.paddingRight);
  const gap = f(cs.columnGap);
  const cw = (inner - gap*(SIZE-1))/SIZE;                                            // cells are square (aspect-ratio 1/1)
  return { left:br.left+(bl+pl)*sc, top:br.top+(bt+pt)*sc, w:cw*sc, h:cw*sc, pitchX:(cw+gap)*sc, pitchY:(cw+gap)*sc };
}
function ccCellAt(g, x, y){
  const gx = (g.pitchX-g.w)/2, gy = (g.pitchY-g.h)/2;
  let c = Math.floor((x-(g.left-gx))/g.pitchX), r = Math.floor((y-(g.top-gy))/g.pitchY);
  // ROOT-CAUSE FIX: off-grid samples were dropped, so after the finger left the board and came back elsewhere the next cell was
  // never a neighbour of the path end and the drawing froze. Clamp to the nearest edge cell instead (off-board cells are still never added).
  r = r<0 ? 0 : (r>=SIZE ? SIZE-1 : r); c = c<0 ? 0 : (c>=SIZE ? SIZE-1 : c);
  return [r,c];
}
function ccEnsureSvg(){
  if(ccSvg) return;
  const NS = 'http://www.w3.org/2000/svg';
  ccSvg = document.createElementNS(NS,'svg'); ccSvg.id = 'cc-draw-svg';
  ccSvgGlow = document.createElementNS(NS,'polyline');
  ccSvgCore = document.createElementNS(NS,'polyline');
  ccSvgHead = document.createElementNS(NS,'circle');
  [ccSvgGlow, ccSvgCore].forEach(pl=>{ pl.setAttribute('fill','none'); pl.setAttribute('stroke-linecap','round'); pl.setAttribute('stroke-linejoin','round'); });
  ccSvgGlow.setAttribute('stroke','rgba(255,255,255,.55)');
  ccSvgCore.setAttribute('stroke','#ff3d9a');
  ccSvgHead.setAttribute('fill','#fff'); ccSvgHead.setAttribute('stroke','#ff3d9a'); ccSvgHead.setAttribute('stroke-width','3');
  ccSvg.appendChild(ccSvgGlow); ccSvg.appendChild(ccSvgCore); ccSvg.appendChild(ccSvgHead);
  document.body.appendChild(ccSvg);
}
// PERF: pointer events only update the path data (cheap). All DOM/SVG work happens at most ONCE per animation frame
// (ccSchedule -> requestAnimationFrame), and only for what actually changed.
let ccRaf = 0, ccSvgShown = false, ccLastRgb = '', ccLastStroke = '';
function ccSchedule(){
  if(ccRaf) return;
  ccRaf = requestAnimationFrame(()=>{ ccRaf = 0; if(ccPath) ccRender(); });
}
function ccStopRaf(){ if(ccRaf){ cancelAnimationFrame(ccRaf); ccRaf = 0; } }
function ccDom(p, k){ return p.dom[k] || (p.dom[k] = getCellDOM((k/SIZE)|0, k%SIZE)); }
function ccRender(){
  const p = ccPath;
  if(!p){ ccClear(); return; }
  const cells = p.cells, n = cells.length, g = p.g;
  // 1) Cell highlights + polyline base: rebuilt only when the list of cells actually changed.
  let sig = '';
  for(let i=0;i<n;i++) sig += (cells[i][0]*SIZE+cells[i][1]) + ',';
  if(sig !== p.sig){
    p.sig = sig;
    const want = new Set();
    for(let i=0;i<n;i++) want.add(cells[i][0]*SIZE+cells[i][1]);
    ccShown.forEach(k=>{ if(!want.has(k)) ccDom(p,k).classList.remove('cc-draw'); });
    want.forEach(k=>{ if(!ccShown.has(k)) ccDom(p,k).classList.add('cc-draw'); });
    ccShown = want;
    p.baseStr = cells.map(([r,c])=>(g.left+c*g.pitchX+g.w/2).toFixed(1)+','+(g.top+r*g.pitchY+g.h/2).toFixed(1)).join(' ');
  }
  // 2) Preview colour = colour this drawing will get (peek only; the index is advanced once, on release). Set only when it changes.
  const _pt = ccPeekDrawTheme();
  if(_pt){
    const rgb = ccHexToRgb(_pt.c2);
    if(rgb !== ccLastRgb){ ccLastRgb = rgb; boardEl.style.setProperty('--cc-rgb', rgb); }
  }
  // 3) Line preview (needs 2+ cells, or 1 cell once the finger has started moving).
  if(n<2 && !(n===1 && p.armed)){
    if(ccSvg && ccSvgShown){ ccSvg.style.display = 'none'; ccSvgShown = false; }
    return;
  }
  ccEnsureSvg();
  const lw = Math.max(6, Math.min(g.w,g.h)*0.42);
  if(!p.svgSized){                                    // once per gesture: confine the SVG to the board area (small repaint layer)
    const m = Math.max(24, lw*1.6);
    const L = g.left-m, T = g.top-m, W = g.pitchX*(SIZE-1)+g.w+2*m, H = g.pitchY*(SIZE-1)+g.h+2*m;
    ccSvg.style.left = L+'px'; ccSvg.style.top = T+'px';
    ccSvg.setAttribute('width', W.toFixed(1)); ccSvg.setAttribute('height', H.toFixed(1));
    ccSvg.setAttribute('viewBox', L.toFixed(1)+' '+T.toFixed(1)+' '+W.toFixed(1)+' '+H.toFixed(1));
    ccSvgGlow.setAttribute('stroke-width', (lw*1.6).toFixed(1));
    ccSvgCore.setAttribute('stroke-width', lw.toFixed(1));
    ccSvgHead.setAttribute('r', (lw*0.6).toFixed(1));
    p.svgSized = true;
  }
  if(_pt && _pt.c2 !== ccLastStroke){ ccLastStroke = _pt.c2; ccSvgCore.setAttribute('stroke', _pt.c2); ccSvgHead.setAttribute('stroke', _pt.c2); }
  // Live tail: from the last selected cell's centre toward the finger, kept inside that cell and on one axis, so the
  // line follows the finger continuously between cell centres without ever implying a cell that is not selected.
  const [lr,lc] = cells[n-1];
  const cx = g.left+lc*g.pitchX+g.w/2, cy = g.top+lr*g.pitchY+g.h/2;
  const hx = g.pitchX/2, hy = g.pitchY/2;
  let fx = Math.max(cx-hx, Math.min(cx+hx, p.lastX)), fy = Math.max(cy-hy, Math.min(cy+hy, p.lastY));
  if(Math.abs(fx-cx) >= Math.abs(fy-cy)) fy = cy; else fx = cx;
  const pts = p.baseStr + ' ' + fx.toFixed(1)+','+fy.toFixed(1);
  if(pts !== p.lastPts){
    p.lastPts = pts;
    ccSvgGlow.setAttribute('points', pts); ccSvgCore.setAttribute('points', pts);
    ccSvgHead.setAttribute('cx', fx.toFixed(1)); ccSvgHead.setAttribute('cy', fy.toFixed(1));
  }
  if(!ccSvgShown){ ccSvg.style.display = 'block'; ccSvgShown = true; }
}
function ccClear(){
  ccStopRaf();
  ccShown.forEach(k=>{ getCellDOM(Math.floor(k/SIZE), k%SIZE).classList.remove('cc-draw'); });
  ccShown = new Set();
  if(ccSvg){ ccSvg.style.display = 'none'; }
  ccSvgShown = false;
}
function ccCancel(){ ccPath = null; ccClear(); }
function ccFlashBad(r,c){
  const d = getCellDOM(r,c);
  d.classList.add('cc-bad');
  setTimeout(()=>d.classList.remove('cc-bad'), 220);
  if(ccPath && !ccPath.warned){ ccPath.warned = true; playSound('invalid'); }
}
function ccStep(r, c, horizFirst){
  const p = ccPath, cells = p.cells;
  const key = r*SIZE+c;
  if(cells.length===0){                       // gesture started on an occupied cell: first empty cell becomes the start
    if(isBlocked(r,c)) return;
    cells.push([r,c]); p.set.add(key); return;
  }
  const [lr,lc] = cells[cells.length-1];
  if(r===lr && c===lc) return;
  if(Math.abs(r-lr)===1 && Math.abs(c-lc)===1){
    // The stroke crossed a cell CORNER. Never connect diagonally: route through the orthogonal
    // neighbour the finger just brushed past (empty, not already drawn), then continue to the target.
    if(p.set.has(key)) return;
    if(isBlocked(r,c)){ ccFlashBad(r,c); return; }
    const viaH = [lr, c], viaV = [r, lc];
    const order = horizFirst ? [viaH, viaV] : [viaV, viaH];
    for(const [vr,vc] of order){
      if(!p.set.has(vr*SIZE+vc) && !isBlocked(vr,vc)){
        cells.push([vr,vc]); p.set.add(vr*SIZE+vc);
        cells.push([r,c]);   p.set.add(key);
        return;
      }
    }
    return;
  }
  if(Math.abs(r-lr)+Math.abs(c-lc)!==1) return;      // any other non-neighbour jump: never accepted
  if(p.set.has(key)){                                // only stepping back onto the previous cell retracts
    if(cells.length>=2){
      const [pr,pc] = cells[cells.length-2];
      if(pr===r && pc===c){ cells.pop(); p.set.delete(lr*SIZE+lc); }
    }
    return;
  }
  if(isBlocked(r,c)){ ccFlashBad(r,c); return; }    // occupied cell: never filled
  cells.push([r,c]); p.set.add(key);
}
function ccFeed(x, y){
  const p = ccPath;
  const dx = x-p.lastX, dy = y-p.lastY, dist = Math.hypot(dx,dy);
  const step = Math.max(2, Math.min(p.g.pitchX, p.g.pitchY)/4);
  const n = Math.max(1, Math.ceil(dist/step));
  for(let i=1;i<=n;i++){
    const cell = ccCellAt(p.g, p.lastX+dx*i/n, p.lastY+dy*i/n);
    if(cell){
      const k = cell[0]*SIZE+cell[1];
      if(k !== p.lastK){ p.lastK = k; ccStep(cell[0], cell[1], Math.abs(dx)>=Math.abs(dy)); }
    }
  }
  p.lastX = x; p.lastY = y;
}
function ccMove(x, y){
  const p = ccPath;
  if(!p) return;
  if(!p.armed){                                      // tap-vs-draw: ignore jitter smaller than ~half a cell
    if(Math.hypot(x-p.px, y-p.py) < Math.min(p.g.pitchX, p.g.pitchY)*0.55) return;
    p.armed = true;
  }
  ccFeed(x, y);
  ccSchedule();
}
// Each NEW drawing gets the next colour of this palette: red, blue, green, purple, orange, cyan, pink, yellow (then cycles).
// The index only advances ONCE per committed drawing (inside classicDrawFill), never on cell movement or render.
const CC_DRAW_PALETTE_IDS = ['apple','blueberry','watermelon2','grape','orange','crystal','lollipop2','lemon'];
let ccDrawColorIdx = 0;
function ccPeekDrawTheme(){
  const id = CC_DRAW_PALETTE_IDS[ccDrawColorIdx % CC_DRAW_PALETTE_IDS.length];
  return CLASSIC_THEMES.find(t=>t.id===id) || null;
}
function ccNextDrawTheme(){
  const t = ccPeekDrawTheme();
  ccDrawColorIdx = (ccDrawColorIdx + 1) % CC_DRAW_PALETTE_IDS.length;
  return t || randomClassicTheme();
}
function ccHexToRgb(h){ h = String(h||'').replace('#',''); if(h.length===3) h = h.replace(/./g,'$&$&'); const n = parseInt(h,16); return isNaN(n) ? '255,61,154' : ((n>>16)&255)+','+((n>>8)&255)+','+(n&255); }
function classicDrawFill(cells){
  if(!CLASSIC_TAP_FILL || mode!=='classic' || gamePaused || classicTapOver) return false;
  if(!gameScreen.classList.contains('active')) return false;
  for(const [r,c] of cells){ if(!inBounds(r,c) || isBlocked(r,c)){ playSound('invalid'); return false; } }
  let minR = SIZE, minC = SIZE;
  for(const [r,c] of cells){ if(r<minR) minR=r; if(c<minC) minC=c; }
  const rel = cells.map(([r,c])=>[r-minR, c-minC]);
  const piece = { shape:{ name:'drawPath', cells:rel }, theme: ccNextDrawTheme(), special: null };
  commitPlacement(piece, minR, minC, null);
  // Candy pop-in, rippling along the drawn path.
  const popped = [];
  cells.forEach(([r,c],i)=>{
    if(!board[r][c].filled) return;                 // already swept away by a line clear
    const d = getCellDOM(r,c);
    d.style.setProperty('--ccd', Math.min(i*28, 420)+'ms');
    d.classList.add('cc-pop');
    popped.push(d);
  });
  if(popped.length) setTimeout(()=>{ popped.forEach(d=>{ d.classList.remove('cc-pop'); d.style.removeProperty('--ccd'); }); }, 1000);
  afterPlacement();
  return true;
}
// ROOT-CAUSE FIX (seen on device): a press that landed on #board-wrap (the white/pink panel AROUND the cells) was ignored by the
// board-only listener AND had touch-action:auto, so the browser/host took the touch over (touchcancel after ~3ms, nothing drawn).
// Presses within a small margin of the grid now start the stroke at the nearest edge cell (same clamp already used when the finger leaves the grid).
function ccNearBoard(x, y){
  const r = boardEl.getBoundingClientRect(), slop = 32;
  return x>=r.left-slop && x<=r.right+slop && y>=r.top-slop && y<=r.bottom+slop;
}
const ccOnDown = (e)=>{
  if(!CLASSIC_TAP_FILL || mode!=='classic') return;
  if(e.currentTarget===boardWrapEl && e.target!==boardWrapEl) return;   // presses on the board itself are handled by the board listener
  if(e.isPrimary===false) return;
  if(e.pointerType==='mouse' && e.button!==0) return;
  let cellEl = e.target.closest('.cell');
  if(cellEl && !boardEl.contains(cellEl)) cellEl = null;
  if(!cellEl && e.target!==boardEl && !(e.currentTarget===boardWrapEl && ccNearBoard(e.clientX, e.clientY))) return;   // ROOT-CAUSE FIX: the 4px gaps + padding (~22% of the board) used to swallow the touch
  e.preventDefault();
  if(ccPath) ccCancel();                            // drop any stale gesture
  if(gamePaused || classicTapOver || !gameScreen.classList.contains('active')) return;
  try{ boardEl.setPointerCapture(e.pointerId); }catch(_){}
  const g0 = ccGeom(), sc0 = cellEl ? [parseInt(cellEl.dataset.r,10), parseInt(cellEl.dataset.c,10)] : ccCellAt(g0, e.clientX, e.clientY);
  ccPath = { pointerId:e.pointerId, cells:[], set:new Set(), g:g0, px:e.clientX, py:e.clientY, lastX:e.clientX, lastY:e.clientY, armed:false, warned:false, dom:{}, sig:null, baseStr:'', lastPts:'', svgSized:false, lastK:-1,
             startR:sc0[0], startC:sc0[1] };
  ccStep(ccPath.startR, ccPath.startC);
  ccRender();
};
boardEl.addEventListener('pointerdown', ccOnDown);
boardWrapEl.addEventListener('pointerdown', ccOnDown);
window.addEventListener('pointermove', (e)=>{
  const p = ccPath;
  if(!p || e.pointerId!==p.pointerId) return;
  if(e.pointerType==='mouse' && e.buttons===0){ ccCancel(); return; }   // button released outside without a pointerup: never stay stuck
  if(e.pointerType==='mouse' && !boardEl.hasPointerCapture(e.pointerId)){ try{ boardEl.setPointerCapture(e.pointerId); }catch(_){} }
  const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : null;
  if(evs && evs.length){ for(let i=0;i<evs.length;i++) ccMove(evs[i].clientX, evs[i].clientY); }
  else ccMove(e.clientX, e.clientY);
});
window.addEventListener('pointerup', (e)=>{
  const p = ccPath;
  if(!p || e.pointerId!==p.pointerId) return;
  if(p.armed) ccMove(e.clientX, e.clientY);          // include the release point
  ccPath = null;                                      // consumed -> a duplicate pointerup/cancel can't place twice
  ccClear();
  const cells = p.cells;
  if(cells.length===0){ playSound('invalid'); return; }              // pressed an occupied cell, nothing drawn
  if(cells.length===1) classicTapFill(cells[0][0], cells[0][1]);    // tap -> exactly one cell
  else classicDrawFill(cells);                                       // draw -> all path cells together
});
window.addEventListener('pointercancel', (e)=>{ if(ccPath && e.pointerId===ccPath.pointerId) ccCancel(); });
// A lost capture / a new press with the SAME pointer id while a path is still open means the pointerup never arrived: drop the stale path.
boardEl.addEventListener('lostpointercapture', (e)=>{ if(e.target===boardEl && ccPath && e.pointerId===ccPath.pointerId) ccCancel(); });
window.addEventListener('pointerdown', (e)=>{ if(ccPath && e.pointerId===ccPath.pointerId) ccCancel(); }, true);
window.addEventListener('pagehide', ()=>{ if(ccPath) ccCancel(); });
window.addEventListener('blur', ()=>{ if(ccPath) ccCancel(); });
document.addEventListener('visibilitychange', ()=>{ if(document.hidden && ccPath) ccCancel(); });
// Belt and braces: never let a swipe on the board scroll / bounce the page.
boardEl.addEventListener('touchmove', (e)=>{ if(mode==='classic' && CLASSIC_TAP_FILL) e.preventDefault(); }, {passive:false});
boardEl.addEventListener('contextmenu', (e)=>{ if(mode==='classic' && CLASSIC_TAP_FILL) e.preventDefault(); });

/* ============================================================
   CLASSIC MODE — advanced scoring (combo / streak / multiplier)
   Completely inert in Journey mode and the More Games mini-games — every
   entry point below is only ever called from processLineClears(), which
   itself only takes this path when mode==='classic'.
============================================================ */
function classicResetComboState(){
  classicStreak = 0;
  classicMultiplier = 1;
  classicHighestStreak = 0;
  classicComboBarEl.classList.toggle('classic-combo-bar-hidden', mode!=='classic');
  heartMultiplierValEl.textContent = '1×';
  streakBadgeEl.classList.add('streak-badge-hidden');
  streakValEl.textContent = '0';
}
function classicBreakStreak(){
  if(mode!=='classic') return;
  if(classicStreak>0){
    classicStreak = 0;
    classicMultiplier = 1;
    heartMultiplierValEl.textContent = '1×';
    heartMultiplierBadgeEl.classList.remove('pulse');
    heartMultiplierBadgeEl.classList.add('fade-break');
    setTimeout(()=>heartMultiplierBadgeEl.classList.remove('fade-break'), 500);
    streakBadgeEl.classList.remove('pulse');
    streakBadgeEl.classList.add('shake-break');
    setTimeout(()=>{
      streakBadgeEl.classList.remove('shake-break');
      streakBadgeEl.classList.add('streak-badge-hidden');
    }, 400);
  }
}
function classicRegisterClear(blockCount, totalLines, rowsToClear, colsToClear){
  classicStreak++;
  classicMultiplier = Math.min(8, Math.max(1, classicStreak));
  if(classicStreak>classicHighestStreak) classicHighestStreak = classicStreak;

  // +80 points per line actually cleared (each row AND each column counts
  // separately — e.g. 1 row + 1 column = 160), then the existing streak
  // multiplier is applied on top exactly as it already was. This replaces
  // the old per-block/multi-line-bonus/streak-bonus formula; the streak
  // system itself (counter, multiplier, badges) is untouched.
  const basePoints = totalLines * 80;
  const finalPoints = Math.round(basePoints*classicMultiplier);

  // Heart multiplier badge: always visible in Classic, pulses on every
  // successful clear.
  heartMultiplierValEl.textContent = classicMultiplier+'×';
  cbRestartClass(heartMultiplierBadgeEl, 'pulse');

  // Streak badge: only appears once an actual streak (2+) is running.
  if(classicStreak>=2){
    streakValEl.textContent = classicStreak;
    streakBadgeEl.classList.remove('streak-badge-hidden');
    cbRestartClass(streakBadgeEl, 'pulse');
  }

  // Exactly one popup per event, to keep the screen clean: a same-move
  // multi-line clear takes priority (it's about THIS move); otherwise, if
  // this move continued a streak of 2+, show the streak-combo text instead.
  // A plain single-line clear with no active streak stays silent.
  if(totalLines>=2){
    const label = totalLines===2?'DOUBLE CLEAR!' : totalLines===3?'TRIPLE CLEAR!' : 'MEGA CLEAR!';
    showComboText(label);
  } else if(classicStreak>=2){
    const label = classicStreak===2?'COMBO!' : classicStreak===3?'DOUBLE COMBO!' : classicStreak===4?'TRIPLE COMBO!' : 'MEGA COMBO!';
    showComboText(label);
  }

  // Small floating "+N" point popup near the actual cleared area (a single
  // popup at the centroid of every cleared cell — deliberately not one per
  // cell, so multiple popups never overlap or clutter the screen).
  const boardRect = cbBoardRect();           // PERF: cached per frame — was a forced layout flush after the ghost DOM writes
  const step = boardCellSize+3;
  let sumX=0, sumY=0, cnt=0;
  rowsToClear.forEach(r=>{ sumX += boardRect.left+8+(SIZE/2)*step; sumY += boardRect.top+8+(r+0.5)*step; cnt++; });
  colsToClear.forEach(c=>{ sumX += boardRect.left+8+(c+0.5)*step; sumY += boardRect.top+8+(SIZE/2)*step; cnt++; });
  if(cnt>0){
    // The earned points of THIS clear (lines x 80 x streak multiplier): one hero popup per clear event, created before any
    // other effect, nudged slightly above the cleared line so the popping candies don't sit behind the digits.
    spawnScoreFloat(sumX/cnt, sumY/cnt - step*0.45, '+'+finalPoints, {hero:true, lines:totalLines});
  }

  return finalPoints;
}

function showComboText(label){
  comboPopupEl.textContent = label;
  cbRestartClass(comboPopupEl, 'show');      // PERF: no forced reflow (see cbRestartClass)
}
// ---- PERF: one board rect read per frame (was: 3-4 getBoundingClientRect calls inside the pointerup handler, each forcing a
// style+layout flush after the previous DOM writes). Board geometry never changes inside a frame; cache is dropped next frame.
let cbRectCache = null;
function cbBoardRect(){
  if(!cbRectCache){ cbRectCache = boardEl.getBoundingClientRect(); requestAnimationFrame(()=>{ cbRectCache = null; }); }
  return cbRectCache;
}
// ---- PERF: restart a CSS-class animation WITHOUT `void el.offsetWidth` (that forced a synchronous style+layout flush in the
// middle of the pointerup handler). The class is removed now and re-added two frames later, so a style recalc in between
// guarantees the animation restarts. A token makes an older pending re-add harmless.
function cbRestartClass(el, cls){
  el.classList.remove(cls);
  const tok = el._cbRt = (el._cbRt||0)+1;
  requestAnimationFrame(()=>requestAnimationFrame(()=>{ if(el._cbRt===tok && el.isConnected) el.classList.add(cls); }));
}
// ---- Score popup layer ----
let cbFxLayer = null;
const cbLivePops = [];
function cbEnsureFxLayer(){
  if(cbFxLayer && cbFxLayer.isConnected) return cbFxLayer;
  cbFxLayer = document.createElement('div');
  cbFxLayer.id = 'cb-fx-layer';
  cbFxLayer.setAttribute('aria-hidden','true');
  document.body.appendChild(cbFxLayer);
  return cbFxLayer;
}
// opts.hero  = the main "+N" of a line/combo clear (largest, longest);  opts.small = secondary popup (+30 placement bonus)
function spawnScoreFloat(x, y, text, opts){
  opts = opts || {};
  const layer = cbEnsureFxLayer();
  const dur = opts.hero ? 1250 : (opts.small ? 850 : 1000);
  const vw = window.innerWidth || document.documentElement.clientWidth || 360;
  const vh = window.innerHeight || document.documentElement.clientHeight || 640;
  const mx = opts.hero ? 64 : 36;
  x = Math.max(mx, Math.min(vw-mx, x));
  y = Math.max(70, Math.min(vh-70, y));
  // two popups of the same move must never sit on top of each other: stack the newer one above the older
  const now = performance.now();
  for(let i=cbLivePops.length-1;i>=0;i--){ if(cbLivePops[i].until<now) cbLivePops.splice(i,1); }
  const stepY = opts.hero ? 46 : 32;
  for(let g=0; g<4 && cbLivePops.some(p=>Math.abs(p.x-x)<70 && Math.abs(p.y-y)<stepY); g++) y -= stepY;
  cbLivePops.push({x:x, y:y, until:now+dur*0.8});
  while(layer.childElementCount>=10) layer.firstElementChild.remove();      // hard cap: never an unbounded pile of nodes
  const f = document.createElement('div');
  f.className = 'cb-pop' + (opts.hero ? ' cb-pop-hero' : '') + (opts.small ? ' cb-pop-sm' : '');
  f.textContent = text;
  f.style.left = x+'px';
  f.style.top = y+'px';
  layer.appendChild(f);
  const done = ()=>{ if(f.parentNode) f.remove(); };
  if(f.animate){
    const T = 'translate(-50%,-50%) ';
    const a = f.animate([
      {opacity:0, transform:T+'translateY(10px) scale(.55)', offset:0},
      {opacity:1, transform:T+'translateY(-6px) scale(1.28)', offset:.14},
      {opacity:1, transform:T+'translateY(-12px) scale(1)', offset:.26},
      {opacity:1, transform:T+'translateY(-34px) scale(1)', offset:.74},
      {opacity:0, transform:T+'translateY(-58px) scale(.96)', offset:1}
    ], {duration:dur, easing:'ease-out', fill:'both'});
    a.onfinish = done; a.oncancel = done;
  } else {
    f.classList.add('cb-pop-css');
    f.style.animationDuration = dur+'ms';
  }
  setTimeout(done, dur+500);                                                  // safety net (e.g. animation paused in a hidden tab)
}
let scoreCountUpRaf = null;
function animateScoreCountUp(elm, fromVal, toVal){
  if(scoreCountUpRaf) cancelAnimationFrame(scoreCountUpRaf);
  const duration = 420;
  const start = performance.now();
  function tick(now){
    const t = Math.min(1, (now-start)/duration);
    const eased = 1-Math.pow(1-t,3);
    elm.textContent = Math.round(fromVal+(toVal-fromVal)*eased);
    if(t<1){ scoreCountUpRaf = requestAnimationFrame(tick); }
    else { elm.textContent = toVal; scoreCountUpRaf = null; }
  }
  scoreCountUpRaf = requestAnimationFrame(tick);
}



/* ============================================================
   PARTICLES
============================================================ */
function spawnPlaceParticles(x,y,color){
  for(let i=0;i<5;i++){
    const p = document.createElement('div');
    p.className='particle';
    const size = 5+Math.random()*5;
    p.style.width=size+'px'; p.style.height=size+'px';
    p.style.left=x+'px'; p.style.top=y+'px';
    p.style.background = color;
    const angle = Math.random()*Math.PI*2;
    const dist = 20+Math.random()*20;
    p.style.setProperty('--pt', `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px)`);
    document.body.appendChild(p);
    setTimeout(()=>p.remove(), 600);
  }
}
// A light candy-colored particle burst for completed rows/columns — a
// handful of particles sampled along each cleared line (not one per
// cell), capped overall, so even a big multi-line clear stays cheap.
// Purely additive to the existing .clearing/clearFlash cell animation.
function spawnLineClearParticles(rowsToClear, colsToClear){
  if(!boardEl) return;
  const rect = boardEl.getBoundingClientRect();
  const step = boardCellSize + 3;
  const cellCenter = (r,c)=>({
    x: rect.left + 8 + (c+0.5)*step,
    y: rect.top + 8 + (r+0.5)*step
  });
  const spawnAt = (x,y,cellR,cellC)=>{
    // Classic Mode: use the actual candy's own colour (board[r][c].c1) so
    // clear particles always match the candy that was really there — a
    // Crystal candy sparkles blue, a Strawberry pops red, etc. (spec:
    // "preserve each candy's unique identity during effects"). Journey
    // mode is left completely untouched — still its original random-THEME
    // particle colour, exactly as before.
    let color;
    let material = null;
    if(mode==='classic'){
      const cell = board[cellR] && board[cellR][cellC];
      color = (cell && cell.c1) || THEMES[Math.floor(Math.random()*THEMES.length)].c1;
      // Step 7: match the sampled particle's shape/texture to the actual
      // candy that was there, same "preserve identity" spirit as the
      // colour above — purely cosmetic, still the same particle budget.
      material = classicCandyMaterialGroup(cell && cell.candyId);
    } else {
      color = THEMES[Math.floor(Math.random()*THEMES.length)].c1;
    }
    const p = document.createElement('div');
    p.className = 'particle' + (material ? ' particle-'+material : '');
    const size = 5+Math.random()*5;
    p.style.width = size+'px'; p.style.height = size+'px';
    p.style.left = x+'px'; p.style.top = y+'px';
    p.style.background = material==='rainbow'
      ? 'conic-gradient(from 0deg, #ff8fa3, #ffd166, #8ee6a8, #7fd8ff, #b48bff, #ff8fa3)'
      : color;
    const angle = Math.random()*Math.PI*2;
    const dist = 18+Math.random()*22;
    p.style.setProperty('--pt', `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px)`);
    document.body.appendChild(p);
    setTimeout(()=>p.remove(), 620);
  };
  let budget = 22; // hard cap regardless of how many lines cleared at once
  rowsToClear.forEach(r=>{
    const samples = [1, Math.floor(SIZE/2), SIZE-2];
    samples.forEach(c=>{
      if(budget<=0 || board[r][c] === undefined) return;
      if(board[r][c].void) return;
      const {x,y} = cellCenter(r,c);
      spawnAt(x,y,r,c); budget--;
    });
  });
  colsToClear.forEach(c=>{
    const samples = [1, Math.floor(SIZE/2), SIZE-2];
    samples.forEach(r=>{
      if(budget<=0 || board[r][c] === undefined) return;
      if(board[r][c].void) return;
      const {x,y} = cellCenter(r,c);
      spawnAt(x,y,r,c); budget--;
    });
  });
}

// Lightens a "#rrggbb" candy colour toward white by `amt` (0..1) — used
// only to tint the line-clear sweep/shockwave a touch brighter than the
// raw candy colour so it reads as "energy" rather than a flat colour bar.
// Never throws on an unexpected/missing value: falls back to plain white.
function lightenHex(hex, amt){
  const m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex || '');
  if(!m) return '#ffffff';
  const r = parseInt(m[1],16), g = parseInt(m[2],16), b = parseInt(m[3],16);
  const mix = (v)=>Math.round(v + (255-v)*amt);
  return `rgb(${mix(r)},${mix(g)},${mix(b)})`;
}
// Representative candy colour for a cleared row/column's sweep/shockwave
// tint — samples the middle cell of that line (Classic Mode's own candy
// colours; Journey's original THEMES palette candies just use their own
// c1 the same way, so this works identically there). Falls back to a
// bright candy-pink on the (should-never-happen, for a genuinely
// completed line) chance the sampled cell is empty.
function classicLineClearColor(r, c){
  const cell = (r!=null) ? board[r][Math.floor(SIZE/2)] : board[Math.floor(SIZE/2)][c];
  return (cell && cell.c1) || '#ff6fb0';
}
// STEP 5 — premium energy sweep + soft shockwave for each cleared
// row/column. Two disposable, fixed-position overlay elements per line
// (see the .line-sweep/.line-shock CSS): a bright bar that scales quickly
// across the line's full length (direction always the same way — left to
// right for rows, top to bottom for columns — so it always reads clearly
// which line is going), plus a soft radial glow centred on that same line.
// Both are pure transform/opacity CSS animations that remove their own
// element via setTimeout, exactly like the existing .particle nodes above
// — no continuous work, nothing left behind. Capped at 6 lines' worth of
// effects even for a rare simultaneous multi-line clear, so this can never
// spawn an unbounded number of elements. Purely visual — called
// immediately alongside spawnLineClearParticles, so it never changes when
// the board's actual data/timeouts run.
function spawnLineClearSweep(rowsToClear, colsToClear){
  if(!boardEl) return;
  const rect = boardEl.getBoundingClientRect();
  const step = boardCellSize + 3;
  const fullSpan = SIZE*step - 3;
  let budget = 6;

  rowsToClear.forEach(r=>{
    if(budget<=0) return; budget--;
    const x = rect.left + 8, y = rect.top + 8 + r*step;
    const base = classicLineClearColor(r, null);
    const bright = lightenHex(base, .7);

    const bar = document.createElement('div');
    bar.className = 'line-sweep';
    bar.style.left = x+'px'; bar.style.top = y+'px';
    bar.style.width = fullSpan+'px'; bar.style.height = boardCellSize+'px';
    bar.style.background = `linear-gradient(90deg, transparent 0%, ${base} 38%, ${bright} 50%, ${base} 62%, transparent 100%)`;
    document.body.appendChild(bar);
    setTimeout(()=>bar.remove(), 300);

    const glow = document.createElement('div');
    glow.className = 'line-shock';
    glow.style.left = (x+fullSpan/2)+'px'; glow.style.top = (y+boardCellSize/2)+'px';
    glow.style.width = fullSpan+'px'; glow.style.height = (boardCellSize*1.7)+'px';
    glow.style.background = `radial-gradient(ellipse, ${bright} 0%, ${base}55 45%, transparent 74%)`;
    document.body.appendChild(glow);
    setTimeout(()=>glow.remove(), 420);
  });

  colsToClear.forEach(c=>{
    if(budget<=0) return; budget--;
    const x = rect.left + 8 + c*step, y = rect.top + 8;
    const base = classicLineClearColor(null, c);
    const bright = lightenHex(base, .7);

    const bar = document.createElement('div');
    bar.className = 'line-sweep vert';
    bar.style.left = x+'px'; bar.style.top = y+'px';
    bar.style.width = boardCellSize+'px'; bar.style.height = fullSpan+'px';
    bar.style.background = `linear-gradient(180deg, transparent 0%, ${base} 38%, ${bright} 50%, ${base} 62%, transparent 100%)`;
    document.body.appendChild(bar);
    setTimeout(()=>bar.remove(), 300);

    const glow = document.createElement('div');
    glow.className = 'line-shock vert';
    glow.style.left = (x+boardCellSize/2)+'px'; glow.style.top = (y+fullSpan/2)+'px';
    glow.style.width = (boardCellSize*1.7)+'px'; glow.style.height = fullSpan+'px';
    glow.style.background = `radial-gradient(ellipse, ${bright} 0%, ${base}55 45%, transparent 74%)`;
    document.body.appendChild(glow);
    setTimeout(()=>glow.remove(), 420);
  });
}
/* ============================================================
   CLASSIC MODE ONLY — 3D LINE CLEAR & COMBO CLEAR ANIMATIONS
   Purely visual + additive. Called from processLineClears() only when
   mode==='classic'. Never touches board data, scoring, sounds or input.
   - classicClearPlan / classicTagClearGhost: stagger the existing
     .clear-ghost candy pop (CSS 3D keyframes, see candyblast-classic-3d-clear-css)
     so it travels along the real cleared row/column.
   - CFX: ONE reusable pointer-events:none canvas + fixed particle pool
     (no per-particle DOM, no per-frame allocation). The rAF loop only
     runs while something is animating, then the canvas is hidden.
============================================================ */
let classicClearTokCounter = 0;
function classicClearPlan(rowsToClear, colsToClear){
  try{
    if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return null;
    const lines = rowsToClear.length + colsToClear.length;
    if(!lines) return null;
    const combo = lines>=2;
    const tier = lines>=4 ? 3 : lines-1;          // 0 single, 1 double, 2 triple, 3 mega (4+)
    const step = combo ? 17 : 21;                  // ms between neighbouring cells along a line
    const gap  = combo ? 30 : 0;                   // ms between successive lines of one combo
    const rowDelay = {}, colDelay = {};
    let idx = 0;
    rowsToClear.forEach(r=>{ rowDelay[r] = Math.min(idx++,3)*gap; });
    colsToClear.forEach(c=>{ colDelay[c] = Math.min(idx++,3)*gap; });
    const dur = combo ? 360 : 300;
    const maxDelay = (SIZE-1)*step + Math.min(lines-1,3)*gap;
    return {tok:++classicClearTokCounter, combo, tier, lines, step, gap, rowDelay, colDelay, dur, cleanupMs: maxDelay+dur+60};
  }catch(e){ return null; }
}
function classicClearDelayFor(plan, r, c){
  let d = Infinity;
  if(plan.rowDelay[r]!==undefined) d = plan.rowDelay[r] + c*plan.step;
  if(plan.colDelay[c]!==undefined){ const v = plan.colDelay[c] + r*plan.step; if(v<d) d = v; }
  return d===Infinity ? 0 : d;
}
function classicTagClearGhost(ghost, r, c, plan){
  ghost.classList.add('cfx3d');
  ghost.setAttribute('data-cfx', plan.combo ? '1' : '0');
  const s = ghost.style;
  s.setProperty('--cfx-d', classicClearDelayFor(plan,r,c)+'ms');
  const sgn = ((r*5+c*3)&1) ? 1 : -1;
  s.setProperty('--cfx-ry', (sgn*((plan.combo?26:16) + ((r+c)%3)*5))+'deg');
  s.setProperty('--cfx-rz', (-sgn*(plan.combo?9:5))+'deg');
}

const CFX = (function(){
  const TAU = Math.PI*2;
  const MAX_P = 170, MAX_W = 18, MAX_R = 18;
  const nav = navigator;
  const lowEnd = !!((nav.hardwareConcurrency && nav.hardwareConcurrency<=4) || (nav.deviceMemory && nav.deviceMemory<=2));
  const budgetScale = lowEnd ? .65 : 1;
  let cv=null, ctx=null, dpr=1, ox=0, oy=0, cssW=0, cssH=0, pxW=0, pxH=0;
  let raf=0, lastT=0, running=false, cur=0, ready=false;
  const P=[], W=[], R=[];
  const sprites = new Map();

  /* ---------- colour + sprite helpers (sprites cached per colour) ---------- */
  function parse(hex){
    const m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex||'');
    return m ? [parseInt(m[1],16),parseInt(m[2],16),parseInt(m[3],16)] : [255,111,176];
  }
  function mix(rgb,a){ return a>=0 ? rgb.map(v=>Math.round(v+(255-v)*a)) : rgb.map(v=>Math.round(v*(1+a))); }
  function rgbs(a,al){ return al==null ? 'rgb('+a[0]+','+a[1]+','+a[2]+')' : 'rgba('+a[0]+','+a[1]+','+a[2]+','+al+')'; }
  function mk(w,h){ const c=document.createElement('canvas'); c.width=w; c.height=h; return c; }
  function sprite(type,hex){
    const key = type+'|'+hex;
    let s = sprites.get(key);
    if(s) return s;
    if(sprites.size>90) sprites.clear();
    const rgb = parse(hex), lt = mix(rgb,.62), dk = mix(rgb,-.45);
    let g, gr;
    if(type==='sph'){
      s = mk(40,40); g = s.getContext('2d');
      gr = g.createRadialGradient(14,12,1.5,20,20,19);
      gr.addColorStop(0,'#fff'); gr.addColorStop(.2,rgbs(mix(rgb,.7))); gr.addColorStop(.55,rgbs(rgb)); gr.addColorStop(1,rgbs(dk));
      g.fillStyle = gr; g.beginPath(); g.arc(20,20,18.5,0,TAU); g.fill();
    } else if(type==='glow'){
      s = mk(64,64); g = s.getContext('2d');
      gr = g.createRadialGradient(32,32,0,32,32,32);
      gr.addColorStop(0,rgbs(mix(rgb,.55),.95)); gr.addColorStop(.28,rgbs(rgb,.6)); gr.addColorStop(.62,rgbs(rgb,.2)); gr.addColorStop(1,rgbs(rgb,0));
      g.fillStyle = gr; g.fillRect(0,0,64,64);
    } else if(type==='star'){
      s = mk(48,48); g = s.getContext('2d');
      gr = g.createRadialGradient(24,24,0,24,24,24);
      gr.addColorStop(0,'rgba(255,255,255,.9)'); gr.addColorStop(.3,rgbs(lt,.5)); gr.addColorStop(1,rgbs(rgb,0));
      g.fillStyle = gr; g.fillRect(0,0,48,48);
      const sg = g.createRadialGradient(24,24,0,24,24,23);
      sg.addColorStop(0,'#fff'); sg.addColorStop(.45,rgbs(mix(rgb,.55))); sg.addColorStop(1,rgbs(rgb));
      g.fillStyle = sg; g.strokeStyle = rgbs(mix(rgb,-.25),.9); g.lineWidth = 1.8; g.beginPath();
      g.moveTo(24,2); g.quadraticCurveTo(26.5,21.5,46,24); g.quadraticCurveTo(26.5,26.5,24,46);
      g.quadraticCurveTo(21.5,26.5,2,24); g.quadraticCurveTo(21.5,21.5,24,2); g.closePath(); g.fill(); g.stroke();
    } else { // bandH / bandV — light-wave: transparent tail -> hot white head
      const H = (type==='bandH');
      s = H ? mk(128,32) : mk(32,128); g = s.getContext('2d');
      gr = H ? g.createLinearGradient(0,0,128,0) : g.createLinearGradient(0,0,0,128);
      gr.addColorStop(0,rgbs(rgb,0)); gr.addColorStop(.5,rgbs(rgb,.5)); gr.addColorStop(.85,rgbs(mix(rgb,.25),.92)); gr.addColorStop(.97,rgbs(mix(rgb,.8),.96)); gr.addColorStop(1,'rgba(255,255,255,1)');
      g.fillStyle = gr; g.fillRect(0,0,s.width,s.height);
      g.globalCompositeOperation = 'destination-in';
      const gv = H ? g.createLinearGradient(0,0,0,32) : g.createLinearGradient(0,0,32,0);
      gv.addColorStop(0,'rgba(0,0,0,0)'); gv.addColorStop(.3,'rgba(0,0,0,.7)'); gv.addColorStop(.5,'rgba(0,0,0,1)'); gv.addColorStop(.7,'rgba(0,0,0,.7)'); gv.addColorStop(1,'rgba(0,0,0,0)');
      g.fillStyle = gv; g.fillRect(0,0,s.width,s.height);
    }
    sprites.set(key,s);
    return s;
  }

  /* ---------- canvas + pools (created once, reused forever) ---------- */
  function init(){
    if(ready) return true;
    try{
      cv = document.createElement('canvas');
      cv.id = 'classic-3d-clear-fx';
      cv.setAttribute('aria-hidden','true');
      ctx = cv.getContext('2d');
      if(!ctx) return false;
      document.body.appendChild(cv);
      for(let i=0;i<MAX_P;i++) P.push({on:false,kind:0,x:0,y:0,z:0,vx:0,vy:0,vz:0,age:0,life:1,size:8,rot:0,spin:0,spr:null,trail:false,tcol:'',px:0,py:0,sx:0,sy:0,sz:0,al:0});
      for(let i=0;i<MAX_W;i++) W.push({on:false});
      for(let i=0;i<MAX_R;i++) R.push({on:false});
      ready = true;
      return true;
    }catch(e){ return false; }
  }
  function placeCanvas(rect, cs){
    dpr = Math.min(window.devicePixelRatio||1, lowEnd ? 1.25 : 1.5);
    const margin = Math.round(cs*1.8)+20;
    const w = Math.round(rect.width + margin*2), h = Math.round(rect.height + margin*2);
    ox = Math.round(rect.left - margin); oy = Math.round(rect.top - margin);
    cv.style.left = ox+'px'; cv.style.top = oy+'px';
    if(w!==cssW || h!==cssH){
      cssW = w; cssH = h;
      cv.style.width = w+'px'; cv.style.height = h+'px';
      pxW = Math.round(w*dpr); pxH = Math.round(h*dpr);
      cv.width = pxW; cv.height = pxH;
    }
    cv.style.display = 'block';
  }
  function allocP(){
    for(let k=0;k<MAX_P;k++){ const i=(cur+k)%MAX_P; if(!P[i].on){ cur=(i+1)%MAX_P; return P[i]; } }
    return null;
  }
  function allocR(){ for(let i=0;i<MAX_R;i++) if(!R[i].on) return R[i]; return null; }
  function allocW(){ for(let i=0;i<MAX_W;i++) if(!W[i].on) return W[i]; return null; }
  function rnd(a,b){ return a+Math.random()*(b-a); }

  /* ---------- emitters ---------- */
  // Candy-coloured 3D spheres + sparkles popping out of one cleared cell
  function emitCell(x,y,hex,tier,horiz,nSph,nSpk,cs){
    const bright = rgbs(mix(parse(hex),.55));
    for(let i=0;i<nSph;i++){
      const p = allocP(); if(!p) return;
      const perp = Math.random()<.6;
      const ang = perp ? ((horiz?Math.PI/2:0) + (Math.random()<.5?0:Math.PI) + rnd(-.8,.8)) : rnd(0,TAU);
      const sp = rnd(70,180+tier*35);
      p.on=true; p.kind=1; p.x=x; p.y=y; p.z=rnd(0,8);
      p.vx=Math.cos(ang)*sp; p.vy=Math.sin(ang)*sp; p.vz=rnd(180,400)+tier*40;
      p.age=0; p.life=rnd(.5,.78)+tier*.04; p.size=cs*rnd(.2,.34)*(1+tier*.08);
      p.spr=sprite('sph',hex); p.trail = tier>=1 && (i&1)===0; p.tcol=bright; p.px=x; p.py=y;
    }
    for(let i=0;i<nSpk;i++){
      const p = allocP(); if(!p) return;
      const ang = rnd(0,TAU), sp = rnd(40,130);
      p.on=true; p.kind=2; p.x=x; p.y=y; p.z=rnd(0,10);
      p.vx=Math.cos(ang)*sp; p.vy=Math.sin(ang)*sp-20; p.vz=rnd(100,220);
      p.age=0; p.life=rnd(.34,.6); p.size=cs*rnd(.42,.66)*(1+tier*.1); p.rot=rnd(0,TAU); p.spin=rnd(-7,7);
      p.spr=sprite('star',hex); p.trail=false; p.px=x; p.py=y;
    }
  }
  // Big flash + tilted shock rings (+ star spray for combos) at a point
  function burstAt(x,y,tier,hex,t0,cs,stars,rings){
    const f = allocR();
    if(f){ f.on=true; f.kind=0; f.x=x; f.y=y; f.t0=t0; f.dur=380+tier*40; f.r0=cs*.4; f.r1=cs*(2.0+tier*.6); f.spr=sprite('glow',hex); f.a=tier===0?.55:.8; }
    for(let k=0;k<rings;k++){
      const r = allocR(); if(!r) break;
      r.on=true; r.kind=1; r.x=x; r.y=y; r.t0=t0+k*90; r.dur=480+tier*30;
      r.r0=cs*.3; r.r1=cs*(2.4+tier*.55)*(k?0.74:1); r.lw=(k?4:7)+tier; r.ratio=.62;
      r.rgb = rgbs(mix(parse(hex),k?.3:0)); r.a = tier===0 ? .6 : .9;
    }
    for(let i=0;i<stars;i++){
      const p = allocP(); if(!p) break;
      const ang = (i/stars)*TAU + rnd(-.25,.25), sp = rnd(150,300)+tier*30;
      p.on=true; p.kind=2; p.x=x; p.y=y; p.z=rnd(0,12);
      p.vx=Math.cos(ang)*sp; p.vy=Math.sin(ang)*sp; p.vz=rnd(120,260);
      p.age=-Math.max(0,(t0-performance.now())/1000);   // negative age = not yet released
      p.life=rnd(.55,.78); p.size=cs*rnd(.55,.85); p.rot=rnd(0,TAU); p.spin=rnd(-6,6);
      p.spr=sprite('star',hex); p.trail=true; p.tcol=rgbs(mix(parse(hex),.15)); p.px=x; p.py=y;
    }
  }

  /* ---------- public: start the effect for one real clear ---------- */
  function play(rows, cols, plan){
    if(!boardEl || !init()) return false;
    const rect = cbBoardRect();
    if(!rect.width || !rect.height) return false;
    const cs = boardCellSize, step = cs+3;
    placeCanvas(rect, cs);
    const now = performance.now();
    const tier = plan.tier, combo = plan.combo;
    const lines = [];
    rows.forEach(r=>lines.push({h:true,idx:r}));
    cols.forEach(c=>lines.push({h:false,idx:c}));
    const budget = [38,90,115,130][tier]*budgetScale;
    const perCell = Math.max(.6, budget/(lines.length*SIZE));
    const bandLenPx = step*(combo?3.4:2.6);
    let cx=0, cy=0, cn=0, firstCol=null;
    const lineCols = [];
    lines.forEach((ln,li)=>{
      const lineDelay = Math.min(li,3)*plan.gap;
      const cells = [];
      for(let i=0;i<SIZE;i++){
        const r = ln.h ? ln.idx : i, c = ln.h ? i : ln.idx;
        const cell = board[r] && board[r][c];
        if(!cell || cell.void) continue;
        cells.push({d:(i+.5)*step, x:rect.left+8+(c+.5)*step, y:rect.top+8+(r+.5)*step, col:cell.c1||'#ff6fb0'});
      }
      if(!cells.length) return;
      const mid = cells[cells.length>>1];
      lineCols.push(mid.col); if(!firstCol) firstCol = mid.col;
      cx += ln.h ? rect.left+8+(SIZE/2)*step : rect.left+8+(ln.idx+.5)*step;
      cy += ln.h ? rect.top+8+(ln.idx+.5)*step : rect.top+8+(SIZE/2)*step;
      cn++;
      const w = allocW();
      if(w){
        w.on=true; w.h=ln.h; w.t0=now+lineDelay; w.cells=cells; w.next=0; w.acc=0; w.tier=tier;
        w.x = ln.h ? rect.left+8 : rect.left+8+ln.idx*step;
        w.y = ln.h ? rect.top+8+ln.idx*step : rect.top+8;
        w.len = SIZE*step-3; w.band=bandLenPx; w.cs=cs; w.step=step; w.msPerPx = plan.step/step;
        w.perCell = perCell; w.col = mid.col;
        w.main = sprite(ln.h?'bandH':'bandV', mid.col);
        w.core = sprite(ln.h?'bandH':'bandV', '#ffffff');
        w.glow = sprite('glow', mid.col);
      }
    });
    if(!cn) return true;
    // Burst at the centre of what was cleared (bigger for bigger combos)
    cx/=cn; cy/=cn;
    const tCentre = now + (SIZE/2)*plan.step + 20;
    burstAt(cx, cy, tier, firstCol, tCentre, cs, [0,6,10,14][tier]*(lowEnd?.7:1)|0, tier===0?1:2);
    if(tier>=3){ // Mega: a wide, soft glow over the board — kept faint so it never hides candies
      const f = allocR();
      if(f){ f.on=true; f.kind=0; f.x=cx; f.y=cy; f.t0=tCentre; f.dur=520; f.r0=cs*1.5; f.r1=rect.width*.78; f.spr=sprite('glow',firstCol); f.a=.3; }
    }
    // Row + column crossing points get their own small coordinated burst
    if(rows.length && cols.length){
      let n = 0;
      for(let a=0;a<rows.length && n<4;a++) for(let b=0;b<cols.length && n<4;b++, n++){
        const r = rows[a], c = cols[b];
        const t = now + Math.max(plan.rowDelay[r]+c*plan.step, plan.colDelay[c]+r*plan.step) + 15;
        const col = (board[r] && board[r][c] && board[r][c].c1) || firstCol;
        burstAt(rect.left+8+(c+.5)*step, rect.top+8+(r+.5)*step, Math.max(0,tier-1), col, t, cs, 4, 1);
      }
    }
    if(!running){ running=true; lastT=performance.now(); raf=requestAnimationFrame(frame); }
    return true;
  }

  /* ---------- rAF loop (runs only while something is alive) ---------- */
  function killAll(){
    for(let i=0;i<MAX_P;i++) P[i].on=false;
    for(let i=0;i<MAX_W;i++) W[i].on=false;
    for(let i=0;i<MAX_R;i++) R[i].on=false;
    if(cv) cv.style.display='none';
    running=false; raf=0;
  }
  function frame(now){
    raf = 0;
    try{
      if(mode!=='classic'){ killAll(); return; }
      let dt = (now-lastT)/1000; lastT = now;
      if(!(dt>0)) dt=.016; if(dt>.05) dt=.05;
      ctx.setTransform(dpr,0,0,dpr,-ox*dpr,-oy*dpr);
      ctx.clearRect(ox,oy,cssW,cssH);
      let alive = false;

      /* pass 1: light waves, flashes, rings (normal blend on purpose: additive blending vanishes on the light board) */
      ctx.globalCompositeOperation = 'source-over';
      for(let i=0;i<MAX_W;i++){
        const w = W[i]; if(!w.on) continue;
        const e = now - w.t0; alive = true;
        if(e<0) continue;
        const head = e/w.msPerPx + w.step;               // leads the candy pop by about one cell
        // release per-cell candy bursts as the head passes each cell
        while(w.next<w.cells.length && head>=w.cells[w.next].d){
          const c = w.cells[w.next++];
          w.acc += w.perCell; const n = w.acc|0; w.acc -= n;
          if(n>0){ const ns = Math.ceil(n*.68); emitCell(c.x,c.y,c.col,w.tier,w.h,ns,n-ns,w.cs); }
        }
        const a = Math.max(0, head-w.band), b = Math.min(w.len, head);
        if(head >= w.len+w.band){ w.on=false; continue; }
        if(b>a){
          const fade = head>w.len ? Math.max(0,1-(head-w.len)/w.band) : 1;
          const k = 128/w.band, sa = (a-(head-w.band))*k, sw = (b-a)*k;
          const th = w.cs*(w.tier>=1?1.7:1.4);
          ctx.globalAlpha = (w.tier>=1?1:.88)*fade;
          if(w.h) ctx.drawImage(w.main, sa,0,sw,32, w.x+a, w.y+w.cs/2-th/2, b-a, th);
          else    ctx.drawImage(w.main, 0,sa,32,sw, w.x+w.cs/2-th/2, w.y+a, th, b-a);
          if(w.tier>=1){                                  // hot white core for combos
            const tc = th*.42; ctx.globalAlpha = .8*fade;
            if(w.h) ctx.drawImage(w.core, sa,0,sw,32, w.x+a, w.y+w.cs/2-tc/2, b-a, tc);
            else    ctx.drawImage(w.core, 0,sa,32,sw, w.x+w.cs/2-tc/2, w.y+a, tc, b-a);
          }
        }
        if(head>0 && head<w.len){                         // glowing head
          const gs = w.cs*(w.tier>=1?2.6:2.0); ctx.globalAlpha = .85;
          if(w.h) ctx.drawImage(w.glow, w.x+head-gs/2, w.y+w.cs/2-gs/2, gs, gs);
          else    ctx.drawImage(w.glow, w.x+w.cs/2-gs/2, w.y+head-gs/2, gs, gs);
        }
      }
      for(let i=0;i<MAX_R;i++){
        const r = R[i]; if(!r.on) continue;
        const e = now - r.t0; alive = true;
        if(e<0) continue;
        const p = e/r.dur;
        if(p>=1){ r.on=false; continue; }
        const ep = 1-(1-p)*(1-p);
        const rad = r.r0 + (r.r1-r.r0)*ep;
        if(r.kind===0){
          ctx.globalAlpha = r.a*Math.pow(1-p,1.5);
          ctx.drawImage(r.spr, r.x-rad, r.y-rad, rad*2, rad*2);
        } else {
          ctx.globalAlpha = r.a*(1-p); ctx.strokeStyle = r.rgb; ctx.lineWidth = r.lw*(1-p)+1.5;
          ctx.beginPath(); ctx.ellipse(r.x, r.y, rad, rad*r.ratio, 0, 0, TAU); ctx.stroke();
          ctx.globalAlpha = r.a*(1-p)*.9; ctx.strokeStyle = '#fff'; ctx.lineWidth = Math.max(1,(r.lw*(1-p)+1.5)*.35);
          ctx.stroke();
        }
      }

      /* update particles */
      for(let i=0;i<MAX_P;i++){
        const p = P[i]; if(!p.on) continue;
        alive = true;
        p.age += dt;
        if(p.age<0){ p.al=0; continue; }                  // waiting for its burst moment
        if(p.age>=p.life){ p.on=false; continue; }
        p.px = p.sx; p.py = p.sy;
        const drag = 1-1.8*dt;
        p.vx*=drag; p.vy*=drag;
        if(p.kind===1) p.vy += 260*dt;
        p.vz -= 640*dt; p.z += p.vz*dt;
        p.x += p.vx*dt; p.y += p.vy*dt;
        if(p.kind===1 && p.z<-6){ p.on=false; continue; }
        const t = p.age/p.life;
        let sc = 1+p.z/280; if(sc<.55) sc=.55; else if(sc>1.9) sc=1.9;
        p.sx = p.x; p.sy = p.y - p.z*.3;
        if(p.age<=dt*1.5){ p.px=p.sx; p.py=p.sy; }
        p.sz = p.size*sc*(1 - t*(p.kind===1?.25:.4));
        p.al = t<.65 ? 1 : 1-(t-.65)/.35;
        p.rot += p.spin*dt;
      }
      /* pass 2: candy spheres (normal blend, shaded for depth) */
      ctx.globalCompositeOperation = 'source-over';
      for(let i=0;i<MAX_P;i++){
        const p = P[i]; if(!p.on || p.kind!==1 || p.age<0) continue;
        ctx.globalAlpha = p.al; ctx.drawImage(p.spr, p.sx-p.sz/2, p.sy-p.sz/2, p.sz, p.sz);
      }
      /* pass 3: glowing trails + sparkles */
      ctx.globalCompositeOperation = 'source-over';
      ctx.lineCap = 'round';
      for(let i=0;i<MAX_P;i++){
        const p = P[i]; if(!p.on || p.age<0) continue;
        if(p.trail){
          ctx.globalAlpha = p.al*.55; ctx.strokeStyle = p.tcol; ctx.lineWidth = Math.max(1.5,p.sz*.5);
          ctx.beginPath(); ctx.moveTo(p.px,p.py); ctx.lineTo(p.sx,p.sy); ctx.stroke();
        }
        if(p.kind===2){
          ctx.globalAlpha = p.al; ctx.save(); ctx.translate(p.sx,p.sy); ctx.rotate(p.rot);
          ctx.drawImage(p.spr, -p.sz/2, -p.sz/2, p.sz, p.sz); ctx.restore();
        }
      }
      ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';

      if(alive){ raf = requestAnimationFrame(frame); }
      else { cv.style.display='none'; running=false; }   // fully idle: nothing left on screen or in the loop
    }catch(e){ try{ killAll(); }catch(_){} }
  }
  return { play };
})();
function spawnBombParticles(r,c){
  const rect = boardEl.getBoundingClientRect();
  const x = rect.left + 8 + (c+0.5)*(boardCellSize+3);
  const y = rect.top + 8 + (r+0.5)*(boardCellSize+3);
  for(let i=0;i<6;i++){
    const p = document.createElement('div');
    p.className='particle';
    const size = 6+Math.random()*7;
    p.style.width=size+'px'; p.style.height=size+'px';
    p.style.left=x+'px'; p.style.top=y+'px';
    p.style.background = ['#ffb84d','#ff6b4d','#ffe14d'][Math.floor(Math.random()*3)];
    const angle = Math.random()*Math.PI*2;
    const dist = 26+Math.random()*26;
    p.style.setProperty('--pt', `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px)`);
    document.body.appendChild(p);
    setTimeout(()=>p.remove(), 650);
  }
}
// Gray ash/smoke flecks that drift upward and fade out after a bomb blast
// — layered on top of the existing bright spawnBombParticles() debris, not
// a replacement for it. Classic Mode only (gated at the call site in
// triggerBombBlast), so Journey mode's bomb blast is completely untouched.
function spawnBombAshParticles(x,y){
  const ashColors = ['#5c5c66','#7a7a85','#3f3f46','#9a9aa5','#55555f'];
  const count = 11;
  for(let i=0;i<count;i++){
    const p = document.createElement('div');
    p.className='ash-particle';
    const size = 3+Math.random()*6;
    p.style.width=size+'px'; p.style.height=size+'px';
    // Slight random spawn jitter around the blast center so the ash reads
    // as a loose cloud rather than a perfect ring from a single point.
    p.style.left=(x+(Math.random()-0.5)*18)+'px';
    p.style.top=(y+(Math.random()-0.5)*18)+'px';
    p.style.background = ashColors[Math.floor(Math.random()*ashColors.length)];
    p.style.opacity = (0.5+Math.random()*0.35).toFixed(2);
    // Ash mostly rises and drifts sideways gently, unlike the outward-
    // bursting colored particles — this is what sells it as settling
    // smoke/ash rather than more explosion confetti.
    const sideDrift = (Math.random()-0.5)*46;
    const riseUp = 34+Math.random()*46;
    const finalScale = 0.25+Math.random()*0.3;
    p.style.setProperty('--apt', `translate(${sideDrift}px, ${-riseUp}px) scale(${finalScale.toFixed(2)})`);
    const duration = 0.85+Math.random()*0.55;
    p.style.animationDuration = duration+'s';
    document.body.appendChild(p);
    setTimeout(()=>p.remove(), duration*1000+120);
  }
}

/* ============================================================
   GAME FLOW
============================================================ */
function updateScoreUI(){
  scoreValEl.textContent = score;
  bestValEl.textContent = best;
  homeBestEl.textContent = best;
}

// True when every tray slot's DOM already shows exactly what trayPieces says (a piece-grid for each
// remaining piece, none for the placed one). Then the 3-slot rebuild is pure wasted work on the
// placement's critical path (it also re-played every remaining piece's entrance pop).
function trayDomMatchesPieces(){
  const slots = trayEl.querySelectorAll('.piece-slot');
  if(slots.length !== 3) return false;
  for(let i=0;i<3;i++){
    const g = slots[i].querySelector('.piece-grid');
    if(!!trayPieces[i] !== !!g) return false;
    if(g && g.classList.contains('dragging')) return false;
  }
  return true;
}
function afterPlacement(){
  if(mode==='journey'){
    // BUGFIX (Step 17 QA — rapid input test): the board stays visible and
    // technically interactive for a short delay after a move already
    // decided the level (420ms complete / 380ms fail / up to 2500ms for
    // the boss victory flourish), so a fast second real placement could
    // land in that window. Once the round is over, skip the rest of this
    // function entirely — no extra move consumed, no duplicate
    // chocolate/bomb tick, no second triggerLevelComplete()/
    // triggerLevelFailed() scheduled. (The piece itself may still visually
    // sit on the board a moment before the screen swaps away, but nothing
    // about the mechanics or level result changes because of it.)
    if(journeyRoundOver) return;
    journeyMovesUsed++;
    // LIMITED MOVES: one successfully placed block = one move, deducted
    // only here (never for dragging/cancelled/invalid placement, since
    // afterPlacement is only ever called after a real placement lands).
    if(journeyMovesRemaining!==null){
      journeyMovesRemaining = Math.max(0, journeyMovesRemaining-1);
      updateMovesUI();
    }
    // CHOCOLATE SPREAD: exactly once per completed move, independent of
    // moves/win/fail — never consumes an extra move itself.
    handleChocolateSpread();
    // CANDY BOMB COUNTDOWN: exactly once per completed move. Any bomb
    // defused by this move's clear was already deleted from
    // journeyBombCells above (processBombDefuses runs inside
    // processLineClears, well before afterPlacement is ever reached), so
    // it's simply skipped here — it can never also be counted as expired
    // on the same move it was cleared.
    const bombExpiredThisMove = tickBombCountdowns();
    // Win check ALWAYS comes first — targets/mechanics are already fully
    // updated by this point, so a move that both empties the move count
    // AND completes the objectives is a WIN, never a fail.
    if(isJourneyLevelComplete()){
      journeyRoundOver = true;
      // LEVEL 200: play the premium victory flourish first — it calls the
      // existing triggerLevelComplete() itself once it finishes. Every
      // other level keeps the exact original 420ms setTimeout behavior.
      if(bossActive && !bossVictorySequencePlaying){
        bossVictorySequencePlaying = true;
        playBossVictorySequence();
      } else if(!bossActive){
        setTimeout(triggerLevelComplete, 420);
      }
      return;
    }
    // Only after confirming the level isn't already won do we check
    // whether any bomb's countdown just reached 0.
    if(bombExpiredThisMove){
      journeyRoundOver = true;
      setTimeout(triggerLevelFailed, 380);
      return;
    }
    // Only after confirming the level isn't already won/bomb-failed do we
    // check whether the player has run out of moves.
    if(journeyMovesRemaining===0){
      journeyRoundOver = true;
      setTimeout(triggerLevelFailed, 380);
      return;
    }
  }
  if(mode==='classic' && CLASSIC_TAP_FILL){
    // Tap-to-fill: there is no tray to refill. Only the game-over check applies.
    if(!classicTapOver && checkGameOver()){
      classicTapOver = true;
      setTimeout(triggerGameOver, 380);
    }
    return;
  }
  if(trayPieces.every(p=>p===null)){
    newTray();
  } else if(!trayDomMatchesPieces()){
    renderTray();
  }
  if(checkGameOver()){
    if(mode==='journey'){
      journeyRoundOver = true;
      setTimeout(triggerLevelFailed, 380);
    } else {
      setTimeout(triggerGameOver, 380);
    }
  }
}

function maybeSpawnObstacle(){
  const threshold = Math.floor(score/300);
  if(threshold > obstaclesSpawned && obstacleCount < 8){
    const empties = [];
    for(let r=0;r<SIZE;r++) for(let c=0;c<SIZE;c++){
      if(!board[r][c].filled && !board[r][c].obstacle) empties.push([r,c]);
    }
    if(empties.length>10){
      const [r,c] = empties[Math.floor(Math.random()*empties.length)];
      board[r][c] = {filled:false, obstacle:true, c1:null,c2:null,emoji:null};
      refreshCellVisual(r,c);
      obstacleCount++;
    }
    obstaclesSpawned = threshold;
  }
}

/* ============================================================
   AD CONFIGURATION — the ONE place for advertisement IDs and settings.
   Kept apart from all game code: hint logic and the games never contain
   an ad unit ID; they only ask AdConfig.getUnitId('<placement>').

   Two separate placements (never shared):
     'rewardedHint' -> rewarded ad shown by HintAccessManager (via AndroidAdBridge)
     'homeScreen'   -> Home Screen ad (HomeAdSlot); unrelated to hints

   ENVIRONMENT
     'test'       (DEFAULT) Google's official sample ad units. Safe to show
                  and tap while developing.
     'production' Uses ONLY the production block below. Google's test IDs
                  are refused here, and a production ID is refused in test mode.

   >>> WHERE THE PRODUCTION IDs GO LATER <<<
     Fill the two "production" fields below with the ad unit IDs from your
     AdMob console (format ca-app-pub-<publisher>/<unit>) and set
       environment: 'production'
     right before you build the release APK/AAB. They are null on purpose:
     no placeholder that could be mistaken for a real ID. While a
     production ID is null, that placement is simply unavailable (no ad, and
     no hint is ever granted for it).

   Only ad UNIT IDs belong here. Never put API keys, service-account
   credentials or backend secrets in this HTML.
   The AdMob APP ID is not read from HTML: it lives in AndroidManifest.xml.
============================================================ */
const AdConfig = (function(){
  const AD_CONFIG = Object.freeze({
    environment: 'production',                       // 'test' | 'production'
    test: Object.freeze({                      // Google official sample ad units
      rewardedHintAdUnitId: 'ca-app-pub-3940256099942544/5224354917',   // rewarded
      homeScreenAdUnitId:   'ca-app-pub-3940256099942544/6300978111'    // banner
    }),
    production: Object.freeze({                // <<< insert real IDs here later
      rewardedHintAdUnitId: 'ca-app-pub-2010039359139196/1402947046',
      homeScreenAdUnitId:   'ca-app-pub-2010039359139196/2524457022'
    })
  });
  const FIELD = { rewardedHint: 'rewardedHintAdUnitId', homeScreen: 'homeScreenAdUnitId' };
  const TEST_PUBLISHER_PREFIX = 'ca-app-pub-3940256099942544/';   // Google's sample publisher
  const ID_FORMAT = /^ca-app-pub-\d{16}\/\d{10}$/;

  function isTest(){ return AD_CONFIG.environment !== 'production'; }   // anything unknown = test
  // Returns the ad unit ID for a placement, or null when it is not usable.
  function getUnitId(placement){
    const field = FIELD[placement];
    if(!field) return null;
    const id = (isTest() ? AD_CONFIG.test : AD_CONFIG.production)[field];
    if(typeof id !== 'string' || !ID_FORMAT.test(id)) return null;
    const isGoogleTest = id.indexOf(TEST_PUBLISHER_PREFIX) === 0;
    if(isTest() !== isGoogleTest) return null;   // never mix test and production IDs
    return id;
  }
  // Read-only snapshot for the Android wrapper:
  //   webView.evaluateJavascript("JSON.stringify(window.AdConfig.getPublicConfig())", ...)
  function getPublicConfig(){
    return Object.freeze({
      environment: isTest() ? 'test' : 'production',
      rewardedHintAdUnitId: getUnitId('rewardedHint'),
      homeScreenAdUnitId: getUnitId('homeScreen')
    });
  }
  return Object.freeze({ isTest, getUnitId, getPublicConfig });
})();
window.AdConfig = AdConfig;

/* ============================================================
   ANDROID AD BRIDGE — the ONLY place the HTML game talks to native code.
   (Isolated on purpose: no game code touches this, and no ad SDK code
   lives in this file.)

   HTML -> native:
     The Android wrapper exposes a JavascriptInterface named
     "AndroidRewardedAd" (WebView.addJavascriptInterface) with ONE method:
         showRewardedHintAd(String requestId)
     It must load/show the real rewarded ad from the native SDK, and later
     report the outcome back using the SAME requestId (see the
     HintAccessManager notes below). (The older name showRewardedAd(id)
     is also accepted.)

   No native interface present (plain browser, or wrapper not connected
   yet) => the bridge reports "unavailable" and NO hint is ever granted.
   This bridge never shows, fakes or simulates an ad.
   The rewarded ad unit ID comes from AdConfig ('rewardedHint'); if none is
   usable the bridge also reports "unavailable".
============================================================ */
const AndroidAdBridge = (function(){
  function nativeInterface(){
    const n = window.AndroidRewardedAd;
    return (n !== undefined && n !== null) ? n : null;
  }
  function consentAllowsAds(){
    // Native (Google UMP) decides. If the wrapper has no consent interface,
    // behave as before (older builds).
    try{
      const c = window.AndroidConsent;
      if(c && typeof c.canRequestAds === 'function') return !!c.canRequestAds();
    }catch(e){}
    return true;
  }
  function isAvailable(){
    const n = nativeInterface();
    if(!consentAllowsAds()) return false;                            // consent not given / not ready yet
    if(AdConfig.getUnitId('rewardedHint') === null) return false;   // no usable ad unit configured
    return !!n && (n.showRewardedHintAd !== undefined || n.showRewardedAd !== undefined);
  }
  // Asks native to show a rewarded ad for one hint. Returns true only if the
  // request was actually handed to native.
  function showRewardedHintAd(requestId){
    const n = nativeInterface();
    if(!n || !consentAllowsAds() || AdConfig.getUnitId('rewardedHint') === null) return false;
    if(n.showRewardedHintAd !== undefined){ n.showRewardedHintAd(String(requestId)); return true; }
    if(n.showRewardedAd !== undefined){ n.showRewardedAd(String(requestId)); return true; }
    return false;
  }
  // The four outcomes native can report for one rewarded-hint request.
  // Only REWARDED can ever grant a hint (see HintAccessManager.handleNativeEvent).
  const OUTCOME = Object.freeze({
    REWARDED: 'REWARDED',
    CLOSED_WITHOUT_REWARD: 'CLOSED_WITHOUT_REWARD',
    FAILED: 'FAILED',
    UNAVAILABLE: 'UNAVAILABLE'
  });
  return Object.freeze({ isAvailable, showRewardedHintAd, OUTCOME });
})();

/* ============================================================
   HINT ACCESS MANAGER — global hint entitlement
   ONE shared system for EVERY hint button in the game (Blast Journey,
   Arrow Puzzle, and any hint added later, e.g. Donut Catch). There are no
   per-game hint counters: the player gets FREE_HINT_LIMIT (3) free hints in
   total, persisted across screens and app restarts. After that every hint
   needs a CONFIRMED rewarded-ad completion.

   FLOW
     hint button -> requestHint() -> [3 free used] -> AndroidAdBridge
       .showRewardedHintAd(requestId) -> native rewarded-ad SDK
       -> user earns reward -> native calls back into the page ->
       HintAccessManager -> exactly ONE hint.

   OUTCOMES (AndroidAdBridge.OUTCOME): REWARDED, CLOSED_WITHOUT_REWARD,
   FAILED, UNAVAILABLE. Native reports them with
     window.HintAccessManager.handleNativeEvent(outcome, requestId, reason)
   Only REWARDED grants a hint. "Ad opened", "ad loaded" and "ad closed" are
   never a reward. The plain names below are accepted as the same outcomes.

   NATIVE -> HTML (Android: webView.evaluateJavascript), always echoing the
   requestId that native received in showRewardedHintAd(requestId):
     window.HintAccessManager.handleNativeEvent('REWARDED_AD_COMPLETED', id)
         the ONLY event that grants a hint (exactly one)
     window.HintAccessManager.handleNativeEvent('REWARDED_AD_CLOSED', id)
         closed without earning the reward -> no hint, nothing changes
     window.HintAccessManager.handleNativeEvent('REWARDED_AD_FAILED', id, reason)
         failed to load/show -> no hint, nothing changes
   (handleRewardedAdCompleted / handleRewardedAdClosed / handleRewardedAdFailed
   are the same three entry points as plain functions.)

   SAFETY: one request at a time; the request is consumed BEFORE the hint is
   granted, so a repeated, late, mismatched or unsolicited callback can never
   grant a second hint; hints are never granted before the completion event;
   double taps are ignored.

   PERSISTENCE: entitlement lives behind a tiny store interface (default =
   this page's localStorage). Browser localStorage is per-app-install data
   only — it cannot identify a physical device and does NOT survive an
   uninstall/reinstall. No device identifiers of any kind are used. A future
   Android wrapper / backend can plug in with setEntitlementStore().

   The Home Screen ad (HomeAdSlot, below) is completely independent: it has
   no reference to this manager and can never spend or grant a hint.
============================================================ */
const HintAccessManager = (function(){
  const FREE_HINT_LIMIT = 3;
  const STORAGE_KEY = 'candyBlastHintAccess';
  const PENDING_TIMEOUT_MS = 120000;   // safety: a request that never hears back is dropped (no hint)
  const REQUEST_COOLDOWN_MS = 600;     // ignores accidental double taps of a hint button
  const MAX_BANKED = 5;

  let state = { freeUsed: 0, banked: 0 };
  let pending = null;                  // { id, source, onGrant, notify }  (null = ad state idle)
  let pendingTimer = null;
  let requestCounter = 0;
  let lastAcceptedAt = 0;
  let granting = false;                // blocks re-entrant requests while a hint is being applied
  const usedRequestIds = {};
  const listeners = [];

  function clampInt(v, lo, hi){
    v = parseInt(v, 10);
    if(!Number.isInteger(v)) return lo;
    return Math.min(hi, Math.max(lo, v));
  }
  function sanitize(v){
    if(!v || typeof v !== 'object') return null;
    return { freeUsed: clampInt(v.freeUsed, 0, FREE_HINT_LIMIT), banked: clampInt(v.banked, 0, MAX_BANKED) };
  }

  // Storage interface: { load(): object|null, save(state): void }.
  const localStorageStore = {
    load(){ try{ return JSON.parse(localStorage.getItem(STORAGE_KEY)); }catch(e){ return null; } },
    save(s){ try{ localStorage.setItem(STORAGE_KEY, JSON.stringify({ v:1, freeUsed: s.freeUsed, banked: s.banked })); }catch(e){} }
  };
  let store = localStorageStore;

  function load(){
    let loaded = null;
    try{ loaded = sanitize(store.load()); }catch(e){ loaded = null; }
    if(loaded) state = loaded;
  }
  function save(){
    try{ store.save({ freeUsed: state.freeUsed, banked: state.banked }); }catch(e){}
  }
  // Lets the Android wrapper / a backend take over persistence later. Free
  // uses already spent are never forgotten when the store is swapped.
  function setEntitlementStore(s){
    if(!s || typeof s.load !== 'function' || typeof s.save !== 'function') return false;
    store = s;
    let loaded = null;
    try{ loaded = sanitize(store.load()); }catch(e){ loaded = null; }
    if(loaded){
      state.freeUsed = Math.max(state.freeUsed, loaded.freeUsed);
      state.banked = loaded.banked;
    }
    save(); emit();
    return true;
  }
  function emit(){
    listeners.forEach(fn=>{ try{ fn(); }catch(e){} });
  }
  function say(notify, msg){
    if(typeof notify === 'function'){ try{ notify(msg); }catch(e){} }
  }

  function canUseFreeHint(){ return state.freeUsed < FREE_HINT_LIMIT; }
  function freeHintsRemaining(){ return Math.max(0, FREE_HINT_LIMIT - state.freeUsed); }
  // Hints that need no ad right now (free ones + any earned-but-unused one).
  function hintsAvailableWithoutAd(){ return freeHintsRemaining() + state.banked; }
  function isAdRequestPending(){ return !!pending; }

  function getProvider(){
    return { isAvailable: AndroidAdBridge.isAvailable, show: AndroidAdBridge.showRewardedHintAd };
  }
  function randomToken(){
    try{
      const a = new Uint32Array(2);
      crypto.getRandomValues(a);
      return a[0].toString(36) + a[1].toString(36);
    }catch(e){
      return Math.random().toString(36).slice(2, 10) + Math.random().toString(36).slice(2, 10);
    }
  }
  function clearPending(){
    pending = null;
    if(pendingTimer){ clearTimeout(pendingTimer); pendingTimer = null; }
  }

  // Applies exactly one hint through the caller's existing hint routine.
  // onGrant() must return false when it could not show a hint (e.g. the
  // player left the level while an ad was playing); the entitlement that was
  // about to be spent is then kept, never lost.
  function grantHint(source, onGrant, kind, notify){
    let applied = false;
    granting = true;
    try{ applied = (typeof onGrant === 'function') && onGrant() !== false; }catch(e){ applied = false; }
    granting = false;
    if(!applied){
      if(kind === 'free') state.freeUsed = Math.max(0, state.freeUsed - 1);
      else state.banked = Math.min(MAX_BANKED, state.banked + 1);   // 'banked' refund, or a confirmed reward that can't be used right now
      save(); emit();
      return false;
    }
    emit();
    return true;
  }

  // Every hint button calls this AFTER confirming a hint is actually
  // possible (so free hints / ads are never spent when there is no move).
  function requestHint(source, onGrant, notify){
    if(pending || granting){ return { status:'busy' }; }
    const now = Date.now();
    if(now - lastAcceptedAt < REQUEST_COOLDOWN_MS){ return { status:'busy' }; }
    if(state.banked > 0){
      lastAcceptedAt = now;
      state.banked--; save();
      grantHint(source, onGrant, 'banked', notify);
      return { status:'granted-banked' };
    }
    if(canUseFreeHint()){
      lastAcceptedAt = now;
      state.freeUsed++; save();
      grantHint(source, onGrant, 'free', notify);
      return { status:'granted-free' };
    }
    // All 3 free hints are used: a confirmed rewarded ad is required.
    const provider = getProvider();
    let available = false;
    try{ available = !!provider && (typeof provider.isAvailable !== 'function' || provider.isAvailable()); }catch(e){ available = false; }
    if(!available){
      say(notify, 'AD NOT AVAILABLE');
      return { status:'unavailable' };
    }
    const id = 'hint-' + (++requestCounter) + '-' + Date.now().toString(36) + '-' + randomToken();
    pending = { id, source, onGrant, notify };
    pendingTimer = setTimeout(()=>{ clearPending(); emit(); }, PENDING_TIMEOUT_MS);
    let handedOver = false;
    try{ handedOver = provider.show(id) !== false; }catch(e){ handedOver = false; }
    if(!handedOver){
      // Only undo if the request is still ours (native may already have answered).
      if(pending && pending.id === id){ clearPending(); }
      say(notify, 'AD NOT AVAILABLE');
      return { status:'unavailable' };
    }
    lastAcceptedAt = now;
    emit();
    return { status:'ad-requested', requestId:id };
  }

  // A callback is honoured only for the ONE outstanding request and only when
  // it echoes that request's id.
  function matchesPending(requestId){
    return !!pending && requestId !== undefined && requestId !== null && String(requestId) === pending.id;
  }

  // REWARDED_AD_COMPLETED — the only event that grants a hint.
  function handleRewardedAdCompleted(requestId){
    if(!matchesPending(requestId)) return false;
    if(usedRequestIds[pending.id]) return false;
    const p = pending;
    usedRequestIds[p.id] = true;     // consumed before granting -> one completion can never grant twice
    clearPending();                  // ad state resets
    return grantHint(p.source, p.onGrant, 'ad', p.notify);
  }
  // REWARDED_AD_CLOSED (closed before the reward) / REWARDED_AD_FAILED (load/show failure).
  // Neither grants anything nor touches the free-hint counter.
  function endWithoutReward(requestId, message){
    if(!matchesPending(requestId)) return false;
    const p = pending;
    usedRequestIds[p.id] = true;
    clearPending();
    say(p.notify, message);
    emit();
    return true;
  }
  function handleRewardedAdClosed(requestId){
    return endWithoutReward(requestId, 'NO HINT — AD NOT COMPLETED');
  }
  function handleRewardedAdFailed(requestId, reason){
    return endWithoutReward(requestId, 'AD NOT AVAILABLE');
  }
  // UNAVAILABLE (no ad could be served): no hint, nothing changes.
  function handleRewardedAdUnavailable(requestId){
    return endWithoutReward(requestId, 'AD NOT AVAILABLE');
  }
  // Single native entry point for the outcomes above.
  function handleNativeEvent(type, requestId, reason){
    switch(String(type)){
      case 'REWARDED':
      case 'REWARDED_AD_COMPLETED': return handleRewardedAdCompleted(requestId);
      case 'CLOSED_WITHOUT_REWARD':
      case 'REWARDED_AD_CLOSED':    return handleRewardedAdClosed(requestId);
      case 'FAILED':
      case 'REWARDED_AD_FAILED':    return handleRewardedAdFailed(requestId, reason);
      case 'UNAVAILABLE':           return handleRewardedAdUnavailable(requestId);
      default: return false;         // unknown events never grant anything
    }
  }

  function subscribe(fn){ if(typeof fn === 'function') listeners.push(fn); }
  function getStatus(){
    return { freeLimit: FREE_HINT_LIMIT, freeUsed: state.freeUsed, freeRemaining: freeHintsRemaining(),
             banked: state.banked, adPending: !!pending, hintRewardRequestId: pending ? pending.id : null };
  }

  load();
  const api = {
    canUseFreeHint, freeHintsRemaining, hintsAvailableWithoutAd, isAdRequestPending,
    requestHint, grantHint,
    handleRewardedAdCompleted, handleRewardedAdClosed, handleRewardedAdFailed, handleRewardedAdUnavailable, handleNativeEvent,
    setEntitlementStore, subscribe, getStatus
  };
  Object.freeze(api);
  return api;
})();
// Public entry point for the native Android app (see the notes above).
window.HintAccessManager = HintAccessManager;

/* ============================================================
   HOME SCREEN AD SLOT — placeholder only (nothing is displayed)
   A hidden, empty container on the Home screen that a future native /
   web ad integration can mount into. It stays hidden until something is
   explicitly mounted and setVisible(true) is called.
   Fully independent of HintAccessManager: it never references it, so it can
   never spend a free hint, grant a hint, or change the hint count.
============================================================ */
const HomeAdSlot = (function(){
  const box = document.getElementById('home-ad-container');
  return Object.freeze({
    getContainer(){ return box; },
    getAdUnitId(){ return AdConfig.getUnitId('homeScreen'); },   // its own config, never the rewarded-hint one
    setVisible(v){ if(box) box.classList.toggle('home-ad-visible', !!v && box.childNodes.length>0); },
    isVisible(){ return !!box && box.classList.contains('home-ad-visible'); }
  });
})();
window.HomeAdSlot = HomeAdSlot;

/* ============================================================
   BLAST JOURNEY — HINT SYSTEM
   Finds a real, currently-valid placement (never a random guess) using the
   same canPlaceShape() check placement itself relies on, then highlights the
   recommended piece + board cells without ever placing anything automatically.
============================================================ */
function showScorePanel(visible){
  scorePanelEl.style.display = visible ? 'flex' : 'none';
}
function showHintBar(visible){
  hintBarEl.classList.toggle('hint-bar-hidden', !visible);
}
function updateHintUI(){
  // Global hint entitlement (HintAccessManager): shows hints left that need no
  // ad, or "AD" once a rewarded ad is required. Never disabled by the count —
  // tapping at 0 requests a rewarded ad instead.
  const avail = HintAccessManager.hintsAvailableWithoutAd();
  hintCountEl.textContent = avail>0 ? '×' + avail : 'AD';
  hintBtnEl.disabled = false;
}
function clearHintHighlights(){
  if(hintTimeoutId){ clearTimeout(hintTimeoutId); hintTimeoutId=null; }
  if(hintFadeTimeoutId){ clearTimeout(hintFadeTimeoutId); hintFadeTimeoutId=null; }
  boardEl.querySelectorAll('.hint-cell').forEach(c=>c.classList.remove('hint-cell','hint-fade'));
  trayEl.querySelectorAll('.piece-grid.hint-glow').forEach(g=>g.classList.remove('hint-glow','hint-fade'));
}
function showHintToast(msg){
  if(hintToastTimeoutId) clearTimeout(hintToastTimeoutId);
  hintToastEl.textContent = msg;
  hintToastEl.classList.add('show');
  hintToastTimeoutId = setTimeout(()=>hintToastEl.classList.remove('show'), 1600);
}
function findHintMove(){
  for(let i=0;i<trayPieces.length;i++){
    const piece = trayPieces[i];
    if(!piece) continue;
    for(let r=0;r<SIZE;r++){
      for(let c=0;c<SIZE;c++){
        if(canPlaceShape(piece.shape.cells, r, c)){
          return {slotIndex:i, piece, r, c};
        }
      }
    }
  }
  return null;
}
function showHintHighlight(move){
  clearHintHighlights();
  const pieceGridEl = trayEl.querySelector(`.piece-grid[data-slot="${move.slotIndex}"]`);
  if(pieceGridEl) pieceGridEl.classList.add('hint-glow');
  move.piece.shape.cells.forEach(([dr,dc])=>{
    const nr = move.r+dr, nc = move.c+dc;
    if(inBounds(nr,nc)) getCellDOM(nr,nc).classList.add('hint-cell');
  });
  hintTimeoutId = setTimeout(()=>{
    boardEl.querySelectorAll('.hint-cell').forEach(c=>c.classList.add('hint-fade'));
    if(pieceGridEl) pieceGridEl.classList.add('hint-fade');
    hintFadeTimeoutId = setTimeout(clearHintHighlights, 350);
  }, 1500);
}
// The unchanged hint behavior, run only once HintAccessManager has granted a
// hint. Returns false if it can't show one (e.g. the player left the level
// while a rewarded ad was playing) so the entitlement is not lost.
function applyJourneyHint(){
  if(mode!=='journey' || !gameScreen.classList.contains('active')) return false;
  const move = findHintMove();
  if(!move) return false;
  updateHintUI();
  playSound('button');
  showHintHighlight(move);
  return true;
}
function useHint(){
  if(mode!=='journey') return;
  if(!findHintMove()){
    showHintToast('NO MOVE AVAILABLE');
    return; // no valid move found — hint is NOT consumed (and no ad is requested)
  }
  HintAccessManager.requestHint('journey', applyJourneyHint, showHintToast);
}

function checkGameOver(){
  if(mode==='classic' && CLASSIC_TAP_FILL){
    // Tap-to-fill: the only move is "fill one empty cell", so the game is over exactly when
    // no empty, playable cell is left on the board.
    for(let r=0;r<SIZE;r++){
      for(let c=0;c<SIZE;c++){ if(!isBlocked(r,c)) return false; }
    }
    return true;
  }
  const pieces = trayPieces.filter(p=>p);
  if(pieces.length===0) return false;
  for(const piece of pieces){
    for(let r=0;r<SIZE;r++){
      for(let c=0;c<SIZE;c++){
        if(canPlaceShape(piece.shape.cells, r, c)) return false;
      }
    }
  }
  return true;
}

function triggerGameOver(){
  playSound('gameover');
  vibrate([30,40,30]);
  el('go-score').textContent = score;
  el('go-best').textContent = best;
  el('go-combo').textContent = classicHighestStreak;
  el('go-streak').textContent = classicHighestStreak;
  el('go-multiplier').textContent = classicMultiplier+'×';
  showScreen(gameoverScreen);
}

/* ============================================================
   BLAST JOURNEY — LEVEL COMPLETE / FAILED
============================================================ */
function computeJourneyStars(){
  const totalRequired = journeyLevel.targets.reduce((s,t)=>s+t.required,0);
  const par = Math.max(6, totalRequired*3);
  if(journeyMovesUsed <= par) return 3;
  if(journeyMovesUsed <= par*1.6) return 2;
  return 1;
}

function triggerLevelComplete(){
  playSound('levelcomplete');
  vibrate([20,30,20,30,40]);
  const n = currentJourneyLevelNumber;
  journeyProgress.completed[n] = true;
  if(n < JOURNEY_TOTAL_LEVELS && journeyProgress.unlocked <= n){
    journeyProgress.unlocked = n+1;
  }
  const stars = computeJourneyStars();
  if(!journeyProgress.stars[n] || journeyProgress.stars[n] < stars){
    journeyProgress.stars[n] = stars;
  }
  saveJourneyProgress();
  el('journey-complete-level-num').textContent = n;
  el('journey-complete-stars').textContent = '⭐'.repeat(stars) + '☆'.repeat(3-stars);
  const nextBtn = el('btn-journey-next');
  nextBtn.style.display = n < JOURNEY_TOTAL_LEVELS ? '' : 'none';
  // Level 200 gets its own grand-finale treatment on top of the normal
  // complete screen — everything else (stars, buttons, saving progress)
  // works exactly the same as any other level.
  const panelEl = document.querySelector('.journey-complete-panel');
  const emojiEl = document.querySelector('.journey-complete-emoji');
  const titleEl = document.querySelector('.journey-complete-title');
  const isFinal = (n===JOURNEY_TOTAL_LEVELS);
  panelEl.classList.toggle('journey-final-celebration', isFinal);
  emojiEl.textContent = isFinal ? '🏆' : '🎉';
  titleEl.textContent = isFinal ? 'CANDY SMASH MASTER!' : 'LEVEL COMPLETE!';
  // Level 200's special victory message, on top of the existing final-
  // celebration treatment above (stars/buttons/save/confetti all still
  // work exactly the same either way).
  if(isFinal){
    const subEl = document.querySelector('.journey-complete-sub');
    if(subEl) subEl.innerHTML = 'YOU BEAT THE CANDY CASTLE! 👑<br>CANDY SMASH JOURNEY COMPLETE!';
  }
  showScreen(journeyCompleteScreen);
  spawnLevelCompleteConfetti(isFinal);
}

function triggerLevelFailed(){
  playSound('levelfailed');
  vibrate([30,40,30]);
  const remainingEl = el('journey-failed-remaining');
  remainingEl.innerHTML = '';
  journeyLevel.targets.filter(t=>t.collected<t.required).forEach(t=>{
    const row = document.createElement('div');
    row.className = 'preview-target-chip';
    row.innerHTML = `<span class="preview-target-emoji">${t.emoji}</span><span class="preview-target-count">${t.required-t.collected} left</span>`;
    remainingEl.appendChild(row);
  });
  showScreen(journeyFailedScreen);
}

/* ============================================================
   BLAST JOURNEY — LEVEL MAP / PREVIEW / START
============================================================ */
// Builds the 200-card grid using a single DocumentFragment (one reflow
// instead of 200) and ONE delegated click listener on the grid container
// (attached once, below) instead of 200 per-card listeners recreated every
// time Level Select is opened. Same cards, same look, same click behavior —
// just far less DOM/listener churn on repeated opens.
function renderJourneyLevelsGrid(){
  journeyLevelsGridEl.innerHTML = '';
  const frag = document.createDocumentFragment();
  for(let n=1; n<=JOURNEY_TOTAL_LEVELS; n++){
    const unlocked = n <= journeyProgress.unlocked;
    const stars = journeyProgress.stars[n] || 0;
    const card = document.createElement('button');
    card.className = 'level-card' + (unlocked?' unlocked':' locked') + (journeyProgress.completed[n]?' completed':'');
    card.dataset.level = n;
    if(unlocked){
      card.innerHTML = `<span class="level-card-num">${n}</span>` +
        (stars>0 ? `<span class="level-card-stars">${'⭐'.repeat(stars)}</span>` : `<span class="level-card-stars level-card-stars-empty">☆☆☆</span>`);
    } else {
      card.innerHTML = `<span class="level-card-lock">🔒</span><span class="level-card-num level-card-num-locked">${n}</span>`;
    }
    frag.appendChild(card);
  }
  journeyLevelsGridEl.appendChild(frag);
}
// Single delegated handler for the whole grid — attached once at startup,
// never re-attached on repeated Level Select opens. Behavior is identical
// to the old per-card listeners: unlocked card taps open the preview,
// locked card taps play the invalid sound.
journeyLevelsGridEl.addEventListener('click', (e)=>{
  const card = e.target.closest('.level-card');
  if(!card || !journeyLevelsGridEl.contains(card)) return;
  const n = parseInt(card.dataset.level, 10);
  if(card.classList.contains('unlocked')){
    playSound('button'); openJourneyPreview(n);
  } else {
    playSound('invalid');
  }
});

function openJourneyLevels(){
  playSound('button');
  loadJourneyProgress();
  renderJourneyLevelsGrid();
  showScreen(journeyLevelsScreen);
}

function openJourneyPreview(n){
  pendingJourneyLevel = n;
  const config = generateLevelConfig(n);
  el('preview-level-num').textContent = n;
  const targetsEl = el('preview-targets');
  targetsEl.innerHTML = '';
  config.targets.forEach(t=>{
    const chip = document.createElement('div');
    chip.className = 'preview-target-chip';
    chip.innerHTML = `<span class="preview-target-emoji">${t.emoji}</span><span class="preview-target-count">× ${t.required}</span>`;
    targetsEl.appendChild(chip);
  });
  showScreen(journeyPreviewScreen);
}

/* ============================================================
   LOCKED CANDIES — Helper Functions
============================================================ */
function initializeLockedCandies(config){
  // Find all locked targets in the config
  const lockedTargets = config.targets.filter(t=>t.locked);
  if(lockedTargets.length===0) return;
  
  // For each locked target type, place 1-2 locked candies on the board
  lockedTargets.forEach(target=>{
    let placed = 0;
    let attempts = 0;
    const targetToPlace = Math.min(1, target.locked); // Usually 1 per target

    const isEligible = (r,c)=>{
      const key = `${r},${c}`;
      if(lockedCandies[key] || pathCells[key] || !board[r][c].filled || board[r][c].void) return false;
      if(board[r][c].specialType) return false;
      return true;
    };
    
    while(placed < targetToPlace && attempts < 100){
      attempts++;
      const r = Math.floor(Math.random()*SIZE);
      const c = Math.floor(Math.random()*SIZE);
      
      // Skip if already locked, already a Candy Path step, or not a valid candy cell
      if(!isEligible(r,c)) continue;
      
      // Place the locked candy
      lockedCandies[`${r},${c}`] = {
        unlockHits: 2,
        type: target.type,
        c1: target.c1,
        c2: target.c2,
        emoji: target.emoji
      };
      placed++;
    }

    // BUGFIX (Step 17 QA): the random search above can still miss an
    // eligible cell purely by bad luck within its attempt cap on a sparse
    // board — fall back to a deterministic scan so a Locked Candy is never
    // silently skipped when a valid cell genuinely exists.
    if(placed < targetToPlace){
      outer:
      for(let r=0;r<SIZE;r++){
        for(let c=0;c<SIZE;c++){
          if(placed >= targetToPlace) break outer;
          if(!isEligible(r,c)) continue;
          lockedCandies[`${r},${c}`] = {
            unlockHits: 2,
            type: target.type,
            c1: target.c1,
            c2: target.c2,
            emoji: target.emoji
          };
          placed++;
        }
      }
    }
  });
}

function showLockedCandyTutorialIfNeeded(config){
  if(!config.hasLockedCandies || lockedCandyTutorialShown) return;
  
  // Show tooltip near first locked candy
  const firstLockedKey = Object.keys(lockedCandies)[0];
  if(!firstLockedKey) return;
  
  lockedCandyTutorialShown = true;
  
  // Create a simple on-screen tutorial
  const tutorial = document.createElement('div');
  tutorial.style.cssText = `
    position:fixed; top:50%; left:50%; transform:translate(-50%, -50%);
    background:rgba(0,0,0,.85); color:#fff; padding:30px 40px;
    border-radius:20px; z-index:9999; text-align:center;
    font-weight:800; font-size:18px; font-family:var(--font-heading);
    box-shadow:0 8px 32px rgba(0,0,0,.5);
    animation:tutorialSlideIn .4s cubic-bezier(.34,1.56,.64,1);
  `;
  
  tutorial.innerHTML = `
    <div style="font-size:32px; margin-bottom:12px;">🔒</div>
    <div style="margin-bottom:8px;">LOCKED CANDY</div>
    <div style="font-size:14px; color:#ccc; margin-bottom:20px;">Clear nearby cells 2 times<br>to unlock it!</div>
    <button style="
      background:#ff6fb0; color:#fff; border:none; padding:10px 20px;
      border-radius:10px; font-weight:800; cursor:pointer; font-size:14px;
      font-family:var(--font-body);
    " onclick="this.parentElement.remove();">GOT IT!</button>
  `;
  
  document.body.appendChild(tutorial);
  
  // Auto-hide after 5 seconds if not closed
  setTimeout(()=>{
    if(tutorial.parentElement) tutorial.remove();
  }, 5000);
}

function processLockedCandyUnlocks(clearedCells){
  if(Object.keys(lockedCandies).length === 0) return;
  
  // BUGFIX (Step 17 QA): one MOVE = at most one hit per locked candy, even
  // if that move's clear happens to touch several of its neighboring cells
  // at once (e.g. an intersecting row+column clear can put 2-4 different
  // cleared cells within 1-cell distance of the same locked candy). The
  // old version decremented once per adjacent cleared cell, so a single
  // lucky move could silently unlock a "2 hits" candy in one go. Reworked
  // to check EACH locked candy once against the whole clearedCells batch,
  // so it only ever loses one hit per call (one call per move — see
  // processLineClears), regardless of how many neighbors cleared.
  Object.entries(lockedCandies).forEach(([key, locked])=>{
    if(locked.unlockHits <= 0) return; // Already unlocked
    
    const [lr, lc] = key.split(',').map(Number);
    
    // Did THIS move's clear touch at least one adjacent (within 1 cell) cell?
    const wasHit = clearedCells.some(([cr, cc])=> Math.abs(cr - lr) <= 1 && Math.abs(cc - lc) <= 1);
    if(!wasHit) return;
    
    locked.unlockHits--;
    playSound('collect'); // Simple feedback sound
    
    if(locked.unlockHits === 0){
      // Unlock animation!
      unlockCandy(lr, lc);
    } else {
      // Show crack animation
      crackLockedCandy(lr, lc);
    }
  });
}

function crackLockedCandy(r, c){
  const dom = getCellDOM(r, c);
  dom.style.animation = 'none';
  void dom.offsetWidth; // Trigger reflow
  dom.style.animation = 'lockedCandyShake .3s ease';
  
  playSound('targetdone');
}

function unlockCandy(r, c){
  const dom = getCellDOM(r, c);
  const key = `${r},${c}`;
  
  // Trigger unlock animation
  dom.classList.add('unlocking');
  playSound('targetdone');
  
  // Remove after animation
  setTimeout(()=>{
    delete lockedCandies[key];
    refreshCellVisual(r, c);
    dom.classList.remove('unlocking');
  }, 500);
}

// Add shake animation for locked candies
const style = document.createElement('style');
style.textContent = `
  @keyframes lockedCandyShake{
    0%, 100%{ transform:translateX(0) rotate(0deg); }
    25%{ transform:translateX(-3px) rotate(-2deg); }
    75%{ transform:translateX(3px) rotate(2deg); }
  }
`;
document.head.appendChild(style);

/* ============================================================
   FROZEN CANDIES — Helper Functions
============================================================ */
function initializeFrozenCandies(config){
  // Find all frozen targets in the config
  const frozenTargets = config.targets.filter(t=>t.frozen);
  if(frozenTargets.length===0) return;
  
  // For each frozen target type, place 1 frozen candy on the board
  frozenTargets.forEach(target=>{
    let placed = 0;
    let attempts = 0;
    const targetToPlace = Math.min(1, target.frozen); // Usually 1 per target

    const isEligible = (r,c)=>{
      const key = `${r},${c}`;
      if(frozenCandies[key] || lockedCandies[key] || pathCells[key] || !board[r][c].filled || board[r][c].void) return false;
      if(board[r][c].specialType) return false;
      return true;
    };
    
    while(placed < targetToPlace && attempts < 100){
      attempts++;
      const r = Math.floor(Math.random()*SIZE);
      const c = Math.floor(Math.random()*SIZE);
      
      // Skip if already frozen/locked, already a Candy Path step, or not a valid candy cell
      if(!isEligible(r,c)) continue;
      
      // Place the frozen candy
      frozenCandies[`${r},${c}`] = {
        iceHits: 2,
        type: target.type,
        c1: target.c1,
        c2: target.c2,
        emoji: target.emoji
      };
      placed++;
    }

    // BUGFIX (Step 17 QA): deterministic fallback so a Frozen Candy is
    // never silently skipped when an eligible cell genuinely exists but
    // the random search missed it within its attempt cap (same fix as
    // initializeLockedCandies above).
    if(placed < targetToPlace){
      outer:
      for(let r=0;r<SIZE;r++){
        for(let c=0;c<SIZE;c++){
          if(placed >= targetToPlace) break outer;
          if(!isEligible(r,c)) continue;
          frozenCandies[`${r},${c}`] = {
            iceHits: 2,
            type: target.type,
            c1: target.c1,
            c2: target.c2,
            emoji: target.emoji
          };
          placed++;
        }
      }
    }
  });
}

function showFrozenCandyTutorialIfNeeded(config){
  if(!config.hasFrozenCandies || frozenCandyTutorialShown) return;
  
  // Show tooltip near first frozen candy
  const firstFrozenKey = Object.keys(frozenCandies)[0];
  if(!firstFrozenKey) return;
  
  frozenCandyTutorialShown = true;
  
  // Create a simple on-screen tutorial
  const tutorial = document.createElement('div');
  tutorial.style.cssText = `
    position:fixed; top:50%; left:50%; transform:translate(-50%, -50%);
    background:rgba(0,0,0,.85); color:#fff; padding:30px 40px;
    border-radius:20px; z-index:9999; text-align:center;
    font-weight:800; font-size:18px; font-family:var(--font-heading);
    box-shadow:0 8px 32px rgba(0,0,0,.5);
    animation:tutorialSlideIn .4s cubic-bezier(.34,1.56,.64,1);
  `;
  
  tutorial.innerHTML = `
    <div style="font-size:32px; margin-bottom:12px;">❄️</div>
    <div style="margin-bottom:8px;">FROZEN CANDY</div>
    <div style="font-size:14px; color:#ccc; margin-bottom:20px;">Clear this cell 2 times<br>to break the ice!</div>
    <button style="
      background:#7fd8ff; color:#000; border:none; padding:10px 20px;
      border-radius:10px; font-weight:800; cursor:pointer; font-size:14px;
      font-family:var(--font-body);
    " onclick="this.parentElement.remove();">GOT IT!</button>
  `;
  
  document.body.appendChild(tutorial);
  
  // Auto-hide after 5 seconds if not closed
  setTimeout(()=>{
    if(tutorial.parentElement) tutorial.remove();
  }, 5000);
}

function processFrozenCandyBreaks(clearedCells){
  if(Object.keys(frozenCandies).length === 0) return;
  
  // For each cleared cell, check if it contains frozen candies
  clearedCells.forEach(([cr, cc])=>{
    const key = `${cr},${cc}`;
    if(frozenCandies[key]){
      const frozen = frozenCandies[key];
      frozen.iceHits--;
      playSound('collect');
      
      if(frozen.iceHits === 0){
        // Break animation!
        breakIce(cr, cc);
      } else {
        // Show crack animation
        crackIce(cr, cc);
      }
    }
  });
}

function crackIce(r, c){
  const dom = getCellDOM(r, c);
  dom.classList.remove('cracking');
  void dom.offsetWidth; // Trigger reflow
  dom.classList.add('cracking');
  playSound('pop');
}

function breakIce(r, c){
  const dom = getCellDOM(r, c);
  const key = `${r},${c}`;
  
  // Trigger break animation
  dom.classList.add('breaking');
  playSound('targetdone');
  
  // Remove after animation
  setTimeout(()=>{
    delete frozenCandies[key];
    refreshCellVisual(r, c);
    dom.classList.remove('breaking');
  }, 500);
}

/* ============================================================
   JELLY CELLS — Helper Functions
============================================================ */
function initializeJellyCells(config){
  const jellyTarget = config.targets.find(t=>t.isJelly);
  if(!jellyTarget || jellyTarget.required<=0) return;

  const desired = jellyTarget.required;
  let placed = 0;
  let attempts = 0;

  // More attempts than locked/frozen (which only ever place 1), since a
  // jelly objective wants several cells at once.
  while(placed < desired && attempts < 300){
    attempts++;
    const r = Math.floor(Math.random()*SIZE);
    const c = Math.floor(Math.random()*SIZE);
    const key = `${r},${c}`;

    // Skip if already jelly/locked/frozen, already a Candy Path step, or not a valid candy cell
    if(jellyCells[key] || lockedCandies[key] || frozenCandies[key] || pathCells[key] || !board[r][c].filled || board[r][c].void) continue;

    // Skip if it's a special candy already
    if(board[r][c].specialType) continue;

    jellyCells[key] = { jellyHits: 1, broken: false };
    placed++;
  }

  // Guard: a sparse starting board may not have enough filled cells to
  // host every requested jelly cell. Never leave the objective needing
  // more jelly cells than actually got placed, or the level could never
  // be completed.
  if(placed === 0){
    const idx = config.targets.indexOf(jellyTarget);
    if(idx>=0) config.targets.splice(idx,1);
    config.hasJellyCells = false;
  } else if(placed < desired){
    jellyTarget.required = placed;
  }
}

/* ============================================================
   BLAST JOURNEY — CHOCOLATE SPREAD
   A chocolate cell can sit on top of a filled candy cell OR an empty
   playable cell (unlike locked/frozen/jelly, which always need a filled
   candy underneath) — it never blocks placement itself. Placed here,
   before buildBoardDOM()/refreshAllCells() run, so — same as
   initializeJellyCells above — it only ever touches the `chocolateCells`
   data map; the visual overlay is picked up automatically by the
   blanket refreshAllCells() call in startJourneyLevel.
============================================================ */
function initializeChocolateCells(config){
  if(!config.hasChocolate || config.chocolateCount<=0) return;

  const desired = config.chocolateCount;
  let placed = 0;
  let attempts = 0;

  while(placed < desired && attempts < 300){
    attempts++;
    const r = Math.floor(Math.random()*SIZE);
    const c = Math.floor(Math.random()*SIZE);
    const key = `${r},${c}`;

    // Never on a void or obstacle cell, and never doubled up with another
    // chocolate cell, an existing locked/frozen/jelly overlay, or a
    // Candy Path step.
    if(board[r][c].void || board[r][c].obstacle) continue;
    if(chocolateCells[key] || lockedCandies[key] || frozenCandies[key] || jellyCells[key] || pathCells[key]) continue;

    chocolateCells[key] = { hits: 1 };
    placed++;
  }

  // Guard: a small/crowded board may not have enough eligible cells to
  // host every requested chocolate cell — never leave the objective
  // needing more clears than actually got placed.
  const chocoTarget = config.targets.find(t=>t.isChocolate);
  if(chocoTarget){
    if(placed === 0){
      const idx = config.targets.indexOf(chocoTarget);
      if(idx>=0) config.targets.splice(idx,1);
      config.hasChocolate = false;
    } else if(placed < desired){
      chocoTarget.required = placed;
    }
  }
}

/* ============================================================
   BLAST JOURNEY — CANDY BOMB COUNTDOWN
   A bomb always sits on a filled candy cell (like locked/frozen/jelly,
   unlike chocolate) — it needs to actually be part of a completed
   row/column to ever be defused, so it must occupy real board content,
   never an empty cell. Positions are never hard-coded: CUSTOM_LEVEL_BOMBS
   only supplies a count + starting countdown per level (see above), and
   this picks `count` random eligible cells at level start, same strategy
   as initializeJellyCells/initializeChocolateCells.
============================================================ */
function initializeBombCells(config){
  if(!config.hasBombs || config.bombCount<=0) return;

  const desired = config.bombCount;
  let placed = 0;
  let attempts = 0;

  while(placed < desired && attempts < 300){
    attempts++;
    const r = Math.floor(Math.random()*SIZE);
    const c = Math.floor(Math.random()*SIZE);
    const key = `${r},${c}`;

    // Never on a void/obstacle cell, never on an empty cell (needs to be
    // real board content to ever be part of a line clear), and never
    // doubled up with another bomb, an existing locked/frozen/jelly/
    // chocolate overlay, or a Candy Path step.
    if(board[r][c].void || board[r][c].obstacle || !board[r][c].filled) continue;
    if(journeyBombCells[key] || lockedCandies[key] || frozenCandies[key] || jellyCells[key] || chocolateCells[key] || pathCells[key]) continue;

    journeyBombCells[key] = { countdown: config.bombCountdown };
    placed++;
  }

  // Guard: a small/crowded board may not have enough eligible filled
  // cells to host every requested bomb — never leave the objective
  // needing more defuses than actually got placed.
  const bombTarget = config.targets.find(t=>t.isBomb);
  if(bombTarget){
    if(placed === 0){
      const idx = config.targets.indexOf(bombTarget);
      if(idx>=0) config.targets.splice(idx,1);
      config.hasBombs = false;
    } else if(placed < desired){
      bombTarget.required = placed;
    }
  }
}

// Refreshes a single bomb cell's countdown number + warning classes.
// Called right after placement (board build) and every time a bomb's
// countdown ticks down. A no-op if the cell no longer has a bomb (it was
// just defused/removed) — refreshCellVisual/breakBomb handle that cell's
// visuals themselves in that case.
function updateBombCellVisual(r,c){
  const key = `${r},${c}`;
  const bomb = journeyBombCells[key];
  if(!bomb) return;
  const dom = getCellDOM(r,c);
  dom.setAttribute('data-bomb-count', Math.max(0,bomb.countdown));
  dom.classList.remove('bomb-warn-3','bomb-warn-2','bomb-warn-1');
  if(bomb.countdown===3) dom.classList.add('bomb-warn-3');
  else if(bomb.countdown===2) dom.classList.add('bomb-warn-2');
  else if(bomb.countdown<=1) dom.classList.add('bomb-warn-1');
}

/* ============================================================
   BLAST JOURNEY — RAINBOW CANDY
   Always sits on a filled candy cell, same requirement as bomb/locked/
   frozen/jelly (needs to actually be part of a real line clear to ever be
   collected). Unlike bomb, it's explicitly ALLOWED to land on a cell that
   is ALSO locked/frozen/jelly — per spec that's the "unlock/break/de-jelly
   first, then collect" case, handled by processRainbowCollection() below.
   It's kept OFF chocolate/bomb cells simply because nothing in the spec
   defines how those two would nest with it, and every other mechanic here
   avoids undefined nesting the same way. Positions are never hard-coded:
   CUSTOM_LEVEL_RAINBOW only supplies a count per level (see above), and
   this picks `count` random eligible cells at level start.
============================================================ */
function initializeRainbowCandies(config){
  if(!config.hasRainbow || config.rainbowCount<=0) return;

  const desired = config.rainbowCount;
  let placed = 0;
  let attempts = 0;

  while(placed < desired && attempts < 300){
    attempts++;
    const r = Math.floor(Math.random()*SIZE);
    const c = Math.floor(Math.random()*SIZE);
    const key = `${r},${c}`;

    if(board[r][c].void || board[r][c].obstacle || !board[r][c].filled) continue;
    if(board[r][c].specialType) continue; // keep it a plain candy underneath, like locked/frozen do
    if(rainbowCells[key] || chocolateCells[key] || journeyBombCells[key] || pathCells[key]) continue;

    rainbowCells[key] = true;
    placed++;
  }

  // Guard: never leave the objective needing more collects than actually
  // got placed (same guard used for chocolate/bomb above).
  const rainbowTarget = config.targets.find(t=>t.isRainbow);
  if(rainbowTarget){
    if(placed === 0){
      const idx = config.targets.indexOf(rainbowTarget);
      if(idx>=0) config.targets.splice(idx,1);
      config.hasRainbow = false;
    } else if(placed < desired){
      rainbowTarget.required = placed;
    }
  }
}

function showJellyTutorialIfNeeded(config){
  if(!config.hasJellyCells || jellyTutorialShown) return;

  // Show tooltip near first jelly cell
  const firstJellyKey = Object.keys(jellyCells)[0];
  if(!firstJellyKey) return;

  jellyTutorialShown = true;

  // Create a simple on-screen tutorial
  const tutorial = document.createElement('div');
  tutorial.style.cssText = `
    position:fixed; top:50%; left:50%; transform:translate(-50%, -50%);
    background:rgba(0,0,0,.85); color:#fff; padding:30px 40px;
    border-radius:20px; z-index:9999; text-align:center;
    font-weight:800; font-size:18px; font-family:var(--font-heading);
    box-shadow:0 8px 32px rgba(0,0,0,.5);
    animation:tutorialSlideIn .4s cubic-bezier(.34,1.56,.64,1);
  `;

  tutorial.innerHTML = `
    <div style="font-size:32px; margin-bottom:12px;">🫧</div>
    <div style="margin-bottom:8px;">JELLY</div>
    <div style="font-size:14px; color:#ccc; margin-bottom:20px;">Clear the jelly-covered cells<br>to remove them!</div>
    <button style="
      background:#ff8fd0; color:#fff; border:none; padding:10px 20px;
      border-radius:10px; font-weight:800; cursor:pointer; font-size:14px;
      font-family:var(--font-body);
    " onclick="this.parentElement.remove();">GOT IT!</button>
  `;

  document.body.appendChild(tutorial);

  // Auto-hide after 5 seconds if not closed
  setTimeout(()=>{
    if(tutorial.parentElement) tutorial.remove();
  }, 5000);
}

