        <div class="premium-go-corner premium-go-corner-tl">🍬</div>
        <div class="premium-go-corner premium-go-corner-tr">🍭</div>
        <div class="journey-complete-emoji">🎉</div>
        <div class="journey-complete-title">LEVEL COMPLETE!</div>
        <div class="journey-complete-sub">Level <span id="journey-complete-level-num">1</span> cleared</div>
        <div class="journey-complete-stars" id="journey-complete-stars">⭐⭐⭐</div>
        <div class="premium-go-buttons premium-go-buttons-col journey-complete-buttons">
          <button class="premium-go-btn premium-go-btn-restart" id="btn-journey-next"><span class="premium-go-btn-icon">➡️</span><span>NEXT LEVEL</span></button>
          <button class="premium-go-btn premium-go-btn-secondary" id="btn-journey-replay"><span class="premium-go-btn-icon">🔄</span><span>REPLAY</span></button>
          <button class="premium-go-btn premium-go-btn-secondary" id="btn-journey-map"><span class="premium-go-btn-icon">🗺️</span><span>MAP</span></button>
          <button class="premium-go-btn premium-go-btn-home" id="btn-journey-home"><span class="premium-go-btn-icon">🏠</span><span>HOME</span></button>
        </div>
        <div class="premium-go-corner premium-go-corner-bl">🍇</div>
        <div class="premium-go-corner premium-go-corner-br">🍡</div>
      </div>
    </div>
  </div>

