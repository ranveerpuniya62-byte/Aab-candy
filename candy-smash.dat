  .observe(settingsScreen, { attributes:true, attributeFilter:['class'] });
// Contact email: open the user's mail app with a new message to the studio. Loaded through a
// hidden frame so that a WebView that cannot handle mailto: can never replace the game page
// with an error page (a normal browser / a wrapper that handles mailto: opens the mail app).
let aboutMailFrame = null;
el('about-email').addEventListener('click', (e)=>{
  e.preventDefault();
  playSound('button');
  try{
    if(!aboutMailFrame){
      aboutMailFrame = document.createElement('iframe');
      aboutMailFrame.setAttribute('aria-hidden', 'true');
      aboutMailFrame.tabIndex = -1;
      aboutMailFrame.style.cssText = 'position:absolute;width:0;height:0;border:0;visibility:hidden;pointer-events:none;';
      document.body.appendChild(aboutMailFrame);
    }
    aboutMailFrame.src = 'about:blank';
    aboutMailFrame.src = el('about-email').getAttribute('href');
  }catch(err){}
});
