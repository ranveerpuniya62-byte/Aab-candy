      </radialGradient>
    </defs>
    <circle cx="50" cy="42" r="26" fill="url(#${g}pop)" stroke="#c01a80" stroke-width=".8"/>
    <circle cx="50" cy="42" r="26" fill="url(#${g}shine)"/>
    <g stroke="#f0609f" stroke-width="1.3" stroke-opacity=".35" stroke-linecap="round">
      <circle cx="50" cy="42" r="20" fill="none"/><circle cx="50" cy="42" r="14" fill="none"/><circle cx="50" cy="42" r="8" fill="none"/>
    </g>
    <rect x="48" y="60" width="4" height="28" fill="#8a5a3a" stroke="#6a3a1a" stroke-width=".6" opacity=".88"/>
    <path d="M48 62 L52 62 L51 65 L49 65 Z" fill="#a57a5a" opacity=".7"/>
    <ellipse cx="44" cy="32" rx="10" ry="6" fill="#fff" opacity=".48"/>
    <circle cx="40" cy="29" r="2.8" fill="#fff" opacity=".88"/>`,
    
  // ============================================================
  // RAINBOW - Multicolor swirl
  // ============================================================
  rainbow2:(g)=>`
    <defs>
      <linearGradient id="${g}bow" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ff6b6b"/><stop offset="16%" stop-color="#ffa86f"/><stop offset="33%" stop-color="#ffd166"/><stop offset="50%" stop-color="#52d75f"/><stop offset="66%" stop-color="#45b7d1"/><stop offset="83%" stop-color="#7d5be8"/><stop offset="100%" stop-color="#c461ee"/>
      </linearGradient>
      <radialGradient id="${g}shine" cx="35%" cy="30%" r="55%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.68"/><stop offset="30%" stop-color="#fff" stop-opacity="0.21"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <circle cx="50" cy="52" r="34" fill="url(#${g}bow)" stroke="#8a4aa0" stroke-width=".8"/>
    <circle cx="50" cy="52" r="34" fill="url(#${g}shine)"/>
    <circle cx="50" cy="52" r="26" fill="none" stroke="url(#${g}bow)" stroke-width="1.5" opacity=".4"/>
    <circle cx="50" cy="52" r="18" fill="none" stroke="url(#${g}bow)" stroke-width="1.2" opacity=".3"/>
    <ellipse cx="38" cy="38" rx="12" ry="7" fill="#fff" opacity=".45"/>
    <circle cx="33" cy="35" r="3" fill="#fff" opacity=".87"/>`,
    
  // ============================================================
  // HARD CANDY - Faceted transparent
  // ============================================================
  hard:(g)=>`
    <defs>
      <linearGradient id="${g}facet" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#fff" stop-opacity=".6"/><stop offset="50%" stop-color="#fff" stop-opacity=".2"/><stop offset="100%" stop-color="#ff4d6d"/>
      </linearGradient>
      <radialGradient id="${g}inner" cx="50%" cy="50%" r="60%">
        <stop offset="0%" stop-color="#ffe0e8"/><stop offset="100%" stop-color="#ff4d6d"/>
      </radialGradient>
    </defs>
    <path d="M50 20 L72 38 L70 78 L30 78 L28 38 Z" fill="url(#${g}facet)" stroke="#cc3a5a" stroke-width=".9" opacity=".9"/>
    <circle cx="50" cy="45" r="18" fill="url(#${g}inner)" opacity=".7"/>
    <g stroke="#ff8aa8" stroke-width="1.3" stroke-opacity=".4">
      <line x1="50" y1="20" x2="50" y2="78"/><line x1="28" y1="38" x2="72" y2="38"/><line x1="30" y1="78" x2="50" y2="50"/><line x1="70" y1="78" x2="50" y2="50"/>
    </g>
    <ellipse cx="44" cy="32" rx="8" ry="5" fill="#fff" opacity=".5"/>
    <circle cx="40" cy="30" r="2.4" fill="#fff" opacity=".9"/>`,
    
  // ============================================================
  // CHOCOLATE - Smooth piece
  // ============================================================
  chocolate2:(g)=>`
    <defs>
      <radialGradient id="${g}choc" cx="45%" cy="40%" r="65%">
        <stop offset="0%" stop-color="#d4a574"/><stop offset="50%" stop-color="#c48a52"/><stop offset="100%" stop-color="#5c3a1e"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="35%" cy="28%" r="50%">
        <stop offset="0%" stop-color="#e8c8a0" stop-opacity=".45"/><stop offset="100%" stop-color="#e8c8a0" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <rect x="24" y="28" width="52" height="48" rx="6" ry="6" fill="url(#${g}choc)" stroke="#4a2a0a" stroke-width=".8"/>
    <rect x="24" y="28" width="52" height="48" rx="6" ry="6" fill="url(#${g}shine)"/>
    <g stroke="#7a5a3a" stroke-width="1" stroke-opacity=".2">
      <line x1="30" y1="28" x2="30" y2="76"/><line x1="40" y1="28" x2="40" y2="76"/><line x1="50" y1="28" x2="50" y2="76"/><line x1="60" y1="28" x2="60" y2="76"/>
      <line x1="24" y1="40" x2="76" y2="40"/><line x1="24" y1="55" x2="76" y2="55"/>
    </g>
    <ellipse cx="35" cy="36" rx="9" ry="5" fill="#fff" opacity=".25"/>
    <circle cx="32" cy="34" r="2" fill="#fff" opacity=".6"/>`,
    
  // ============================================================
  // JELLY - Gelatinous blob
  // ============================================================
  jelly:(g)=>`
    <defs>
      <radialGradient id="${g}gel" cx="50%" cy="50%" r="65%">
        <stop offset="0%" stop-color="#ffe8b6"/><stop offset="50%" stop-color="#ffe29a"/><stop offset="100%" stop-color="#e08a3c"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="40%" cy="35%" r="55%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.68"/><stop offset="30%" stop-color="#fff" stop-opacity="0.21"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <path d="M30 50 Q25 35 50 25 Q75 35 70 50 Q75 70 50 80 Q25 70 30 50 Z" fill="url(#${g}gel)" stroke="#d07020" stroke-width=".8" opacity=".9"/>
    <path d="M30 50 Q25 35 50 25 Q75 35 70 50 Q75 70 50 80 Q25 70 30 50 Z" fill="url(#${g}shine)"/>
    <g fill="#f0b050" opacity=".1">
      <circle cx="45" cy="55" r="1.3"/><circle cx="58" cy="45" r="1.2"/>
    </g>
    <ellipse cx="40" cy="38" rx="10" ry="7" fill="#fff" opacity=".4"/>
    <circle cx="36" cy="35" r="2.5" fill="#fff" opacity=".82"/>`,
    
  // ============================================================
  // GUMMY - Bear shape
  // ============================================================
  gummy:(g)=>`
    <defs>
      <radialGradient id="${g}body" cx="50%" cy="55%" r="62%">
        <stop offset="0%" stop-color="#ffb066"/><stop offset="50%" stop-color="#ff9f43"/><stop offset="100%" stop-color="#c25a00"/>
      </radialGradient>
      <radialGradient id="${g}shine" cx="45%" cy="35%" r="50%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.63"/><stop offset="30%" stop-color="#fff" stop-opacity="0.189"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <circle cx="50" cy="50" r="22" fill="url(#${g}body)" stroke="#8a3a00" stroke-width=".7"/>
    <circle cx="38" cy="32" r="8" fill="url(#${g}body)" stroke="#8a3a00" stroke-width=".6"/>
    <circle cx="62" cy="32" r="8" fill="url(#${g}body)" stroke="#8a3a00" stroke-width=".6"/>
    <circle cx="50" cy="50" r="22" fill="url(#${g}shine)"/>
    <circle cx="38" cy="32" r="8" fill="url(#${g}shine)"/>
    <circle cx="62" cy="32" r="8" fill="url(#${g}shine)"/>
    <circle cx="36" cy="30" r="1.4" fill="#000" opacity=".6"/>
    <circle cx="64" cy="30" r="1.4" fill="#000" opacity=".6"/>
    <ellipse cx="46" cy="42" rx="5" ry="3" fill="#fff" opacity=".35"/>
    <circle cx="44" cy="40" r="1.8" fill="#fff" opacity=".75"/>`,
    
  // ============================================================
  // SWIRL - Mint candy swirl
  // ============================================================
  swirl:(g)=>`
    <defs>
      <linearGradient id="${g}swirl" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#fff"/><stop offset="25%" stop-color="#e8fff8"/><stop offset="50%" stop-color="#d5fff5"/><stop offset="75%" stop-color="#2bb8a0"/><stop offset="100%" stop-color="#0a9080"/>
      </linearGradient>
      <radialGradient id="${g}shine" cx="32%" cy="28%" r="52%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.73"/><stop offset="30%" stop-color="#fff" stop-opacity="0.231"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <circle cx="50" cy="52" r="32" fill="url(#${g}swirl)" stroke="#0a8070" stroke-width=".8"/>
    <circle cx="50" cy="52" r="32" fill="url(#${g}shine)"/>
    <g fill="none" stroke="#2bb8a0" stroke-width="2.2" stroke-opacity=".3" stroke-linecap="round">
      <path d="M28 52 Q50 30 72 52"/><path d="M28 52 Q50 74 72 52"/>
    </g>
    <ellipse cx="40" cy="38" rx="11" ry="7" fill="#fff" opacity=".48"/>
    <circle cx="35" cy="35" r="2.6" fill="#fff" opacity=".88"/>`,
    
  // ============================================================
  // STAR - Faceted star
  // ============================================================
  star:(g)=>`
    <defs>
      <linearGradient id="${g}point" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ffffd0"/><stop offset="50%" stop-color="#fff59d"/><stop offset="100%" stop-color="#f2b400"/>
      </linearGradient>
      <radialGradient id="${g}shine" cx="50%" cy="40%" r="50%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.73"/><stop offset="30%" stop-color="#fff" stop-opacity="0.231"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <polygon points="50,18 60,35 78,40 65,52 70,70 50,58 30,70 35,52 22,40 40,35" fill="url(#${g}point)" stroke="#d4a300" stroke-width=".9"/>
    <polygon points="50,18 60,35 78,40 65,52 70,70 50,58 30,70 35,52 22,40 40,35" fill="url(#${g}shine)"/>
    <g stroke="#e0b800" stroke-width="1.1" stroke-opacity=".3">
      <line x1="50" y1="18" x2="50" y2="58"/><line x1="50" y1="58" x2="30" y2="70"/><line x1="50" y1="58" x2="70" y2="70"/>
    </g>
    <ellipse cx="45" cy="28" rx="8" ry="5" fill="#fff" opacity=".48"/>
    <circle cx="42" cy="25" r="2.3" fill="#fff" opacity=".87"/>`,
    
  // ============================================================
  // CRYSTAL - Faceted gem
  // ============================================================
  crystal:(g)=>`
    <defs>
      <linearGradient id="${g}gem" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#fff"/><stop offset="25%" stop-color="#e0ffff"/><stop offset="50%" stop-color="#b3f5ff"/><stop offset="75%" stop-color="#6ae8ff"/><stop offset="100%" stop-color="#3fc6e0"/>
      </linearGradient>
      <radialGradient id="${g}shine" cx="50%" cy="35%" r="45%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.78"/><stop offset="30%" stop-color="#fff" stop-opacity="0.252"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <path d="M50 12 L74 35 L68 82 L32 82 L26 35 Z" fill="url(#${g}gem)" stroke="#1a9aaa" stroke-width="1" opacity=".93"/>
    <path d="M50 12 L74 35 L68 82 L32 82 L26 35 Z" fill="url(#${g}shine)"/>
    <g stroke="#40d0e8" stroke-width="1.2" stroke-opacity=".35">
      <line x1="50" y1="12" x2="50" y2="82"/><line x1="26" y1="35" x2="74" y2="35"/><line x1="32" y1="82" x2="50" y2="47"/><line x1="68" y1="82" x2="50" y2="47"/>
    </g>
    <path d="M50 12 L74 35 L62 57" fill="#a8f0ff" opacity=".15"/>
    <ellipse cx="43" cy="28" rx="7" ry="4.5" fill="#fff" opacity=".5"/>
    <circle cx="40" cy="26" r="2.2" fill="#fff" opacity=".91"/>`,
};

// ============================================================
// PREMIUM CANDY LIGHTING FOUNDATION (Graphics Step 1)
// One shared, static-SVG "studio lighting" layer that gives every candy the
// same premium 3D-glossy quality: volume shading with dark lower/side
// falloff, soft bounce/rim light, a broad soft highlight, a crisp specular
// highlight + tiny reflection point, and a small secondary reflected spot.
// Material profiles (fruit / hard candy / chocolate / gummy / star /
// crystal) change the intensities so each candy still feels different.
// Every layer is clipped to the candy's own silhouette (PREMIUM_CANDY_BODIES)
// so nothing spills outside the artwork. Pure gradients + a few shapes:
// no filters, no blur, no canvas, no animation, no external assets.
// VISUAL ONLY — it never touches candyId, c1/c2, board state, matching,
// clearing, dragging or scoring. Classic-only: Blast Journey's original
// THEMES carry no candyId and never reach this code.
// To upgrade a future candy: add its silhouette to PREMIUM_CANDY_BODIES and
// (optionally) a material to PREMIUM_CANDY_PROFILE_OF. A candy with neither
// still gets a sensible default body + the glossy profile.
// ============================================================
const PREMIUM_CANDY_PROFILES = {
  // STEP 3 polish: added sat (colour vibrancy), top (soft top light), wrap (curved surface reflection)
  glossy: {shade:.40, rim:.26, soft:.54, spec:1,   dot:.95, bounce:.22, inner:.12, edge:.36, bevel:.42, glint:0,   sat:.22, top:.26, wrap:.30},
  hard:   {shade:.36, rim:.34, soft:.50, spec:1,   dot:1,   bounce:.28, inner:.06, edge:.72, bevel:.44, glint:.34, sat:.20, top:.28, wrap:.34},
  choc:   {shade:.50, rim:.20, soft:.42, spec:.92, dot:.80, bounce:.14, inner:0,   edge:.30, bevel:.58, glint:0,   sat:.16, top:.20, wrap:.34},
  gummy:  {shade:.28, rim:.36, soft:.50, spec:.90, dot:.90, bounce:.20, inner:.78, edge:.58, bevel:.32, glint:0,   sat:.24, top:.24, wrap:.28},
  star:   {shade:.38, rim:.28, soft:.56, spec:1,   dot:1,   bounce:.26, inner:.20, edge:.50, bevel:.48, glint:0,   sat:.20, top:.26, wrap:.30},
  crystal:{shade:.26, rim:.40, soft:.44, spec:1,   dot:1,   bounce:.32, inner:.36, edge:.82, bevel:.38, glint:.44, sat:.18, top:.28, wrap:.36},
  rainbow:{shade:.18, rim:.26, soft:.54, spec:1,   dot:.95, bounce:.14, inner:.12, edge:.46, bevel:.24, glint:0,   sat:.05, top:.24, wrap:.32}
};
const PREMIUM_CANDY_PROFILE_OF = {
  hard:'hard', lollipop2:'hard', swirl:'hard', chocolate2:'choc', rainbow2:'rainbow',
  jelly:'gummy', gummy:'gummy', star:'star', crystal:'crystal'
};
// Silhouette bodies per candy id: bbox [x0,y0,x1,y1] in the 100x100 art space
// + the exact clip shape. `lite` bodies (e.g. gummy ears) only get a highlight.
const PREMIUM_CANDY_BODIES = {
  strawberry:[{b:[23,29,77,88], clip:'<path d="M50 29 C72 29 82 50 72 80 C65 90 35 90 28 80 C18 50 28 29 50 29 Z"/>'}],
  cherry:[{b:[19,42,59,82], clip:'<circle cx="39" cy="62" r="20"/>'},{b:[45,42,85,82], clip:'<circle cx="65" cy="62" r="20"/>'}],
  orange:[{b:[16,18,84,86], clip:'<circle cx="50" cy="52" r="34"/>'}],
  lemon:[{b:[17,18,83,85], clip:'<path d="M17 52 C17 32 34 18 50 18 C66 18 83 32 83 52 C83 72 66 85 50 85 C34 85 17 72 17 52 Z"/>'}],
  apple:[{b:[19,27,81,87], clip:'<path d="M50 30 C69 26 83 40 81 58 C79 76 65 87 50 87 C35 87 21 76 19 58 C17 40 31 26 50 30 Z"/>'}],
  blueberry:[{b:[20,25,80,85], clip:'<circle cx="50" cy="55" r="30"/>'}],
  grape:[{b:[23,26,55,58], clip:'<circle cx="39" cy="42" r="16"/>'},{b:[45,26,77,58], clip:'<circle cx="61" cy="42" r="16"/>'},{b:[34,49,66,81], clip:'<circle cx="50" cy="65" r="16"/>'}],
  watermelon2:[{b:[15,17,85,87], clip:'<circle cx="50" cy="52" r="35"/>'}],
  pineapple:[{b:[22,33,78,97], clip:'<ellipse cx="50" cy="65" rx="28" ry="32"/>'}],
  kiwi:[{b:[17,25,83,91], clip:'<circle cx="50" cy="58" r="33"/>'}],
  peach:[{b:[17,23,83,89], clip:'<circle cx="50" cy="56" r="33"/>'}],
  lollipop2:[{b:[24,16,76,68], clip:'<circle cx="50" cy="42" r="26"/>'}],
  rainbow2:[{b:[16,18,84,86], clip:'<circle cx="50" cy="52" r="34"/>'}],
  hard:[{b:[28,20,72,78], clip:'<path d="M50 20 L72 38 L70 78 L30 78 L28 38 Z"/>'}],
  chocolate2:[{b:[24,28,76,76], clip:'<rect x="24" y="28" width="52" height="48" rx="6" ry="6"/>'}],
  jelly:[{b:[27,28,73,80], clip:'<path d="M30 50 Q25 35 50 25 Q75 35 70 50 Q75 70 50 80 Q25 70 30 50 Z"/>'}],
  gummy:[{b:[28,28,72,72], clip:'<circle cx="50" cy="50" r="22"/>'},{b:[30,24,46,40], clip:'<circle cx="38" cy="32" r="8"/>', lite:true},{b:[54,24,70,40], clip:'<circle cx="62" cy="32" r="8"/>', lite:true}],
  swirl:[{b:[18,20,82,84], clip:'<circle cx="50" cy="52" r="32"/>'}],
  star:[{b:[22,18,78,70], clip:'<polygon points="50,18 60,35 78,40 65,52 70,70 50,58 30,70 35,52 22,40 40,35"/>'}],
  crystal:[{b:[26,12,74,82], clip:'<path d="M50 12 L74 35 L68 82 L32 82 L26 35 Z"/>'}]
};
// Tiny hex colour mixer for the lighting tints (a → b by t, 0..1).
function _pcMix(a, b, t){
  const p = h=>{ h = String(h||'').replace('#',''); if(h.length===3) h = h.split('').map(x=>x+x).join(''); const n = parseInt(h,16); return isNaN(n)||h.length!==6 ? [200,200,200] : [(n>>16)&255,(n>>8)&255,n&255]; };
  const A = p(a), B = p(b);
  return 'rgb(' + A.map((v,i)=>Math.round(v+(B[i]-v)*t)).join(',') + ')';
}
// Returns {defs, body, base, shadow}: `base` is the brighter, richer body
// gradient stops (kept under the original gid so existing art that uses
// url(#gid) picks it up); `body` is the lighting overlay drawn ON TOP of the
// art; `shadow` is the soft contact-shadow ellipse geometry.
function buildPremiumCandyLighting(gid, candyId, c1, c2){
  const bodies = PREMIUM_CANDY_BODIES[candyId] || [{b:[18,20,82,84], clip:'<circle cx="50" cy="52" r="32"/>'}];
  const def = (typeof getClassicCandyDef==='function') ? getClassicCandyDef(candyId) : null;
  const P = PREMIUM_CANDY_PROFILES[PREMIUM_CANDY_PROFILE_OF[candyId] || 'glossy'] || PREMIUM_CANDY_PROFILES.glossy;
  const isStar = (PREMIUM_CANDY_PROFILE_OF[candyId] === 'star');
  const shadeC = isStar ? _pcMix(c2, '#b34700', .55) : _pcMix(c2, '#000000', .55);
  const rimC   = _pcMix(c1, '#ffffff', .62);
  const warmC  = _pcMix(c1, '#ffd9a0', .5);
  const innerC = _pcMix(c1, '#ffffff', .35);
  const satC   = _pcMix(c1, c2, .45);
  const f = n=>Math.round(n*10)/10;
  let defs = ''
    // volume: transparent lit centre → dark falloff toward lower/side edges
    + `<radialGradient id="${gid}vol" cx=".36" cy=".30" r=".88"><stop offset="0" stop-color="${shadeC}" stop-opacity="${f(P.shade*0*100)/100}"/><stop offset="0.38" stop-color="${shadeC}" stop-opacity="${f(P.shade*0*100)/100}"/><stop offset="0.52" stop-color="${shadeC}" stop-opacity="${f(P.shade*0.1*100)/100}"/><stop offset="0.66" stop-color="${shadeC}" stop-opacity="${f(P.shade*0.3*100)/100}"/><stop offset="0.8" stop-color="${shadeC}" stop-opacity="${f(P.shade*0.58*100)/100}"/><stop offset="0.92" stop-color="${shadeC}" stop-opacity="${f(P.shade*0.84*100)/100}"/><stop offset="1" stop-color="${shadeC}" stop-opacity="${f(P.shade*1*100)/100}"/></radialGradient>`
    // rim / bounce light along the far (lower-right) edge
    + `<radialGradient id="${gid}rim" cx=".34" cy=".28" r=".95"><stop offset="0" stop-color="${rimC}" stop-opacity="${f(P.rim*0*100)/100}"/><stop offset="0.6" stop-color="${rimC}" stop-opacity="${f(P.rim*0*100)/100}"/><stop offset="0.74" stop-color="${rimC}" stop-opacity="${f(P.rim*0.1*100)/100}"/><stop offset="0.86" stop-color="${rimC}" stop-opacity="${f(P.rim*0.38*100)/100}"/><stop offset="0.95" stop-color="${rimC}" stop-opacity="${f(P.rim*0.72*100)/100}"/><stop offset="1" stop-color="${rimC}" stop-opacity="${f(P.rim*1*100)/100}"/></radialGradient>`
    // rounded bevel: light upper-left edge -> dark lower-right edge (stroked along the silhouette)
    + `<linearGradient id="${gid}bev" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="${f(P.bevel*1.15)}"/><stop offset=".42" stop-color="#fff" stop-opacity="0"/><stop offset=".62" stop-color="${shadeC}" stop-opacity="0"/><stop offset="1" stop-color="${shadeC}" stop-opacity="${P.bevel}"/></linearGradient>`
    // thin rim light: bright upper-left edge, soft coloured bounce on the lower-right edge
    + `<linearGradient id="${gid}rs" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".62"/><stop offset=".34" stop-color="#fff" stop-opacity=".10"/><stop offset=".62" stop-color="${rimC}" stop-opacity=".08"/><stop offset="1" stop-color="${rimC}" stop-opacity="${f(Math.min(.55,P.rim*1.4))}"/></linearGradient>`
    // glass glint band (hard candy / crystal only)
    + `<linearGradient id="${gid}gl" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity="${P.glint}"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>`
    // broad soft highlight
    + `<radialGradient id="${gid}soft" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fff" stop-opacity="${P.soft}"/><stop offset=".55" stop-color="#fff" stop-opacity="${f(P.soft*.35*100)/100}"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>`
    // warm reflected light from the "table" (lower area)
    + `<radialGradient id="${gid}bnc" cx=".55" cy=".95" r=".55"><stop offset="0" stop-color="${warmC}" stop-opacity="${P.bounce}"/><stop offset="1" stop-color="${warmC}" stop-opacity="0"/></radialGradient>`
    // translucent inner glow (gummy / crystal / star)
    + `<radialGradient id="${gid}inn" cx=".55" cy=".68" r=".55"><stop offset="0" stop-color="${innerC}" stop-opacity="${P.inner}"/><stop offset="1" stop-color="${innerC}" stop-opacity="0"/></radialGradient>`
    // STEP 3: vibrancy tint (candy's own colour, saturated toward c2) under the lighting
    + `<radialGradient id="${gid}col" cx=".46" cy=".52" r=".62"><stop offset="0" stop-color="${satC}" stop-opacity="${f(P.sat*100)/100}"/><stop offset=".55" stop-color="${satC}" stop-opacity="${f(P.sat*.62*100)/100}"/><stop offset="1" stop-color="${satC}" stop-opacity="0"/></radialGradient>`
    // STEP 3: smooth soft top light (many stops = no banding)
    + `<linearGradient id="${gid}top" x1=".3" y1="0" x2=".5" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="${f(P.top*100)/100}"/><stop offset=".14" stop-color="#fff" stop-opacity="${f(P.top*.72*100)/100}"/><stop offset=".3" stop-color="#fff" stop-opacity="${f(P.top*.38*100)/100}"/><stop offset=".46" stop-color="#fff" stop-opacity="${f(P.top*.12*100)/100}"/><stop offset=".62" stop-color="#fff" stop-opacity="0"/></linearGradient>`
    // STEP 3: soft internal ambient shadow along the lower part
    + `<linearGradient id="${gid}amb" x1=".45" y1="0" x2=".55" y2="1"><stop offset=".5" stop-color="${shadeC}" stop-opacity="0"/><stop offset=".68" stop-color="${shadeC}" stop-opacity="${f(P.shade*.14*100)/100}"/><stop offset=".84" stop-color="${shadeC}" stop-opacity="${f(P.shade*.3*100)/100}"/><stop offset="1" stop-color="${shadeC}" stop-opacity="${f(P.shade*.46*100)/100}"/></linearGradient>`
    // STEP 3: tapered fade for the curved surface reflection stroke
    + `<linearGradient id="${gid}wr" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".3" stop-color="#fff" stop-opacity="1"/><stop offset=".7" stop-color="#fff" stop-opacity=".75"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>`;
  let body = '';
  bodies.forEach((bd, i)=>{
    const [x0,y0,x1,y1] = bd.b, w = x1-x0, h = y1-y0, cx = (x0+x1)/2, cy = (y0+y1)/2;
    defs += `<clipPath id="${gid}k${i}">${bd.clip}</clipPath>`;
    const hx = cx - w*.17, hy = cy - h*.22;      // highlight anchor (upper-left of the body)
    let g = `<g clip-path="url(#${gid}k${i})">`;
    if(!bd.lite){
      if(P.sat > 0) g += `<rect x="${x0}" y="${y0}" width="${w}" height="${h}" fill="url(#${gid}col)"/>`;
      g += `<rect x="${x0}" y="${y0}" width="${w}" height="${h}" fill="url(#${gid}top)"/>`;
      g += `<rect x="${x0}" y="${y0}" width="${w}" height="${h}" fill="url(#${gid}vol)"/>`;
      g += `<rect x="${x0}" y="${y0}" width="${w}" height="${h}" fill="url(#${gid}amb)"/>`;
      g += `<rect x="${x0}" y="${y0}" width="${w}" height="${h}" fill="url(#${gid}rim)"/>`;
      g += `<rect x="${x0}" y="${y0}" width="${w}" height="${h}" fill="url(#${gid}bnc)"/>`;
      if(P.inner > 0) g += `<rect x="${x0}" y="${y0}" width="${w}" height="${h}" fill="url(#${gid}inn)"/>`;
      // bevel: the candy's own silhouette, stroked and clipped to itself = rounded edge shading
      g += bd.clip.replace(/\/>\s*$/, ` fill="none" stroke="url(#${gid}bev)" stroke-width="${f(Math.max(3.6,w*.09))}" stroke-linejoin="round"/>`);
      g += bd.clip.replace(/\/>\s*$/, ` fill="none" stroke="url(#${gid}rs)" stroke-width="1.7" stroke-linejoin="round"/>`);
      if(P.glint > 0) g += `<rect x="${f(cx - w*.09)}" y="${f(y0 - 4)}" width="${f(w*.18)}" height="${f(h + 8)}" fill="url(#${gid}gl)" transform="rotate(32 ${f(cx)} ${f(cy)})"/>`;
    }
    g += `<ellipse cx="${f(hx)}" cy="${f(hy)}" rx="${f(w*.30)}" ry="${f(h*.18)}" fill="url(#${gid}soft)" transform="rotate(-28 ${f(hx)} ${f(hy)})"/>`;
    // (clip group stays open: specular, arcs & spots below are also clipped to the silhouette)
    // crisp specular + reflection point sit on top (not clipped, they are inside the body anyway)
    const sx = cx - w*.22, sy = cy - h*.27;
    g += `<ellipse cx="${f(sx)}" cy="${f(sy)}" rx="${f(Math.max(4.2,w*.24))}" ry="${f(Math.max(2.6,h*.12))}" fill="url(#${gid}soft)" opacity=".5" transform="rotate(-30 ${f(sx)} ${f(sy)})"/>`;
    g += `<ellipse cx="${f(sx)}" cy="${f(sy)}" rx="${f(Math.max(2.4,w*.13))}" ry="${f(Math.max(1.4,h*.07))}" fill="#fff" opacity="${P.spec}" transform="rotate(-30 ${f(sx)} ${f(sy)})"/>`;
    g += `<circle cx="${f(sx - w*.11)}" cy="${f(sy + h*.09)}" r="${f(Math.max(1.1,w*.035))}" fill="#fff" opacity="${P.dot}"/>`;
    if(!bd.lite){
      // small secondary reflected spot, lower right
      g += `<ellipse cx="${f(cx + w*.24)}" cy="${f(cy + h*.27)}" rx="${f(w*.08)}" ry="${f(h*.04)}" fill="#fff" opacity=".24" transform="rotate(-30 ${f(cx + w*.24)} ${f(cy + h*.27)})"/>`;
      if(P.edge > 0){
        // crisp edge light along the upper-left silhouette (hard candy / crystal)
        const rx = w*.46, ry = h*.46, a1 = 200*Math.PI/180, a2 = 262*Math.PI/180;
        g += `<path d="M${f(cx+rx*Math.cos(a1))} ${f(cy+ry*Math.sin(a1))} A${f(rx)} ${f(ry)} 0 0 1 ${f(cx+rx*Math.cos(a2))} ${f(cy+ry*Math.sin(a2))}" fill="none" stroke="#fff" stroke-opacity="${P.edge}" stroke-width="1.6" stroke-linecap="round"/>`;
      }
    }
    if(!bd.lite){
      const pt=(rx,ry,a)=>f(cx+rx*Math.cos(a*Math.PI/180))+' '+f(cy+ry*Math.sin(a*Math.PI/180));
      const r1x=w*.36, r1y=h*.36, r2x=w*.38, r2y=h*.38;
      g += `<path d="M${pt(r1x,r1y,208)} A${f(r1x)} ${f(r1y)} 0 0 1 ${pt(r1x,r1y,262)}" fill="none" stroke="url(#${gid}wr)" stroke-opacity="${f(Math.min(.62,P.wrap+.16))}" stroke-width="${f(Math.max(1.6,w*.05))}" stroke-linecap="round"/>`;
      g += `<path d="M${pt(r1x*.8,r1y*.8,214)} A${f(r1x*.8)} ${f(r1y*.8)} 0 0 1 ${pt(r1x*.8,r1y*.8,248)}" fill="none" stroke="#fff" stroke-opacity="${f(P.wrap*.55)}" stroke-width="${f(Math.max(.8,w*.02))}" stroke-linecap="round"/>`;
      g += `<ellipse cx="${f(cx - w*.26)}" cy="${f(cy + h*.24)}" rx="${f(w*.07)}" ry="${f(h*.035)}" fill="${warmC}" opacity=".2" transform="rotate(35 ${f(cx - w*.26)} ${f(cy + h*.24)})"/>`;
      // STEP 5: faint cool reflected light opposite the main highlight, for extra roundness (kept subtle, never metallic)
      g += `<ellipse cx="${f(cx + w*.30)}" cy="${f(cy + h*.30)}" rx="${f(w*.10)}" ry="${f(h*.05)}" fill="#fff" opacity="${f(P.rim*.16*100)/100}" transform="rotate(-40 ${f(cx + w*.30)} ${f(cy + h*.30)})"/>`;
      g += `<path d="M${pt(r2x,r2y,18)} A${f(r2x)} ${f(r2y)} 0 0 1 ${pt(r2x,r2y,70)}" fill="none" stroke="${rimC}" stroke-opacity="${f(.16+P.bounce*.6)}" stroke-width="${f(Math.max(1.2,w*.03))}" stroke-linecap="round"/>`;
    }
    g += '</g>';
    body += g;
  });
  // contact shadow geometry from the union of the bodies
  let minX=100, maxX=0, maxY=0;
  bodies.forEach(bd=>{ minX=Math.min(minX,bd.b[0]); maxX=Math.max(maxX,bd.b[2]); maxY=Math.max(maxY,bd.b[3]); });
  const shadow = {cx:(minX+maxX)/2, cy:Math.min(90, maxY-2), rx:Math.max(18, Math.min(34, (maxX-minX)*.55)), ry:7.5};
  // richer base gradient: bright core, true colour mid, deeper edge
  const base = `<stop offset="0" stop-color="${_pcMix(c1,'#ffffff',.4)}"/>`
             + `<stop offset=".32" stop-color="${_pcMix(c1,'#ffffff',.04)}"/>`
             + `<stop offset=".72" stop-color="${_pcMix(c1,c2,.62)}"/>`
             + `<stop offset="1" stop-color="${_pcMix(c2,'#000000',.22)}"/>`;
  return {defs, body, base, shadow};
}

// Builds the inline SVG markup for a filled cell/piece-block that carries
// a candyId from the map above. Returns null when there's no premium art
// for this candy (the original 8 THEMES, or specials), so callers fall
// straight back to the existing plain-emoji rendering untouched.
// STEP 9 ERROR SAFETY: wrapped so a broken/unexpected art entry can never
// crash the whole game — worst case it just falls back to null (same as
// "no premium art"), same as any candy that legitimately has none.
// STEP 3 — PREMIUM 3D FINISH (applied once here, uniformly, to all 20
// candies). This wraps every per-candy silhouette from CANDY_ART with the
// same three cosmetic layers so every candy shares identical, consistent
// "studio lighting": (1) a soft, gradient-blurred contact shadow instead of
// a flat ellipse, for real depth; (2) a subtle colour-matched ambient glow
// behind the piece (uses the candy's own c1, so it never clashes); (3) a
// single diagonal glass sheen swept across the tile on top, the same
// glossy-mobile-game "polish pass" every candy gets. All three are plain
// static SVG (gradients + a couple of shapes) — no filters, no blur, no
// canvas, no per-frame cost — so this stays cheap on low-end Android even
// with a full 8x8 board of these. Purely a rendering add-on: it never
// touches candyId, c1/c2, board state, drag/drop or scoring.
function buildCandySVG(candyId, c1, c2){
  try{
    const art = CANDY_ART[candyId];
    if(!art) return null;
    const gid = 'cg' + (++_candyGradSeq % 100000);
    const L = buildPremiumCandyLighting(gid, candyId, c1, c2);
    return `<svg viewBox="0 0 100 100" class="candy-svg" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">`
      + `<defs>`
      // Body gradient keeps the original id (gid): every silhouette that fills
      // itself with url(#gid) now gets a brighter core + deeper rim.
      + `<radialGradient id="${gid}" cx="34%" cy="27%" r="80%">${L.base}</radialGradient>`
      // Soft contact shadow (radial fade, not a hard ellipse).
      + `<radialGradient id="${gid}shadow" cx="50%" cy="50%" r="50%">`
      + `<stop offset="0%" stop-color="#000" stop-opacity=".38"/>`
      + `<stop offset="60%" stop-color="#000" stop-opacity=".16"/>`
      + `<stop offset="100%" stop-color="#000" stop-opacity="0"/>`
      + `</radialGradient>`
      // Faint colour-matched ambient glow.
      + `<radialGradient id="${gid}glow" cx="50%" cy="46%" r="60%">`
      + `<stop offset="0%" stop-color="${c1}" stop-opacity=".12"/>`
      + `<stop offset="100%" stop-color="${c1}" stop-opacity="0"/>`
      + `</radialGradient>`
      + L.defs
      + `</defs>`
      + `<ellipse cx="${L.shadow.cx}" cy="${L.shadow.cy}" rx="${L.shadow.rx}" ry="${L.shadow.ry}" fill="url(#${gid}shadow)"/>`
      + `<circle cx="50" cy="50" r="40" fill="url(#${gid}glow)"/>`
      + art(gid)
      + L.body
      + `</svg>`;
  } catch(err){
    console.error('[Candy Blast] buildCandySVG failed for candyId="'+candyId+'" — falling back to plain emoji.', err);
    return null;
  }
}

// ============================================================
// STEP 9 — SINGLE SOURCE OF TRUTH: lookup + safe accessors
// Every system that needs a Classic candy's data (name, colours, material
// group) goes through these instead of re-scanning CLASSIC_EXTRA_THEMES or
// keeping its own separate copy of the data.
// ============================================================
const CLASSIC_CANDY_BY_ID = {};
CLASSIC_EXTRA_THEMES.forEach(t=>{ CLASSIC_CANDY_BY_ID[t.id] = t; });

// Safe getter: never throws, never returns undefined. An unknown/invalid
// id (corrupted save data, a future typo, etc.) just resolves to null —
// every caller below already treats null as "no special candy data, use
// the generic/default behaviour", so a bad id degrades gracefully instead
// of crashing anything.
function getClassicCandyDef(candyId){
  if(!candyId) return null;
  const def = CLASSIC_CANDY_BY_ID[candyId];
  return def || null;
}

// Step 7's clear-pop material lookup now simply reads the `material` field
// declared once on each candy's own central definition above (see the
// CLASSIC_EXTRA_THEMES comment) instead of keeping its own separate
// switch/case list — one source of truth, exactly per Step 9 point 2/8.
// Behaviour for every existing candy is unchanged: soft/choc/shard/rainbow
// exactly as before, everything else still null (generic pop).
function classicCandyMaterialGroup(candyId){
  const def = getClassicCandyDef(candyId);
  return (def && def.material) || null;
}

// STEP 9 point 3 — asset validation at startup: confirms every one of the
// 20 central candy definitions actually has matching premium art, and logs
// a clear, developer-only console warning (never a crash, never a visible
// error to the player) for anything missing so a future typo'd id or a
// removed CANDY_ART entry is caught immediately instead of silently
// rendering an invisible candy. A candy missing its art still safely
// falls back to its plain emoji glyph everywhere (see buildCandySVG),
// exactly like the original 8 THEMES candies already do.
function validateClassicCandyAssets(){
  CLASSIC_EXTRA_THEMES.forEach(def=>{
    if(!CANDY_ART[def.id]){
      console.error('[Candy Blast] Missing premium art for candy id "'+def.id+'" ('+(def.name||'unnamed')+'). Falling back to emoji glyph.');
    }
    if(!def.emoji){
      console.error('[Candy Blast] Candy id "'+def.id+'" has no emoji fallback configured — this candy could render invisible if its art is ever missing.');
    }
  });
}
validateClassicCandyAssets();
// Full Classic-mode pool: original 8 + the 20 new ones = 28 possible
// candy looks. Journey keeps using THEMES (8) directly, unchanged.
const CLASSIC_THEMES = THEMES.concat(CLASSIC_EXTRA_THEMES);

// ============================================================
// CLASSIC MODE STEP 7 — material identity for the clear-pop effect.
// (STEP 9 update: classicCandyMaterialGroup itself now lives earlier in
// the file, right next to CLASSIC_CANDY_BY_ID, reading the `material`
// field declared once on each candy's own central definition instead of
// its own separate switch/case — single source of truth. Nothing about
// its behaviour changed: jelly/gummy = soft, chocolate = choc, hard/
// crystal = shard, rainbow = rainbow, everything else = null/generic.)
// ============================================================
// Brief glossy highlight sheen over a just-placed cell (Classic Mode
// placement polish, Step 7 item 1). A disposable overlay DIV, same
// pattern as the existing particle effects — appended, self-removing,
// never blocks input or touches game state/timing.
function spawnClassicPlaceSheen(r,c){
  const dom = getCellDOM(r,c);
  if(!dom) return;
  const rect = dom.getBoundingClientRect();
  const sheen = document.createElement('div');
  sheen.className = 'candy-gloss-sheen';
  sheen.style.left = rect.left+'px';
  sheen.style.top = rect.top+'px';
  sheen.style.width = rect.width+'px';
  sheen.style.height = rect.height+'px';
  document.body.appendChild(sheen);
  setTimeout(()=>sheen.remove(), 320);
}

const SHAPES = [
  {name:'single', cells:[[0,0]]},
  {name:'h2', cells:[[0,0],[0,1]]},
  {name:'v2', cells:[[0,0],[1,0]]},
  {name:'h3', cells:[[0,0],[0,1],[0,2]]},
  {name:'v3', cells:[[0,0],[1,0],[2,0]]},
  {name:'h4', cells:[[0,0],[0,1],[0,2],[0,3]]},
  {name:'v4', cells:[[0,0],[1,0],[2,0],[3,0]]},
  {name:'sq2', cells:[[0,0],[0,1],[1,0],[1,1]]},
  {name:'L1', cells:[[0,0],[1,0],[2,0],[2,1]]},
  {name:'L2', cells:[[0,1],[1,1],[2,1],[2,0]]},
  {name:'L3', cells:[[0,0],[0,1],[1,0],[2,0]]},
  {name:'L4', cells:[[0,0],[0,1],[1,1],[2,1]]},
  {name:'T', cells:[[0,0],[0,1],[0,2],[1,1]]},
  {name:'Trot', cells:[[0,1],[1,0],[1,1],[2,1]]},
  {name:'Z', cells:[[0,0],[0,1],[1,1],[1,2]]},
  {name:'S', cells:[[0,1],[0,2],[1,0],[1,1]]},
  {name:'plus', cells:[[0,1],[1,0],[1,1],[1,2],[2,1]]},
  {name:'corner1', cells:[[0,0],[0,1],[1,0]]},
  {name:'corner2', cells:[[0,0],[0,1],[1,1]]},
  {name:'corner3', cells:[[0,0],[1,0],[1,1]]},
  {name:'corner4', cells:[[0,1],[1,0],[1,1]]},
  {name:'sq3', cells:[[0,0],[0,1],[0,2],[1,0],[1,1],[1,2],[2,0],[2,1],[2,2]]}
];

const SPECIAL_TYPES = [
  {type:'bomb', icon:'💣'},
  {type:'line', icon:'⚡'},
  {type:'area', icon:'✨'}
];

/* ============================================================
   STATE
============================================================ */
let board = [];          // board[r][c] = {filled, obstacle, void, c1, c2, emoji, specialType, blastColor}
let score = 0;
let best = 0;
let mode = 'classic';    // 'classic' | 'journey'
// Classic-mode-only advanced scoring state (combo/streak/multiplier). Never
// read or written to in Journey mode or the More Games mini-games.
let classicStreak = 0;        // consecutive moves in a row that cleared >=1 line (uncapped)
let classicMultiplier = 1;    // min(8, classicStreak), applied to line-clear points only
let classicHighestStreak = 0; // best streak reached this game, shown on Game Over
// Classic-mode-only rare Tornado POWER-UP: a hidden setTimeout chain
// decides only WHEN a tornado piece is allowed to appear in the tray next
// to the normal candy pieces (2-3 times per session, long unpredictable
// gaps). It NEVER clears the board by itself — the tornado just sits in
// the tray like any other piece until the player actually drags it onto
// the board, exactly like the Bomb piece. Every entry point below is
// gated on mode==='classic'.
let tornadoTimerId = null;       // schedules the NEXT tornado piece to appear in the tray
let tornadoActive = false;       // true only while the clear ANIMATION itself is playing
let tornadoOfferState = 'idle';  // 'idle' | 'pending' (a tornado piece currently sits, unplaced, in the tray)
let tornadoOffersShown = 0;
let tornadoMaxOffers = 3;
const TORNADO_AREA = 6; // 6×6 clear area, clipped to the board
let trayPieces = [null,null,null];
// CLASSIC TAP-TO-FILL: Classic Mode no longer uses the 3-piece tray / drag-and-drop. The player taps
// an empty board cell to fill it with ONE candy. Blast Journey keeps its tray + drag system untouched.
// Set to false to restore the old Classic tray gameplay (all old code is still in place).
const CLASSIC_TAP_FILL = true;
let classicTapOver = false;      // true once Classic game over has been detected (blocks further taps)
let dragInfo = null;
let boardCellSize = 40;
// Actual on-screen #board padding/gap, read from the real computed CSS
// (see computeCellSize()) instead of guessed constants. #board's CSS gap
// changes across responsive breakpoints (4px / 3.5px / 3px) and its
// padding is 0 — these are kept in sync with reality so the drop/placement
// math (which converts a release point into a board row/col) always
// matches where the cells are actually drawn, instead of drifting off by
// a growing amount the further a cell is from the top-left corner.
let boardPadding = 0;
let boardGap = 4;
let obstaclesSpawned = 0;
let obstacleCount = 0;
let placementsSinceStart = 0;
let audioCtx = null;

let settings = {sound:true, vibration:true};

/* ---- Blast Journey state ---- */
const JOURNEY_TOTAL_LEVELS = 200;
let journeyProgress = { unlocked:1, completed:{}, stars:{} };
const ARROW_TOTAL_LEVELS = 100;
let arrowProgress = { unlocked:1, completed:{} };
let journeyLevel = null;          // live level config with mutable target.collected counters
let currentJourneyLevelNumber = 0;
let pendingJourneyLevel = 0;      // level chosen on the map, shown on the preview screen
let journeyMovesUsed = 0;
let hintTimeoutId = null;
let lockedCandyTutorialShown = false; // Show tutorial only first time locked candy appears
let lockedCandies = {};  // Map of "r,c" -> { unlockHits, type, c1, c2, emoji }
let frozenCandyTutorialShown = false; // Show tutorial only first time frozen candy appears
let frozenCandies = {};  // Map of "r,c" -> { iceHits, type, c1, c2, emoji }
let jellyTutorialShown = false; // Show tutorial only first time jelly appears
let jellyCells = {};  // Map of "r,c" -> { jellyHits, broken }
let journeyMovesRemaining = null; // null = unlimited moves for this level; else counts down
let journeyMovesTutorialShown = false; // Show "Limited Moves!" tutorial only the first time
let comboTutorialShown = false; // Show "COMBO CHALLENGE" tutorial only the first time
let chocolateTutorialShown = false; // Show "CHOCOLATE" tutorial only the first time
let chocolateCells = {};  // Map of "r,c" -> { hits } — can sit on a filled OR empty cell
let chocolateBrokenThisMove = false; // set true inside processChocolateBreaks whenever a chocolate cell actually breaks during the current move
let chocolateMovesSinceBreak = 0;    // consecutive valid Journey moves without a chocolate break; drives the spread interval
let journeyBombTutorialShown = false; // Show "CANDY BOMB" tutorial only the first time this mechanic appears
let journeyBombCells = {};  // Map of "r,c" -> { countdown } — always sits on a filled candy cell (needs to be part of a real line clear to defuse)
let rainbowTutorialShown = false; // Show "RAINBOW CANDY" tutorial only the first time this mechanic appears
let rainbowCells = {};      // Map of "r,c" -> true — always sits on a filled candy cell; can coexist with locked/frozen/jelly on that same cell (see processRainbowCollection), but never with chocolate/bomb (excluded at placement)
let treasureTutorialShown = false; // Show "TREASURE" tutorial only the first time this mechanic appears
let treasureCells = {};     // Map of "r,c" -> { hitsRequired, hitsRemaining } — always sits on a filled candy cell; can coexist with locked/frozen/jelly on that same cell (see processTreasureBoxHits), but never with chocolate/bomb/rainbow (excluded at placement)
let pathTutorialShown = false; // Show "SWEET PATH" tutorial only the first time this mechanic appears
let pathCells = {};   // Map of "r,c" -> { order, completed } — this level's Candy Path steps, keyed by position. Hand-authored per level (CUSTOM_LEVEL_PATH), never randomly generated, so the route is always connected and valid.
let pathSequence = []; // Ordered array of "r,c" keys, START to FINISH, built by initializePathCells()
let pathNextIndex = 0; // Index into pathSequence of the next step that must be cleared, in order — see processPathProgress()

// ---------- LEVEL 200 — "CANDY CASTLE" FINAL BOSS ----------
const BOSS_LEVEL_NUMBER = 200;
const BOSS_DAMAGE_CAP_PER_MOVE = 2; // sensible cap so one big multi-line move can't instant-kill the boss
const BOSS_INTRO_LINES = ['Candy Smash Journey', 'Candy Castle', 'FINAL CHALLENGE'];
let bossActive = false;                 // true only while currentJourneyLevelNumber===BOSS_LEVEL_NUMBER
// BUGFIX (Step 17 QA — rapid input test): true from the instant a move is
// determined to win or fail the level until the next startJourneyLevel().
// Guards afterPlacement() below against a second real placement landing
// during the ~380-2500ms delay before the complete/failed screen actually
// appears (the board itself is still visible/interactive right up until
// that screen swap) — without it, a fast second move in that window could
// consume an extra move and schedule a second triggerLevelComplete()/
// triggerLevelFailed() call.
let journeyRoundOver = false;
let bossPhase = 1;                      // 1/2/3 — purely visual/narrative (see damageBossOnClear); never changes which mechanics are on the board
let bossCelebrationShown = false;       // the ~50% HP "Candy Castle Celebration" — once per level attempt
let bossVictorySequencePlaying = false; // guards the existing triggerLevelComplete() from firing before the victory animation finishes
let bossIntroTimeoutId = null;
/* ============================================================
   BLAST JOURNEY — level-wise candy-themed backgrounds.
   Journey-only (applyBlastJourneyTheme is never called from Classic);
   Classic's background/board are completely untouched by this system —
   see the #game-screen:not(.journey-mode) CSS guard above.
============================================================ */
const JOURNEY_THEMES = [
  { name:'Strawberry Candy Garden',    from:1,   to:5,   top:'#ffd1e0', bottom:'#ff8fb3', accent:'rgba(255,92,138,.35)',  particles:['🍓','🍬','✨'] },
  { name:'Lemon Candy Land',           from:6,   to:10,  top:'#fff6c9', bottom:'#ffe066', accent:'rgba(255,204,51,.35)',  particles:['🍋','🍭','✨'] },
  { name:'Blueberry Ice World',        from:11,  to:15,  top:'#d6f0ff', bottom:'#8ecbf0', accent:'rgba(79,179,232,.35)',  particles:['🫐','❄️','✨'] },
  { name:'Chocolate Cookie World',     from:16,  to:20,  top:'#e8cba8', bottom:'#8a5a34', accent:'rgba(201,138,75,.4)',   particles:['🍫','🍪','✨'] },
  { name:'Mint Candy Valley',          from:21,  to:25,  top:'#d9fff0', bottom:'#7fe0c2', accent:'rgba(63,207,158,.35)',  particles:['🍬','🫧','✨'] },
  { name:'Grape Jelly World',          from:26,  to:30,  top:'#e3d1ff', bottom:'#9a6fe0', accent:'rgba(123,75,214,.35)',  particles:['🍇','🫧','✨'] },
  { name:'Orange Citrus Blast',        from:31,  to:35,  top:'#ffe0c2', bottom:'#ff9d4d', accent:'rgba(255,122,26,.35)',  particles:['🍊','🍑','✨'] },
  { name:'Cotton Candy Sky',           from:36,  to:40,  top:'#ffd9f0', bottom:'#c6b3ff', accent:'rgba(255,159,224,.35)', particles:['☁️','🍬','✨'] },
  { name:'Rainbow Candy World',        from:41,  to:45,  top:'#ffe9a8', bottom:'#ff9fd6', accent:'rgba(255,204,51,.35)',  particles:['🌈','🍬','✨'] },
  { name:'Caramel Candy Factory',      from:46,  to:50,  top:'#ffe8b8', bottom:'#c98a3a', accent:'rgba(224,164,74,.4)',   particles:['🍯','🍬','✨'] },
  { name:'Tropical Candy Island',      from:51,  to:60,  top:'#c8f7dc', bottom:'#4fd6a8', accent:'rgba(255,204,51,.35)',  particles:['🍍','🍉','🥥'] },
  { name:'Marshmallow Cloud World',    from:61,  to:70,  top:'#fff0f5', bottom:'#cfe8ff', accent:'rgba(255,179,209,.35)', particles:['☁️','🍡','✨'] },
  { name:'Candy Neon City',            from:71,  to:80,  top:'#2a1a4d', bottom:'#5c2a8a', accent:'rgba(255,46,196,.4)',   particles:['💫','🍬','✨'] },
  { name:'Rainbow Dessert World',      from:81,  to:90,  top:'#ffd8ec', bottom:'#b8a8ff', accent:'rgba(255,143,214,.35)', particles:['🧁','🍩','🍨'] },
  { name:'Sweet Explosion World',      from:91,  to:100, top:'#ffd1a8', bottom:'#ff6f9c', accent:'rgba(255,204,51,.4)',   particles:['🍓','🍋','🫐'] },
  { name:'Chocolate Volcano Candy World', from:101, to:120, top:'#5a2a1a', bottom:'#c9401a', accent:'rgba(255,167,51,.4)', particles:['🍫','🔥','✨'] },
  { name:'Frozen Candy Palace',        from:121, to:140, top:'#eaf6ff', bottom:'#9ecbe8', accent:'rgba(191,227,255,.4)',  particles:['❄️','💎','✨'] },
  { name:'Giant Candy Kingdom',        from:141, to:160, top:'#ffe1f0', bottom:'#c39aff', accent:'rgba(255,204,51,.35)',  particles:['👑','🍬','✨'] },
  { name:'Ultimate Sweet Blast',       from:161, to:180, top:'#ff9ac2', bottom:'#7b4bd6', accent:'rgba(255,204,51,.4)',   particles:['💥','🍬','✨'] },
  { name:'Rainbow Master World',       from:181, to:199, top:'#ffd6a8', bottom:'#a8d6ff', accent:'rgba(255,143,214,.4)',  particles:['🌈','✨','💫'] },
  { name:'Final Candy Smash World',    from:200, to:200, top:'#ffe066', bottom:'#ff6fb0', accent:'rgba(255,255,255,.5)',  particles:['🌈','🎉','✨'], finale:true },
];
function getJourneyThemeForLevel(level){
  return JOURNEY_THEMES.find(t=>level>=t.from && level<=t.to) || JOURNEY_THEMES[0];
}
/* ============================================================
   BLAST JOURNEY — 20 (+1 finale) distinct board SHAPES, one per theme
   level-range (same ranges as JOURNEY_THEMES above). '1' = playable cell,
   '0' = void (outside the level's board shape, permanently blocked,
   rendered invisible). Every mask was validated offline to be unique
   (no two ranges share a shape) and to leave a reasonable number of
   playable cells. Classic mode never touches this array.
============================================================ */
const JOURNEY_BOARD_SHAPES = [

  { from:1,   to:5,   name:'Strawberry Garden',    mask:['01111110','11111111','11111111','11111111','11111111','11111111','11111111','01111110'] },
  { from:6,   to:10,   name:'Lemon Land',    mask:['00111100','01111110','11111111','11111111','11111111','11111111','01111110','00111100'] },
  { from:11,   to:15,   name:'Blueberry Ice',    mask:['00111100','00111100','11111111','11111111','11111111','11111111','00111100','00111100'] },
  { from:16,   to:20,   name:'Chocolate World',    mask:['11111111','11111111','00111100','00111100','00111100','00111100','00111100','00111100'] },
  { from:21,   to:25,   name:'Mint Valley',    mask:['00011000','00111100','01111110','11111111','11111111','01111110','00111100','00011000'] },
  { from:26,   to:30,   name:'Grape Jelly',    mask:['11111111','11111111','11111111','11111111','11111111','11100000','11100000','11100000'] },
  { from:31,   to:35,   name:'Orange Blast',    mask:['11111111','11111111','11111111','11111111','11111111','00000111','00000111','00000111'] },
  { from:36,   to:40,   name:'Cotton Candy Sky',    mask:['10111011','11111111','11111111','11111111','11111111','11111111','11111111','11111111'] },
  { from:41,   to:45,   name:'Rainbow Candy',    mask:['00111100','01111110','11111111','11111111','11111111','11111111','11111111','11111111'] },
  { from:46,   to:50,   name:'Caramel Factory',    mask:['11111111','11111111','01111110','01111110','01111110','00111100','00111100','00011000'] },
  { from:51,   to:60,   name:'Tropical Island',    mask:['00111000','01111100','11111110','11111111','11111111','01111111','00111110','00011100'] },
  { from:61,   to:70,   name:'Marshmallow Cloud',    mask:['10111011','11111111','11111111','11111111','11111111','11111111','11111111','10111011'] },
  { from:71,   to:80,   name:'Candy Neon City',    mask:['11111111','11111111','10000001','10000001','10000001','10000001','11111111','11111111'] },
  { from:81,   to:90,   name:'Dessert World',    mask:['11111111','01111110','01111110','00111100','00111100','00111100','00111100','00111100'] },
  { from:91,   to:100,   name:'Sweet Explosion',    mask:['10000001','11000011','11100111','11111111','11111111','11100111','11000011','10000001'] },
  { from:101,   to:120,   name:'Chocolate Volcano',    mask:['00011000','00111100','00111100','01111110','01111110','01111110','11111111','11111111'] },
  { from:121,   to:140,   name:'Frozen Candy Palace',    mask:['01011010','11111111','11111111','11111111','11111111','11111111','11111111','11111111'] },
  { from:141,   to:160,   name:'Giant Candy Kingdom',    mask:['01011010','11111111','11111111','11111111','11111111','11111111','11111111','01011010'] },
  { from:161,   to:180,   name:'Ultimate Sweet Blast',    mask:['11111111','11111111','11000011','11000011','11000011','11000011','11111111','11111111'] },
  { from:181,   to:199,   name:'Rainbow Master',    mask:['11111111','01111110','00111100','00011000','00011000','00111100','01111110','11111111'] },
  { from:200,   to:200,   name:'Final Candy Smash',    mask:['11111111','11111111','11111111','11111111','11111111','11111111','11111111','11111111'] },
];
function getJourneyBoardShapeForLevel(level){
  return JOURNEY_BOARD_SHAPES.find(s=>level>=s.from && level<=s.to) || JOURNEY_BOARD_SHAPES[JOURNEY_BOARD_SHAPES.length-1];
}
// Stamps a shape's void mask onto a freshly-created board. Must run BEFORE
// any obstacles/targets are placed, since those loops skip void cells.
function applyBoardShapeMask(b, shape){
  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      b[r][c].void = shape.mask[r][c]==='0';
    }
  }
}
let journeyThemeActiveLayer = null; // 'a' | 'b' | null (null = nothing applied yet this session)
let journeyThemeCurrentName = null;
function journeyBuildThemeParticles(layerEl, theme){
  layerEl.innerHTML = '';
  const anims = ['journeyFloatA','journeyFloatB','journeyFloatC'];
  const count = 7; // few, lightweight, decorative only — never a performance concern
  for(let i=0;i<count;i++){
    const p = document.createElement('span');
    p.className = 'journey-particle';
    p.textContent = theme.particles[i % theme.particles.length];
    p.style.left = (6+Math.random()*88)+'%';
    p.style.top = (6+Math.random()*88)+'%';
    p.style.fontSize = (14+Math.random()*14)+'px';
    p.style.animationName = anims[i % anims.length];
    p.style.animationDuration = (5+Math.random()*4)+'s';
    p.style.animationDelay = (Math.random()*3)+'s';
    layerEl.appendChild(p);
  }
}
// Centralized theme application — the ONLY place that reads JOURNEY_THEMES
// and writes to the background layers, so there is one source of truth and
// nothing level-specific is ever duplicated elsewhere.
function applyBlastJourneyTheme(level){
  const theme = getJourneyThemeForLevel(level);
  if(theme.name===journeyThemeCurrentName) return; // same theme as already showing — no pointless re-transition
  journeyThemeCurrentName = theme.name;

  const nextLayerKey = journeyThemeActiveLayer==='a' ? 'b' : 'a';
  const nextLayerEl = el('journey-theme-bg-'+nextLayerKey);
  const prevLayerEl = journeyThemeActiveLayer ? el('journey-theme-bg-'+journeyThemeActiveLayer) : null;

  // Each Journey theme now renders its OWN sky (top->bottom gradient from
  // JOURNEY_THEMES) softly blended with the shared illustrated Candy
  // Kingdom artwork, plus its own accent-colored hill silhouette (see
  // .journey-theme-bg::before) and particle set — so all 20+1 worlds have
  // a visibly distinct sky/lighting/color atmosphere while still sharing
  // one lightweight base illustration (no extra image bytes).
  nextLayerEl.style.backgroundImage =
    `linear-gradient(180deg, ${theme.top} 0%, ${theme.bottom} 100%), var(--candy-kingdom-bg)`;
  nextLayerEl.style.setProperty('--theme-accent', theme.accent);
  // Also set on #game-screen (an actual ancestor of #board) so playable
  // cells and void-cell styling — which live outside the theme-bg layer —
  // can read the same custom property via normal CSS inheritance.
  // theme.accent is already an rgba(...) string (see JOURNEY_THEMES above),
  // so it's reused as-is for the soft void-cell glow, no color parsing
  // needed.
  gameScreen.style.setProperty('--theme-accent', theme.accent);
  gameScreen.style.setProperty('--theme-accent-soft', theme.accent);
  nextLayerEl.classList.toggle('finale-world', !!theme.finale);
  journeyBuildThemeParticles(nextLayerEl, theme);

  // Crossfade: fade the new layer in, fade the old one out. requestAnimationFrame
  // ensures the browser registers the "before" state (no .active) before we
  // flip it, so the opacity transition actually animates instead of snapping.
  requestAnimationFrame(()=>{
    nextLayerEl.classList.add('active');
    if(prevLayerEl && prevLayerEl!==nextLayerEl) prevLayerEl.classList.remove('active');
  });
  journeyThemeActiveLayer = nextLayerKey;
}

// Brief "SWEET EXPLOSION -> LEVEL N -> theme name" flourish shown every
// time a Journey level starts. Purely decorative and non-blocking
// (pointer-events:none in CSS) — gameplay underneath is already fully
// live and playable while this fades in/out over it.
let journeyIntroTimeoutId = null;
function showJourneyLevelIntro(n){
  const overlay = el('journey-intro-overlay');
  const theme = getJourneyThemeForLevel(n);
  el('journey-intro-level-num').textContent = n;
  el('journey-intro-theme-name').textContent = theme.name;
  if(journeyIntroTimeoutId){ clearTimeout(journeyIntroTimeoutId); journeyIntroTimeoutId = null; }
  overlay.classList.add('journey-intro-visible');
  journeyIntroTimeoutId = setTimeout(()=>{
    overlay.classList.remove('journey-intro-visible');
    journeyIntroTimeoutId = null;
  }, 1500);
}
// Cancels the intro immediately (no lingering overlay) — called whenever
// the player leaves the game screen entirely.
function hideJourneyLevelIntro(){
  if(journeyIntroTimeoutId){ clearTimeout(journeyIntroTimeoutId); journeyIntroTimeoutId = null; }
  el('journey-intro-overlay').classList.remove('journey-intro-visible');
}

// A light candy-confetti burst for the Level Complete screen — a fixed,
// small number of emoji particles that fall and fade once, then remove
// themselves. Cheap: capped at 18 short-lived DOM nodes, no animation
// loop, nothing left running once they're done.
function spawnLevelCompleteConfetti(grand, container){
  container = container || journeyCompleteScreen;
  container.querySelectorAll('.confetti-piece').forEach(p=>p.remove());
  const emojis = ['🍬','🍭','🍩','🧁','⭐','✨','🍓','🍫'];
  const count = grand ? 26 : 18;
  for(let i=0;i<count;i++){
    const p = document.createElement('div');
    p.className = 'confetti-piece';
    p.textContent = emojis[Math.floor(Math.random()*emojis.length)];
    p.style.left = (Math.random()*100)+'%';
    p.style.animationDelay = (Math.random()*0.4)+'s';
    p.style.animationDuration = (1.6+Math.random()*1.3)+'s';
    p.style.fontSize = (15+Math.random()*15)+'px';
    container.appendChild(p);
    setTimeout(()=>p.remove(), 3300);
  }
}

