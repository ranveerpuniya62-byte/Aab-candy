          <span class="premium-go-eyes">✕ ✕</span>
          <span class="premium-go-mouth"></span>
        </div>
      </div>
      <div class="premium-go-title-badge">
        <div class="premium-go-title-frosting">
          <span class="premium-go-leaf premium-go-leaf-l">🍃</span>
          <span class="premium-go-leaf premium-go-leaf-r">🍃</span>
        </div>
        <span class="premium-go-title-line premium-go-title-gold">GAME</span>
        <span class="premium-go-title-line premium-go-title-white">OVER</span>
      </div>
      <div class="premium-go-panel">
        <div class="premium-go-corner premium-go-corner-tl">🍬</div>
        <div class="premium-go-corner premium-go-corner-tr">🍭</div>
        <div class="premium-go-stats">
          <div class="premium-go-row">
            <span class="premium-go-row-icon">⭐</span>
            <span class="premium-go-row-label">Score</span>
            <span class="premium-go-row-value" id="go-score">0</span>
          </div>
          <div class="premium-go-row">
            <span class="premium-go-row-icon">👑</span>
            <span class="premium-go-row-label">Best</span>
            <span class="premium-go-row-value" id="go-best">0</span>
          </div>
