  198: [{ type: 'blue', target: 8, locked: 1 }],
  199: [{ isJelly: true, jellyCount: 2 }],

  // ============================================================
  // LEVEL 200: "CANDY CASTLE" — FINAL BOSS LEVEL
  // A {type:'boss', hp} entry is pulled out of the objectives array
  // separately, same pattern as chocolate/bomb/rainbow/treasure above —
  // see the isBoss branch in generateLevelConfig — and becomes the
  // level's standalone "👑 collected/required" objective (never a
  // collectible candy). Alongside it, a light set of ALREADY-EXISTING
  // mechanics keep running exactly as they always have: Locked + Frozen +
  // Jelly here (the level's "Phase 2" flavor), and Rainbow + Treasure +
  // Path via CUSTOM_LEVEL_RAINBOW/TREASURE/PATH[200] below (the level's
  // "Phase 3" flavor). No new mechanic is introduced — see damageBossOnClear()
  // for how "phases" are purely a visual/narrative layer driven by boss HP
  // thresholds, never a change to which mechanics are on the board.
  // ============================================================
  200: [
    { type: 'boss', hp: 10 },
    { type: 'pink', target: 4, locked: 1 },
    { type: 'blue', target: 4, frozen: 1 },
    { isJelly: true, jellyCount: 2 }
  ]
};

